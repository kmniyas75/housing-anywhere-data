k":"https://housinganywhere.imgix.net/unit_type/1680919/e22eeb5d-081a-4fbb-b024-79bc818e63d7.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","categories":null,"sizes":{"1024x768":{"link":"https://housinganywhere.imgix.net/unit_type/1680919/e22eeb5d-081a-4fbb-b024-79bc818e63d7.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/unit_type/1680919/e22eeb5d-081a-4fbb-b024-79bc818e63d7.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1680919/e22eeb5d-081a-4fbb-b024-79bc818e63d7.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1680919/e22eeb5d-081a-4fbb-b024-79bc818e63d7.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1680919/e22eeb5d-081a-4fbb-b024-79bc818e63d7.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"Möbliertes Haus in ruhiger, ländlicher Lage in Zachow in den Ruhner Bergen, ideal für Projektmitarbeitende, Monteure oder Berufstätige, die für einen befristeten Zeitraum in der Region arbeiten und bewusst ruhig wohnen möchten.\n\nDas Haus ist ein moderner Neubau und bietet ein Wohnzimmer, eine voll ausgestattete Küche, ein Schlafzimmer sowie ein Gästezimmer. Zusätzlich stehen zwei separate Arbeitsbereiche zur Verfügung, wodurch sich das Haus gut für längere Aufenthalte und berufliches Arbeiten eignet.\n\nEin großer Garten kann mitgenutzt werden und bietet viel Ruhe und Abstand. Die Unterkunft wird häufig von Projekt- und Montageteams genutzt, u. a. aus dem Bereich Energie und Infrastruktur.\n\nDie Autobahn (A24 Richtung Berlin / Hamburg) ist in ca. 15 Minuten mit dem Auto erreichbar. Parkmöglichkeiten befinden sich direkt am Haus.\n\nEin Self Check-in über Schlüsselbox ermöglicht eine flexible Anreise.\n\nBettwäsche und Handtücher sind vorhanden, eine regelmäßige Reinigung inklusive Wäschewechsel erfolgt in festem Intervall.\n\nEin eigener Parkplatz sowie ein Ladeanschluss für Elektrofahrzeuge steht am Carport zur Verfügung.","facilities":{"airConditioning":{"value":"no"},"allergyFriendly":{"value":"no"},"balconyTerrace":{"value":"private"},"basement":{"value":"no"},"bathroom":{"value":"private"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"yes"},"bedrooms":{"value":"2"},"closet":{"value":"yes"},"couplesAllowed":{"value":"yes"},"desk":{"value":"yes"},"dishwasher":{"value":"yes"},"dryer":{"value":"yes"},"electricityCostIncluded":{"value":"yes"},"flooring":{"value":"plastic"},"garden":{"value":"private"},"gasCostIncluded":{"value":"yes"},"heating":{"value":"central"},"internetCostIncluded":{"value":"yes"},"kitchen":{"value":"private"},"kitchenware":{"value":"private"},"livingRoom":{"value":"private"},"parking":{"value":"private"},"pets":{"value":"no"},"playMusic":{"value":"yes"},"registrationPossible":{"value":"yes"},"roomFurniture":{"value":"yes"},"smoking":{"value":"outside_only"},"toilet":{"value":"private"},"totalSize":{"value":"120"},"tv":{"value":"yes"},"washingMachine":{"value":"yes"},"waterCostIncluded":{"value":"yes"},"wheelchairAccessible":{"value":"no"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":295000,"deposit":0,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"2950.00","deposit":"0.00","agencyFee":"0.00","estimatedBills":"0.00"},"minimumStayMonths":0,"moveInWindow":0,"currentOccupancy":0,"minAge":0,"maxAge":0,"preferredGender":"","available":[{"to":"9999-12-31","from":"2026-03-30"}],"updated":"2026-03-30T11:00:12Z","__utId__":"ut1680919"}]