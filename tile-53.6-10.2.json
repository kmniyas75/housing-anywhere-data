e.imgix.net/unit_type/1714026/1e3e3888-4d89-4d3f-bc5e-fba772f1e3a7.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1714026/1e3e3888-4d89-4d3f-bc5e-fba772f1e3a7.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1714026/1e3e3888-4d89-4d3f-bc5e-fba772f1e3a7.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"Diese stilvoll möblierte Wohnung bietet auf 104 m2 ein großzügiges, loftartiges Wohngefühl mit viel Licht und warmer Atmosphäre.\n\nDer große, offene Wohn-, Ess- und Küchenbereich bildet das Herzstück der Wohnung und vermittelt ein sehr luftiges Raumgefühl. Hochwertige Möbel, Holzfußboden sowie Holzfenster im Mahagoni-Stil unterstreichen den individuellen Charakter. Der Küchenbereich besteht aus einer großen  Kochinsel sowie einem separaten Arbeitsraum, in dem sich Wasch-, Geschirrschpül- und Kaffeemaschiene sowie Spüle und Kühlschrank befinden.\n\nEin Schlafraum mit Schreibtisch, ein kleines modernes Duschbad sowie ein separates WC sind Bestandteil der Wohnung.\n\nEin großer Balkon lädt zum Entspannen ein.\n\nAußerdem gehören 2 Stellplätze auf privatem Grund zu der Wohnung.\n\nLage:\nDie Wohnung befindet sich in einer ruhigen und grünen Umgebung von Großhansdorf (Schmalenbek) mit einer U-Bahnanbindung in die Hamburger Innenstadt. Die U-Bahn (U1) ist in ca. 5 Minuten zu Fuß erreichbar. Außerdem nur 3 bis 5 Minuten zu Fuß: Supermarkt, Apotheke, Bäcker/Cafe, Bankautomat und ein Restaurant.\n\nEbenfalls nur wenige Minuten entfernt ist der Manhagener Wald  – ideal zum Joggen, Spazierengehen oder Radfahren.","facilities":{"airConditioning":{"value":"no"},"allergyFriendly":{"value":"no"},"balconyTerrace":{"value":"private"},"basement":{"value":"no"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"yes"},"bedrooms":{"value":"1"},"closet":{"value":"yes"},"couplesAllowed":{"value":"yes"},"desk":{"value":"yes"},"dishwasher":{"value":"yes"},"dryer":{"value":"no"},"electricityCostIncluded":{"value":"yes"},"flooring":{"value":"wood"},"garden":{"value":"no"},"gasCostIncluded":{"value":"yes"},"heating":{"value":"gas"},"internetCostIncluded":{"value":"yes"},"kitchen":{"value":"private"},"kitchenware":{"value":"private"},"livingRoom":{"value":"private"},"parking":{"value":"private"},"pets":{"value":"no"},"playMusic":{"value":"no"},"registrationPossible":{"value":"yes"},"roomFurniture":{"value":"yes"},"smoking":{"value":"no"},"toilet":{"value":"private"},"totalSize":{"value":"104"},"tv":{"value":"yes"},"washingMachine":{"value":"yes"},"waterCostIncluded":{"value":"yes"},"wheelchairAccessible":{"value":"no"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":195000,"deposit":240000,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"1950.00","deposit":"2400.00","agencyFee":"0.00","estimatedBills":"0.00"},"minimumStayMonths":4,"moveInWindow":0,"currentOccupancy":0,"minAge":0,"maxAge":0,"preferredGender":"","available":[{"to":"9999-12-31","from":"2026-07-01"}],"updated":"2026-06-08T15:12:28Z","__utId__":"ut1714026"}]