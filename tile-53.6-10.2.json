dth":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1740671/1d450ec3-aad0-4d40-b5c3-6561a6c725bf.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1740671/1d450ec3-aad0-4d40-b5c3-6561a6c725bf.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"Exclusive fully furnished maisonette in a quiet residential area in Ahrensburg near Hamburg. The apartment offers approx. 120 sqm of living space across two levels and is ideal for professionals, couples or small families looking for a high-quality temporary home.\n\nThe spacious living and dining area features solid wood flooring, designer furniture and a Bang & Olufsen TV/DVD sound system. The premium Bulthaup kitchen is fully equipped with natural-stone worktops, a large refrigerator, oven, steam oven, dishwasher and Nespresso coffee machine.\n\nThe apartment offers two sleeping areas: one with a double bed and a main bedroom with two single beds that can be joined together as a double bed. A separate home office with fitted desk and cabinetry provides an ideal workspace.\n\nThere are two high-quality bathrooms finished in natural stone and marble, including a full en-suite bathroom and a separate shower bathroom. A Dyson Supersonic hair dryer is provided.\n\nA private west-facing roof terrace, private garage, high-speed internet/Wi-Fi, washer-dryer, premium bed linen and towels complete the accommodation.\n\nAhrensburg railway station is approximately 8 minutes away on foot. Direct trains connect Ahrensburg with Hamburg Central Station, with the fastest connection taking approximately 16 minutes.\n\nMonthly rent includes utilities, heating, electricity, water and internet.\n\nMinimum rental period: 3 months. Maximum rental period: 9 months.\nNon-smoking property. No pets. No parties or events. The fireplace is not available for tenant use.","facilities":{"airConditioning":{"value":"no"},"balconyTerrace":{"value":"private"},"bathroom":{"value":"private"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"no"},"bedrooms":{"value":"2"},"closet":{"value":"yes"},"couplesAllowed":{"value":"yes"},"desk":{"value":"no"},"dishwasher":{"value":"yes"},"dryer":{"value":"yes"},"electricityCostIncluded":{"value":"yes"},"flooring":{"value":"wood"},"garden":{"value":"no"},"gasCostIncluded":{"value":"yes"},"heating":{"value":"gas"},"internetCostIncluded":{"value":"yes"},"kitchen":{"value":"private"},"kitchenware":{"value":"private"},"livingRoom":{"value":"private"},"parking":{"value":"private"},"pets":{"value":"no"},"playMusic":{"value":"no"},"registrationPossible":{"value":"yes"},"roomFurniture":{"value":"yes"},"smoking":{"value":"no"},"toilet":{"value":"private"},"totalSize":{"value":"120"},"tv":{"value":"yes"},"washingMachine":{"value":"yes"},"waterCostIncluded":{"value":"yes"},"wheelchairAccessible":{"value":"no"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":489000,"deposit":489000,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"4890.00","deposit":"4890.00","agencyFee":"0.00","estimatedBills":"0.00"},"minimumStayMonths":3,"moveInWindow":0,"currentOccupancy":0,"minAge":0,"maxAge":0,"preferredGender":"","available":[{"to":"9999-12-31","from":"2026-11-01"}],"updated":"2026-09-24T13:27:40Z","__utId__":"ut1740671"}]