link":"https://housinganywhere.imgix.net/unit_type/1485098/cac5f4c5-8f92-4a53-89be-0d453c8cc17b.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}},{"originalLink":"https://housinganywhere.imgix.net/unit_type/1485098/b240d569-8b97-4630-b3de-10a55c834e6d.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","categories":null,"sizes":{"1024x768":{"link":"https://housinganywhere.imgix.net/unit_type/1485098/b240d569-8b97-4630-b3de-10a55c834e6d.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/unit_type/1485098/b240d569-8b97-4630-b3de-10a55c834e6d.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1485098/b240d569-8b97-4630-b3de-10a55c834e6d.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1485098/b240d569-8b97-4630-b3de-10a55c834e6d.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1485098/b240d569-8b97-4630-b3de-10a55c834e6d.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}},{"originalLink":"https://housinganywhere.imgix.net/unit_type/1485098/8ecac28c-981f-4167-9c8b-6b5c7b9056c0.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","categories":null,"sizes":{"1024x768":{"link":"https://housinganywhere.imgix.net/unit_type/1485098/8ecac28c-981f-4167-9c8b-6b5c7b9056c0.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/unit_type/1485098/8ecac28c-981f-4167-9c8b-6b5c7b9056c0.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1485098/8ecac28c-981f-4167-9c8b-6b5c7b9056c0.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1485098/8ecac28c-981f-4167-9c8b-6b5c7b9056c0.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1485098/8ecac28c-981f-4167-9c8b-6b5c7b9056c0.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"Die Helle und frisch modernisierte Wohnung in zentraler Lage ist ruhig gelegen und hochwertig Ausgestattet, Sie ist perfekt für 2 Personen, eine dritte Person kann auf der bequemen Couch schlafen und gerne stellen wir auch ein Kinder Reisebett zur Verfügung. \n\nEs gibt direkt am Haus 2 Öffentliche Parkplätze, es gibt darüber hinaus viele Parkmöglichkeiten um das Haus. \n\nDas Schlafzimmer ist mit einem 180x200 großem Boxspringbett und hochwertiger Bettwäsche ausgestattet, ein Kleiderschrank bietet genug Platz auch für längere Aufenthalte. \n\nEs gibt einen Arbeitsplatz um mit seinem Notebook zu arbeiten sowie ein Bügelbrett und Bügeleisen. Das gemütliche Wohnzimmer lädt zum verweilen und entspannen ein, natürlich mit euren Lieblingsserien die Ihr mit eurem Account über unsere ROKU Streambar anschauen könnt oder alle klassischen TV Sender. Ein 55 Zoll HD-TV und eine schnelle W-LAN Verbindung von bis zu 250 MBit/s sorgen für ruckelfreien Genuss. \n\nIn der Küche dürft Ihr euch kulinarisch austoben, sie hat einen großen Kühlschrank mit großem Gefrierfach sowie moderne Geräte der Marke Bosch als Spülmaschine, Herd und Backofen. Besteck und Kochgeschirr von WMF runden die Ausstattung zusammen mit dem Toaster, Wasserkocher und der Nespresso Kaffeemaschine ab. Zusätzliche ist in der Küche eine gemütlicher Esstisch mit Platz für bis zu 4 Personen. \n\nIm Hellen Bad hat die Wohnung ein großes Waschbecken mit einem beleuchteten großem Spiegel und genug Ablage Platz, zusätzlich befindet sich im Bad eine Waschmaschine mit Wäscheständer. Das absolute Highlight ist die große Whirlpool Badewanne für zwei Personen mit Radio und Beleuchtung. Der große helle Flur bietet einen großen Eingangsbereich mit einer Garderobe für Jacken und Schuhe. ","facilities":{"airConditioning":{"value":"no"},"allergyFriendly":{"value":"yes"},"balconyTerrace":{"value":"no"},"basement":{"value":"no"},"bathroom":{"value":"private"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"yes"},"bedrooms":{"value":"2"},"closet":{"value":"yes"},"couplesAllowed":{"value":"yes"},"desk":{"value":"yes"},"dishwasher":{"value":"yes"},"dryer":{"value":"no"},"electricityCostIncluded":{"value":"yes"},"flooring":{"value":"laminate"},"garden":{"value":"no"},"gasCostIncluded":{"value":"yes"},"heating":{"value":"central"},"internetCostIncluded":{"value":"yes"},"kitchen":{"value":"private"},"kitchenware":{"value":"private"},"livingRoom":{"value":"private"},"parking":{"value":"no"},"pets":{"value":"no"},"playMusic":{"value":"discussable"},"registrationPossible":{"value":"yes"},"roomFurniture":{"value":"yes"},"smoking":{"value":"no"},"toilet":{"value":"private"},"totalSize":{"value":"84"},"tv":{"value":"yes"},"washingMachine":{"value":"yes"},"waterCostIncluded":{"value":"yes"},"wheelchairAccessible":{"value":"no"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":150000,"deposit":150000,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"1500.00","deposit":"1500.00","agencyFee":"0.00","estimatedBills":"0.00"},"minimumStayMonths":0,"moveInWindow":0,"currentOccupancy":0,"minAge":0,"maxAge":0,"preferredGender":"","available":[{"to":"9999-12-31","from":"2026-04-11"}],"updated":"2026-04-11T05:00:03Z","__utId__":"ut1485098"}]