alen Rückzugsort zum Wohnen und Arbeiten in absolut ruhiger Lage in Lengfeld, keine 10 Minuten von der Würzburger Innenstadt entfernt. Die Rembrandtstraße und der Hauseingang trennt ein ca. 30 qm großer Garten, der zur Vermietung dazugehört. Das Arbeitszimmer mit eingebauten Spotlichtern ist schallisoliert, was besonders für Musiker oder Sounddesigner eine ideale Arbeitsumgebung darstellt.\n\nDer Hauptraum, in dem die Küche integriert ist, umfasst ca. 35 qm. Das Arbeitszimmer ist ca. 12 qm groß.\n\nDie Studiowohnung liegt im Erdgeschoss zur Rembrandtstraße mit eigenem Hauseingang bzw. im Untergeschoss einer Hauptwohnung und ist von dieser getrennt.","facilities":{"airConditioning":{"value":"no"},"balconyTerrace":{"value":"no"},"basement":{"value":"private"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedrooms":{"value":"0"},"closet":{"value":"yes"},"couplesAllowed":{"value":"yes"},"desk":{"value":"yes"},"dishwasher":{"value":"yes"},"dryer":{"value":"yes"},"electricityCostIncluded":{"value":"yes"},"flooring":{"value":"laminate"},"garden":{"value":"private"},"gasCostIncluded":{"value":"yes"},"heating":{"value":"central"},"internetCostIncluded":{"value":"yes"},"kitchen":{"value":"private"},"kitchenware":{"value":"private"},"livingRoom":{"value":"private"},"parking":{"value":"shared"},"pets":{"value":"yes"},"playMusic":{"value":"yes"},"registrationPossible":{"value":"yes"},"roomFurniture":{"value":"yes"},"smoking":{"value":"outside_only"},"toilet":{"value":"private"},"totalSize":{"value":"52"},"tv":{"value":"no"},"washingMachine":{"value":"yes"},"waterCostIncluded":{"value":"yes"},"wheelchairAccessible":{"value":"no"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":120000,"deposit":100000,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"1200.00","deposit":"1000.00","agencyFee":"0.00","estimatedBills":"0.00"},"minimumStayMonths":0,"moveInWindow":0,"currentOccupancy":0,"minAge":0,