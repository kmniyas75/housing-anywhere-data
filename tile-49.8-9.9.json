,"height":600}}},{"originalLink":"https://housinganywhere.imgix.net/unit_type/1703497/072e20e6-9af6-42eb-b268-79f923bd5cf9.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","categories":["bedroom"],"sizes":{"1024x768":{"link":"https://housinganywhere.imgix.net/unit_type/1703497/072e20e6-9af6-42eb-b268-79f923bd5cf9.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/unit_type/1703497/072e20e6-9af6-42eb-b268-79f923bd5cf9.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1703497/072e20e6-9af6-42eb-b268-79f923bd5cf9.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1703497/072e20e6-9af6-42eb-b268-79f923bd5cf9.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1703497/072e20e6-9af6-42eb-b268-79f923bd5cf9.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}},{"originalLink":"https://housinganywhere.imgix.net/unit_type/1703497/67a5575b-5a7f-43e8-aa13-8f7c41cdf2b7.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","categories":["bedroom"],"sizes":{"1024x768":{"link":"https://housinganywhere.imgix.net/unit_type/1703497/67a5575b-5a7f-43e8-aa13-8f7c41cdf2b7.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/unit_type/1703497/67a5575b-5a7f-43e8-aa13-8f7c41cdf2b7.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1703497/67a5575b-5a7f-43e8-aa13-8f7c41cdf2b7.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1703497/67a5575b-5a7f-43e8-aa13-8f7c41cdf2b7.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1703497/67a5575b-5a7f-43e8-aa13-8f7c41cdf2b7.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"The Room\nBeautiful, bright south-facing room (19.2 m2) plus an adjoining study (5.5 m2),\nyour own apartment entrance and a private bathroom—perfect if you value privacy\nbut also want to be part of a shared living arrangement.\nThe room is fully furnished—just bring your suitcases; we’ve got the rest. In the room:\na 140 cm solid wood bed, wardrobe, pictures, rugs, lamps, sideboard, sitting area, etc...\nNo IKEA stress, no moving truck—just move in and feel at home.\nThe light-filled, fully furnished room is ideal for studying, working, or simply relaxing.\nThe room is available from 1st of August 26.\n\nThe Shared Apartment\nWe’re a group of four young ladies — students and young professionals. Things are laid-back here—everyone does their own thing, but we also cook together sometimes and have coffee on the balcony. What we’re looking for: respectful coexistence, reliability, and a laid-back atmosphere.\n\nAmenities\nKitchen – new appliances, including a coffee maker, oven, and steam cooker\nWasher & dryer – brand-new, shared in the laundry room\nBathroom & hallway (shared, approx. 34m2 extra)\nDSL/Wi-Fi throughout the apartment\nParking available with a resident parking permit\nNo pets\n\nThe location – it doesn’t get much better than this in Würzburg\nJust 150 meters to the tram station, with direct access to the city center and all its restaurants and shopping options. \n\nContact\nSounds good? Then send us a quick note telling us a little about yourself—a few sentences about who you are, your studies or job, and why you’re coming to or staying in Würzburg. We’ll get back to you soon and easily set up a viewing appointment.\nPlease include your name, email address, and phone number—it’ll make everything much easier and faster.\n\n\n","facilities":{"airConditioning":{"value":"no"},"allergyFriendly":{"value":"no"},"balconyTerrace":{"value":"private"},"basement":{"value":"no"},"bathroom":{"value":"shared_w_girls"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomSize":{"value":"25"},"bedrooms":{"value":"1"},"closet":{"value":"yes"},"couplesAllowed":{"value":"no"},"desk":{"value":"yes"},"dishwasher":{"value":"yes"},"dryer":{"value":"yes"},"electricityCostIncluded":{"value":"no"},"flooring":{"value":"laminate"},"garden":{"value":"no"},"gasCostIncluded":{"value":"no"},"gender":{"value":"female"},"heating":{"value":"gas"},"housematesGender":{"value":"shared_w_girls"},"internetCostIncluded":{"value":"no"},"kitchen":{"value":"shared"},"kitchenware":{"value":"shared"},"livingRoom":{"value":"shared"},"parking":{"value":"no"},"pets":{"value":"no"},"playMusic":{"value":"discussable"},"registrationPossible":{"value":"yes"},"roomFurniture":{"value":"yes"},"smoking":{"value":"no"},"toilet":{"value":"shared"},"totalSize":{"value":"106"},"tv":{"value":"no"},"washingMachine":{"value":"yes"},"waterCostIncluded":{"value":"no"},"wheelchairAccessible":{"value":"no"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":55000,"deposit":165000,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"550.00","deposit":"1650.00","agencyFee":"0.00","estimatedBills":"0.00"},"minimumStayMonths":6,"moveInWindow":0,"currentOccupancy":3,"minAge":18,"maxAge":30,"preferredGender":"","available":[{"to":"9999-12-31","from":"2027-03-01"}],"updated":"2026-08-09T04:44:35Z","__utId__":"ut1703497"}]