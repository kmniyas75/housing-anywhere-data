e/1733807/39d3b72a-ceaa-4fc9-af98-2da474a01aba.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}},{"originalLink":"https://housinganywhere.imgix.net/unit_type/1733807/f89071dc-733f-47f5-b8c8-aee4992a8de7.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","categories":["bathroom"],"sizes":{"1024x768":{"link":"https://housinganywhere.imgix.net/unit_type/1733807/f89071dc-733f-47f5-b8c8-aee4992a8de7.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/unit_type/1733807/f89071dc-733f-47f5-b8c8-aee4992a8de7.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1733807/f89071dc-733f-47f5-b8c8-aee4992a8de7.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1733807/f89071dc-733f-47f5-b8c8-aee4992a8de7.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1733807/f89071dc-733f-47f5-b8c8-aee4992a8de7.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}},{"originalLink":"https://housinganywhere.imgix.net/unit_type/1733807/5d4b6f73-8bab-44ae-a89b-4599d056ac13.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","categories":["bathroom"],"sizes":{"1024x768":{"link":"https://housinganywhere.imgix.net/unit_type/1733807/5d4b6f73-8bab-44ae-a89b-4599d056ac13.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/unit_type/1733807/5d4b6f73-8bab-44ae-a89b-4599d056ac13.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1733807/5d4b6f73-8bab-44ae-a89b-4599d056ac13.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1733807/5d4b6f73-8bab-44ae-a89b-4599d056ac13.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1733807/5d4b6f73-8bab-44ae-a89b-4599d056ac13.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"Everything included: one fixed price, no extra bills, no final utility settlement. Utilities, heating, electricity, water, fibre internet and an underground parking space are all covered by the monthly rent. You pay exactly what you see, with no surprise costs at the end of your stay.\n\nThis is a new 46 m2 apartment with a separate bedroom, not a studio. You get a real door between your bedroom and your living area, which makes a genuine difference over a semester or a project assignment.\n\nLocation\nThe apartment is on Otto-Hahn-Straße in Regensburg's university district. The University of Regensburg (UR) and the OTH Regensburg are just a few minutes away on foot or by bike. Despite the central location, the building sits on a quiet side street with no through traffic, so you will not hear the city at night. The motorway access (A3) is two minutes away by car, and supermarkets and public transport are within walking distance.\n\nLayout\n- Separate bedroom with door\n- Spacious living/dining room with integrated work area\n- Fully equipped kitchen\n- Bathroom with walk-in shower\n- Hallway with wardrobe\n- Balcony\n\nBedroom\n- Boxspring double bed with storage underneath\n- Large wardrobe, hangers included\n- Two bedside tables with reading lamps\n- Insect screen on the window\n- Blinds for complete darkness\n\nLiving & dining area\n- Sofa bed with adjustable backrest (extra sleeping space for visitors)\n- Coffee table, smart TV with sideboard\n- Large dining table with chairs\n- Separate electrically height-adjustable desk with monitor, a proper home-office setup\n- Direct access to the balcony\n\nBalcony\n- Table, chairs and an outdoor sofa\n- Additional table that converts into a drying rack\n- Full-height sliding insect screen door\n\nKitchen\n- Fitted kitchen with AEG appliances: induction hob, oven, microwave, fridge, freezer, dishwasher\n- High-quality Fissler induction cookware\n- Complete set of crockery, cutlery, glasses and cooking utensils\n- Kettle and coffee machine\n- Tall pull-out pantry cupboard\n\nBathroom\n- Walk-in shower with glass screen\n- Large washbasin with vanity unit\n- Illuminated mirror cabinet\n- LG washer-dryer with app control\n- Towels provided (several sets)\n\nAlso included\n- Underfloor heating in every room\n- Fibre internet, 150 Mbit/s\n- Bed linen and towels, several sets provided\n- Iron and ironing board\n- Vacuum cleaner and cleaning equipment\n- Smoke detectors\n\nParking & storage\n- Underground parking space included (duplex, lower level, suitable for larger cars)\n- Private storage unit in the basement\n- Lockable bicycle room in the building\n\nBuilding\n- Video intercom, so you can see who is at the front door\n- Lift to your floor\n- Well-maintained new building with 16 apartments\n- Energy efficiency class A, very low running costs, already covered by your rent\n\nGood to know\n- Available from 1 January 2027, with no fixed end date. A stay of just a few months is just as welcome as a longer tenancy.\n- Suitable for one or two people\n- No smoking, no pets\n- Move in with just your suitcase, everything else is already here","facilities":{"airConditioning":{"value":"no"},"allergyFriendly":{"value":"yes"},"balconyTerrace":{"value":"private"},"basement":{"value":"private"},"bathroom":{"value":"private"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"yes"},"bedrooms":{"value":"1"},"closet":{"value":"yes"},"couplesAllowed":{"value":"yes"},"desk":{"value":"yes"},"dishwasher":{"value":"yes"},"dryer":{"value":"yes"},"electricityCostIncluded":{"value":"yes"},"flooring":{"value":"plastic"},"garden":{"value":"no"},"gasCostIncluded":{"value":"yes"},"heating":{"value":"central"},"internetCostIncluded":{"value":"yes"},"kitchen":{"value":"private"},"kitchenware":{"value":"private"},"livingRoom":{"value":"private"},"parking":{"value":"private"},"pets":{"value":"no"},"playMusic":{"value":"no"},"registrationPossible":{"value":"yes"},"roomFurniture":{"value":"yes"},"smoking":{"value":"no"},"toilet":{"value":"private"},"totalSize":{"value":"46"},"tv":{"value":"yes"},"washingMachine":{"value":"yes"},"waterCostIncluded":{"value":"yes"},"wheelchairAccessible":{"value":"no"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":165000,"deposit":300000,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"1650.00","deposit":"3000.00","agencyFee":"0.00","estimatedBills":"0.00"},"minimumStayMonths":1,"moveInWindow":0,"currentOccupancy":0,"minAge":0,"maxAge":0,"preferredGender":"","available":[{"to":"9999-12-31","from":"2027-01-01"}],"updated":"2026-10-05T16:31:37Z","__utId__":"ut1733807"}]