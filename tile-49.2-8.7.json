0b2c270ef5.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1594100/2997c984-5d0c-45eb-ba26-0b0b2c270ef5.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1594100/2997c984-5d0c-45eb-ba26-0b0b2c270ef5.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"Liebe Mieter,  Gäste & Geschäftsreisende, herzlich Willkommen bei MyB♡LEISURE & dem stilvollen Premium Apartment in der Weinstadt Rauenberg - sehr nahe an SAP & Heidelberg, Mannheim im Rhein-Neckar-Kreis.\n\nDas Premium Apartment bietet ein(en)...\n\n... ebenerdigen, barrierefreien und separaten Eingang.\n... kostenfreien Parkplatz direkt an der Doppelgarage (Stellplatz RECHTS).\n... schönen Terrassenbereich mit einem Gartenanteil für Sie.\n... großen Raum indem sich eine geräumige Küche, ein Esstisch mit 4 Plätzen und das gemütliche Wohnzimmer mit Tagesdecke & flauschigen Kissen befinden.\n... Highspeed-Internet via WLAN zum Arbeiten\n... 50 Zoll Smart TV mit Netflix-Zugang und ein Sonos Soundsystem, welches für  Lieblings-Vibes in Wohlfühl-Atmosphäre sorgen.\n... modern eingerichtetes Schlafzimmer mit einem Kingsize Boxspringbett (1,80 x 2,00 m), einem großen Kleiderschrank und einem zusätzlichem Smart TV zur Unterhaltung mit Netflix & Co.\n... ein zusätzliches bequemes Schlafsofa (1,60 x 2,00 m) für einen dritten und vierten Gast. (z.B. Kinder)\n... stylisches Tageslichtbad mit einer großzügigen, ebenerdigen Dusche, WC und Waschmaschine. Lasst euch vom Spiel mit der Beleuchtung überraschen ;-)\n... vollausgestattete Küche mit Kühlschrank inkl. Gefrierfach, Spüle, Microwelle, Herd und Backofen.\n...elektrischen Kamin der neben der Fussbodenheizung für weitere, behagliche Wärme, Beleuchtung und unvergessliche Momente sorgt.\n...exklusiven Gäste-Service an. Sehr gerne sind wir für Fragen, kleine und große Wünsche für Sie da.\n... Fußläufig zu Supermärkten, Drogerie, Bushaltestelle & Geschäften\n... Nahe SAP, MLP, 1899 Hoffenheim Stadion & Badewelt Sinsheim\n... Top Autobahnanbindung (A6) z.B. nach Frankfurt Flughafen\n\nDas stylische und gemütliche Premium Apartment von MyB♡Leisure steht für das möblierte Wohnen auf Zeit zur Verfügung und befindet sich in einem freistehenden Einfamilienhaus im modernen Bauhausstil mit Flachdach. Es wurde im großen Stil neu eingerichtet und Dich erwartet ein frisches & modernes Design sowie viele smarte Annehmlichkeiten in einem ruhigen Wohngebiet.\n\nThis is MyB♡leisure ...\n... when business meets leisure & lifestyle.","facilities":{"airConditioning":{"value":"no"},"allergyFriendly":{"value":"no"},"balconyTerrace":{"value":"private"},"basement":{"value":"no"},"bathroom":{"value":"private"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"yes"},"bedrooms":{"value":"1"},"closet":{"value":"yes"},"couplesAllowed":{"value":"yes"},"desk":{"value":"yes"},"dishwasher":{"value":"yes"},"dryer":{"value":"yes"},"electricityCostIncluded":{"value":"yes"},"flooring":{"value":"laminate"},"garden":{"value":"private"},"gasCostIncluded":{"value":"yes"},"heating":{"value":"electrical"},"internetCostIncluded":{"value":"yes"},"kitchen":{"value":"private"},"kitchenware":{"value":"private"},"livingRoom":{"value":"private"},"parking":{"value":"shared"},"pets":{"value":"no"},"playMusic":{"value":"discussable"},"registrationPossible":{"value":"yes"},"roomFurniture":{"value":"yes"},"smoking":{"value":"outside_only"},"toilet":{"value":"private"},"totalSize":{"value":"52"},"tv":{"value":"yes"},"washingMachine":{"value":"yes"},"waterCostIncluded":{"value":"yes"},"wheelchairAccessible":{"value":"no"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":160000,"deposit":120000,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"1600.00","deposit":"1200.00","agencyFee":"0.00","estimatedBills":"0.00"},"minimumStayMonths":1,"moveInWindow":0,"currentOccupancy":0,"minAge":0,"maxAge":0,"preferredGender":"","available":[{"to":"9999-12-31","from":"2026-07-13"}],"updated":"2026-07-13T11:50:05Z","__utId__":"ut1594100"}]