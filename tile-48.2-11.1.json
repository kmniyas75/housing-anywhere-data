0024/d22e2d10-04ab-4ac8-a02c-541187fd6cb1.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/room/1850024/d22e2d10-04ab-4ac8-a02c-541187fd6cb1.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/room/1850024/d22e2d10-04ab-4ac8-a02c-541187fd6cb1.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/room/1850024/d22e2d10-04ab-4ac8-a02c-541187fd6cb1.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/room/1850024/d22e2d10-04ab-4ac8-a02c-541187fd6cb1.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}},{"originalLink":"https://housinganywhere.imgix.net/room/1850024/5f08cbfa-2ad9-44e2-a62b-01c58b0c6916.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","categories":null,"sizes":{"1024x768":{"link":"https://housinganywhere.imgix.net/room/1850024/5f08cbfa-2ad9-44e2-a62b-01c58b0c6916.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/room/1850024/5f08cbfa-2ad9-44e2-a62b-01c58b0c6916.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/room/1850024/5f08cbfa-2ad9-44e2-a62b-01c58b0c6916.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/room/1850024/5f08cbfa-2ad9-44e2-a62b-01c58b0c6916.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/room/1850024/5f08cbfa-2ad9-44e2-a62b-01c58b0c6916.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"The apartment on the first floor of the Weberhof has a total of 79 square meters of living space. This apartment is suitable for up to 5 people. The almost 80 square meters of the apartment on the 1st floor are divided into:\n\n- Two bedrooms with double beds, each of which can also be used as a two-bed room\nBathroom with shower and tub.\n- Living room with kitchen, dining area and living area with sofa bed\ncorridor between the rooms.\n- In our holiday apartments / business apartments you have similar comfort as in a hotel and at the same time are more flexible than in a rented apartment.\n\nAll rooms are invitingly friendly, flooded with light and bright. Of course, blinds are also available. You can enjoy the view of the Bavarian foothills of the Alps from a large number of windows, because Poigern is a small town surrounded by nature. The shower with a view is particularly daring - nobody can see you, but you can enjoy the vastness of nature while showering.\n\n- Flat screen TVs in every bedroom and also in the living room\n- Fully equipped kitchen, including dishwasher and built-in fridge\n- A washing machine and a tumble dryer are available in each apartment\n- Desk or work table so that you can work from home\n- The bathroom is equipped with a wellness shower (raindrop shower) and a corner bath\n- A safe is available\n\nAn extension of the rental period is also possible after an internal check.\n\nPlease be aware that HousingAnywhere is an online booking platform. Therefore exchanging contact details and offering viewings is not possible. If you would like to reserve this accommodation, send me a booking request or a message and please mention your age and occupation. I look forward to meeting you!","facilities":{"airConditioning":{"value":"no"},"allergyFriendly":{"value":"no"},"balconyTerrace":{"value":"no"},"basement":{"value":"no"},"bathroom":{"value":"private"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},