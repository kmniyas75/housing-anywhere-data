udents and professionals seeking a calm living environment\n\t•\tBalanced mix of privacy and shared living\n\n⸻\n\nAdditional Notes\n\t•\tShared apartment (2 flatmates, mixed gender possible)\n\t•\tRespectful and quiet co-living expected\n\t•\tCleaning is organized as a shared responsibility among residents to maintain a clean and comfortable living space","facilities":{"bathroom":{"value":"shared_w_both"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"yes"},"bedroomSize":{"value":"12"},"bedrooms":{"value":"1"},"closet":{"value":"yes"},"couplesAllowed":{"value":"no"},"desk":{"value":"yes"},"dishwasher":{"value":"yes"},"electricityCostIncluded":{"value":"yes"},"flooring":{"value":"laminate"},"gasCostIncluded":{"value":"yes"},"heating":{"value":"gas"},"housematesGender":{"value":"shared_w_both"},"internetCostIncluded":{"value":"yes"},"kitchen":{"value":"shared"},"kitchenware":{"value":"shared"},"livingRoom":{"value":"shared"},"pets":{"value":"no"},"playMusic":{"value":"discussable"},"registrationPossible":{"value":"yes"},"roomFurniture":{"value":"yes"},"smoking":{"value":"outside_only"},"toilet":{"value":"shared"},"totalSize":{"value":"150"},"tv":{"value":"yes"},"washingMachine":{"value":"yes"},"waterCostIncluded":{"value":"yes"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":75000,"deposit":150000,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"750.00","deposit":"1500.00","agencyFee":"0.00","estimatedBills":"0.00"},"minimumStayMonths":6,"moveInWindow":30,"currentOccupancy":8,"minAge":18,"maxAge":35,"preferredGender":"","available":[{"to":"9999-12-31","from":"2026-11-01"}],"updated":"2026-08-04T19:46:25Z","__utId__":"ut1696670"},{"id":"1688630","rank":24,"rating":0,"published":"2026-02-10","kind":1,"kindLabel":"entire place","type":3,"typeLabel":"apartment","rentType":"monthly","title":"Münchner Straße, Starnberg","cancellationPolicy":"strict","marketType