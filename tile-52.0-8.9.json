nd Garage = Anmietung möglich (persönliche Absprache) \n\n\nENGLISH:\n\nMove Right In – Fully Furnished 3-Room Apartment\nIdeal for a couple, a small family, or a single parent with child.\n\nThis bright, ready-to-live-in apartment offers comfort, flexibility, and a well-thought-out layout – all you need to bring is your suitcase.\nCentrally located, fully equipped, and instantly welcoming.\n🧠 Flexible Extra Room\nWhether you need a home office, shared flat bedroom, gaming setup, or guest room – this space adapts to your lifestyle.\n\n🍳 Fully Equipped Kitchen\nCooking made easy: stove, oven, fridge, dishwasher, plenty of storage and counter space included.\n\n🌞 Bright & Peaceful\nLarge windows let in plenty of daylight and create a calm living atmosphere – quiet living right in the heart of the city.\n\n🚶‍♀️ Prime Location:\n– City center within walking distance\n– Public transport, supermarkets & university nearby\n– Optional parking space directly at the building\n\nyou can rent garage or place for your car separately","facilities":{"airConditioning":{"value":"no"},"allergyFriendly":{"value":"no"},"balconyTerrace":{"value":"shared"},"basement":{"value":"shared"},"bathroom":{"value":"private"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"yes"},"bedrooms":{"value":"2"},"closet":{"value":"yes"},"couplesAllowed":{"value":"yes"},"desk":{"value":"yes"},"dishwasher":{"value":"yes"},"dryer":{"value":"no"},"electricityCostIncluded":{"value":"no"},"flooring":{"value":"laminate"},"garden":{"value":"no"},"gasCostIncluded":{"value":"no"},"gender":{"value":"female"},"heating":{"value":"gas"},"internetCostIncluded":{"value":"no"},"kitchen":{"value":"private"},"kitchenware":{"value":"private"},"livingRoom":{"value":"private"},"parking":{"value":"private"},"pets":{"value":"discussable"},"playMusic":{"value":"discussable"},"registrationPossible":{"value":"yes"},"roomFurniture":{"value":"yes"},"smoking":{"value":"outside_only"},"toilet":{"value":"