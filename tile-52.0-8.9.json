beiten.\n\n🛏 **Ruhiges Schlafzimmer mit Doppelbett**\nauf der 2. Ebene - Das Schlafzimmer ist als behaglicher Rückzugsort eingerichtet und eignet sich ideal für Paare oder Personen, die einen separaten, ruhigen Schlafbereich schätzen.\n\n🍳 **Voll ausgestattete Küche**\nDie Küche verfügt über Herd, Backofen, Kühlschrank.\n\n🌞 **Hell & freundlich**\nGroße Fenster sorgen für viel Tageslicht und eine angenehme Wohnatmosphäre.\n\n**Einziehen, ankommen, wohlfühlen.**\nDiese Wohnung passt sich flexibel verschiedenen Lebenssituationen an – ob Paar, kleine Familie, Alleinerziehende/r oder WG.\n\n🚗 **Stellplatz oder Garage**\nEin Stellplatz oder eine Garage kann nach Absprache separat angemietet werden.","facilities":{"airConditioning":{"value":"yes"},"allergyFriendly":{"value":"no"},"balconyTerrace":{"value":"shared"},"basement":{"value":"private"},"bathroom":{"value":"private"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"no"},"bedrooms":{"value":"1"},"closet":{"value":"yes"},"couplesAllowed":{"value":"yes"},"desk":{"value":"yes"},"dishwasher":{"value":"yes"},"dryer":{"value":"no"},"electricityCostIncluded":{"value":"no"},"flooring":{"value":"laminate"},"garden":{"value":"no"},"gasCostIncluded":{"value":"no"},"gender":{"value":"female"},"heating":{"value":"gas"},"internetCostIncluded":{"value":"yes"},"kitchen":{"value":"private"},"kitchenware":{"value":"private"},"livingRoom":{"value":"private"},"parking":{"value":"private"},"pets":{"value":"no"},"playMusic":{"value":"discussable"},"registrationPossible":{"value":"yes"},"roomFurniture":{"value":"yes"},"smoking":{"value":"no"},"toilet":{"value":"private"},"totalSize":{"value":"45"},"tv":{"value":"yes"},"washingMachine":{"value":"no"},"waterCostIncluded":{"value":"yes"},"wheelchairAccessible":{"value":"no"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":64900,"deposit":150000,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"month