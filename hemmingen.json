5a-eeea2ccbaba8.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1583157/cc74a2fd-2bc6-41ee-815a-eeea2ccbaba8.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1583157/cc74a2fd-2bc6-41ee-815a-eeea2ccbaba8.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"Are you looking for a cozy and quiet place to stay in Hemmingen, just minutes from Hannover?\n\nI’m renting out a beautiful, furnished, and bright 15m2 room in my house in Hemmingen for €320 per month (including utilities). The room is available immediately. Shared spaces include the bathroom, kitchen, living room, and a lovely garden with a view of greenery.\nThe house is located in a peaceful yet central area. The Hemmingen S-Bahn station (Line 13) is only about 200 meters away, and it’s just a 17-minute ride to Kröpcke in the heart of Hannover.\n\nAbout me:\nI’m Susanne, 62 years old, and work as a school social worker. I love singing in a choir, spending time outdoors, being with my grandchildren, and meeting friends regularly.\n\nAbout you:\nI’m looking for a female tenant who can communicate in English (German knowledge is not required). Ideally, you are an international student, perhaps from Asia — Japan, China, South Korea, Vietnam, or similar countries.\nI am fascinated by Asian culture and would enjoy sharing cultural experiences with you. If you’re musically inclined, even better — my home is perfect for practicing an instrument without disturbances.\n\nIf this sounds like the right place for you, feel free to reach out! Let’s chat and see if we’d be a good match.","facilities":{"allergyFriendly":{"value":"yes"},"balconyTerrace":{"value":"shared"},"basement":{"value":"no"},"bathroom":{"value":"shared_w_girls"},"bed":{"value":"yes"},"bedroomFurnished":{