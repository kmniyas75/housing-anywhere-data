type/1727311/b3a0f156-a82b-47c9-bd58-6b047082d433.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1727311/b3a0f156-a82b-47c9-bd58-6b047082d433.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"Vermietet wird eine voll ausgestattete 3-Zimmer-Wohnung im Zentrum von Jülich für den Zeitraum November 2026 bis Februar 2027.\n\nDie Wohnung befindet sich im 3. Obergeschoss / Dachgeschoss und ist komplett möbliert. Sie verfügt über eine offene Küche + Esszimmer, ein Wohnzimmer, ein Schlafzimmer, Badezimmer, Abstellkammer und Balkon.\n\nZur Ausstattung gehören eine voll ausgestattete Küche, Waschmaschine, Trockner, Internet / WLAN sowie zwei Fernseher. Im Wohnzimmer befindet sich ein 65-Zoll-TV, im Schlafzimmer ein 55-Zoll-TV.\n\nDurch die zentrale Lage sind Einkaufsmöglichkeiten, Restaurants, Cafés und öffentliche Verkehrsmittel schnell erreichbar.\n\nDie Wohnung eignet sich ideal für Berufspendler, Projektmitarbeiter, Studierende, Gastwissenschaftler oder Personen, die für einige Monate eine möblierte Unterkunft in Jülich suchen.\n\nVerfügbar von November bis Februar.\n\nBei Interesse bitte mit Namen, gewünschtem Zeitraum und Anzahl der Personen melden.\n\nBilder folgen. Besichtigung auch per Video Call möglich!","facilities":{"airConditioning":{"value":"no"},"balconyTerrace":{"value":"private"},"basement":{"value":"no"},"bathroom":{"value":"private"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedrooms":{"value":"1"},"closet":{"value":"yes"},"couplesAllowed":{"value":"yes"},"desk":{"value":"yes"},"dishwasher":{"value":"yes"},"dryer":{"value":"yes"},"electricityCostIncluded":{"value":"yes"},"garden":{"value":"no"},"gasCostIncluded":{"value":"yes"},"heating":{"value":"central"},"internetCostIncluded":{"value":"yes"},"kitchen":{"value":"private"},"kitchenware":{"value":"private"},"livingRoom":{"value":