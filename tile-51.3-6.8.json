 Kaffeemaschine, Toaster, Herd, Backofen, Mikrowelle, Wasserkocher, Kaffee, verschiedene Teesorten und natürlich eine Auswahl an Töpfen, Pfannen und wichtigen Utensilien.\n\nDas neue Badezimmer hat eine ebenerdige Dusche, Waschbecken, WC.\n\nEs steht außerdem eine eigene Waschmaschine zur Verfügung.\n\nAuf Wunsch kann ein privater Stellplatz für 40,- € monatlich angemietet werden.\n\nEntfernungen mit dem Auto:\n\nFlughafen Düsseldorf: 7 Min.\nMesse Düsseldorf: 20 Min.\nMesse Essen: 20 Min.\nKöln: 40 Min.\n\nSehr guter ÖPNV-Anschluss.","facilities":{"airConditioning":{"value":"no"},"allergyFriendly":{"value":"yes"},"balconyTerrace":{"value":"private"},"basement":{"value":"no"},"bathroom":{"value":"private"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"yes"},"bedrooms":{"value":"0"},"closet":{"value":"yes"},"couplesAllowed":{"value":"yes"},"desk":{"value":"yes"},"dishwasher":{"value":"no"},"dryer":{"value":"no"},"electricityCostIncluded":{"value":"yes"},"flooring":{"value":"plastic"},"garden":{"value":"no"},"gasCostIncluded":{"value":"no"},"heating":{"value":"central"},"internetCostIncluded":{"value":"yes"},"kitchen":{"value":"private"},"kitchenware":{"value":"private"},"livingRoom":{"value":"private"},"parking":{"value":"private"},"pets":{"value":"no"},"playMusic":{"value":"yes"},"registrationPossible":{"value":"yes"},"roomFurniture":{"value":"yes"},"smoking":{"value":"no"},"toilet":{"value":"private"},"totalSize":{"value":"43"},"tv":{"value":"no"},"washingMachine":{"value":"yes"},"waterCostIncluded":{"value":"yes"},"wheelchairAccessible":{"value":"no"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":140000,"deposit":140000,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"1400.00","deposit":"1400.00","agencyFee":"0.00","estimatedBills":"0.00"},"minimumStayMonths":0,"moveInWindow":0,"currentOccupancy":0,"minAge":0,"maxAge":0,"preferredGender":"","availabl