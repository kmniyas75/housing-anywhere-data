2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1557232/e4a90252-8df2-4060-a503-8046c2e1c48d.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1557232/e4a90252-8df2-4060-a503-8046c2e1c48d.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"We are pleased to offer you a beautiful semi-detached house for rent in Kleinmachnow. This bright and spacious home boasts 120 square meters of living space, making it perfect for families or couples who need extra room. The quiet and green surroundings of Kleinmachnow provide a high quality of life, ideal for nature lovers and families. Features: The house includes 3 spacious bedrooms, 1,5 modern bathrooms, and an additional study, perfect for a home office or hobby room. The fully equipped kitchen leaves nothing to be desired, and the cozy terrace invites you to relax and enjoy. Special Features: The property is located in a quiet and family-friendly neighbourhood and impresses with its high-quality fittings and bright, friendly rooms. A Bechstein Piano for creative artists is as well included in the furniture. Location: Kleinmachnow offers excellent infrastructure with numerous shopping facilities, schools (e.g. BBIS Berlin Brandenburg International School), and kindergartens nearby. The good connection to public transportation allows quick access to Berlin and Potsdam. Buses are within walking distance, train station (Berlin Wannsee/Berlin Mexikoplatz) can be reached by bicycle within 10 minutes and provide convenient connections to Berlin and Potsdam. Berlin city Center can be reached by car within 20 minutes.","facilities":{"airConditioning":{"value":"no"},"allergyFriendly":{"value":"yes"},"balconyTerrace":{"value":"private"},"basement":{"value":"private"},"bed":{"value":"yes"},"bedroomFu