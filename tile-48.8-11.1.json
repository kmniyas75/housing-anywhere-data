_type/1679789/07d5a3c2-9af2-45b0-ad1c-b3e2964397f9.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}},{"originalLink":"https://housinganywhere.imgix.net/unit_type/1679789/5acbdc52-35ef-4dd4-bdd5-0f57cc5e04af.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","categories":null,"sizes":{"1024x768":{"link":"https://housinganywhere.imgix.net/unit_type/1679789/5acbdc52-35ef-4dd4-bdd5-0f57cc5e04af.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/unit_type/1679789/5acbdc52-35ef-4dd4-bdd5-0f57cc5e04af.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1679789/5acbdc52-35ef-4dd4-bdd5-0f57cc5e04af.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1679789/5acbdc52-35ef-4dd4-bdd5-0f57cc5e04af.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1679789/5acbdc52-35ef-4dd4-bdd5-0f57cc5e04af.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}},{"originalLink":"https://housinganywhere.imgix.net/unit_type/1679789/3e5f3ce1-9fae-4222-8f18-b39a5d07f244.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","categories":null,"sizes":{"1024x768":{"link":"https://housinganywhere.imgix.net/unit_type/1679789/3e5f3ce1-9fae-4222-8f18-b39a5d07f244.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/unit_type/1679789/3e5f3ce1-9fae-4222-8f18-b39a5d07f244.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1679789/3e5f3ce1-9fae-4222-8f18-b39a5d07f244.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1679789/3e5f3ce1-9fae-4222-8f18-b39a5d07f244.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1679789/3e5f3ce1-9fae-4222-8f18-b39a5d07f244.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"Beautiful, furnished apartment, flooded with natural light (south-facing), in a privileged location with views of the iconic Willibaldsburg. The apartment has been recently renovated and furnished with a tasteful blend of modern and antique design, featuring quality furniture and carefully selected collectibles. It previously belonged to a well-known and respected couple from Eichstätt.\n\nThe apartment offers 105 square meters of living space, is located on the second floor, and enjoys views on both sides of the building. It includes two bedrooms, a very spacious living and dining area, a generous entrance hall, a large balcony/terrace totaling 25 square meters, a guest toilet, a bathroom with shower and bathtub, a fully equipped kitchen, an additional storage room, and two parking options (one public and one shared with the other owners).\n\nAvailable from September 2026 – this charming apartment is ideal for a university lecturer, a single professional, or a couple. It is located just 5 minutes from Eichstätt’s historic old town, directly opposite the Norma supermarket and the train station, 30 meters from Café SIPL, and within immediate proximity to shops, a gas station, and all that this beautiful town has to offer.\n\nThe apartment is fully equipped with a double bed, a single bed, wardrobes, sofa, armchairs, desks, complete kitchenware and dishes, a washing machine, towels, and bed linen. Wi-Fi is available. No television.\n\nMonthly rent: €1,900 + charges €250.\nSecurity deposit: three months’ rent, payable in advance.","facilities":{"airConditioning":{"value":"no"},"allergyFriendly":{"value":"yes"},"balconyTerrace":{"value":"private"},"basement":{"value":"no"},"bathroom":{"value":"private"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"no"},"bedrooms":{"value":"2"},"closet":{"value":"yes"},"couplesAllowed":{"value":"yes"},"desk":{"value":"yes"},"dishwasher":{"value":"yes"},"dryer":{"value":"no"},"electricityCostIncluded":{"value":"no"},"flooring":{"value":"wood"},"garden":{"value":"no"},"gasCostIncluded":{"value":"no"},"heating":{"value":"central"},"internetCostIncluded":{"value":"no"},"kitchen":{"value":"private"},"kitchenware":{"value":"private"},"livingRoom":{"value":"private"},"parking":{"value":"no"},"pets":{"value":"no"},"playMusic":{"value":"yes"},"registrationPossible":{"value":"yes"},"roomFurniture":{"value":"yes"},"smoking":{"value":"no"},"tenantStatus":{"value":"working professionals only"},"toilet":{"value":"private"},"totalSize":{"value":"125"},"tv":{"value":"no"},"washingMachine":{"value":"yes"},"waterCostIncluded":{"value":"no"},"wheelchairAccessible":{"value":"no"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":190000,"deposit":570000,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"1900.00","deposit":"5700.00","agencyFee":"0.00","estimatedBills":"0.00"},"minimumStayMonths":12,"moveInWindow":0,"currentOccupancy":0,"minAge":30,"maxAge":0,"preferredGender":"","available":[{"to":"9999-12-31","from":"2026-09-01"}],"updated":"2026-08-25T07:53:20Z","__utId__":"ut1679789"}]