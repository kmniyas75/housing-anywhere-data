1536&w=2048","categories":null,"sizes":{"1024x768":{"link":"https://housinganywhere.imgix.net/room/1713745/9c7e7e16-6b1a-4aca-b763-e5fd33b4c19a.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/room/1713745/9c7e7e16-6b1a-4aca-b763-e5fd33b4c19a.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/room/1713745/9c7e7e16-6b1a-4aca-b763-e5fd33b4c19a.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/room/1713745/9c7e7e16-6b1a-4aca-b763-e5fd33b4c19a.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/room/1713745/9c7e7e16-6b1a-4aca-b763-e5fd33b4c19a.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}},{"originalLink":"https://housinganywhere.imgix.net/room/1713745/e4a6aed4-1285-4a34-9fb4-8ce53a0549d5.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","categories":null,"sizes":{"1024x768":{"link":"https://housinganywhere.imgix.net/room/1713745/e4a6aed4-1285-4a34-9fb4-8ce53a0549d5.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/room/1713745/e4a6aed4-1285-4a34-9fb4-8ce53a0549d5.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/room/1713745/e4a6aed4-1285-4a34-9fb4-8ce53a0549d5.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/room/1713745/e4a6aed4-1285-4a34-9fb4-8ce53a0549d5.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/room/1713745/e4a6aed4-1285-4a34-9fb4-8ce53a0549d5.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"Diese schöne, gepflegte Wohnung im ersten OG kann ab sofort bezogen werden. Zu dem Apartment zählen drei hübsche Zimmer. Des Weiteren überzeugt der gute Schnitt, durch den das Objekt auch für WGs geeignet ist. Beachten Sie auch den Garten, in dem es sich wunderbar vom Alltag erholen lässt. Die vorhandene Einbauküche spart Ihnen Zeit und Geld. Durch den zur Wohnung gehörenden Stellplatz finden Sie immer einen Parkplatz. Auch ein Kellerraum ist vorhanden und bietet weiteren Stauraum.\n\nDie Immobilie befindet sich in Probstzella. In der Nähe liegen die Orte Ludwigsstadt und Gräfenthal. Wenige Gehminuten von der Immobilie entfernt gibt es eine Bäckerei, ein Restaurant und einen Supermarkt. Ein Museum und eine Apotheke sind ebenso in der Nähe gelegen. Weiter entfernt finden Sie darüber hinaus mehrere Schulen und Kindergärten. Einen Arzt und zahlreiche Erholungs- und Sportmöglichkeiten (u. a. eine Grün- und Parkanlage) gibt es schließlich ebenfalls im größeren Umkreis.\n\nDie Dreizimmerwohnung in Probstzella befindet sich in hervorragender Lage direkt am Bahnhof. Ein Supermark ist direkt gegenüber. Der Garten kann mitbenutzt werden. Ein offener Garagenstellplatz ist für 35 EUR/mtl ebenfalls vorhanden. Die Wohnung befindet sich im 1. OG.\n\nZentralheizung mit Erdgas, Durchlauferhutzer in Bad und Küche. Bad mit Badewanne und Dusche, Doppelwaschbecken und Toilette und Waschmaschinenanschluß. Küche mit Herd, Schränken und Kühlschrank. Abstellkammer im Treppenhaus und Keller sind vorhanden.\n\nDie Zimmer sind auf Wunsch  möbliert. Die Wohnung ist bei zwei Parteien auch WG-geeignet.","facilities":{"airConditioning":{"value":"no"},"allergyFriendly":{"value":"no"},"balconyTerrace":{"value":"no"},"basement":{"value":"shared"},"bathroom":{"value":"shared_w_both"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"yes"},"bedrooms":{"value":"3"},"closet":{"value":"yes"},"couplesAllowed":{"value":"yes"},"desk":{"value":"yes"},"dishwasher":{"value":"no"},"dryer":{"value":"no"},"electricityCostIncluded":{"value":"no"},"flooring":{"value":"laminate"},"garden":{"value":"shared"},"gasCostIncluded":{"value":"no"},"heating":{"value":"gas"},"internet":{"value":"yes"},"internetCostIncluded":{"value":"no"},"kitchen":{"value":"shared"},"kitchenware":{"value":"shared"},"livingRoom":{"value":"shared"},"parking":{"value":"shared"},"pets":{"value":"discussable"},"playMusic":{"value":"no"},"registrationPossible":{"value":"yes"},"roomFurniture":{"value":"no"},"smoking":{"value":"outside_only"},"toilet":{"value":"shared"},"totalSize":{"value":"70"},"tv":{"value":"yes"},"washingMachine":{"value":"yes"},"waterCostIncluded":{"value":"no"},"wheelchairAccessible":{"value":"no"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":65000,"deposit":195000,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"650.00","deposit":"1950.00","agencyFee":"0.00","estimatedBills":"0.00"},"minimumStayMonths":0,"moveInWindow":0,"currentOccupancy":0,"minAge":0,"maxAge":0,"preferredGender":"","available":[{"to":"9999-12-31","from":"2026-06-08"}],"updated":"2026-06-08T14:32:12Z","__utId__":"ut1067000"}]