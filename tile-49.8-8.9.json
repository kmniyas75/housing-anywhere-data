=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1564452/d989903c-4822-48d7-b1ad-9860227e8439.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1564452/d989903c-4822-48d7-b1ad-9860227e8439.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1564452/d989903c-4822-48d7-b1ad-9860227e8439.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"Die vakante Wohnung befindet sich im 2. OG und besticht mit einem wunderbaren Blick auf die Georg-August Zinn Straße und deren Geschäfte im Herzen der Weininsel Groß-Umstadt.\n\nDie Wohnung wurde komplett renoviert und verfügt mit großzügigen 115 qm über 2 Zimmer, einem großem Badezimmer mit begehbarer ebenerdiger Dusche, Badewanne, WC, Bidet und einem Doppelwaschtisch. \nDie große luxuriöse Küche mit hochwertigen Küchengeräten, einer Kochinsel und angrenzendem offen Essbereich lassen das Herz eines jeden Hobbykochs höher schlagen. Der große Wohnbereich gewährt einen sensationellen Blick auf die Innenstadt.\nDas Schlafzimmer misst ganze 30 qm und verfügt über einen riesigen begehbaren Kleiderschrank.\nInsgesamt wurden 90 dimmbare LED Spots verbaut, die die gesamte Wohnung in eine tolle Atmosphäre tauchen. In allen Decken sind Lautsprecher verbaut, welche separat angesteuert werden können und die automatisch gesteuerten Sonnenschutzrollos schützen vor der Sommersonne, ohne die Wohnung zu verdunkeln.\nZur Wohnung gehört ein eigener Hauswirtschaftsraum und auf dem riesigen ausgebauten Dachboden findet sich genug Stauraum für weitere Habseligkeiten und Hobbys.\n","facilities":{"airConditioning":{"value":"no"},"allergyFriendly":{"value":"yes"},"balconyTerrace":{"value":"no"},"basement":{"value":"shared"},"bathroom":{"value":"private"},"bed":{"value":"no"},"bedroomFurnished":{"value":"no"},"bedroomLock":{"value":"no"},"bedrooms":{"value":"1"},"closet":{"value":"yes"},"couplesAllowed":{"value":"yes"},"desk":{"value":"no"},"dishwasher":{"value":"yes"},"dryer":{"value":"no"},"electricityCostIncluded":{"value":"yes"},"flooring":{"value":"stone"},"garden":{"value":"no"},"gasCostIncluded":{"value":"yes"},"heating":{"value":"gas"},"internetCostIncluded":{"value":"no"},"kitchen":{"value":"private"},"kitchenware":{"value":"no"},"livingRoom":{"value":"private"},"parking":{"value":"no"},"pets":{"value":"yes"},"playMusic":{"value":"yes"},"registrationPossible":{"value":"yes"},"roomFurniture":{"value":"no"},"smoking":{"value":"outside_only"},"toilet":{"value":"private"},"totalSize":{"value":"115"},"tv":{"value":"no"},"washingMachine":{"value":"no"},"waterCostIncluded":{"value":"yes"},"wheelchairAccessible":{"value":"no"},"wifi":{"value":"no"}},"costs":{"currency":"EUR","pricing":"monthly","price":160000,"deposit":270000,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"1600.00","deposit":"2700.00","agencyFee":"0.00","estimatedBills":"0.00"},"minimumStayMonths":0,"moveInWindow":0,"currentOccupancy":0,"minAge":0,"maxAge":0,"preferredGender":"","available":[{"to":"9999-12-31","from":"2026-08-20"}],"updated":"2026-08-20T04:41:54Z","__utId__":"ut1564452"}]