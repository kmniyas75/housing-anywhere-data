iginalLink":"https://housinganywhere.imgix.net/unit_type/1614377/a25db733-16de-441c-9c9a-4af57771f28a.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","categories":null,"sizes":{"1024x768":{"link":"https://housinganywhere.imgix.net/unit_type/1614377/a25db733-16de-441c-9c9a-4af57771f28a.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/unit_type/1614377/a25db733-16de-441c-9c9a-4af57771f28a.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1614377/a25db733-16de-441c-9c9a-4af57771f28a.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1614377/a25db733-16de-441c-9c9a-4af57771f28a.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1614377/a25db733-16de-441c-9c9a-4af57771f28a.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}},{"originalLink":"https://housinganywhere.imgix.net/unit_type/1614377/4bdbaa02-f607-4843-9e00-6ccfd1550f25.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","categories":null,"sizes":{"1024x768":{"link":"https://housinganywhere.imgix.net/unit_type/1614377/4bdbaa02-f607-4843-9e00-6ccfd1550f25.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/unit_type/1614377/4bdbaa02-f607-4843-9e00-6ccfd1550f25.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1614377/4bdbaa02-f607-4843-9e00-6ccfd1550f25.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1614377/4bdbaa02-f607-4843-9e00-6ccfd1550f25.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1614377/4bdbaa02-f607-4843-9e00-6ccfd1550f25.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}},{"originalLink":"https://housinganywhere.imgix.net/unit_type/1614377/0a0ab44d-ef9f-4c34-8dc5-555db62366c0.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","categories":["bedroom"],"sizes":{"1024x768":{"link":"https://housinganywhere.imgix.net/unit_type/1614377/0a0ab44d-ef9f-4c34-8dc5-555db62366c0.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/unit_type/1614377/0a0ab44d-ef9f-4c34-8dc5-555db62366c0.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1614377/0a0ab44d-ef9f-4c34-8dc5-555db62366c0.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1614377/0a0ab44d-ef9f-4c34-8dc5-555db62366c0.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1614377/0a0ab44d-ef9f-4c34-8dc5-555db62366c0.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"Relax in this modern and newly renovated apartment. In addition to mountain views & idyllic tranquility, enjoy other highlights:\n\n→ Balcony with gas grill + dining area for 4\n→ Fully equipped kitchen\n→ Spacious living room + dining area for 4\n→ Sofa bed with topper (160x200cm)\n→ PS5 with 4 controllers + games\n→ Zattoo HD TV on 55-inch TV + sound box\n→ Washing machine\n→ Bike storage\n\nHere you're far away from the hustle & bustle, yet close to the center. Perfectly located for hikers and bikers!\n\nThe heart of the apartment is the spacious living, dining, and lounge area with an open-plan kitchen and direct access to the sunny balcony:\n→ Comfortable dining area for 4 people indoors and outdoors\n→ 55-inch Smart TV + streaming\n→ Soundbar\n→ PS5 with 2 controllers + game selection\n→ Comfortable sofa bed + high-quality mattress topper (160x200cm)\n→ Large gas grill + accessories\n\nFully equipped kitchen:\n→ Refrigerator-freezer combination\n→ Oven, microwave, kettle, toaster, etc.\n→ Dishwasher\n→ Nespresso and filter coffee machine + small coffee gift\n→ Basic supplies of salt, pepper, oil, baking paper, etc.\n\nBedroom:\n→ Comfortable 160cm double bed\n→ Open wardrobe\n→ Folding baby bed with extra Hauk mattress\n→ Bed linen included\n\nBathroom:\n→ Newly renovated bathroom with a large, modern rain shower\n→ Washing machine\n→ Hairdryer, towels, shower gel, shampoo, and Conditioner\n\nBad Berleburg invites you to hike, bike, ski, or simply explore the beautiful surroundings and nature. A highlight is Sayn-Wittgenstein Castle, which offers regular guided tours or a museum tour. You are surrounded by numerous parks, as well as inviting restaurants and cafés. The Rothaarbad spa with its wellness area is just a few minutes from the accommodation. The Wisent Hut is particularly recommended as a starting point for exploring the bison wilderness, as is a trip to the numerous hiking trails of the Rothaarsteig. Winterberg can be reached in just 20 minutes. A bus stop is just a 2-minute walk away, with direct connections to the city center as well as to Bad Laasphe, Siegen and Winterberg.\n\nA two-minute walk from the accommodation, there are several daily bus connections to the center of Bad Berleburg, as well as to Siegen and Bad Laasphe. The train station is a five-minute drive or about a 20-minute walk away. From there, there are regular direct buses to Winterberg. The Kurhessenbahn takes you to Marburg via Bad Laasphe and Biedenkopf in just two hours.","facilities":{"airConditioning":{"value":"no"},"allergyFriendly":{"value":"yes"},"balconyTerrace":{"value":"private"},"basement":{"value":"no"},"bathroom":{"value":"private"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"yes"},"bedrooms":{"value":"2"},"closet":{"value":"yes"},"couplesAllowed":{"value":"yes"},"desk":{"value":"yes"},"dishwasher":{"value":"yes"},"dryer":{"value":"no"},"electricityCostIncluded":{"value":"yes"},"garden":{"value":"no"},"gasCostIncluded":{"value":"yes"},"heating":{"value":"central"},"internetCostIncluded":{"value":"yes"},"kitchen":{"value":"private"},"kitchenware":{"value":"private"},"livingRoom":{"value":"private"},"parking":{"value":"private"},"pets":{"value":"no"},"registrationPossible":{"value":"no"},"roomFurniture":{"value":"yes"},"smoking":{"value":"outside_only"},"toilet":{"value":"private"},"totalSize":{"value":"45"},"tv":{"value":"yes"},"washingMachine":{"value":"yes"},"waterCostIncluded":{"value":"yes"},"wheelchairAccessible":{"value":"no"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":200000,"deposit":100000,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"2000.00","deposit":"1000.00","agencyFee":"0.00","estimatedBills":"0.00"},"minimumStayMonths":1,"moveInWindow":0,"currentOccupancy":0,"minAge":18,"maxAge":0,"preferredGender":"","available":[{"to":"2026-12-29","from":"2026-11-08"},{"to":"9999-12-31","from":"2027-01-02"}],"updated":"2026-10-30T01:58:26Z","__utId__":"ut1614377"}]