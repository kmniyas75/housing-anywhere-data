/b3cd3f99-cde9-4da8-96aa-6285c3debb72.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}},{"originalLink":"https://housinganywhere.imgix.net/unit_type/1664531/24bae006-d9d2-4feb-935b-bbd7262abec1.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","categories":null,"sizes":{"1024x768":{"link":"https://housinganywhere.imgix.net/unit_type/1664531/24bae006-d9d2-4feb-935b-bbd7262abec1.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/unit_type/1664531/24bae006-d9d2-4feb-935b-bbd7262abec1.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1664531/24bae006-d9d2-4feb-935b-bbd7262abec1.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1664531/24bae006-d9d2-4feb-935b-bbd7262abec1.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1664531/24bae006-d9d2-4feb-935b-bbd7262abec1.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}},{"originalLink":"https://housinganywhere.imgix.net/unit_type/1664531/27862e83-7373-4f7a-ac9f-14b118e98eb0.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","categories":null,"sizes":{"1024x768":{"link":"https://housinganywhere.imgix.net/unit_type/1664531/27862e83-7373-4f7a-ac9f-14b118e98eb0.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/unit_type/1664531/27862e83-7373-4f7a-ac9f-14b118e98eb0.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1664531/27862e83-7373-4f7a-ac9f-14b118e98eb0.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1664531/27862e83-7373-4f7a-ac9f-14b118e98eb0.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1664531/27862e83-7373-4f7a-ac9f-14b118e98eb0.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"Willkommen in der gemütlichen Wohnung im Herzen des trendigen Herzogenrath! \nDiese wunderschöne Wohnung bietet alles, was für den täglichen Bedarf benötigt wird (Waschmaschine, Backofen, Geschirrspüler, Esstisch, etc...). Eine perfekte Mischung aus Komfort und Bequemlichkeit. \nEs verfügt über ein großes Wohnzimmer mit viel natürlichem Licht, ein perfekter Ort zum Entspannen.\nEin Stellplatz gehört zur Wohnung und ist im Preis  inklusiv.\n\nDie Unterkunft\nDie Wohnung befindet sich im Erdgeschoss und bietet einen ruhigen Rückzugsort mit viel natürlichem Licht.\n\nWohnzimmer\nDer ideale Ort zum Entspannen und Erholen. Mit großen Fenstern ist es ein sehr gemütlicher Ort zum Chillen.\n\nSchlafzimmer\nDas Schlafzimmer ist deine ruhige Oase, komplett eingerichtet mit einem Queensize-Bett, Nachttischen und einem großen Schrank, um deine Sachen aufzubewahren. Ein Ganzkörperspiegel, Verdunkelungsvorhänge sowie einen Sessel bieten einen ruhigen Raum zum entspannen oder Kraft tanken.\n\nKüche\nDie Küche ist voll ausgestattet, von modernen Geräten bis hin zu Kochgeschirr und Utensilien. Spülmaschine, Herd, Kaffeemaschine, etc...\n\nBadezimmer und WC\nAlles ist bereits vorhanden: Handtücher, Waschmaschine, Trockner, etc...\n\nIm Wohn-, und Schlaf ist heller Parkettboden verlegt. Die Küche und das Badezimmer und Flur sind hell gefliest.\nDie doppelverglasten Holzfenster sind mit Rollläden ausgestattet.\nDie Wohnung ist mit einer EBK ausgestattet. Die Küche ist vollausgestattet: Kühlschrank, Spülmaschine, Dunstabzugshaube, Geschirrspüler, Kaffeemaschine, Toaster, Mikrowelle, Wasserkocher, etc.....\nSchnelles Internet ist vorhanden und im Preis inklusiv..\n\nDie Reinigung des Treppenhauses, die Pflege der Gartenanlagen\n(Möglichkeit zur Mitbenutzung der umlaufenden Rasenfläche\nbesteht), sowie die Nutzung des Außenstellplatzes sind in den\nMietkosten bereits enthalten.\n\nLAGE:\nDie Wohnung befindet sich im Erdgeschoss eines\nMehrfamilienhauses in einer sehr ruhigen Seitenstraße eines an das\nNaturschutzgebiet Wurmtal (direkter Zugang über Fußweg in ca.\n200m Entfernung!) grenzenden, neueren Wohngebietes in\nHerzogenrath-Straß. \nDas direkte Umfeld besteht vornehmlich aus Einfamilienhäusern bzw. kleineren Mehrfamilienhäusern.\nIn unmittelbarer Nähe befinden sich verschiedene Geschäfte des\ntäglichen Bedarfs inkl. verschiedener Supermärkte, Ärzte, Apotheke,\nSchulen sowie Kindergärten.\nIn das Stadtzentrum Herzogenrath und das Zentrum Kohlscheid\ngelangen Sie mit dem Auto in ca. 5 Minuten; Aachen liegt 15-20\nMinuten Autofahrt entfernt. Es besteht außerdem eine gute\nAnbindung an das Autobahnnetz nach Köln und Düsseldorf (A4 und\nA44 in ca. 10 Minuten zu erreichen), sowie an die benachbarten\nNiederlande und Belgien. Busverbindungen in die Stadt Aachen und\ndie umliegenden Orte befinden sich in kurzer fußläufiger Entfernung;\ndie Anbindung an das Verkehrsnetz der Deutschen Bahn und der\nEuregiobahn erfolgt entweder über den Bahnhof Kohlscheid oder\nHerzogenrath (beide ca. 5 Autominuten entfernt).","facilities":{"airConditioning":{"value":"no"},"allergyFriendly":{"value":"yes"},"balconyTerrace":{"value":"private"},"basement":{"value":"private"},"bathroom":{"value":"private"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"yes"},"bedrooms":{"value":"1"},"closet":{"value":"yes"},"couplesAllowed":{"value":"yes"},"desk":{"value":"yes"},"dishwasher":{"value":"yes"},"dryer":{"value":"yes"},"electricityCostIncluded":{"value":"yes"},"flooring":{"value":"wood"},"garden":{"value":"shared"},"gasCostIncluded":{"value":"yes"},"heating":{"value":"electrical"},"internetCostIncluded":{"value":"yes"},"kitchen":{"value":"private"},"kitchenware":{"value":"private"},"livingRoom":{"value":"private"},"parking":{"value":"private"},"pets":{"value":"discussable"},"playMusic":{"value":"discussable"},"registrationPossible":{"value":"yes"},"roomFurniture":{"value":"yes"},"smoking":{"value":"outside_only"},"toilet":{"value":"private"},"totalSize":{"value":"61"},"tv":{"value":"yes"},"washingMachine":{"value":"yes"},"waterCostIncluded":{"value":"yes"},"wheelchairAccessible":{"value":"no"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":194100,"deposit":194100,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"1941.00","deposit":"1941.00","agencyFee":"0.00","estimatedBills":"0.00"},"minimumStayMonths":1,"moveInWindow":0,"currentOccupancy":0,"minAge":0,"maxAge":0,"preferredGender":"","available":[{"to":"9999-12-31","from":"2026-04-24"}],"updated":"2026-04-24T11:31:29Z","__utId__":"ut1664531"}]