":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1702973/88f2166f-6d32-426d-95e2-6457a2436b73.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1702973/88f2166f-6d32-426d-95e2-6457a2436b73.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}},{"originalLink":"https://housinganywhere.imgix.net/unit_type/1702973/bf067ee7-48c9-491e-8e0b-ce70da730413.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","categories":["bathroom"],"sizes":{"1024x768":{"link":"https://housinganywhere.imgix.net/unit_type/1702973/bf067ee7-48c9-491e-8e0b-ce70da730413.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/unit_type/1702973/bf067ee7-48c9-491e-8e0b-ce70da730413.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1702973/bf067ee7-48c9-491e-8e0b-ce70da730413.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1702973/bf067ee7-48c9-491e-8e0b-ce70da730413.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1702973/bf067ee7-48c9-491e-8e0b-ce70da730413.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}},{"originalLink":"https://housinganywhere.imgix.net/unit_type/1702973/13276982-9706-40cb-8885-c3512ee628df.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","categories":["bathroom"],"sizes":{"1024x768":{"link":"https://housinganywhere.imgix.net/unit_type/1702973/13276982-9706-40cb-8885-c3512ee628df.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/unit_type/1702973/13276982-9706-40cb-8885-c3512ee628df.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1702973/13276982-9706-40cb-8885-c3512ee628df.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1702973/13276982-9706-40cb-8885-c3512ee628df.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1702973/13276982-9706-40cb-8885-c3512ee628df.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"Das Haus wird ausschließlich an Studierende und Azubis vermietet – ideal für ein entspanntes WG-Leben unter Gleichgesinnten.\n\nWOHNUNG UND MÖBLIERUNG\nEin Grundriss der Wohnung ist als Foto hinterlegt. Die Zimmer sind zwischen ca. 12 m2 und 20 m2 groß, wurden frisch gestrichen und haben teilweise direkten Balkonzugang. Sie wurden mit neuen IKEA-Möbeln ausgestattet, darunter Bett, Kleiderschrank, Schreibtisch und Stuhl, sodass ein unkomplizierter Einzug möglich ist. Außerdem ist die Wohnung mit einer modernen Einbauküche ausgestattet.\n\nDas Gebäude ist ein Gründerzeit-Altbau (Baujahr 1910) mit hohen Decken und großen Fenstern. Kein Neubau, sondern ein Haus mit typischem Altbaucharakter. Die Badezimmer sind funktional gestaltet. WC und Dusche befinden sich in getrennten Räumen, was den WG-Alltag erleichtert.\n\nPAUSCHALMIETE\nDie WG-Zimmer werden mit anteiliger Nutzung der Allgemeinbereiche zu Pauschalmieten vermietet. Die Pauschalmiete enthält alle Betriebskosten, Heizung, Warmwasser und Strom. WLAN Zugang wird ohne Zusatzkosten bereitgestellt.\n\nPauschalmiete bedeutet: Es erfolgt keine jährliche Nebenkostenabrechnung – du erhältst keine Rückerstattung, musst aber auch keine Nachzahlungen leisten.\n\nEine Courtage fällt nicht an.\n\nDie Kaution muss vor der Schlüsselübergabe gezahlt werden.\n\nDein neues Zuhause erwartet dich.\n\nTOP-LAGE FÜR STUDIERENDE\nDas Haus liegt zwischen der Osnabrücker Innenstadt und dem Westerberg-Campus. Beide Ziele sind fußläufig erreichbar und weitere Hochschulstandorte sind ebenfalls in der Nähe.\n\nEinkaufsmöglichkeiten befinden sich ca. 150 m schräg über die Straße (Combi mit Bäcker).\n\nHier geht es zum Video des Rundgangs in der Wohnung:\n\n(hidden)\n\n\nIn 5 Minuten fußläufig erreichbar befindet sich eine sehr gut angebundene Bushaltestelle.","facilities":{"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"yes"},"bedroomSize":{"value":"12"},"bedrooms":{"value":"1"},"closet":{"value":"yes"},"couplesAllowed":{"value":"yes"},"desk":{"value":"yes"},"dishwasher":{"value":"no"},"electricityCostIncluded":{"value":"yes"},"garden":{"value":"no"},"gasCostIncluded":{"value":"yes"},"internetCostIncluded":{"value":"yes"},"kitchen":{"value":"shared"},"livingRoom":{"value":"no"},"parking":{"value":"no"},"pets":{"value":"no"},"playMusic":{"value":"discussable"},"registrationPossible":{"value":"yes"},"smoking":{"value":"outside_only"},"tenantStatus":{"value":"students only"},"toilet":{"value":"shared"},"totalSize":{"value":"91"},"waterCostIncluded":{"value":"yes"},"wheelchairAccessible":{"value":"no"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":46900,"deposit":92700,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"469.00","deposit":"927.00","agencyFee":"0.00","estimatedBills":"0.00"},"minimumStayMonths":3,"moveInWindow":0,"currentOccupancy":3,"minAge":18,"maxAge":0,"preferredGender":"","available":[{"to":"9999-12-31","from":"2026-06-08"}],"updated":"2026-06-08T15:09:29Z","__utId__":"ut1702973"}]