in the area \nShopping nearby: Bio Company & Aldi (1 min), Edeka & Rossmann (6 min), Alnatura (12 min)  \n\nTransport \nApprox. 40 minutes to Alexanderplatz  \n\nConditions \nPreferred term: around 6 months, flexible and extendable \nRent: €1,234 per month (all-inclusive) \nDeposit: €1,500 \nAnmeldung: possible\nHouse rules: No smoking, no pets, no parties  \n\nIf this apartment speaks to you, and you can imagine yourself living, creating, or practicing here with care, please get in touch and tell us a little about yourself.\n","facilities":{"airConditioning":{"value":"no"},"allergyFriendly":{"value":"yes"},"bathroom":{"value":"private"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"yes"},"bedrooms":{"value":"1"},"closet":{"value":"yes"},"couplesAllowed":{"value":"yes"},"desk":{"value":"yes"},"dishwasher":{"value":"yes"},"dryer":{"value":"no"},"electricityCostIncluded":{"value":"yes"},"flooring":{"value":"wood"},"gasCostIncluded":{"value":"yes"},"internetCostIncluded":{"value":"yes"},"kitchen":{"value":"private"},"kitchenware":{"value":"private"},"livingRoom":{"value":"private"},"pets":{"value":"no"},"playMusic":{"value":"yes"},"registrationPossible":{"value":"yes"},"roomFurniture":{"value":"yes"},"smoking":{"value":"no"},"toilet":{"value":"private"},"totalSize":{"value":"55"},"tv":{"value":"no"},"washingMachine":{"value":"yes"},"waterCostIncluded":{"value":"yes"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":123400,"deposit":150000,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"1234.00","deposit":"1500.00","agencyFee":"0.00","estimatedBills":"0.00"},"minimumStayMonths":6,"moveInWindow":0,"currentOccupancy":0,"minAge":0,"maxAge":0,"preferredGender":"","available":[{"to":"9999-12-31","from":"2026-10-31"}],"updated":"2026-03-31T02:12:16Z","__utId__":"ut1694249"}]