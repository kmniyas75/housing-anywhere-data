ype/1748403/daff9761-c147-433e-9b1d-29a8ab67d132.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1748403/daff9761-c147-433e-9b1d-29a8ab67d132.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1748403/daff9761-c147-433e-9b1d-29a8ab67d132.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1748403/daff9761-c147-433e-9b1d-29a8ab67d132.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"Beautifully equipped studio with a new kitchen near Chemnitz city centre:\nEnjoy your own fully furnished apartment in Schloßchemnitz, with shopping, fitness facilities and green spaces within walking distance.\n\nThis bright, freshly renovated apartment offers approximately 30 m2 of thoughtfully arranged space. The entire apartment is exclusively yours, including a combined living and sleeping room, a separate kitchen, a bathroom and a hallway. It is ideal for one person or a couple.\n\nA kitchen that goes beyond the basics:\nThe separate, newly installed kitchen comes with an extensive selection of new appliances and everything you need for everyday cooking:\n• Hob and built-in oven\n• Fridge-freezer and dishwasher\n• Contact grill and air fryer\n• Electric kettle, toaster and food processor\n• Capsule coffee machine with milk frother\n• Crockery, cutlery, pots, pans and cooking utensils  \n\nThe extendable dining table provides space for 4–6 people when opened.\n\nComfortable living and working:\nThe living and sleeping room features a TV and an extendable bed that can be used as a single or double bed. A height-adjustable desk and office chair provide a convenient workspace. WiFi is available, with an internet connection of up to 250 Mbps.\n\nA wardrobe in the hallway provides storage. Your own washing machine, iron and vacuum cleaner make longer stays convenient.\nThe bathroom has a bathtub with an overhead rain shower, a handheld shower and an illuminated mirror.\n\nConvenient location:\nThe apartment is on Limbacher Straße in Schloßchemnitz, close to the city centre. Supermarkets, shopping facilities, places to eat and a fitness studio are within walking distance.\n\nRental information:\nAvailable from 1 February 2027. Registration at the address (Anmeldung) is possible.\n\nThe monthly rent is all-inclusive, covering electricity, heating, water and Wi-Fi.\n\nPlease include your preferred move-in date, intended rental period and number of occupants in your enquiry.","facilities":{"airConditioning":{"value":"no"},"balconyTerrace":{"value":"no"},"basement":{"value":"shared"},"bathroom":{"value":"private"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"yes"},"bedrooms":{"value":"1"},"closet":{"value":"yes"},"couplesAllowed":{"value":"yes"},"desk":{"value":"yes"},"dishwasher":{"value":"yes"},"dryer":{"value":"yes"},"electricityCostIncluded":{"value":"yes"},"flooring":{"value":"laminate"},"garden":{"value":"shared"},"gasCostIncluded":{"value":"yes"},"heating":{"value":"central"},"internetCostIncluded":{"value":"yes"},"kitchen":{"value":"private"},"kitchenware":{"value":"private"},"livingRoom":{"value":"private"},"parking":{"value":"shared"},"pets":{"value":"discussable"},"playMusic":{"value":"discussable"},"registrationPossible":{"value":"yes"},"roomFurniture":{"value":"yes"},"smoking":{"value":"no"},"toilet":{"value":"private"},"totalSize":{"value":"30"},"tv":{"value":"yes"},"washingMachine":{"value":"yes"},"waterCostIncluded":{"value":"yes"},"wheelchairAccessible":{"value":"yes"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":95000,"deposit":25000,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly