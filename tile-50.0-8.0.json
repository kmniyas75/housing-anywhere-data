ivate"},"basement":{"value":"shared"},"bathroom":{"value":"shared_w_both"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"yes"},"bedroomSize":{"value":"25"},"bedrooms":{"value":"1"},"closet":{"value":"yes"},"couplesAllowed":{"value":"no"},"desk":{"value":"yes"},"dishwasher":{"value":"yes"},"dryer":{"value":"no"},"electricityCostIncluded":{"value":"yes"},"flooring":{"value":"wood"},"garden":{"value":"no"},"gasCostIncluded":{"value":"yes"},"heating":{"value":"gas"},"housematesGender":{"value":"shared_w_boys"},"internetCostIncluded":{"value":"yes"},"kitchen":{"value":"shared"},"kitchenware":{"value":"shared"},"livingRoom":{"value":"shared"},"parking":{"value":"private"},"pets":{"value":"no"},"playMusic":{"value":"no"},"roomFurniture":{"value":"yes"},"smoking":{"value":"outside_only"},"tenantStatus":{"value":"students only"},"toilet":{"value":"private"},"totalSize":{"value":"25"},"tv":{"value":"no"},"washingMachine":{"value":"yes"},"waterCostIncluded":{"value":"yes"},"wheelchairAccessible":{"value":"yes"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":70500,"deposit":148500,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"705.00","deposit":"1485.00","agencyFee":"0.00","estimatedBills":"0.00"},"minimumStayMonths":7,"moveInWindow":0,"currentOccupancy":3,"minAge":0,"maxAge":0,"preferredGender":"","available":[{"to":"9999-12-31","from":"2026-12-17"}],"updated":"2026-10-05T16:32:51Z","__utId__":"ut1743841"}]