b.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1596999/5910a1cf-ba6f-42a4-a274-a8152f60015b.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"Traumwohnung direkt am See\nSie träumen von einer Wohnung mit Blick und direktem Zugang zum See? Dann ist dieses Angebot genau das Richtige für Sie!\nHelle, moderne Räume mit hochwertiger Ausstattung.\nRuhige und idyllische Lage, ideal zum Entspannen.\nStellplatz vorhanden.\nDie 2-Zimmerwohnung befindet sich an der Stadtgrenze Berlins auf einem 2000 qm großen parkähnlichen Grundstück direkt am See, eingebettet in eine landschaftlich reizvolle Seenlandschaft mit vielfältigen Wassersportmöglichkeiten, wie schwimmen, paddeln, segeln, surfen, Wasserski fahren, angeln und vieles mehr. Ein Kanu steht zur Verfügung.\nNähe zu Berlin und Flughafen BER:\nDie Unterkunft befindet sich in Zeuthen, nur einen Katzensprung von der deutschen Hauptstadt Berlin entfernt. \nHervorragende Anbindung mit der S-Bahn:\nZeuthen ist hervorragend an das öffentliche Verkehrsnetz angeschlossen, insbesondere durch die S-Bahn, die eine schnelle Verbindung in die Berliner Innenstadt bietet. Sie können die berühmten Sehenswürdigkeiten der Stadt problemlos erkunden und gleichzeitig die Ruhe und Entspannung am See genießen.\n","facilities":{"airConditioning":{"value":"no"},"allergyFriendly":{"value":"no"},"balconyTerrace":{"value":"private"},"basement":{"value":"no"},"bathroom":{"value":"private"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"yes"},"bedrooms":{"value":"1"},"closet":{"value":"yes"},"couplesAllowed":{"value":"yes"},"desk":{"value":"yes"},"dishwasher":{"value":"yes"},"dryer":{"value":"yes"},"electricityCostIncluded":{"value":"yes"},"flooring":{"value":"stone"},"garden":{"value":"private"},"gasCostIncluded":{"value":"yes"},"heating":{"value":"central"},"internetCostIncluded":{"value":"yes"},"kitchen":{"value":"private"},"kitchenware":{"value":"private"},"livingRoom":{"value":"private"},"parking":{"value":"private"},"pets":{"value":"no"},"playMusic":{"value":"no"},"registrationPossible":{"value":"yes"},"roomFurniture":{"value":"yes"},"smoking":{"value":"outside_only"},"toilet":{"value":"private"},"totalSize":{"value":"48"},"tv":{"value":"yes"},"washingMachine":{"value":"yes"},"waterCostIncluded":{"value":"yes"},"wheelchairAccessible":{"value":"no"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":145000,"deposit":165000,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"1450.00","deposit":"1650.00","agencyFee":"0.00","estimatedBills":"0.00"},"minimumStayMonths":3,"moveInWindow":0,"currentOccupancy":0,"minAge":0,"maxAge":0,"preferredGender":"","available":[{"to":"9999-12-31","from":"2026-03-30"}],"updated":"2026-03-30T10:53:26Z","__utId__":"ut1596999"}]