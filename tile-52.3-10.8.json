e8a.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/room/1771984/3812ec92-af7b-4507-b4e2-693437cd2e8a.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/room/1771984/3812ec92-af7b-4507-b4e2-693437cd2e8a.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}},{"originalLink":"https://housinganywhere.imgix.net/room/1771984/6ed17cc8-8f26-49de-aa13-1745112ee1c5.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","categories":null,"sizes":{"1024x768":{"link":"https://housinganywhere.imgix.net/room/1771984/6ed17cc8-8f26-49de-aa13-1745112ee1c5.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/room/1771984/6ed17cc8-8f26-49de-aa13-1745112ee1c5.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/room/1771984/6ed17cc8-8f26-49de-aa13-1745112ee1c5.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/room/1771984/6ed17cc8-8f26-49de-aa13-1745112ee1c5.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/room/1771984/6ed17cc8-8f26-49de-aa13-1745112ee1c5.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"Our comfort apartment is 30sqm and is equipped with: \nbathroom with shower/toilet, hair dryer, mirror, washbasin, Flat-screen TV, direct-dial telephone, room safe, WIFI, living area, sleeping area, in-floor heating, kitchen or cooking facilities, refrigerator with freezer, glass-ceramic stoves, stainless-steel kitchen sink, dishes/glasses/pots/silverware, electric kettle, flat iron and ironing board.\n\nThe apartment is only a seven-minute drive from the center of Wolfsburg, but miles away from the hustle and bustle of the inner-city. In the midst of the rural idyll of Nordsteimke, you can enjoy your morning breakfast with a view of our apple orchard.\n\nOr you can take a sundowner on your balcony or the beautiful garden terrace after a hard day's work.\n\nAmbitious runners and walkers have the most beautiful jogging routes with field and forest paths around the manor right at their feet.\n\nIn the courtyard garden there are comfortable seats and loungers in a dreamlike setting. And in the old court smithy you can work out on modern sports equipment or relax in the sauna.\n\nIn the facilities you can also find the following services:\n\n• Breakfast in the farm kitchen with delicious products from the region\n• Evening snacks and drinks\n• Regular cleaning of the apartment with change of bed linen and towels\n• High-speed Internet, satellite TV with eight Sky channels\n• Washing machines and dryers (coin operated), external laundry service\n• Extra bed possible for (weekend) visitors\n• In-house parking spaces\n\nPlease be aware that HousingAnywhere is an online booking platform. Therefore exchanging contact details and offering viewings is not possible. If you would like to reserve this accommodation, send me a booking request or a message and please mention your age and occupation. I look forward to meeting you!","facilities":{"airConditioning":{"value":"no"},"allergyFriendly":{"value":"no"},"balconyTerrace":{"value":"private"},"basement":{"value":"no"},"bathroom":{"value":"private"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"no"},"bedrooms":{"value":"0"},"closet":{"value":"yes"},"couplesAllowed":{"value":"yes"},"desk":{"value":"yes"},"dishwasher":{"value":"no"},"dryer":{"value":"yes"},"electricityCostIncluded":{"value":"yes"},"flooring":{"value":"wood"},"garden":{"value":"shared"},"gasCostIncluded":