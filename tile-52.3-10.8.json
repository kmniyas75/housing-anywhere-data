cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/room/1771994/50861796-278e-46aa-a53f-9ac0daa4b366.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/room/1771994/50861796-278e-46aa-a53f-9ac0daa4b366.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}},{"originalLink":"https://housinganywhere.imgix.net/room/1771994/32bc394b-4433-4f53-92a7-23de813744c7.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","categories":null,"sizes":{"1024x768":{"link":"https://housinganywhere.imgix.net/room/1771994/32bc394b-4433-4f53-92a7-23de813744c7.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/room/1771994/32bc394b-4433-4f53-92a7-23de813744c7.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/room/1771994/32bc394b-4433-4f53-92a7-23de813744c7.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/room/1771994/32bc394b-4433-4f53-92a7-23de813744c7.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/room/1771994/32bc394b-4433-4f53-92a7-23de813744c7.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"Our superior apartment are 41sqm and are equipped with: \nbathroom with shower/toilet, hair dryer, make-up mirror, washbasin, Flat-screen TV, direct-dial telephone, room safe, WIFI, living area, sleeping area, a terrace or balcony, in-floor heating, kitchen, refrigerator with freezer, glass-ceramic stoves, stainless-steel kitchen sink, dishes/glasses/pots/silverware, electric kettle, flat iron and ironing board.\n\nThe apartment is only a seven-minute drive from the center of Wolfsburg, but miles away from the hustle and bustle of the inner-city. In the midst of the rural idyll of Nordsteimke, you can enjoy your morning breakfast with a view of our apple orchard.\n\nOr you can take a sundowner on your balcony or the beautiful garden terrace after a hard day's work.\n\nAmbitious runners and walkers have the most beautiful jogging routes with field and forest paths around the manor right at their feet.\n\nIn the courtyard garden there are comfortable seats and loungers in a dreamlike setting. And in the old court smithy you can work out on modern sports equipment or relax in the sauna.\n\nIn the facilities you can also find the following services:\n\n• Breakfast in the farm kitchen with delicious products from the region\n• Evening snacks and drinks\n• Regular cleaning of the apartment with change of bed linen and towels\n• High-speed Internet, satellite TV with eight Sky channels\n• Washing machines and dryers (coin operated), external laundry service\n• Extra bed possible for (weekend) visitors\n• In-house parking spaces\n\nPlease be aware that HousingAnywhere is an online booking platform. Therefore exchanging contact details and offering viewings is not possible. If you would like to reserve this accommodation, send me a booking request or a message and please mention your age and occupation. I look forward to meeting you!","facilities":{"airConditioning":{"value":"no"},"balconyTerrace":{"value":"private"},"bathroom":{"value":"private"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedrooms":{"value":"1"},"closet":{"value":"yes"},"couplesAllowed":{"value":"yes"},"dryer":{"value":"yes"},"electricityCostIncluded":{"value":"yes"},"flooring":{"value":"wood"},"garden":{"value":"shared"},"gasCostIncluded":{"value":"yes"},"heating":{"value":"central"},"internetCostIncluded":{"value":"yes"},"kitchen":{"value":"private"},"kitchenware":{"value":"private"},"livingRoom":{"value":"private"},"parking":{"value":"shared"},"pets":{"value":"no"},"playMusic":{"value":"no"},"roomFurniture":{"value":"yes"},"smoking":{"value":"no"},"toilet":{"value":"private"},"totalSize":{"value":"41"},"tv":{"value":"yes"},"washingMachine":{"value":"yes"},"waterCostIncluded":{"value":"yes"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":360000,"deposit":0,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"3600.00","deposit":"0.00","agencyFee":"0.00","estimatedBills":"0.00"},"minimumStayMonths":1,"moveInWindow":0,"currentOccupancy":0,"minAge":0,"maxAge":0,"preferredGender":"","available":[{"to":"9999-12-31","from":"2026-06-08"}],"updated":"2026-06-08T14:35:17Z","__utId__":"ut1125248"}]