/2e8030a1-0fff-4344-8e2b-45f3400f8759.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","categories":["bathroom"],"sizes":{"1024x768":{"link":"https://housinganywhere.imgix.net/unit_type/1747936/2e8030a1-0fff-4344-8e2b-45f3400f8759.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/unit_type/1747936/2e8030a1-0fff-4344-8e2b-45f3400f8759.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1747936/2e8030a1-0fff-4344-8e2b-45f3400f8759.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1747936/2e8030a1-0fff-4344-8e2b-45f3400f8759.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1747936/2e8030a1-0fff-4344-8e2b-45f3400f8759.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}},{"originalLink":"https://housinganywhere.imgix.net/unit_type/1747936/26c41688-326d-4cbc-977a-87965173617f.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","categories":["bathroom"],"sizes":{"1024x768":{"link":"https://housinganywhere.imgix.net/unit_type/1747936/26c41688-326d-4cbc-977a-87965173617f.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/unit_type/1747936/26c41688-326d-4cbc-977a-87965173617f.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1747936/26c41688-326d-4cbc-977a-87965173617f.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1747936/26c41688-326d-4cbc-977a-87965173617f.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1747936/26c41688-326d-4cbc-977a-87965173617f.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"A spacious top-floor apartment full of character in central Leer, Ostfriesland, Germany\n\nExposed timber beams, high ceilings and unusually shaped windows give this approximately 125 m2 apartment its distinctive character. An open layout, two separate bedrooms and high-quality fittings combine a sense of space with modern comfort.\n\nWith its artistically painted façade, the building stands at the beginning of the pedestrian shopping area, where the town centre meets Leer’s historic old town. Shops, cafés and restaurants are just a short walk away. Upstairs, the apartment offers a retreat above the street, with views across the town’s rooftops.\n\nLiving and cooking\n\nThe spacious, open-plan living and dining area features exposed timber beams and offers room for your own ideas and personal style.\n\nThe well-equipped kitchen includes an island with a  induction hob and an adjoining breakfast bar. Appliances include a dishwasher, oven, microwave and fridge-freezer.\n\nThe living area opens onto a sheltered balcony with a view of the tower.\n\nBedrooms and bathroom\n\nTwo separate bedrooms offer flexibility, whether you need a second bedroom, a guest room or a home office. The roof window in the main bedroom has an electrically operated screen.\n\nThe generous bathroom includes a bathtub, separate shower, double vanity unit and toilet. An electric heated towel rail provides additional warmth whenever you want it, independently of the underfloor heating. There is also a separate guest toilet.\n\nAdditional features\nThe apartment has underfloor heating, a video intercom and lift access. It also comes with a private storage room in the basement, with electricity connected to the apartment’s own meter. A parking space is available in a car park with barrier-controlled access, approximately five minutes’ walk away.\n\nRental details\nMonthly rent: € 1.300\nMonthly advance payment for service and heating costs: € 350\nTotal monthly payment: € 1,650\n\nService and heating costs are reconciled annually against actual costs. Electricity and internet are not included; tenants arrange and pay for these separately.\nThe minimum rental period is twelve months. Longer stays are welcome.\n\nThe apartment is offered unfurnished, with the fitted kitchen and appliances described above. Furnishing can be arranged by agreement at a separately agreed rental price.\n\nInterested?\nWe welcome enquiries from working professionals and expats with a reliable income.\n\nPlease introduce yourself briefly, tell us who would be moving in, what you do for work, your preferred move-in date and how long you would like to stay.\n\nBefore signing the tenancy agreement, we require proof of employment, such as an employment contract or employer’s confirmation, together with suitable proof of income and, where applicable, a valid residence permit for Germany. If you are relocating for a new role, confirmation from your future employer is welcome.\n\nViewings are arranged following an initial conversation and a genuine interest in renting the apartment.\n\nYou are welcome to respond in Dutch, German or English.","facilities":{"airConditioning":{"value":"no"},"allergyFriendly":{"value":"yes"},"balconyTerrace":{"value":"private"},"basement":{"value":"private"},"bathroom":{"value":"private"},"bed":{"value":"no"},"bedroomFurnished":{"value":"no"},"bedroomLock":{"value":"no"},"bedrooms":{"value":"2"},"closet":{"value":"yes"},"couplesAllowed":{"value":"yes"},"desk":{"value":"no"},"dishwasher":{"value":"yes"},"dryer":{"value":"no"},"electricityCostIncluded":{"value":"no"},"flooring":{"value":"laminate"},"gasCostIncluded":{"value":"yes"},"heating":{"value":"central"},"internetCostIncluded":{"value":"no"},"kitchen":{"value":"private"},"kitchenware":{"value":"private"},"livingRoom":{"value":"private"},"parking":{"value":"private"},"pets":{"value":"no"},"playMusic":{"value":"discussable"},"registrationPossible":{"value":"yes"},"roomFurniture":{"value":"no"},"smoking":{"value":"outside_only"},"tenantStatus":{"value":"working professionals only"},"toilet":{"value":"private"},"totalSize":{"value":"125"},"tv":{"value":"no"},"washingMachine":{"value":"no"},"waterCostIncluded":{"value":"yes"},"wheelchairAccessible":{"value":"yes"},"wifi":{"value":"no"}},"costs":{"currency":"EUR","pricing":"monthly","price":165000,"deposit":250000,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"1650.00","deposit":"2500.00","agencyFee":"0.00","estimatedBills":"0.00"},"minimumStayMonths":12,"moveInWindow":0,"currentOccupancy":0,"minAge":0,"maxAge":0,"preferredGender":"","available":[{"to":"9999-12-31","from":"2026-10-22"}],"updated":"2026-10-22T10:59:49Z","__utId__":"ut1747936"}]