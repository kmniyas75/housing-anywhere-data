et/unit_type/1379789/be4ad236-96ff-4811-abfe-fa8ca8ef154e.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","categories":null,"sizes":{"1024x768":{"link":"https://housinganywhere.imgix.net/unit_type/1379789/be4ad236-96ff-4811-abfe-fa8ca8ef154e.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/unit_type/1379789/be4ad236-96ff-4811-abfe-fa8ca8ef154e.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1379789/be4ad236-96ff-4811-abfe-fa8ca8ef154e.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1379789/be4ad236-96ff-4811-abfe-fa8ca8ef154e.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1379789/be4ad236-96ff-4811-abfe-fa8ca8ef154e.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}},{"originalLink":"https://housinganywhere.imgix.net/unit_type/1379789/5ebf141b-4429-4547-8274-9ce2cf48a712.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","categories":null,"sizes":{"1024x768":{"link":"https://housinganywhere.imgix.net/unit_type/1379789/5ebf141b-4429-4547-8274-9ce2cf48a712.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/unit_type/1379789/5ebf141b-4429-4547-8274-9ce2cf48a712.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1379789/5ebf141b-4429-4547-8274-9ce2cf48a712.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1379789/5ebf141b-4429-4547-8274-9ce2cf48a712.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1379789/5ebf141b-4429-4547-8274-9ce2cf48a712.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"Fully furnished 2-room apartment in renovated 3-sided courtyard in Heideblick\n\nDescription:\nImmerse yourself in the peaceful idyll of rural life! This charming 2-room apartment is part of a lovingly renovated 3-sided courtyard from 1900, which was completely renovated in 1990 and renovated again in 2023. The apartment is fully furnished and has 50sqm of living space, consisting of a living room/bedroom, an eat-in kitchen and a bathroom.\n\nIn the living room/bedroom you will find a comfortable 160 cm queen-size bed and a pull-out sofa bed that can accommodate up to two additional guests. The modern fitted kitchen is equipped with all necessary kitchen utensils and has a dining table for four people. The bathroom is equipped with a shower.\n\nOther amenities include a smart TV and WiFi with 16 Mbit. Outside, a private terrace with a table and four chairs invites you to relax, and the courtyard offers barbecue facilities. Parking is available in the courtyard or on the street.\n\nLocation:\nLocated on the Niederlausitzer Landrücken Nature Park, the location of the apartment offers a picturesque retreat with the Spreewald forest nearby. A popular hiking and cycling trail, the \"Kornradenweg\", runs right past the site. Other nearby attractions include a birdwatching observation tower, a restaurant within walking distance and a horse riding stable in the village. Architectural highlights such as the village church and the mill enrich the rural atmosphere of Heideblick.\n\nAdditional information:\nThe apartment is perfectly suited for individuals, couples or fitters looking for temporary accommodation. The minimum rental period is three days and the maximum rental period is 24 months. A deposit of €1,000 is required and a final cleaning fee of €75 is charged. In order for the booking to be confirmed, a rental agreement is also concluded. To do this, the tenant must upload his ID to the platform and transfer the deposit to the landlord's account before moving in.","facilities":{"airConditioning":{"value":"no"},"allergyFriendly":{"value":"no"},"balconyTerrace":{"value":"private"},"basement":{"value":"no"},"bathroom":{"value":"private"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"no"},"bedrooms":{"value":"1"},"closet":{"value":"yes"},"couplesAllowed":{"value":"yes"},"desk":{"value":"yes"},"dishwasher":{"value":"no"},"dryer":{"value":"yes"},"electricityCostIncluded":{"value":"yes"},"flooring":{"value":"stone"},"garden":{"value":"shared"},"gasCostIncluded":{"value":"yes"},"heating":{"value":"wood_stove"},"internetCostIncluded":{"value":"yes"},"kitchen":{"value":"private"},"kitchenware":{"value":"private"},"livingRoom":{"value":"private"},"parking":{"value":"shared"},"pets":{"value":"no"},"playMusic":{"value":"discussable"},"registrationPossible":{"value":"yes"},"roomFurniture":{"value":"yes"},"smoking":{"value":"outside_only"},"toilet":{"value":"private"},"totalSize":{"value":"55"},"tv":{"value":"yes"},"washingMachine":{"value":"yes"},"waterCostIncluded":{"value":"yes"},"wheelchairAccessible":{"value":"no"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":79000,"deposit":100000,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"790.00","deposit":"1000.00","agencyFee":"0.00","estimatedBills":"0.00"},"minimumStayMonths":3,"moveInWindow":0,"currentOccupancy":0,"minAge":0,"maxAge":0,"preferredGender":"","available":[{"to":"9999-12-31","from":"2027-12-01"}],"updated":"2026-07-14T05:00:58Z","__utId__":"ut1379789"}]