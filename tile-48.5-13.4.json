-4b09-bdc2-4372853f2353.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","categories":null,"sizes":{"1024x768":{"link":"https://housinganywhere.imgix.net/unit_type/1690448/77cb0abd-2056-4b09-bdc2-4372853f2353.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/unit_type/1690448/77cb0abd-2056-4b09-bdc2-4372853f2353.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1690448/77cb0abd-2056-4b09-bdc2-4372853f2353.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1690448/77cb0abd-2056-4b09-bdc2-4372853f2353.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1690448/77cb0abd-2056-4b09-bdc2-4372853f2353.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}},{"originalLink":"https://housinganywhere.imgix.net/unit_type/1690448/269cf012-baf5-4216-b656-ba0ad5d3d56b.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","categories":null,"sizes":{"1024x768":{"link":"https://housinganywhere.imgix.net/unit_type/1690448/269cf012-baf5-4216-b656-ba0ad5d3d56b.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/unit_type/1690448/269cf012-baf5-4216-b656-ba0ad5d3d56b.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1690448/269cf012-baf5-4216-b656-ba0ad5d3d56b.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1690448/269cf012-baf5-4216-b656-ba0ad5d3d56b.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1690448/269cf012-baf5-4216-b656-ba0ad5d3d56b.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"Hallo zusammen,\nich vermiete mein komplett möbliertes WG-Zimmer in einer 2er WG für ein halbes Jahr unter, da ich für ein Praktikum in einer anderen Stadt bin.\nDas Zimmer ist großzügig geschnitten, lichtdurchflutet und hat direkten Blick auf den Inn – schöner kann man kaum aufwachen! Durch den Holzboden wirkt der Raum besonders warm und gemütlich. Zur Ausstattung gehören ein Bett, ein großer Kleiderschrank, ein Schreibtisch, ein Sofa sowie ein Tisch mit Stühlen. Außerdem gibt es viel Stauraum, sodass du dich direkt wohlfühlen und ohne großen Aufwand einziehen kannst.\nDie Wohnung liegt direkt am Inn, mitten in der Altstadt – zentraler geht es kaum. Cafés, Einkaufsmöglichkeiten und alles, was man im Alltag braucht, sind fußläufig erreichbar.\nDie Küche ist voll ausgestattet (inkl. allem, was man zum Kochen braucht) und auch das Badezimmer bietet alles, was man benötigt.\nDein zukünftiger Mitbewohner ist Julian. Er kocht sehr gerne und geht regelmäßig ins Gym. Gemeinsame Abende in der Küche oder entspanntes Zusammensitzen sind immer willkommen – gleichzeitig hat natürlich jeder seinen eigenen Rückzugsort.\nDie Warmmiete beträgt 470 € inklusive aller Nebenkosten.\nWenn du Interesse hast, melde dich gerne mit ein paar Infos zu dir","facilities":{"airConditioning":{"value":"no"},"allergyFriendly":{"value":"yes"},"balconyTerrace":{"value":"no"},"basement":{"value":"shared"},"bathroom":{"value":"shared_w_both"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"yes"},"bedroomSize":{"value":"16"},"bedrooms":{"value":"1"},"closet":{"value":"yes"},"couplesAllowed":{"value":"no"},"desk":{"value":"yes"},"dishwasher":{"value":"no"},"dryer":{"value":"yes"},"electricityCostIncluded":{"value