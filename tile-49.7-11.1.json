gb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1723545/d66beb34-0728-48d0-b36a-0c4851d8633a.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1723545/d66beb34-0728-48d0-b36a-0c4851d8633a.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"Diese gepflegte und vollständig möblierte 3-Zimmer-Wohnung mit ca. 88 m2 Wohnfläche befindet sich in ruhiger und dennoch zentraler Lage von Ebermannstadt, nur wenige Schritte vom Stadtpark entfernt.\nDie Wohnung überzeugt durch ihren großzügigen Grundriss und ihre hochwertige Ausstattung. Sie verfügt über ein gemütliches Schlafzimmer mit 1 Doppelbett, ein weiteres Zimmer inkl. franz. Bett, das sich ideal als Kinder-, Arbeits- oder Gästezimmer eignet, ein helles Wohnzimmer mit großzügigem Essbereich sowie eine voll ausgestattete Küche. \nEin Reisebett für Kinder kann ebenfalls genutzt werden.\nDas Tageslichtbad mit Fenster sorgt für eine angenehme Wohnatmosphäre. Ein besonderes Highlight ist die überdachte Terrasse mit eigenem Gartenanteil – ein idealer Ort zum Entspannen nach der Arbeit oder zum Genießen der Natur. \nErgänzt wird das Angebot durch eine praktische Abstellkammer in der Wohnung und einen Trockenraum (inkl. eigener Waschmaschine + Trockner) und Fahrradkeller im Gemeinschaftskeller. Die Wohnung eignet sich besonders für Berufspendler, Projektmitarbeiter, Geschäftsreisende, Fachkräfte oder Paare, die für mehrere Monate ein komfortables Zuhause auf Zeit suchen.\n\nDie historische Altstadt ist in etwa zehn Gehminuten erreichbar, der Bahnhof in rund fünf Minuten. Gleichzeitig beginnt die reizvolle Wander- und Naturregion der Fränkischen Schweiz praktisch vor der Haustür.","facilities":{"airConditioning":{"value":"no"},"balconyTerrace":{"value":"private"},"basement":{"value":"shared"},"bathroom":{"value":"private"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"yes"},"bedrooms":{"value":"1"},"closet":{"value":"yes"},"couplesAllowed":{"value":"yes"},"desk":{"value":"yes"},"dishwasher":{"value":"yes"},"dryer":{"value":"yes"},"electricityCostIncluded":{"value":"yes"},"garden":{"value":"private"},"gasCostIncluded":{"value":"yes"},"heating":{"value":"gas"},"internetCostIncluded":{"value":"yes"},"kitchen":{"value":"private"},"kitchenware":{"value":"private"},"livingRoom":{"value":"private"},"parking":{"value":"private"},"pets":{"value":"no"},"registrationPossible":{"value":"yes"},"roomFurniture":{"value":"yes"},"smoking":{"value":"outside_only"},"tenantStatus":{"value":"working professionals only"},"toilet":{"value":"private"},"totalSize":{"value":"88"},"tv":{"value":"yes"},"washingMachine":{"value":"yes"},"waterCostIncluded":{"value":"yes"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":155000,"deposit":250000,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"1550.00","deposit":"2500.00","agencyFee":"0.00","estimatedBills":"0.00"},"minimumStayMonths":3,"moveInWindow":0,"currentOccupancy":0,"minAge":0,"maxAge":0,"preferredGender":"","available":[{"to":"9999-12-31","from":"2026-10-01"}],"updated":"2026-07-13T12:43:45Z","__utId__":"ut1723545"}]