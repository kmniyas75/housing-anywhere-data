-4c2f-8e8f-b18a0481a45d.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1676677/d280ffec-84a7-4c2f-8e8f-b18a0481a45d.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1676677/d280ffec-84a7-4c2f-8e8f-b18a0481a45d.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"Willkommen im Wildlife Apartment – einer vollständig möblierten 3,5-Zimmer-Wohnung für komfortables und unkompliziertes Wohnen auf Zeit.\n\nDie Wohnung eignet sich ideal für Pendler, Projektmitarbeiter, Expats oder berufstätige Mieter, z. B. zwei Singles, ein Paar (ggf. mit Kind) oder eine Einzelperson. Auch eine kleine, berufstätige WG ist möglich.\n\nEckdaten & Highlights\n\n- 82 qm Dachgeschosswohnung in ruhigem Wohngebiet (Filderstadt-Plattenhardt)\n3,5 Zimmer:\n- 2 Schlafzimmer\n- separater Arbeitsbereich mit Schreibtisch\n- großzügiger Wohnbereich\n- Balkon mit Grill und Aussicht\n- Voll ausgestattete Küche\n- Waschmaschine vorhanden\n- 1 Badezimmer + separate Toilette\n- 2 Stellplätze (1 Garagenplatz + 1 sehr großzügiger Außenstellplatz)\n- Einkaufsmöglichkeiten und Restaurants fußläufig erreichbar\n- Ca. 10 Minuten mit dem Auto zum Flughafen und zur Messe\n\nMietmodell\n\n- Monatliche Pauschalmiete: 2.400 €\n- Inklusive Hausnebenkosten, Strom, Internet sowie vollständiger Möblierung\n- Keine separate Nebenkostenabrechnung\n- Keine zusätzlichen Verträge erforderlich\n\nFlexibilität\n\n- Anpassungen der Ausstattung oder des Mobiliars sind nach - Absprache und je nach Bedarf möglich (z. B. für berufstätige WGs oder Firmenmieter).\n\nSonstiges\n\n- Nichtraucherwohnung (Nichtrauchen im Innenbereich)\n- Haustiere nach Absprache\n- Geeignet für bis zu 4 Personen, optimal bei Nutzung durch max. 3 Personen aufgrund von 2 Schlafzimmern\nIdeal für befristete Mietverhältnisse\n- WG-geeignet (berufstätig)\n\nAnkommen, einziehen, wohlfühlen – mit planbaren Fixkosten und maximalem Komfort.","facilities":{"allergyFriendly":{"value":"yes"},"balconyTerrace":{"value":"private"},"basement":{"value":"no"},"bathroom":{"value":"private"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"yes"},"bedrooms":{"value":"2"},"closet":{"value":"yes"},"couplesAllowed":{"value":"yes"},"desk":{"value":"yes"},"dishwasher":{"value":"yes"},"electricityCostIncluded":{"value":"yes"},"flooring":{"value":"laminate"},"garden":{"value":"shared"},"gasCostIncluded":{"value":"yes"},"heating":{"value":"central"},"internetCostIncluded":{"value":"yes"},"kitchen":{"value":"private"},"kitchenware":{"value":"private"},"livingRoom":{"value":"private"},"parking":{"value":"private"},"pets":{"value":"discussable"},"playMusic":{"value":"discussable"},"registrationPossible":{"value":"yes"},"roomFurniture":{"value":"yes"},"smoking":{"value":"outside_only"},"toilet":{"value":"private"},"totalSize":{"value":"82"},"tv":{"value":"yes"},"washingMachine":{"value":"yes"},"waterCostIncluded":{"value":"yes"},"wheelchairAccessible":{"value":"no"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":240000,"deposit":240000,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"2400.00","deposit":"2400.00","agencyFee":"0.00","estimatedBills":"0.00"},"minimumStayMonths":1,"moveInWindow":0,"currentOccupancy":0,"minAge":0,"maxAge":0,"preferredGender":"","available":[{"to":"9999-12-31","from":"2026-08-02"}],"updated":"2026-04-02T06:24:11Z","__utId__":"ut1676677"}]