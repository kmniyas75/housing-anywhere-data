6&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1486881/f24144cc-3a1f-49ed-8464-9b1de6548971.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1486881/f24144cc-3a1f-49ed-8464-9b1de6548971.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1486881/f24144cc-3a1f-49ed-8464-9b1de6548971.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"This luxuriously furnished business apartment „Apartment Kreuzberg“ is located in the popular Berlin district (Berliner Viertel) of Pattensen, close to the Hannover fair. The studio has been completely modernised and refurnished in 2024 and has a modern daylight bathroom with shower, washer-dryer, LED-mirror, and towel radiator. The living-sleeping area is equipped with wooden flooring and offers a kitchen with sink, stove, microwave, toaster, kettle, fridge-freezer combination and capsule coffee maker (Tschibo Caffissimo Pure plus coffee machine). Mini oven can be provided upon request. The kitchen area is equipped with comfortable seating for two persons (Please note: Rental price as shown above includes utilities for only 1 person. For 2nd person additional EUR 150,00 are added to monthly costs) and can be used perfectly as a laptop workplace. For optimal working from home conditions, Apartment Kreuzberg offers high-speed 5G internet access and Wi-Fi. A luxurious queen size box spring bed (H2/H3) provides excellent sleeping comfort, while a 43-inch Samsung Crystal UHD 4K Smart TV provides high class evening TV entertainment. In addition, the apartment offers a wardrobe with mirrored doors, as well as a small lounge area with leather armchair and side table. The apartment is equipped with a washer-dryer. In addition, lease includes a lockable utility room in (hidden)ment of the house which can be used exclusively by the tenant offering additional space for its personal belongings. In (hidden)ment of the house there is also a commonly used utility room with additional storage facilities for bicycles. Free public car parking is available in front of the house. Various restaurants and grocery stores, the Calenberg shopping center, a sports gym and bus stop with direct connection to the city center of Hannover as well as Hannover fair are in walking distance from the apartment. Both can be reached within 15-20 minutes by car or nonstop in about 30 minutes by bus. For leisure time, the „Calenberger Land“ recreational area is situated just a few steps away offering various running, hiking and cycling possibilities.","facilities":{"airConditioning":{"value":"no"},"allergyFriendly":{"value":"yes"},"balconyTerrace":{"value":"no"},"basement":{"value":"private"},"bathroom":{"value":"private"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"yes"},"bedrooms":{"value":"0"},"closet":{"value":"yes"},"couplesAllowed":{"value":"yes"},"desk":{"value":"yes"},"dishwasher":{"value":"no"},"dryer":{"value":"yes"},"electricityCostIncluded":{"value":"yes"},"flooring":{"value":"wood"},"garden":{"value":"shared"},"gasCostIncluded":{"value":"yes"},"heating":{"value":"central"},"internetCostIncluded":{"value":"yes"},"kitchen":{"value":"private"},"kitchenware":{"value":"private"},"livingRoom":{"value":"private"},"parking":{"value":"shared"},"pets":{"value":"no"},"playMusic":{"value":"yes"},"registrationPossible":{"value":"yes"},"roomFurniture":{"value":"yes"},"smoking":{"value":"outside_only"},"toilet":{"value":"private"},"totalSize":{"value":"25"},"tv":{"value":"yes"},"washingMachine":{"value":"yes"},"waterCostIncluded":{"value":"yes"},"wheelchairAccessible":{"value":"no"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":94500,"deposit":120000,"agencyFee":0,"esti