/59c6164c-c596-46a9-a45f-04740ce165eb.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1699626/59c6164c-c596-46a9-a45f-04740ce165eb.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}},{"originalLink":"https://housinganywhere.imgix.net/unit_type/1699626/1289e45f-821d-4999-9812-4ef90de7bab9.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","categories":null,"sizes":{"1024x768":{"link":"https://housinganywhere.imgix.net/unit_type/1699626/1289e45f-821d-4999-9812-4ef90de7bab9.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/unit_type/1699626/1289e45f-821d-4999-9812-4ef90de7bab9.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1699626/1289e45f-821d-4999-9812-4ef90de7bab9.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1699626/1289e45f-821d-4999-9812-4ef90de7bab9.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1699626/1289e45f-821d-4999-9812-4ef90de7bab9.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}},{"originalLink":"https://housinganywhere.imgix.net/unit_type/1699626/51fe2ce3-6711-491d-baf8-73d1e9237e40.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","categories":null,"sizes":{"1024x768":{"link":"https://housinganywhere.imgix.net/unit_type/1699626/51fe2ce3-6711-491d-baf8-73d1e9237e40.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/unit_type/1699626/51fe2ce3-6711-491d-baf8-73d1e9237e40.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1699626/51fe2ce3-6711-491d-baf8-73d1e9237e40.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1699626/51fe2ce3-6711-491d-baf8-73d1e9237e40.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1699626/51fe2ce3-6711-491d-baf8-73d1e9237e40.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"Stilvolle, frisch renovierte 3,5-Zimmer-Maisonette über zwei Ebenen mit separatem Eingang, voll möbliert und sofort bezugsfertig. Perfekt für Berufspendler und Expats: Heidelberg, Mannheim, Walldorf und Karlsruhe in direkter Nähe. Warmmiete: 2100 € inkl. Nebenkosten, Highspeed-Internet & TV, Parkplatz mit Wallbox. Mindestmietdauer 6 Monate.\n________________________________________\n\nBeschreibung:\nDiese frisch modernisierte Maisonette-Wohnung (Erstbezug nach Renovierung Ende 2025) bietet auf 80 m2 lichtdurchflutete, großzügige Räume über mehrere Ebenen. Die Wohnung ist voll möbliert und sofort bezugsfertig, inklusive moderner Einbauküche, Waschmaschine & Trockner, hochwertiger Ausstattung und stilvoller Einrichtung.\n\nAusstattung & Highlights:\n•\tHeimkinoanlage mit Full-HD-Beamer im Wohnzimmer\n•\tKlimaanlage und Elektrokamin mit realistischen Flammen\n•\tHochwertige Vinylböden in Eichenoptik im Obergeschoss\n•\tModerne Einbauküche mit Marken-Waschmaschine & -Trockner\n•\tOffener Essbereich am Tresen, ideal für gemeinsames Kochen oder Arbeiten\n•\tZwei flexible Zimmer für Schlaf- oder Arbeitsbereich, wahlweise mit Bett & Smart-TV oder als Office\n•\tModernes Badezimmer mit großzügiger Komfortdusche\n•\tElektrische Rollläden, zentrale Gasheizung, moderne LED-Beleuchtung\n•\tHighspeed-LAN & WLAN inklusive\n•\tParkplatz direkt am Haus mit Wallbox\n•\tKleine Abstellräume in den oberen Wohnebenen\n•\tGepflegte Wohnanlage mit nur 4 Einheiten\n•\tKleine Sitzgelegenheit im Vorgarten\n•\tOptional: „Ready to move in“ inklusive Geschirr, Bettwäsche & Handtücher\n\n\nWohnungsaufteilung:\n•\tErdgeschoss: Separater und offener Eingangsbereich / Diele\n•\tObergeschoss: Geräumiges Wohnzimmer (~23 m2) mit Klimaanlage und Heimkino, Küche mit Einbaugeräten, offener Essbereich, Abstellraum (~2,5 m2)\n•\tDachgeschoss: Modernes Bad mit Komfortdusche, zwei nahezu gleich große Zimmer (Schlaf- & Arbeitsbereich flexibel nutzbar), kleiner Abstellraum\n•\tSpitzboden: 48 m2 Stauraum unter Dachschrägen\n \nLage & Umgebung:\nRuhiges Wohnviertel mit direktem Zugang zu Wald und Wiesen – ideal zum Entspannen nach der Arbeit. Einkaufsmöglichkeiten, Bushaltestelle und Regionalexpress (z. B. Mannheim Hbf in 16 Minuten) sind fußläufig erreichbar. Perfekte Lage für Berufspendler und Expats: Heidelberg, Mannheim, Walldorf und Karlsruhe in direkter Nähe, SAP Walldorf unter 15 Minuten per Auto.\n","facilities":{"airConditioning":{"value":"yes"},"allergyFriendly":{"value":"yes"},"balconyTerrace":{"value":"no"},"basement":{"value":"no"},"bathroom":{"value":"private"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"yes"},"bedrooms":{"value":"2"},"closet":{"value":"yes"},"couplesAllowed":{"value":"yes"},"desk":{"value":"yes"},"dishwasher":{"value":"yes"},"dryer":{"value":"yes"},"electricityCostIncluded":{"value":"yes"},"flooring":{"value":"stone"},"garden":{"value":"no"},"gasCostIncluded":{"value":"yes"},"heating":{"value":"central"},"internetCostIncluded":{"value":"yes"},"kitchen":{"value":"private"},"kitchenware":{"value":"private"},"livingRoom":{"value":"private"},"parking":{"value":"private"},"pets":{"value":"discussable"},"playMusic":{"value":"discussable"},"registrationPossible":{"value":"yes"},"roomFurniture":{"value":"yes"},"smoking":{"value":"outside_only"},"toilet":{"value":"private"},"totalSize":{"value":"80"},"tv":{"value":"yes"},"washingMachine":{"value":"yes"},"waterCostIncluded":{"value":"yes"},"wheelchairAccessible":{"value":"no"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":210000,"deposit":420000,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"2100.00","deposit":"4200.00","agencyFee":"0.00","estimatedBills":"0.00"},"minimumStayMonths":4,"moveInWindow":0,"currentOccupancy":0,"minAge":18,"maxAge":0,"preferredGender":"","available":[{"to":"9999-12-31","from":"2026-04-09"}],"updated":"2026-04-09T07:45:20Z","__utId__":"ut1699626"}]