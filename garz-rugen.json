00x600":{"link":"https://housinganywhere.imgix.net/unit_type/1628766/b358463f-d3af-4493-adda-b934107fd109.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}},{"originalLink":"https://housinganywhere.imgix.net/unit_type/1628766/781816ec-4b66-4710-825a-d4fd76cdf9cf.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","categories":null,"sizes":{"1024x768":{"link":"https://housinganywhere.imgix.net/unit_type/1628766/781816ec-4b66-4710-825a-d4fd76cdf9cf.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/unit_type/1628766/781816ec-4b66-4710-825a-d4fd76cdf9cf.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1628766/781816ec-4b66-4710-825a-d4fd76cdf9cf.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1628766/781816ec-4b66-4710-825a-d4fd76cdf9cf.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1628766/781816ec-4b66-4710-825a-d4fd76cdf9cf.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"Die Ferienwohnung Rugiana... Dein Rückzugsort im ruhigen Süden Rügens, perfekt für Langzeitgäste, digitale Nomaden und Familien, die Natur und Nachhaltigkeit lieben.\n\nDie 85 qm große, lichtdurchflutete Wohnung bietet alles, was Du brauchst: zwei Schlafzimmer, ein gemütliches Wohnzimmer, eine voll ausgestattete Küche, Waschmaschine und schnelles WLAN. Der umzäunte Garten mit windgeschützter Sitzecke lädt zum Arbeiten im Grünen oder entspannten Grillen ein.\n\nWer bewusst lebt, fühlt sich bei uns besonders wohl: Im ganzen Haus fließt 100 % Ökostrom und das Abwasser wird in unserer eigenen Biokläranlage natürlich gereinigt.\n\nFür Familien ist bestens gesorgt: Gitterbett, Wickeltisch, Laufgitter, Hochstuhl, Treppenschutzgitter und Spielsachen sind vorhanden. Auch Hunde sind herzlich willkommen.\n\nDirekt vor der Tür beginnt übrigens die Schoritzer Wiek... ein Paradies für Vogelbeobachtung, Naturfotografie oder einfach nur zum Durchatmen. Abseits der Touristenströme, mitten im Grünen und doch gut angebunden für Ausflüge über die ganze Insel.\n\nKlingt nach dem, was Du suchst? Dann freuen wir uns auf Dich!","facilities":{"airConditioning":{"value":"no"},"allergyFriendly":{"value":"no"},"balconyTerrace":{"value":"no"},"basement":{"value":"no"},"bathroom":{"value":"private"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"yes"},"bedrooms":{"value":"2"},"closet":{"value":"yes"},"couplesAllowed":{"value":"yes"},"desk":{"value":"yes"},"dishwasher":{"value":"yes"},"dryer":{"value":"no"},"electricityCostIncluded":{"value":"yes"},"flooring":{"value":"laminate"},"garden":{"value":"private"},"gasCostIncluded":{"value":"yes"},"heating":{"value":"gas"},"internetCostIncluded":{"value":"yes"},"kitchen":{"value":"private"},"kitchenware":{"value":"private"},"livingRoom":{"value":"private"},"parking":{"value":"private"},"pets":{"value":"discussable"},"playMusic":{"value":"yes"},"registrationPossible":{"value":"yes"},"roomFurniture":{"value":"yes"},"smoking":{"value":"outside_only"},"toilet":{"value":"private"},"totalSize":{"value":"85"},"tv":{"value":"yes"},"washingMachine":{"value":"yes"},"waterCostIncluded":{"value":"yes"},"wheelchairAccessible":{"value":"no"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":130000,"deposit":50000,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"1300.00","deposit":"500.00","agencyFee":"0.00","estimatedBills":"0.00"},"minimumStayMonths":6,"moveInWindow":0,"currentOccupancy":0,"minAge":0,"maxAge":0,"preferredGender":"","available":[{"to":"9999-12-31","