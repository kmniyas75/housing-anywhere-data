fit=clip&h=768&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/unit_type/1740958/4e7ced24-311a-4097-9ea9-868731698ba6.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1740958/4e7ced24-311a-4097-9ea9-868731698ba6.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1740958/4e7ced24-311a-4097-9ea9-868731698ba6.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1740958/4e7ced24-311a-4097-9ea9-868731698ba6.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"Moderne, vollständig möblierte 2-Zimmer-Wohnung mit ca. 60 m2 in attraktiver Lage nahe Rhein, Innenstadt und Dom. Die Wohnung eignet sich ideal für längere Aufenthalte von Einzelpersonen, Paaren oder kleinen Familien. Sie verfügt über einen Wohnbereich mit offener Küche und Essecke, ein separates Schlafzimmer mit Kingsize-Doppelbett, ein modernes Bad, einen Abstellraum mit Waschtrockner sowie einen großzügigen überdachten Balkon. Ein Schlafsofa im Wohnzimmer bietet eine zusätzliche Schlafmöglichkeit.\n\nDie Wohnung ist barrierefrei per Aufzug erreichbar und mit elektronischem Zugangssystem sowie smarten Komponenten ausgestattet. WLAN, Smart-TV und ein geeigneter Arbeitsplatz sind ebenfalls vorhanden. Direkt am Rhein gelegen, erreichen Sie das Technikmuseum bequem zu Fuß; der Speyerer Dom liegt etwa 1 km entfernt. Weitere Sehenswürdigkeiten der Innenstadt sind ebenfalls gut zu Fuß oder mit dem Fahrrad erreichbar. Ein Supermarkt befindet sich rund 600 m entfernt.\n\nDie Wohnung wird ausschließlich zu Wohnzwecken vermietet. Eine Wohnungsgeberbestätigung wird ausgestellt; soweit gesetzlich erforderlich, ist die Anmeldung des Wohnsitzes durch den Mieter vorzunehmen.","facilities":{"airConditioning":{"value":"no"},"allergyFriendly":{"value":"yes"},"balconyTerrace":{"value":"private"},"bathroom":{"value":"private"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"yes"},"bedrooms":{"value":"1"},"closet":{"value":"yes"},"couplesAllowed":{"value":"yes"},"desk":{"value":"yes"},"dishwasher":{"value":"yes"},"dryer":{"value":"yes"},"electricityCostIncluded":{"value":"yes"},"flooring":{"value":"wood"},"gasCostIncluded":{"value":"yes"},"heating":{"value":"central"},"internetCostIncluded":{"value":"yes"},"kitchen":{"value":"private"},"kitchenware":{"value":"private"},"livingRoom":{"value":"private"},"parking":{"value":"private"},"pets":{"value":"no"},"playMusic":{"value":"no"},"registrationPossible":{"value":"yes"},"roomFurniture":{"value":"yes"},"smoking":{"value":"no"},"toilet":{"value":"private"},"totalSize":{"value":"60"},"tv":{"value":"yes"},"washingMachine":{"value":"yes"},"waterCostIncluded":{"value":"yes"},"wheelchairAccessible":{"value":"yes"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":148000,"deposit":150000,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"1480.00","deposit":"1500.00","agencyFee":"0.00","estimatedBills":"0.00"},"minimumStayMonths":1,"moveInWindow":0,"currentOccupancy":0,"minAge":0,"maxAge":0,"preferredGender":"","available":[{"to":"2026-10-30","from":"2026-09-28"},{"to":"9999-12-31","from":"2026-12-20"}],"updated":"2026-09-20T15:45:37Z","__utId__":"ut1740958"}]