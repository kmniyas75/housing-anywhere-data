ssbereich im Freien. Das Stadtzentrum mit seinen Geschäften und Märkten ist nur 5 Gehminuten entfernt. In der anderen Richtung liegt der Wald gleich um die Ecke und bietet endlose Möglichkeiten für ruhige Spaziergänge oder Joggingrunden.\n\nDiese Wohnung wurde kürzlich renoviert und verfügt über ein Schlafzimmer sowie einen sehr geräumigen, offenen Wohnbereich mit Küche, Essbereich und Sofaecke. Die Küche und das Badezimmer sind beide neu renoviert, die Küche ist mit allen modernen Annehmlichkeiten ausgestattet. Zusätzlich gibt auch eine Arbeitsecke mit einem Schreibtisch und schnellem Internetzugang.","facilities":{"airConditioning":{"value":"no"},"allergyFriendly":{"value":"no"},"balconyTerrace":{"value":"private"},"basement":{"value":"no"},"bathroom":{"value":"shared_w_both"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"no"},"bedrooms":{"value":"1"},"closet":{"value":"yes"},"couplesAllowed":{"value":"yes"},"desk":{"value":"yes"},"dishwasher":{"value":"yes"},"dryer":{"value":"no"},"electricityCostIncluded":{"value":"yes"},"flooring":{"value":"wood"},"garden":{"value":"private"},"gasCostIncluded":{"value":"yes"},"heating":{"value":"central"},"internetCostIncluded":{"value":"yes"},"kitchen":{"value":"private"},"kitchenware":{"value":"private"},"livingRoom":{"value":"private"},"parking":{"value":"private"},"pets":{"value":"discussable"},"playMusic":{"value":"discussable"},"registrationPossible":{"value":"yes"},"roomFurniture":{"value":"yes"},"smoking":{"value":"outside_only"},"toilet":{"value":"private"},"totalSize":{"value":"85"},"tv":{"value":"yes"},"washingMachine":{"value":"yes"},"waterCostIncluded":{"value":"yes"},"wheelchairAccessible":{"value":"no"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":120000,"deposit":180000,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"1200.00","deposit":"1800.00","agencyFee":"0.00","estimatedBills":"0.00"},"minimu