gix.net/unit_type/1611917/e7bb96e9-983b-4000-ae8d-47e0fdb35ecf.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","categories":null,"sizes":{"1024x768":{"link":"https://housinganywhere.imgix.net/unit_type/1611917/e7bb96e9-983b-4000-ae8d-47e0fdb35ecf.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/unit_type/1611917/e7bb96e9-983b-4000-ae8d-47e0fdb35ecf.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1611917/e7bb96e9-983b-4000-ae8d-47e0fdb35ecf.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1611917/e7bb96e9-983b-4000-ae8d-47e0fdb35ecf.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1611917/e7bb96e9-983b-4000-ae8d-47e0fdb35ecf.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}},{"originalLink":"https://housinganywhere.imgix.net/unit_type/1611917/62f6c1c0-fd70-4030-bbdb-632d2b3998ce.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","categories":null,"sizes":{"1024x768":{"link":"https://housinganywhere.imgix.net/unit_type/1611917/62f6c1c0-fd70-4030-bbdb-632d2b3998ce.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/unit_type/1611917/62f6c1c0-fd70-4030-bbdb-632d2b3998ce.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1611917/62f6c1c0-fd70-4030-bbdb-632d2b3998ce.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1611917/62f6c1c0-fd70-4030-bbdb-632d2b3998ce.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1611917/62f6c1c0-fd70-4030-bbdb-632d2b3998ce.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"Möbliertes Dachgeschoss-Appartement auf historischem Gutshof / Furnished attic apartment in a historic manor courtyard.\n\n43 qm Appartement mit Doppelbett, Pantryküche inkl. Geschirr, Schreibtisch, WC, Dusche. Komplett eingerichtet mit TV, WLAN. 1. Etage im \"Torhaus\" eines historischen Denkmal-geschützten Gutshofes. Tolles Ambiente mitten im Grünen. \nDieses helle, voll möblierte Appartement befindet sich auf dem historischen, denkmalgeschützten Gut Boisdorf in sehr ruhiger, grüner Lage zwischen Köln und Aachen,  Am Rand der Nordeifel, Düren-Rölsdorf und Lendersdorf.\n\nDie Wohnung liegt im Dachgeschoss des historischen Torhauses und verfügt über ein eigenes Treppenhaus, das nur mit einer weiteren Wohnung geteilt wird. Sie ist komplett möbliert und ausgestattet mit einer eingerichteten Küchenzeile sowie einem Bad mit Dusche und WC.\n\nAuf dem Gutshof leben insgesamt 17 Familien und Singles. Den Bewohnerinnen und Bewohnern stehen ein gemeinschaftlicher Fitness- und Workoutraum zur Verfügung. Zusätzlich können der mediterran anmutende Innenhof mit Platanen und Sitzgelegenheiten, der große parkähnliche Garten sowie die angrenzende Obstwiese mit Tieren genutzt werden. Buslinie, Bäckereien, Café und Supermarkt sind fußläufig erreichbar. Der Bahnhof ist mit dem Fahrrad in ca. zehn Minuten zu erreichen. Alle 20 Minuten mit S-Bahn nach Köln in nur 35 Minuten. Auch Aachen und Jülich sind super gut angebunden\n\nDie Mindestmietdauer beträgt drei Monate. \n\nFurnished attic apartment in a historic manor courtyard.\n\n43 sqm apartment with double bed, kitchenette incl. cookware, desk, WC and shower. Fully furnished and equipped with TV and Wi-Fi. Located on the 1st floor in the “Gatehouse” of a listed historic manor. Wonderful atmosphere surrounded by greenery.\n\nThis bright, fully furnished apartment is located on the historic, listed Gut Boisdorf, in a very quiet and green setting between Cologne and Aachen, on the edge of the Northern Eifel, near Düren-Rölsdorf and Lendersdorf.\n\nThe apartment is situated in the attic of the historic gatehouse and has its own staircase, which is shared with only one other apartment. It is fully furnished and equipped with a fitted kitchenette as well as a bathroom with shower and toilet.\n\nA total of 17 families and singles live on the manor estate. Residents have access to a shared fitness and workout room. In addition, the Mediterranean-style inner courtyard with plane trees and seating areas, the large park-like garden, and the adjacent orchard with animals can be used. Bus line, bakeries, café, and supermarket are within walking distance. The train station can be reached by bicycle in about ten minutes. Suburban trains run every 20 minutes to Cologne, reaching it in just 35 minutes. Aachen and Jülich are also very well connected.\n\nThe minimum rental period is three months.\n\n","facilities":{"airConditioning":{"value":"no"},"allergyFriendly":{"value":"no"},"balconyTerrace":{"value":"shared"},"basement":{"value":"shared"},"bathroom":{"value":"private"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"yes"},"bedrooms":{"value":"0"},"closet":{"value":"yes"},"couplesAllowed":{"value":"no"},"desk":{"value":"yes"},"dishwasher":{"value":"no"},"dryer":{"value":"no"},"electricityCostIncluded":{"value":"yes"},"flooring":{"value":"carpet"},"garden":{"value":"shared"},"gasCostIncluded":{"value":"yes"},"heating":{"value":"gas"},"internetCostIncluded":{"value":"yes"},"kitchen":{"value":"private"},"kitchenware":{"value":"private"},"livingRoom":{"value":"private"},"parking":{"value":"private"},"pets":{"value":"no"},"playMusic":{"value":"no"},"registrationPossible":{"value":"yes"},"roomFurniture":{"value":"yes"},"smoking":{"value":"yes"},"toilet":{"value":"private"},"totalSize":{"value":"42"},"tv":{"value":"yes"},"washingMachine":{"value":"no"},"waterCostIncluded":{"value":"yes"},"wheelchairAccessible":{"value":"no"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":59600,"deposit":0,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"596.00","deposit":"0.00","agencyFee":"0.00","estimatedBills":"0.00"},"minimumStayMonths":3,"moveInWindow":0,"currentOccupancy":0,"minAge":0,"maxAge":0,"preferredGender":"","available":[{"to":"9999-12-31","from":"2026-05-16"}],"updated":"2026-05-16T16:22:07Z","__utId__":"ut1611917"}]