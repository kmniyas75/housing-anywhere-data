[{"id":"1747015","rank":274,"rating":0,"published":"2026-10-19","kind":2,"kindLabel":"private room","type":1,"typeLabel":"house","rentType":"monthly","title":"Laurentiusstraße, Bad Staffelstein","cancellationPolicy":"30d-movein-flexible","marketType":"rental_company","originalLink":"https://housinganywhere.com/room/ut1747015/de/Bad Staffelstein/laurentiusstra-e?utm_source=Stayforall&affiliate_partner_id=260011&utm_content=Bad Staffelstein&utm_medium=affiliate","localizedLinks":{"de":"https://housinganywhere.com/de/room/ut1747015/de/Bad Staffelstein/laurentiusstra-e?utm_medium=affiliate&utm_source=Stayforall&affiliate_partner_id=260011&utm_content=Bad Staffelstein","es":"https://housinganywhere.com/es/room/ut1747015/de/Bad Staffelstein/laurentiusstra-e?utm_medium=affiliate&utm_source=Stayforall&affiliate_partner_id=260011&utm_content=Bad Staffelstein","fr":"https://housinganywhere.com/fr/room/ut1747015/de/Bad Staffelstein/laurentiusstra-e?utm_medium=affiliate&utm_source=Stayforall&affiliate_partner_id=260011&utm_content=Bad Staffelstein","it":"https://housinganywhere.com/it/room/ut1747015/de/Bad Staffelstein/laurentiusstra-e?utm_medium=affiliate&utm_source=Stayforall&affiliate_partner_id=260011&utm_content=Bad Staffelstein","nl":"https://housinganywhere.com/nl/room/ut1747015/de/Bad Staffelstein/laurentiusstra-e?utm_source=Stayforall&affiliate_partner_id=260011&utm_content=Bad Staffelstein&utm_medium=affiliate","pl":"https://housinganywhere.com/pl/room/ut1747015/de/Bad Staffelstein/laurentiusstra-e?utm_medium=affiliate&utm_source=Stayforall&affiliate_partner_id=260011&utm_content=Bad Staffelstein","pt":"https://housinganywhere.com/pt/room/ut1747015/de/Bad Staffelstein/laurentiusstra-e?utm_source=Stayforall&affiliate_partner_id=260011&utm_content=Bad Staffelstein&utm_medium=affiliate","ro":"https://housinganywhere.com/ro/room/ut1747015/de/Bad Staffelstein/laurentiusstra-e?utm_medium=affiliate&utm_source=Stayforall&affiliate_partner_id=260011&utm_content=Bad Staffelstei