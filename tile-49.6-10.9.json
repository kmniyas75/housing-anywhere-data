height":600}}},{"originalLink":"https://housinganywhere.imgix.net/unit_type/1710693/8b9126dc-056b-4eee-8a6c-45ca205220c3.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","categories":null,"sizes":{"1024x768":{"link":"https://housinganywhere.imgix.net/unit_type/1710693/8b9126dc-056b-4eee-8a6c-45ca205220c3.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/unit_type/1710693/8b9126dc-056b-4eee-8a6c-45ca205220c3.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1710693/8b9126dc-056b-4eee-8a6c-45ca205220c3.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1710693/8b9126dc-056b-4eee-8a6c-45ca205220c3.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1710693/8b9126dc-056b-4eee-8a6c-45ca205220c3.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}},{"originalLink":"https://housinganywhere.imgix.net/unit_type/1710693/924043c7-fc8e-4d30-bc16-e0009e0d7b09.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","categories":null,"sizes":{"1024x768":{"link":"https://housinganywhere.imgix.net/unit_type/1710693/924043c7-fc8e-4d30-bc16-e0009e0d7b09.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/unit_type/1710693/924043c7-fc8e-4d30-bc16-e0009e0d7b09.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1710693/924043c7-fc8e-4d30-bc16-e0009e0d7b09.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1710693/924043c7-fc8e-4d30-bc16-e0009e0d7b09.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1710693/924043c7-fc8e-4d30-bc16-e0009e0d7b09.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"Move in and feel at home right away: a fully furnished house with garden perfect for families with kids, surrounded by nature yet just minutes from Erlangen. We are renting out our home for a limited period. The house is located in a quiet, family-friendly cul-de-sac on a spacious property right next to open fields. Nature starts directly behind the house, offering great opportunities for walking, cycling, and relaxing – while Erlangen is easily accessible (bus ~5 minutes walk, ~10 minutes ride, ~20 minutes by bike). The house The house offers approx. 125 m2 of living space with 5 rooms plus an attic studio with the opportunity to use as a home office. The bright living area includes a dining table for up to 6 people and a large sofa that can also be used as a sofa bed. There is no TV, creating a calm and relaxed atmosphere. The kitchen was renovated in 2023 and is fully equipped, including a Quooker system providing boiling, chilled, and sparkling water. One room on the ground floor is currently used as a playroom. Toys and books and other childrens stuff can be left in the house if desired. Sleeping & working Upstairs you will find a master bedroom with a 2×2 m bed and built-in wardrobe, a children’s room with a bunk bed, and another room with a 1.40 m bed. The bathroom includes a bathtub and a beautiful view over the fields. The attic studio offers two desks and a sofa bed, making it ideal for working from home or hosting guests. Basement & features The basement includes a laundry room (with two washing machines, one with dryer function), storage space, a hobby/workshop room, and utility rooms. One room will remain locked for private storage. Additional features include solar panels (installed in 2024), internet and phone connection, and satellite TV access. Garden & outdoor area The garden opens directly onto fields and is perfect for relaxing. For children, there is a sandbox, a swing, a slide, and a small wooden play tower in the back. A small fire bowl is also available and can be used – we simply ask that any fire is handled responsibly and never left unattended. Smoking is not permitted inside the house, but is of course allowed in the garden and outdoor areas. The garage is mainly used for bicycles and garden equipment. There is a parking space on the property and additional parking in the quiet street. Location & neighborhood The neighborhood is quiet, friendly, and family-oriented. The immediate neighbors are very kind and happy to help if needed – for example, a spare key can easily be left with them. Shops, bakery, school, and medical services are located within the village. A swimming lake is about a 20-minute walk away. There are two kindergarten nearby and an elementary school in walking distance.\n","facilities":{"airConditioning":{"value":"no"},"balconyTerrace":{"value":"private"},"basement":{"value":"private"},"bathroom":{"value":"private"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"no"},"bedrooms":{"value":"3"},"closet":{"value":"yes"},"couplesAllowed":{"value":"yes"},"desk":{"value":"yes"},"dishwasher":{"value":"yes"},"dryer":{"value":"yes"},"electricityCostIncluded":{"value":"yes"},"flooring":{"value":"laminate"},"garden":{"value":"private"},"gasCostIncluded":{"value":"yes"},"heating":{"value":"central"},"internetCostIncluded":{"value":"yes"},"kitchen":{"value":"private"},"kitchenware":{"value":"private"},"livingRoom":{"value":"private"},"parking":{"value":"private"},"pets":{"value":"discussable"},"playMusic":{"value":"yes"},"registrationPossible":{"value":"yes"},"roomFurniture":{"value":"yes"},"smoking":{"value":"outside_only"},"tenantStatus":{"value":"working professionals only"},"toilet":{"value":"private"},"totalSize":{"value":"128"},"tv":{"value":"no"},"washingMachine":{"value":"yes"},"waterCostIncluded":{"value":"yes"},"wheelchairAccessible":{"value":"no"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":215000,"deposit":300000,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"2150.00","deposit":"3000.00","agencyFee":"0.00","estimatedBills":"0.00"},"minimumStayMonths":6,"moveInWindow":0,"currentOccupancy":0,"minAge":0,"maxAge":0,"preferredGender":"","available":[{"to":"2027-07-31","from":"2026-10-23"},{"to":"9999-12-31","from":"2028-01-01"}],"updated":"2026-06-08T15:11:45Z","__utId__":"ut1710693"}]