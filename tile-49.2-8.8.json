net/unit_type/1667835/d2ba4d38-15f2-4147-9983-7195c8db3da2.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","categories":null,"sizes":{"1024x768":{"link":"https://housinganywhere.imgix.net/unit_type/1667835/d2ba4d38-15f2-4147-9983-7195c8db3da2.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/unit_type/1667835/d2ba4d38-15f2-4147-9983-7195c8db3da2.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1667835/d2ba4d38-15f2-4147-9983-7195c8db3da2.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1667835/d2ba4d38-15f2-4147-9983-7195c8db3da2.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1667835/d2ba4d38-15f2-4147-9983-7195c8db3da2.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}},{"originalLink":"https://housinganywhere.imgix.net/unit_type/1667835/cef50eb5-4c83-482b-b4cf-dd602514083d.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","categories":["livingroom"],"sizes":{"1024x768":{"link":"https://housinganywhere.imgix.net/unit_type/1667835/cef50eb5-4c83-482b-b4cf-dd602514083d.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/unit_type/1667835/cef50eb5-4c83-482b-b4cf-dd602514083d.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1667835/cef50eb5-4c83-482b-b4cf-dd602514083d.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1667835/cef50eb5-4c83-482b-b4cf-dd602514083d.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1667835/cef50eb5-4c83-482b-b4cf-dd602514083d.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"Frisch renoviert, hochwertig ausgestattet und liebevoll eingerichtet - bei jedem Schritt warst Du als Gast in unserem Kopf.\nUnser zwei Zimmer Apartment in Sinsheim-Dühren enthält alles was Dein Herz für einen Kurz- oder Langzeitaufenthalt benötigt.\n\nNachdem Check-in über das elektronische Türschloss, findest du im Eingangsbereich eine Garderobe mit Sitzbank, einen Wandspiegel, eine Schuhmatte und zwei Regenschirme frei zu Deiner Verfügung.\n\nDirekt links findest Du den ersten Raum und das Herzstück jeder Übernachtung - das Schlafzimmer. Ausgestattet mit einem Kingsize Bett (180x200) und einer orthopädischen Premium 7-Zonen-Matratze für optimalen Schlafkomfort. Zudem gibt es einen Standspiegel und einen Garderobenschrank für jeden Kleidungsstil. Ebenso stellen wir ein Bügelbrett, Bügeleisen und weitere wichtige Utensilien bereit - schaue hierzu gerne in unseren Ausstattungsmerkmalen nach!\n\nZurück im Flur führt Dich der Gang weiter in Richtung Wohnzimmer und besticht durch Design-Elemente, welche Ruhe und Erholung ausstrahlen. Uns ist wichtig, dass Du Dich wie Zuhause fühlst.\n\nDas nächste Zimmer links ist unser neues Badezimmer. Ein klares Highlight ist die integrierte Regenschauer-Dusche mit genügend Wasserdruck. Zudem gibt es einen Kosmetikspiegel, einen Föhn und Qualitäts-Pflegeprodukte von Prija, welche Du gerne für Deinen Aufenthalt verwenden darfst.\n\nDas Wohnzimmer beginnt mit einem stimmigen Wohn-Essbereich und einem großen Esstisch an dem vier Personen Platz nehmen können. Die offene Küche sticht durch ihren Theken-Ausschnitt hervor, welcher Tageslicht einbringt. Die Küche ist voll ausgestattet. Du findest dort u.a. Herd, Kühlschrank, Gefrierschrank, Spülmaschine, Mikrowelle, Wasserkocher, Messerblock und alles was Du sonst noch brauchst, um lecker zu kochen. Auf dem Tresen gibt es auch eine Kaffee-Station. Hier stellen wir Kaffee & Kaffeesahne, Zucker und einige beliebte Teesorten für Dich bereit. \n\nDas gemütliche Sofa und der 4k Smart-TV runden den Wohnraum ab.\nZudem bietet die Wohnung mit dem bequemen Schlafsofa auch Platz für\neinen dritten und vierten Gast.\nDer Hängesessel in der Ecke des Wohnzimmers lädt zum gemütlichen Verweilen ein. Im Wohnbereich gelangst Du auch auf den großzügigen Balkon mit Sitzgelegenheiten. Die Balkontür ist mit einer professionellen Fliegengittertür (Moskitonetz) ausgestattet, ebenso wie mindestens ein Fenster in jedem Raum dieser Unterkunft.","facilities":{"airConditioning":{"value":"no"},"allergyFriendly":{"value":"no"},"balconyTerrace":{"value":"private"},"basement":{"value":"no"},"bathroom":{"value":"private"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"yes"},"bedrooms":{"value":"1"},"closet":{"value":"yes"},"couplesAllowed":{"value":"yes"},"desk":{"value":"yes"},"dishwasher":{"value":"yes"},"dryer":{"value":"yes"},"electricityCostIncluded":{"value":"yes"},"flooring":{"value":"plastic"},"garden":{"value":"no"},"gasCostIncluded":{"value":"yes"},"heating":{"value":"central"},"internetCostIncluded":{"value":"yes"},"kitchen":{"value":"private"},"kitchenware":{"value":"private"},"livingRoom":{"value":"private"},"parking":{"value":"private"},"pets":{"value":"discussable"},"playMusic":{"value":"discussable"},"registrationPossible":{"value":"yes"},"roomFurniture":{"value":"yes"},"smoking":{"value":"outside_only"},"toilet":{"value":"private"},"totalSize":{"value":"62"},"tv":{"value":"yes"},"washingMachine":{"value":"yes"},"waterCostIncluded":{"value":"yes"},"wheelchairAccessible":{"value":"no"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":130000,"deposit":150000,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"1300.00","deposit":"1500.00","agencyFee":"0.00","estimatedBills":"0.00"},"minimumStayMonths":1,"moveInWindow":0,"currentOccupancy":0,"minAge":0,"maxAge":0,"preferredGender":"","available":[{"to":"9999-12-31","from":"2026-05-18"}],"updated":"2026-05-18T04:03:06Z","__utId__":"ut1667835"}]