":"https://housinganywhere.imgix.net/unit_type/1653498/8b3ef26a-a0b5-4c3c-a192-4dee74f5403a.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1653498/8b3ef26a-a0b5-4c3c-a192-4dee74f5403a.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1653498/8b3ef26a-a0b5-4c3c-a192-4dee74f5403a.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"This charming house with a beautiful fenced garden is located 20 minutes by car from Überlingen on Lake Constance.\n\nIt has two bedrooms with two beds: each has a 140 cm and a 90 cm bed. It has two bathrooms. One has a shower, the other a bathtub with shower attachment. There is a fully equipped kitchen with a dishwasher, microwave, coffee machine and toaster, fridge and freezer. Upstairs there is a cosy TV corner. Downstairs there is a washing machine and a pantry.\n\nThe wonderful garden is completely fenced in and it is a pleasure to sit on the balcony and look out over it.\n\nThere is a garage and public parking space directly behind the house, from where you can access the garden through a small gate.\n\nThe house is a 20-minute drive from Überlingen and a 10-minute drive from Pfullendorf with all its supermarkets and the beautiful Pfullendorf Seepark. It is a 5-minute drive from Herdwangen Schönach, where there is a bakery and a village shop.\n\nUp to two well-behaved dogs are welcome. If you have more, please contact us in advance. The house is located in the immediate vicinity of a forest and is therefore ideal for hiking.\n\nThe house is more suitable for adults and older children, as there is an indoor balcony overlooking the living room, which could be dangerous if children climb on it. ","facilities":{"airConditioning":{"value":"no"},"allergyFriendly":{"value":"no"},"balconyTerrace":{"value":"private"},"basement":{"value":"private"},"bathroom":{"value":"private"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"no"},"bedrooms":{"value":"2"},"closet":{"value":"yes"},"couplesAllowed":{"value":"yes"},"desk":{"value":"yes"},"dishwasher":{"value":"yes"},"dryer":{"value":"yes"},"electricityCostIncluded":{"value":"no"},"flooring":{"value":"carpet"},"garden":{"value":"private"},"gasCostIncluded":{"value":"no"},"heating":{"value":"central"},"internetCostIncluded":{"value":"yes"},"kitchen":{"value":"private"},"kitchenware":{"value":"private"},"livingRoom":{"value":"private"},"parking":{"value":"private"},"pets":{"value":"discussable"},"playMusic":{"value":"yes"},"registrationPossible":{"value":"yes"},"roomFurniture":{"value":"yes"},"smoking":{"value":"no"},"toilet":{"value":"private"},"totalSize":{"value":"100"},"tv":{"value":"yes"},"washingMachine":{"value":"yes"},"waterCostIncluded":{"value":"no"},"wheelchairAccessible":{"value":"no"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":370000,"deposit":370000,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"3700.00","deposit":"3700.00","agencyFee":"0.00","estimatedBills":"0.00"},"minimumStayMonths":0,"moveInWindow":0,"currentOccupancy":0,"minAge":18,"maxAge":0,"preferredGender":"","available":[{"to":"2026-08-07","from":"2026-08-07"},{"to":"2026-08-28","from":"2026-08-16"},{"to":"2026-10-10","from":"2026-09-04"},{"to":"2027-12-31","from":"2026-10-21"},{"to":"9999-12-31","from":"2028-02-08"}],"updated":"2026-08-07T22:14:16Z","__utId__":"ut1653498"}]