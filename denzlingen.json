 authorities\n\nNo smoking, no pets\n\nUpon request: linen package (bed linen + towels) available for a one-time fee of €50\n\nAmenities:\n\nFully equipped kitchen\nSenseo coffee machine\nMicrowave\nStove with oven\nBasic cookware and dishes\nWi-Fi\nWashing machine (shared, in utility room of main building)\nPrivate terrace\n\n\nFeel free to contact me if you have any  questions\n\nSonstiges\nContact via email","facilities":{"airConditioning":{"value":"no"},"allergyFriendly":{"value":"no"},"balconyTerrace":{"value":"private"},"basement":{"value":"no"},"bathroom":{"value":"private"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"no"},"bedrooms":{"value":"1"},"closet":{"value":"yes"},"couplesAllowed":{"value":"no"},"desk":{"value":"yes"},"dishwasher":{"value":"no"},"dryer":{"value":"no"},"electricityCostIncluded":{"value":"yes"},"flooring":{"value":"laminate"},"garden":{"value":"no"},"gasCostIncluded":{"value":"no"},"heating":{"value":"central"},"internetCostIncluded":{"value":"yes"},"kitchen":{"value":"private"},"kitchenware":{"value":"private"},"livingRoom":{"value":"private"},"parking":{"value":"no"},"pets":{"value":"no"},"playMusic":{"value":"no"},"registrationPossible":{"value":"yes"},"roomFurniture":{"value":"yes"},"smoking":{"value":"outside_only"},"toilet":{"value":"private"},"totalSize":{"value":"40"},"tv":{"value":"yes"},"washingMachine":{"value":"yes"},"waterCostIncluded":{"value":"yes"},"wheelchairAccessible":{"value":"no"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":95000,"deposit":95000,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"950.00","deposit":"950.00","agencyFee":"0.00","estimatedBills":"0.00"},"minimumStayMonths":2,"moveInWindow":0,"currentOccupancy":0,"minAge":20,"maxAge":0,"preferredGender":"","available":[{"to":"9999-12-31","from":"2027-01-07"}],"updated":"2026-03-30T10:58:09Z","__utId__":"ut1660105"}]