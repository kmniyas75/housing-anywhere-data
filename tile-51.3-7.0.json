62204-91dc-4ef8-8f2f-e906cf6562e0.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}},{"originalLink":"https://housinganywhere.imgix.net/unit_type/1749523/16995206-6e8c-493b-b33d-5ceb284a6d59.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","categories":null,"sizes":{"1024x768":{"link":"https://housinganywhere.imgix.net/unit_type/1749523/16995206-6e8c-493b-b33d-5ceb284a6d59.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/unit_type/1749523/16995206-6e8c-493b-b33d-5ceb284a6d59.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1749523/16995206-6e8c-493b-b33d-5ceb284a6d59.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1749523/16995206-6e8c-493b-b33d-5ceb284a6d59.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1749523/16995206-6e8c-493b-b33d-5ceb284a6d59.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"Welcome to this freshly furnished apartment in a desirable location in Essen-Werden. Both the charming old town and Folkwang University of the Arts are within easy walking distance. The apartment offers a peaceful living environment while being conveniently located close to everything you need.\n\nThe apartment also benefits from excellent public transport connections. Essen-Werden S-Bahn station is just a few minutes' walk away, with connections to Essen Central Station (approx. 10 minutes) and Düsseldorf Central Station (approx. 30 minutes).\n\nSituated on the first floor of a well-maintained building, the apartment features bright interiors, parquet flooring and a charming little balcony where you can enjoy the afternoon sun. \n\nThe fully equipped kitchen has everything you need for everyday living, including a Nespresso machine, toaster and kettle. High-speed Wi-Fi and a dedicated workspace make the apartment ideal for working from home, business stays or studying.\n\nA washing machine and tumble dryer are available in the building.\n\nThe peaceful atmosphere and friendly neighborhood make this apartment a comfortable place to call home. It is particularly well suited to professionals, visiting lecturers, students and anyone looking for a comfortable temporary home in Essen-Werden.\n\nWe look forward to welcoming tenants who will appreciate the apartment and its well-maintained surroundings.","facilities":{"airConditioning":{"value":"no"},"allergyFriendly":{"value":"yes"},"balconyTerrace":{"value":"private"},"basement":{"value":"private"},"bathroom":{"value":"private"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedrooms":{"value":"0"},"closet":{"value":"yes"},"couplesAllowed":{"value":"yes"},"desk":{"value":"yes"},"dishwasher":{"value":"yes"},"dryer":{"value":"yes"},"electricityCostIncluded":{"value":"yes"},"flooring":{"value":"wood"},"garden":{"value":"no"},"gasCostIncluded":{"value":"yes"},"heating":{"value":"central"},"internetCostIncluded":{"value":"yes"},"kitchen":{"value":"private"},"kitchenware":{"value":"private"},"livingRoom":{"value":"private"},"parking":{"value":"no"},"pets":{"value":"yes"},"playMusic":{"value":"yes"},"roomFurniture":{"value":"yes"},"smoking":{"value":"no"},"toilet":{"value":"private"},"totalSize":{"value":"33"},"tv":{"value":"yes"},"washingMachine":{"value":"yes"},"waterCostIncluded":{"value":"yes"},"wheelchairAccessible":{"value":"no"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":139000,"deposit":0,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"1390.00","deposit":"0.00","agencyFee":"0.00","estimatedBills":"0.00"},