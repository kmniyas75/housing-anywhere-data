26cb-4432-9a13-42d10eae2e26.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1336801/2672bd52-26cb-4432-9a13-42d10eae2e26.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"The property is a house in a quiet and safe part of Gronau, directly at the boarder to the Netherlands. The train station is 10 minutes away by bike and you have a direct train connection to Enschede Central Station. Alternatively you can take the bus (bus stops across the street) to the Gronau train station. You can also cycle to the boarder and take the Bus/train from there. You have all the important shopping facilities in the immediate vicinity (Grocery Stores, Gym etc.).The house is furnished with a fitted kitchen and has a large living room. The Bedrooms are rented unfurnished.  There are parking spaces for cars and a shelter for bicycles. There are no extra costs (electricity costs etc. included).\nThe kitchen is fully equipped with all the important things like a dishwasher etc. and a kitchen table with space for four persons. The bathroom has a washing machine, a bath tub, a shower and two sinks. You can rent the rooms immediately. They are between 16 to 28m2.\n\nPrize: (hidden)€ incl. G/E/W\n\nWe are supporting students from Saxion and other universities for more than 10 years. If you are looking for a furnished room, we would also find a solution. ","facilities":{"airConditioning":{"value":"no"},"allergyFriendly":{"value":"no"},"balconyTerrace":{"value":"private"},"basement":{"value":"shared"},"bathroom":{"value":"shared_w_girls"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"yes"},"bedroomSize":{"value":"24"},"bedrooms":{"value":"1"},"closet":{"value":"yes"},"couplesAllowed":{"value":"no"},"desk":{"value":"yes"},"dishwasher":{"value":"yes"},"dryer":{"value":"no"},"electricityCostIncluded":{"v