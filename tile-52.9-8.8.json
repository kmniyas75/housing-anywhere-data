format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1720169/33b7890c-b676-4b10-bc0a-ef25db52e3aa.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"Design-Apartment auf Zeit – exklusiv, möbliert und sofort bezugsbereit\n\nDieses hochwertig ausgestattete Design-Apartment richtet sich an eine Person – ideal für internationale Fach- und Führungskräfte, Projektmitarbeitende oder Mitarbeitende, deren Unterkunft vom Arbeitgeber organisiert wird. Wer für einen begrenzten Zeitraum in der Region arbeitet und eine stilvolle Alternative zum Hotel sucht, findet hier ein Zuhause mit Privatsphäre und hohem Wohnkomfort.\n\nDas Apartment verfügt über einen eigenen Eingang und ist vollständig möbliert. Zur Ausstattung gehören maßgefertigte Einbaumöbel mit deckenhohem Kleiderschrank, massive Eichenholzdielen, natürliche Tonputzwände, eine voll ausgestattete Teeküche und eigene Waschmaschine, ein komfortables 1,20-m-Bett sowie ein hochwertiges Bad aus Moleanos-Naturstein mit Dusche.\n\nAls Bewohner des Hauses können Sie außerdem die gemeinschaftliche Outdoor-Webergrill-Kitchen mit Sitzbereich im Garten mitbenutzen – ideal zum Kochen, Essen oder Entspannen an warmen Tagen. Im Apartmenthaus wohnen insgesamt nur wenige Parteien, wodurch eine ruhige und angenehme Atmosphäre entsteht.\n\nDie Lage ist hervorragend: Der Marktplatz mit Restaurants, Cafés und Einkaufsmöglichkeiten ist in wenigen Gehminuten erreichbar. Der Bahnhof ist ebenfalls nur wenige Minuten entfernt; von dort gelangen Sie in etwa zehn Minuten zum Bremer Hauptbahnhof.\n\nMietdauer: 12 bis 24 Monate. Die Warmmiete umfasst die vollständige Möblierung. Das Apartment ist sofort bezugsbereit – Koffer auspacken und einziehen.","facilities":{"airConditioning":{"value":"no"},"allergyFriendly":{"value":"yes"},"balconyTerrace":{"value":"shared"},"basement":{"value":"no"},"bathroom":{"value":"private"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"yes"},"bedrooms":{"value":"1"},"closet":{"value":"yes"},"couplesAllowed":{"value":"no"},"desk":{"value":"no"},"dishwasher":{"value":"no"},"dryer":{"value":"no"},"electricityCostIncluded":{"value":"yes"},"flooring":{"value":"wood"},"garden":{"value":"shared"},"gasCostIncluded":{"value":"yes"},"heating":{"value":"gas"},"internetCostIncluded":{"value":"yes"},"kitchen":{"value":"private"},"kitchenware":{"value":"private"},"livingRoom":{"value":"no"},"parking":{"value":"private"},"pets":{"value":"no"},"playMusic":{"value":"yes"},"registrationPossible":{"value":"yes"},"roomFurniture":{"value":"no"},"smoking":{"value":"no"},"toilet":{"value":"private"},"totalSize":{"value":"20"},"tv":{"value":"no"},"washingMachine":{"value":"yes"},"waterCostIncluded":{"value":"yes"},"wheelchairAccessible":{"value":"no"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":68000,"deposit":204000,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"680.00","deposit":"2040.00","agencyFee":"0.00","estimatedBills":"0.00"},"minimumStayMonths":0,"moveInWindow":0,"currentOccupancy":0,"minAge":0,"maxAge":0,"preferredGender":"","available":[{"to":"9999-12-31","from":"2026-06-26"}],"updated":"2026-06-26T20:20:31Z","__utId__":"ut1720169"}]