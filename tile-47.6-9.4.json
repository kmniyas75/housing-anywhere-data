ix.net/unit_type/1659806/8636ebf9-c69f-4708-b7af-128db83412e6.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1659806/8636ebf9-c69f-4708-b7af-128db83412e6.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1659806/8636ebf9-c69f-4708-b7af-128db83412e6.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}},{"originalLink":"https://housinganywhere.imgix.net/unit_type/1659806/4081fad1-0a15-4cae-9d6a-253e764498a6.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","categories":null,"sizes":{"1024x768":{"link":"https://housinganywhere.imgix.net/unit_type/1659806/4081fad1-0a15-4cae-9d6a-253e764498a6.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/unit_type/1659806/4081fad1-0a15-4cae-9d6a-253e764498a6.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1659806/4081fad1-0a15-4cae-9d6a-253e764498a6.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1659806/4081fad1-0a15-4cae-9d6a-253e764498a6.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1659806/4081fad1-0a15-4cae-9d6a-253e764498a6.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"Sehr helle, 75m2 große Wohnung im Erdgeschoß eines freistehenden Zweifamilienhauses. Alle Zimmer komplett eingerichtet mit vom Schreiner gefertigten Massivholzmöbeln, bestehend aus Bett, Schrank, Nachttisch, Schreibtisch und Rollcontainer mit 4 Schubkasten. 25 m2 großes Wohn - Esszimmer, mit Massivholztisch, 5 Stühlen, Sideboard, Klappsofa, Küche, bestehend aus Kühlschrank mit Gefrierfach, Backofen, Glaskeramik-Kochfeld, Vorratsschränken. Die Raumtrennung zwischen Küche und Wohnzimmer besteht aus einer Sitztheke mit 3 Barhockern. Garderobe. Bad mit Eck-Runddusche , Waschmaschine , Spiegelschrank. Separates WC. Schließanlage vorhanden. Die Wohnungsausrichtung ist Süd - Südwest mit traumhafter, unverbauter Berg- und Seesicht, mitten im Grünen auf einer Anhöhe in absolut ruhiger Lage, nahe am Waldrand. Die Aussicht ist überwältigend. Wer die Ruhe und Natur liebt, jedoch nicht die Abgeschiedenheit, der fühlt sich hier wohl. Die Wohnung ist durch eine eigene Haustüre zu erreichen. 20m2 große Sonnenterrasse. Eigener Parkplatz, direkt am Haus. Überdachter Fahrradstellplatz. ~3,5 KM zu den Unis","facilities":{"airConditioning":{"value":"no"},"allergyFriendly":{"value":"yes"},"balconyTerrace":{"value":"shared"},"basement":{"value":"no"},"bathroom":{"value":"shared_w_both"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"yes"},"bedroomSize":{"value":"12"},"bedrooms":{"value":"1"},"cleaningCommonRoomsIncluded":{"value":"no"},"cleaningPrivateRoomIncluded":{"value":"no"},"closet":{"value":"yes"},"couplesAllowed":{"value":"no"},"desk":{"value":"yes"},"dishwasher":{"value":"no"},"dryer":{"value":"no"},"electricityCostIncluded":{"value":"yes"},"flooring":{"value":"laminate"},"garden":{"value":"shared"},"gasCostIncluded":{"value":"yes"},"gender":{"value":"male"},"heating":{"value":"central"},"housematesGender":{"value":"shared_w_boys"},"internet":{"value":"yes"},"internetCostIncluded":{"value":"yes"},"kitchen":{"value":"shared"},"kitchenware":{"value":"shared"},"livingRoom":{"value":"shared"},"parking":{"value":"private"},"pets":{"value":"no"},"playMusic":{"value":"discussable"},"registrationPossible":{"value":"yes"},"roomFurniture":{"value":"yes"},"smoking":{"value":"outside_only"},"toilet":{"value":"shared"},"totalSize":{"val