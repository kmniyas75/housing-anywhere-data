296e5daa9.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1741459/8e03a13a-4c1e-4f8b-b89c-805296e5daa9.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1741459/8e03a13a-4c1e-4f8b-b89c-805296e5daa9.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1741459/8e03a13a-4c1e-4f8b-b89c-805296e5daa9.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"9-Bedroom Corporate Apartment | Teams & Professionals | Simbach\n\nThis spacious and modern apartment at Adolf-Kolping-Straße offers comfortable accommodation for up to 9 residents and is particularly well suited for professionals, project teams, interns, business travelers and groups looking for a practical home for a longer stay.\n\nThe apartment combines generous private space with functional shared areas. Residents benefit from fast Wi-Fi, a fully equipped kitchen, practical working areas and a comfortable environment designed for everyday living.\n\nThe Apartment\n\nThe property features 9 separate bedrooms, providing each resident with their own private space while sharing the main facilities of the apartment.\n\nThe accommodation includes:\n\n• 9 private bedrooms\n• Fully equipped kitchen\n• High-speed Wi-Fi\n• Work-friendly spaces\n• Furnished living areas\n• Practical storage options\n• Comfortable setup for medium- and long-term stays\n\nThe layout makes the apartment especially suitable for employees working on temporary assignments, companies accommodating project teams, interns and professionals relocating to the region.\n\nLocation\n\nThe apartment is located in Adolf-Kolping-Straße in central Simbach am Inn. The town centre and everyday amenities are within short walking distance. Supermarkets, bakeries, pharmacies, restaurants, cafés and other services can be reached conveniently without a car. Local property information for Adolf-Kolping-Straße indicates that both the town centre and supermarket shopping are approximately a 5-minute walk away. \n\nOne of the main advantages of the location is its proximity to Braunau am Inn in Austria. Simbach and Braunau form a closely connected cross-border area, giving residents convenient access to workplaces, shopping and services on both the German and Austrian sides of the border. (Braunau.Simbach.Inn)\n\nTransport & Connections\n\nSimbach (Inn) railway station is within walking distance of the property. The station provides regional rail connections towards Mühldorf am Inn and Munich, making the apartment practical for professionals travelling within southeastern Bavaria. (Bahnhof)\n\nBy car, Simbach offers convenient access via the B12 and A94, connecting the area towards Mühldorf and Munich. The nearby border crossing also provides direct access to Braunau am Inn and Upper Austria. (Immobilien Hasler)\n\nCurrent rail connections also make longer-distance travel practical. Connections from Simbach towards Munich operate via the Südostbayernbahn network, while Salzburg can be reached by train with connections from Simbach. (Südbayernbahn)\n\nIdeal For Longer Stays\n\nWith 9 individual bedrooms, reliable internet and a central location close to transport and everyday services, this apartment offers a practical and comfortable solution for professionals, employees, project teams and other residents looking for accommodation in Simbach am Inn for several months.","facilities":{"airConditioning":{"value":"no"},"bathroom":{"value":"shared_w_both"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"yes"},"bedrooms":{"value":"8+"},"closet":{"value":"yes"},"couplesAllowed":{"value":"yes"},"desk":{"value":"yes"},"dishwasher":{"value":"yes"},"dryer":{"value":"no"},"electricityCostIncluded":{"value":"yes"},"flooring":{"value":"laminate"},"gasCostIncluded":{"value":"yes"},"heating":{"value":"gas"},"internetCostIncluded":{"value":"yes"},"kitchen":{"value":"private"},"kitchenware":{"value":"private"},"pets":{"value":"yes"},"playMusic":{"value":"yes"},"roomFurniture":{"value":"no"},"smoking":{"value":"outside_only"},"toilet":{"value":"private"},"totalSize":{"value":"250"},"tv":{"value":"no"},"washingMachine":{"value":"yes"},"waterCostIncluded":{"value":"yes"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":450000,"deposit":900000,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"4500.00","deposit":"9000.00","agencyFee":"0.00","estimatedBills":"0.00"},"minimumStayMonths":3,"moveInWindow":15,"currentOccupancy":0,"minAge":18,"maxAge":0,"preferredGender":"","available":[{"to":"9999-12-31","from":"2026-09-22"}],"updated":"2026-09-22T00:11:03Z","__utId__":"ut1741459"}]