at%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/room/1766100/99644fca-45d0-4cc5-8fa0-642a3c9c6788.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/room/1766100/99644fca-45d0-4cc5-8fa0-642a3c9c6788.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}},{"originalLink":"https://housinganywhere.imgix.net/room/1766100/19d6cbd6-9789-4aa6-aa62-86015555e2f4.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","categories":["floorplan"],"sizes":{"1024x768":{"link":"https://housinganywhere.imgix.net/room/1766100/19d6cbd6-9789-4aa6-aa62-86015555e2f4.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/room/1766100/19d6cbd6-9789-4aa6-aa62-86015555e2f4.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/room/1766100/19d6cbd6-9789-4aa6-aa62-86015555e2f4.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/room/1766100/19d6cbd6-9789-4aa6-aa62-86015555e2f4.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/room/1766100/19d6cbd6-9789-4aa6-aa62-86015555e2f4.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"You can find our barrier-free apartment ME 2 on the ground floor. When furnishing in the maritime style, we paid special attention to seniors and people with physical disabilities: barrier-free access, of course contactless; large spaces to move around in the combined living room / kitchen area; Bathroom and terrace particularly easy to reach; Everyday objects easily accessible and usable. Of course, comfort and health are not neglected, as in all of our apartments with carpet tiles suitable for allergy sufferers and electronically controlled heating, which can be preheated.\n\nIdeally suited for 2 people.\n\nSize: 50 m2, bedroom with adjoining bathroom, combined area for living, kitchen and dining, terrace, barrier-free access\nBOX SPRING BED 180 x 200 cm\n\nIn the apartment you get:\nChildren up to 6 free\nFree, safe & fast WIFI\nelectronic heating control, preheatable\nTowels\nBed linen\nBlankets & pillows \nIroning station\nHair dryer\nVarious hygiene items\nMineral water\nCoffee machine with coffee\nWashing machine and dryer in the central reception area\nFree parking in front of the house\n\nbedroom\n\nCarpet tiles, suitable for allergy sufferers\nBOX SPRING BED 180 x 200 cm, can also be set up as a twin bed\nOpen wardrobe\nBedside tables with USB sockets for charging mobile phones\nBedside lamps\nAccess to the sundeck terrace\nFloor-to-ceiling curtains in maritime style\n\nbathroom\n\nHerringbone floor tiles\nFloor-level shower with handle and shower chair\nVanity unit with a large mirror\nToilet with grab rails\nSurface heating element with towel dryer\nFirst aid kit (in the bathroom)\n\nCombined living / kitchen area\n\nCarpet tiles, suitable for allergy sufferers\nFloor-to-ceiling curtains in maritime style\n3-seater sofa with coffee table, 2-part\nSmart TV with German / international channels and multimedia\nLighting complete with LED, dimmable, color mood adjustable\n\nLarge areas of movement\nCountertop with sink\nCeramic hob with extractor hood\noven\nmicrowave\nFridge freezer\nCoffee machine with beans\nKettle, egg boiler, toaster, mixer and other kitchen appliances\nCutlery, dishes and glasses\nPots, pans, spices\nOil & vinegar\nDining table with 2 chairs\n\nKeyless, barrier-free access via the Nuki app or code entry\n\nPlease be aware that HousingAnywhere is an online booking platform. Therefore exchanging contact details and offering viewings is not possible. If you would like to reserve this accommodation, send me a booking request or a message and please mention your age and occupation. I look forward to meeting you!","facilities":{"allergyFriendly":{"value":"yes"},"balconyTerrace":{"value":"private"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedrooms":{"value":"1"},"couplesAllowed":{"value":"yes"},"dishwasher":{"value":"yes"},"electricityCostIncluded":{"value":"no"},"flooring":{"value":"wood"},"gasCostIncluded":{"value":"no"},"heating":{"value":"central"},"internetCostIncluded":{"value":"yes"},"kitchen":{"value":"private"},"kitchenware":{"value":"private"},"livingRoom":{"value":"private"},"parking":{"value":"shared"},"pets":{"value":"no"},"playMusic":{"value":"discussable"},"roomFurniture":{"value":"yes"},"smoking":{"value":"no"},"toilet":{"value":"private"},"totalSize":{"value":"50"},"washingMachine":{"value":"yes"},"waterCostIncluded":{"value":"yes"},"wheelchairAccessible":{"value":"yes"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":240000,"deposit":0,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"2400.00","deposit":"0.00","agencyFee":"0.00","estimatedBills":"0.00"},"minimumStayMonths":0,"moveInWindow":0,"currentOccupancy":0,"minAge":0,"maxAge":0,"preferredGender":"","available":[{"to":"9999-12-31","from":"2026-03-30"}],"updated":"2026-03-30T10:20:54Z","__utId__":"ut1119354"},{"id":"1119447","rank":-40,"rating":0,"published":"2021-12-13","kind":1,"kindLabel":"entire place","type":3,"typeLabel":"apartment","rentType":"monthly","title":"Elberfelder Straße, Mettmann","cancellationPolicy":"strict","marketType":"rental_company","originalLink":"https://housinganywhere.com/room/ut1119447/de/Mettmann/elberfelder-stra-e?utm_medium=affiliate&utm_source=Stayforall&affiliate_partner_id=260011&utm_content=Mettmann","localizedLinks":{"de":"https://housinganywhere.com/de/room/ut1119447/de/Mettmann/elbe