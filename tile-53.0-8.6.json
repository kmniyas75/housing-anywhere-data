=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","categories":["bathroom"],"sizes":{"1024x768":{"link":"https://housinganywhere.imgix.net/unit_type/1696788/3aa54868-caec-4fee-8e02-bd97749743d2.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/unit_type/1696788/3aa54868-caec-4fee-8e02-bd97749743d2.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1696788/3aa54868-caec-4fee-8e02-bd97749743d2.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1696788/3aa54868-caec-4fee-8e02-bd97749743d2.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1696788/3aa54868-caec-4fee-8e02-bd97749743d2.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}},{"originalLink":"https://housinganywhere.imgix.net/unit_type/1696788/95ec68a0-d4d3-4126-83ed-3766b5fe6ce0.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","categories":["bathroom"],"sizes":{"1024x768":{"link":"https://housinganywhere.imgix.net/unit_type/1696788/95ec68a0-d4d3-4126-83ed-3766b5fe6ce0.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/unit_type/1696788/95ec68a0-d4d3-4126-83ed-3766b5fe6ce0.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1696788/95ec68a0-d4d3-4126-83ed-3766b5fe6ce0.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1696788/95ec68a0-d4d3-4126-83ed-3766b5fe6ce0.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1696788/95ec68a0-d4d3-4126-83ed-3766b5fe6ce0.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"The 2-room apartment with hallway, kitchen, bathroom, and terrace is located on the outskirts of Bremen in a green area, in an apartment building with a total of five residential units. From the kitchen bay window, you can look directly at old oak trees and watch the squirrels scurrying about. It is a very quiet building, where most of the owners live themselves. Accordingly, I am only looking for quiet tenants who do not want to throw parties in my apartment.\nThe apartment is in very good condition. All rooms were completely renovated in 2021 and all major electrical appliances, electric stove with oven, dishwasher, refrigerator and freezer, washing machine, and television were replaced in 2021 or in subsequent years. Most recently, the television was replaced in 2024.\nThere are additional common areas in the basement that can be used by all residents of the building. These include a laundry room with washing machines. Each resident has their own washing machine there for their sole use. There is also a washing machine available for your sole use. In addition, there is a large drying room in the basement that all residents can use. There is also a communal bicycle storage room.\nThe furnishings are very good, and two people should be able to live there comfortably. In addition to the bedroom with a double bed, there is a sofa bed in the living room (the red sofa in the picture, 1.5 meters wide). The bed in the bedroom is extra-long. The mattress measures 2.2 meters long x 1.8 meters wide. It is therefore also very suitable for tall people. The bed and mattress were purchased brand new in 2026.\n\nWithin a radius of approximately 1.5 kilometers, there is a large shopping center, a hardware store, a pharmacy, a bakery, and a bank. Another large shopping center with many smaller and larger stores for daily needs is approximately 7 kilometers away. There is a bus connection to the public transport network 700 meters away.\n\nThe apartment is very easy to reach by car and there is plenty of free parking directly in front of the building. There are beautiful opportunities for walks and jogging in nature in the immediate vicinity of the apartment. The apartment is ideal for tenants who have a car at their disposal and who work in Bremen or the surrounding area.\n","facilities":{"airConditioning":{"value":"no"},"allergyFriendly":{"value":"no"},"balconyTerrace":{"value":"private"},"basement":{"value":"shared"},"bathroom":{"value":"private"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"yes"},"bedrooms":{"value":"2"},"closet":{"value":"yes"},"couplesAllowed":{"value":"yes"},"desk":{"value":"yes"},"dishwasher":{"value":"yes"},"dryer":{"value":"no"},"electricityCostIncluded":{"value":"yes"},"flooring":{"value":"laminate"},"garden":{"value":"private"},"gasCostIncluded":{"value":"yes"},"heating":{"value":"central"},"internetCostIncluded":{"value":"yes"},"kitchen":{"value":"private"},"kitchenware":{"value":"private"},"livingRoom":{"value":"private"},"parking":{"value":"private"},"pets":{"value":"discussable"},"playMusic":{"value":"discussable"},"registrationPossible":{"value":"yes"},"roomFurniture":{"value":"yes"},"smoking":{"value":"outside_only"},"toilet":{"value":"private"},"totalSize":{"value":"60"},"tv":{"value":"yes"},"washingMachine":{"value":"yes"},"waterCostIncluded":{"value":"yes"},"wheelchairAccessible":{"value":"no"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":130000,"deposit":0,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"1300.00","deposit":"0.00","agencyFee":"0.00","estimatedBills":"0.00"},"minimumStayMonths":3,"moveInWindow":0,"currentOccupancy":0,"minAge":21,"maxAge":0,"preferredGender":"","available":[{"to":"9999-12-31","from":"2026-05-04"}],"updated":"2026-05-04T18:21:08Z","__utId__":"ut1696788"}]