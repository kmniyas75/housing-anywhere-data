ll,"sizes":{"1024x768":{"link":"https://housinganywhere.imgix.net/unit_type/1491976/3c5826d4-dc17-48e2-936b-6820bdd6c011.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/unit_type/1491976/3c5826d4-dc17-48e2-936b-6820bdd6c011.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1491976/3c5826d4-dc17-48e2-936b-6820bdd6c011.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1491976/3c5826d4-dc17-48e2-936b-6820bdd6c011.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1491976/3c5826d4-dc17-48e2-936b-6820bdd6c011.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"Das Apartment befindet sich im Erdgeschoss einer 2018 fertiggestellten Ökohauses mit insgesamt sechs Parteien. In der Wohnung wurde geschmackvolles Echtholz-Parkett verlegt und durch die Fußbodenheizung entsteht im Winter eine angenehme Wärme. Weiterhin verfügt das gesamte Apartment über elektrische Außenrollos, sodass alle Räume abgedunkelt werden können. Das Wohnzimmer ist mit einem Essbereich und einem Smart-TV (55\") sowie SONOS Box zur Musikwiedergabe ausgestattet. Die beiden kleinen Terrassen - eine davon ist überdacht- sind vom Wohnzimmer aus begehbar.\nDie exklusive Einbauküche mit BORA Kochfeld und Granit-Arbeitsplatte verfügt über einen Kühlschrank mit Gefrierfach, einen Geschirrspüler, einen Backofen mit Mikrowellenfunktion, eine Nespresso-Kaffeemaschine mit Milchaufschäumer, einen Toaster, einen Wasserkocher sowie sämtliches Kücheninventar.\nDas Schlafzimmer ist mit einem Doppelbett (1,80x2m) und einem Smart-TV (55\") ausgestattet. Das sehr hochwertige Tageslichtbad verfügt über eine bodentiefe Dusche. Handtücher und Föhn sind vorhanden. Der Waschtrockner befindet sich ebenfalls im Badezimmer.\nIm Abstellrau befinden sich Putzutensilien, das Bügelbrett mit Bügeleisen und der Staubsauger. \nDer Flur bietet mit einem Schrank zusätzlichen Stauraum.\nIn der angegebenen Miete sind alle Nebenkosten, der Highspeed-Internetanschluss, eine wöchentliche Reinigung, der Rundfunkbeitrag sowie ein Tiefgaragenstellplatz enthalten. Außerdem ist im Mietpreis bei einer Mietzeit unter 6 Monaten die Mehrwertsteuer von 7% und bei einer Mietzeit von mehr als 6 Monaten die Mehrwertsteuer von 19 % bereits inklusive.\nEin Energieausweis ist vorhanden.","facilities":{"airConditioning":{"value":"no"},"allergyFriendly":{"value":"yes"},"balconyTerrace":{"value":"private"},"basement":{"value":"no"},"bathroom":{"value":"private"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"yes"},"bedrooms":{"value":"1"},"closet":{"value":"yes"},"couplesAllowed":{"value":"yes"},"desk":{"value":"yes"},"dishwasher":{"value":"yes"},"dryer":{"value":"yes"},"electricityCostIncluded":{"value":"yes"},"flooring":{"value":"wood"},"garden":{"value":"private"},"gasCostIncluded":{"value":"yes"},"heating":{"value":"central"},"internetCostIncluded":{"value":"yes"},"kitchen":{"value":"private"},"kitchenware":{"value":"private"},"livingRoom":{"value":"private"},"parking":{"value":"private"},"pets":{"value":"no"},"playMusic":{"value":"no"},"registrationPossible":{"value":"yes"},"roomFurniture":{"value":"yes"},"smoking":{"value":"no"},"toilet":{"value":"private"},"totalSize":{"value":"78"},"tv":{"value":"yes"},"washingMachine":{"value":"yes"},"waterCostIncluded":{"value":"yes"},"wheelchairAccessible":{"value":"no"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":229000,"deposit":458000,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"2290.00","deposit":"4580.00","agencyFee":"0.0