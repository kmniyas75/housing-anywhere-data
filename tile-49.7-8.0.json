gix.net/unit_type/1714654/f47dc9ce-23e2-4bf9-8bda-041ef8b6c677.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1714654/f47dc9ce-23e2-4bf9-8bda-041ef8b6c677.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"\nModern Apartment with Parking and Garden Area in Alzey\n\nWelcome to your home away from home in Alzey. This fully furnished apartment is ideal for business travelers, project workers, and commuters. Thanks to its complete equipment, you can move in and feel comfortable right away.\n\nThe spacious sleeping and living area offers plenty of room to relax or work. A table with two comfortable chairs provides a pleasant space for dining or working from home. The large kitchen also features a dining area with a table and two chairs. For added convenience, there is a separate dressing/storage room with a wardrobe. The modern bathroom benefits from natural daylight and a bright, welcoming design.\n\nThe apartment is equipped with modern technology and thoughtful amenities. USB and USB-C charging ports are available next to the beds and in the living area, making it easy to charge phones, tablets, and laptops. Several modern lamps with warm lighting create a cozy and welcoming atmosphere throughout the apartment.\n\nAmenities\n\n✔ Fully furnished and move-in ready, including dishes, cutlery, cookware\n✔ High-speed Wi-Fi\n✔ Private washing machine\n✔ Spacious kitchen with dining area\n✔ Separate wardrobe/storage room\n✔ Modern daylight bathroom\n✔ USB and USB-C charging ports by the bed and in the living area\n✔ Modern ambient lighting with warm light\n✔ TV\n✔ Bed linen and towels provided\n✔ Free parking space\n✔ Access to a garden and outdoor seating area\n✔ Non-smoking apartment\n✔ No pets allowed\n\nLocation\n\nThe apartment is conveniently located near the A61/A63 motorway interchange. The Alzey industrial area is only 3.5 km away. Mainz, Worms, Mannheim, and the Rhine-Main metropolitan area are easily accessible.\n\nNearby you will find:\n\n- Italian restaurant (60 m)\n- Fitness center (60 m)\n- Recreational lake area (750 m)\n- Supermarket and bakery (900 m)\n- Alzey-West train station (1.5 km)\n- Alzey city center (1.5 km)\n\nThe combination of excellent transport connections, a quiet location, outdoor space, and complete amenities makes this apartment an ideal choice for both business and private stays.","facilities":{"airConditioning":{"value":"no"},"allergyFriendly":{"value":"yes"},"balconyTerrace":{"value":"no"},"basement":{"value":"no"},"bathroom":{"value":"private"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"yes"},"bedrooms":{"value":"1"},"closet":{"value":"yes"},"couplesAllowed":{"value":"yes"},"desk":{"value":"yes"},"dishwasher":{"value":"yes"},"dryer":{"value":"yes"},"electricityCostIncluded":{"value":"yes"},"flooring":{"value":"laminate"},"garden":{"value":"shared"},"gasCostIncluded":{"value":"yes"},"heating":{"value":"gas"},"internetCostIncluded":{"value":"yes"},"kitchen":{"value":"private"},"kitchenware":{"value":"private"},"livingRoom":{"value":"private"},"parking":{"value":"private"},"pets":{"value":"no"},"playMusic":{"value":"discussable"},"registrationPossible":{"value":"yes"},"roomFurniture":{"value":"yes"},"smoking":{"value":"no"},"toilet":{"value":"private"},"totalSize":{"value":"32"},"tv":{"value":"yes"},"washingMachine":{"value":"yes"},"waterCostIncluded":{"value":"yes"},"wheelchairAccessible":{"value":"no"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":140000,"deposit":170000,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"1400.00","deposit":"1700.00","agencyFee":"0.00","estimatedBills":"0.00"},"minimumStayMonths":1,"moveInWindow":0,"currentOccupancy":0,"minAge":0,"maxAge":0,"preferredGender":"","available":[{"to":"9999-12-3