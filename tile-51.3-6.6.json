:800,"height":600}}},{"originalLink":"https://housinganywhere.imgix.net/unit_type/1512335/dbeee3e7-8805-4546-84f8-8f6f07e3f6dd.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","categories":null,"sizes":{"1024x768":{"link":"https://housinganywhere.imgix.net/unit_type/1512335/dbeee3e7-8805-4546-84f8-8f6f07e3f6dd.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/unit_type/1512335/dbeee3e7-8805-4546-84f8-8f6f07e3f6dd.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1512335/dbeee3e7-8805-4546-84f8-8f6f07e3f6dd.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1512335/dbeee3e7-8805-4546-84f8-8f6f07e3f6dd.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1512335/dbeee3e7-8805-4546-84f8-8f6f07e3f6dd.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}},{"originalLink":"https://housinganywhere.imgix.net/unit_type/1512335/cc405804-67d6-453a-943a-0628f5034c62.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","categories":null,"sizes":{"1024x768":{"link":"https://housinganywhere.imgix.net/unit_type/1512335/cc405804-67d6-453a-943a-0628f5034c62.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/unit_type/1512335/cc405804-67d6-453a-943a-0628f5034c62.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1512335/cc405804-67d6-453a-943a-0628f5034c62.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1512335/cc405804-67d6-453a-943a-0628f5034c62.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1512335/cc405804-67d6-453a-943a-0628f5034c62.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"Modernes Business Appartment voll möbliert mit Terrasse und Garten bei Düsseldorf am Rhein\n\nImmobilie\nDieses attraktive EG-Apartment zeichnet sich durch eine komfortable und moderne Innenausstattung aus und kann ab sofort bezogen werden.\nDas Apartment verfügt über drei Zimmer: \n    • Offener Wohn-Ess-Bereich mit angrenzender offener Küche mit Kochinsel\n    • Schlaf- und Arbeitszimmer\n    • zweites Schlafzimmer, welches auch als Kinderzimmer genutzt werden kann\n    • Tageslichtbad mit bodengleicher Regendusche und LED Panorama-Spiegel\n    • Hauswirtschaftsraum mit eigener Waschmaschine.\n\nEine komplette Sanierung fand im Jahr 2022 statt, die letzte Renovierung 2024. Besonders attraktiv wird das Apartment durch die 16 qm-Sonnenterrasse mit Zugang zum eigenen Garten. \n\nAusstattung\n    • Voll ausgestattete Einbauküche mit Kochfeld, Backofen, Spülmaschine, Kühlschrank, Wasserkocher, Toaster, Kaffeemaschine und Mikrowelle und Zubehör zum Kochen\n    • Wohnzimmer mit Sofa mit Recamiere und Fernseher mit Internet-TV-Stick\n    • Schlafzimmer mit großem Doppelbett (mit Bettwäsche) und Arbeitsbereich mit großem Schreibtisch\n    • ein weiteres Schlafzimmer großem Einzelbett (mit Bettwäsche)\n    • Modernes Tageslicht-Bad mit bodengleicher Regendusche und beheiztem LED Panorama-Spiegel\n    • W-LAN mit High-Speed Internet bis zu 250 MBit\n    • TV mit TV-Stick\n    • Neue dreifachverglaste Kunststoff-Fenster in 2019\n    • Energieverbrauchsausweis liegt zur Besichtigung vor\n    • Keine Haustiere und keine Partys erlaubt\n\nLage\nGelegen ist diese wunderschöne Wohnung auf der nördlichen Stadtgrenze zu Düsseldorf, welche sogar mit dem Fahrrad am Rhein entlang erreichbar ist. Beliebte Wohnlage in direkter Nähe zum Rhein. In unmittelbarer Nähe befindet sich das Landschaftsschutzgebiet \"Mündelheimer Rheinbogen\". \nFußläufig 3 Gehminuten bis BUS  Stationen 941 und 942, 9 Fahrminuten bis Bahnhof Kesselsberg, 6 Fahrminuten zur Autobahn A57. Öffentliche Parkplätze vor der Wohnung.","facilities":{"airConditioning":{"value":"no"},"allergyFriendly":{"value":"yes"},"balconyTerrace":{"value":"private"},"basement":{"value":"no"},"bathroom":{"value":"private"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"yes"},"bedrooms":{"value":"2"},"closet":{"value":"yes"},"couplesAllowed":{"value":"yes"},"desk":{"value":"yes"},"dishwasher":{"value":"yes"},"dryer":{"value":"no"},"electricityCostIncluded":{"value":"yes"},"flooring":{"value":"other"},"garden":{"value":"private"},"gasCostIncluded":{"value":"yes"},"heating":{"value":"central"},"internetCostIncluded":{"value":"yes"},"kitchen":{"value":"private"},"kitchenware":{"value":"private"},"livingRoom":{"value":"private"},"parking":{"value":"shared"},"pets":{"value":"no"},"playMusic":{"value":"yes"},"registrationPossible":{"value":"yes"},"roomFurniture":{"value":"yes"},"smoking":{"value":"outside_only"},"tenantStatus":{"value":"working professionals only"},"toilet":{"value":"private"},"totalSize":{"value":"85"},"tv":{"value":"yes"},"washingMachine":{"value":"yes"},"waterCostIncluded":{"value":"yes"},"wheelchairAccessible":{"value":"no"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":210000,"deposit":390000,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"2100.00","deposit":"3900.00","agencyFee":"0.00","estimatedBills":"0.00"},"minimumStayMonths":6,"moveInWindow":0,"currentOccupancy":0,"minAge":0,"maxAge":0,"preferredGender":"","available":[{"to":"9999-12-31","from":"2026-06-08"}],"updated":"2026-06-08T14:49:45Z","__utId__":"ut