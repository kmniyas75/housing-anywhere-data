ight":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1638032/b92e3aa7-b3ff-483a-bd87-4f2eb29755a0.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1638032/b92e3aa7-b3ff-483a-bd87-4f2eb29755a0.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"Moin zusammen,\n\nda ich dieses Jahr wieder für längere Zeit nach Mallorca gehen möchte, vermiete ich meine schöne Wohnung im beliebten Kasernengelände Donnerschwee für ca. sechs Monate zur Zwischenmiete.\n\nDie Wohnung hat ca. 50 m2, ist gut geschnitten, hell und vollständig möbliert. Sie besteht aus einem gemütlichen Wohnbereich, einem separaten Schlafzimmer, einer voll ausgestatteten Einbauküche sowie einem Badezimmer mit Dusche und Badewanne. Eine Waschtrockner ist ebenfalls vorhanden.\n\nBesonders schön ist der Balkon mit Südwest-Ausrichtung – ab ca. 12 Uhr hat man dort Sonne und kann den Tag entspannt ausklingen lassen.\n\nDie Wohnung ist komplett bezugsfertig: Möbel, Küche, Internet, Strom, Heizung, Nebenkosten, GEZ – alles ist bereits enthalten. Man kann also einfach einziehen und muss sich um nichts weiter kümmern.\n\nRahmendaten:\n\nOrt: Kaserngelände Donnerschwee, Oldenburg\nWohnfläche: ca. 50 m2\nZimmer: 2\nVerfügbar: frühestens ab 15.09.2026\nMietdauer: flexibel, idealerweise ca. 6 Monate\nMiete: 1.100 € monatlich all inclusive\n\nDie Wohnung eignet sich ideal für jemanden, der vorübergehend in Oldenburg ist, beruflich hier zu tun hat, eine Übergangslösung sucht oder einfach gerne in einer besonderen und angenehmen Wohnumgebung wohnen möchte.\n\nBei Interesse freue ich mich über eine kurze Nachricht mit ein paar Infos zu dir und dem gewünschten Zeitraum.\n\nViele Grüße,\nJan","facilities":{"airConditioning":{"value":"no"},"allergyFriendly":{"value":"no"},"balconyTerrace":{"value":"private"},"basement":{"value":"no"},"bathroom":{"value":"private"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"yes"},"bedrooms":{"value":"1"},"closet":{"value":"yes"},"desk":{"value":"yes"},"dishwasher":{"value":"yes"},"dryer":{"value":"yes"},"electricityCostIncluded":{"value":"yes"},"flooring":{"value":"stone"},"garden":{"value":"no"},"gasCostIncluded":{"value":"yes"},"heating":{"value":"central"},"internetCostIncluded":{"value":"yes"},"kitchen":{"value":"private"},"kitchenware":{"value":"private"},"livingRoom":{"value":"private"},"parking":{"value":"private"},"pets":{"value":"no"},"playMusic":{"value":"no"},"roomFurniture":{"value":"yes"},"smoking":{"value":"outside_only"},"toilet":{"value":"private"},"totalSize":{"value":"50"},"tv":{"value":"yes"},"washingMachine":{"value":"yes"},"waterCostIncluded":{"value":"yes"},"wheelchairAccessible":{"value":"no"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":110000,"deposit":150000,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"1100.00","deposit":"1500.00","agencyFee":"0.00","estimatedBills":"0.00"},"minimumStayMonths":4,"moveInWindow":0,"currentOccupancy":0,"minAge":0,"maxAge":0,"preferredGender":"","available":[{"to":"9999-12-31","from":"2026-06-08"}],"updated":"2026-06-08T15:00:14Z","__utId__":"ut1638032"}]