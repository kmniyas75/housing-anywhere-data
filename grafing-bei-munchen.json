ight":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1435799/a19ebe38-8bcd-4d57-bf8c-047afbed8db2.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1435799/a19ebe38-8bcd-4d57-bf8c-047afbed8db2.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1435799/a19ebe38-8bcd-4d57-bf8c-047afbed8db2.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"Metropolregion München mit der S-Bahn-Linie (Abfahrt Grafing Stadt) in 30 Minuten zu erreichen. \nMit dem Regionalzug (Abfahrt Grafing Bahnhof) in 15 Minuten.\n\nDie Gästewohnung „ Am Seefeld“ im Souterrain ist komplett neu ausgestattet und bietet eine gemütliche Unterkunft in idyllischer Lage am ländlichen Ortsrand, umgeben von Feldern und in der Nähe eines malerischen Sees, der perfekte Ausgangspunkt, um die Schönheit der Natur und die ländliche Atmosphäre dieser Region zu erkunden als auch schnell in die Metropolregion München mit der S-Bahn-Linie (7 bis 10 Minuten zu Fuß) zu kommen.\n\nDie „GastRoom Am Seefeld“ verfügt über Fenster in jedem Raum,  die viel Tageslicht hereinlassen und ist mit Fußbodenheizung ausgestattet sowie eine moderne Küche mit allen notwendigen Geräten und Utensilien für Selbstversorger.\n\nDas Schlafzimmer ist geräumig und komfortabel mit einem bequemen Boxspringbett ausgestattet, perfekt für erholsame Nächte. \nDas Badezimmer ist modern und bietet eine Dusche, Föhn, Hygieneartikel und einen Waschtrockner sowie alle notwendigen Annehmlichkeiten.\n\nSchlafzimmer: \nBoxspringbett mit H2+ H3 Matratze 180 x 200\nDaunenbetten, Wolldecken, Bettwäsche Kleiderbügel, Bügeleisen \nKleiderschrank\nPlatz für Kinderreisebett \nArbeitsplatz \n\nKüche:\nKeramikeßtisch\n2x Lederstühle \nSchlafcouch 193 x140 \nKühlschrank + Gefrierfach\nToaster\nNespressomaschine\nWasserkocher\nCerankochfeld, Backofen \nTöpfe, Pfannen, Geschirr, Gläser\nWLAN + SAT-TV mit Netflix und weitere Apps\n\nBad:\nGlasdusche\nBosch Waschtrockner\nBraun HaarFön\nKosmetikspiegel\nKosmetik - und Hygieneartikel Schadstofffrei (TOXFOX)\nHandtücher\n\nFlur:\nGarderobe\nSpiegel groß\n\nÜberdachter Außenbereich mit Sitzgelegenheit\n\nGrafing ist eine charmante Altstadt mit historischer Architektur, kleinen Geschäften, gemütlichen Cafés und traditionellen bayerischen Restaurants, liegt im Landkreis Ebersberg und befindet sich im südlichen Teil Oberbayerns. Die Stadt erstreckt sich inmitten einer malerischen Landschaft mit sanften Hügeln, Wäldern und landwirtschaftlichen Flächen. Die Region ist bekannt für ihre Naturschönheit und bietet zahlreiche Möglichkeiten für Outdoor-Aktivitäten wie Wandern, Radfahren und Naturerkundungen.\nGrafing ist ein beliebter Wohnort für Pendler, die in München arbeiten, da die Stadt dank einer guten Verkehrsanbindung sowohl mit dem Auto als auch mit der S-Bahn bequem erreichbar ist. Die S-Bahn-Linie S4 verbindet Grafing mit dem Münchner Stadtzentrum und bietet eine effiziente Möglichkeit, die Metropole zu erreichen.\n\nInsgesamt zeichnet sich Grafing bei München durch seine ruhige und idyllische Lage inmitten der Natur aus, während gleichzeitig die Vorzüge und Annehmlichkeiten einer Großstadt wie München leicht erreichbar sind. Dies macht Grafing zu einem attraktiven Ort für Menschen, die das Beste aus beiden Welten suchen. Wohnung hell, alle Zimmer mit Fenster, 42 qm, Steinboden, Fußbodenheizung, Mückengitter überall, Rolladen, eigener Eingang, kostenloser Parkplatz direkt vor der Tür, Rauchmelder, Erste-Hilfe-Set, überdachter Aussenbereich im Freien. \n","facilities":{"airConditioning":{"value":"no"},"allergyFriendly":{"value":"yes"},"balconyTerrace":{"value":"private"},"basement":{"value":"no"},"bathroom":{"value":"private"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"yes"},"bedrooms":{"value":"1"},"closet":{"value":"yes"},"couplesAllowed":{"value":"yes"},"desk":{"value":"yes"},"dishwasher":{"value":"no"},"dryer":{"value":"yes"},"electricityCostIncluded":{"value":"no"},"flooring":{"value":"stone"},"garden":{"value":"no"},"gasCostIncluded":{"value":"no"},"heating":{"value":"central"},"internetCostIncluded":{"value":"yes"},"kitchen":{"value":"private"},"kitchenware":{"value":"private"},"livingRoom":{"value":"private"},"parking":{"value":"private"},"pets":{"value":"no"},"playMusic":{"value":"discussable"},"registrationPossible":{"value":"yes"},"roomFurniture":{"value":"yes"},"smoking":{"value":"outside_only"},"toilet":{"value":"private"},"totalSize":{"value":"43"},"tv":{"value":"yes"},"washingMachine":{"value":"yes"},"waterCostIncluded":{"value":"no"},"wheelchairAccessible":{"value":"no"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":149900,"deposit":300000,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"1499.00","deposit":"3000.00","agencyFee":"0.00","estimatedBills":"0.00"},"minimumStayMonths":1,"moveInWindow":0,"currentOccupancy":0,"minAge":18,"maxAge":0,"preferredGender":"","available":[{"to":"9999-12-31","from":"2026-03-30"}],"updated":"2026-03-30T10:41:23Z","__utId__":"ut1435799"}]