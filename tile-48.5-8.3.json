b13b72f.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1679765/f0c07951-15d8-481b-9271-1a626b13b72f.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1679765/f0c07951-15d8-481b-9271-1a626b13b72f.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"Ruhestein Quartier – möblierte Ferienwohnung für Langzeitaufenthalte\n\nWillkommen im Ruhestein Quartier! Unsere voll möblierte Wohnung bietet Platz für bis zu 6 Erwachsene und 2 Kinder und ist ideal für Monatsaufenthalte, Praktika oder Projektarbeit.\n\nHighlights der Wohnung:\n- Voll ausgestattete Küche inkl. Geschirr, Herd, Kühlschrank, Waschmaschine und Kaffeemaschine\n- Gemütlicher Wohn- und Essbereich mit TV und WLAN\n- Separate Schlafzimmer für Privatsphäre\n- Duschzimmer direkt an einem Schlafzimmer (Durchgangszimmer) \n- Arbeitsbereich für Studium oder Homeoffice\n\nExtras für Langzeitgäste:\n- Reinigung wöchentlich möglich\n- Gästekarte für kostenlose Nutzung des Nahverkehrs\n- Vergünstigungen bei lokalen Einrichtungen\n- Kamin auf Anfrage (gegen Gebühr)\n\nLage:\n- Ruhige Lage in der Nähe von Supermärkten, Cafés und Restaurants\n- Gute Anbindung an öffentliche Verkehrsmittel\n- Parkplatz hinter dem Haus inklusive\n\nIdeal für: Studierende, Praktikanten, Berufstätige oder Familien, die einen komfortablen, möblierten Aufenthalt für 1 Monat oder länger suchen.","facilities":{"airConditioning":{"value":"no"},"allergyFriendly":{"value":"yes"},"balconyTerrace":{"value":"no"},"basement":{"value":"shared"},"bathroom":{"value":"private"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"yes"},"bedrooms":{"value":"2"},"closet":{"value":"yes"},"couplesAllowed":{"value":"yes"},"desk":{"value":"no"},"dishwasher":{"value":"yes"},"dryer":{"valu