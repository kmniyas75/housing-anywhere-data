d87-2263-4e11-ad8d-2784dc828c14.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1602358/dd803d87-2263-4e11-ad8d-2784dc828c14.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1602358/dd803d87-2263-4e11-ad8d-2784dc828c14.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"This stylish single-family home was extensively renovated in 2018.\n\nThe light-filled ground floor features a large living space, a dining area for up to 8 people, and an open fully equipped kitchen with an island. It includes an integrated coffee machine, a wine fridge, as well as an oven, dishwasher, large refrigerator, and freezer. Next to the dining area is a covered balcony with lounge furniture.\n\nAdditional rooms:\nOn the ground floor - an office and a storage room/closet.\nIn the basement - a small guest room with a small shower bathroom, a large additional living space with hardwood floors (guest or children's room, hobby room, etc.), a cellar/storage room, a heating cellar with space for sports equipment or similar, and a large laundry room with a chest freezer.\n\nOn the 1st mezzanine floor, there is a daylight bathroom with a very large shower, a toilet, and a double sink.\n\nOn the 1st upper floor, there are 3 small bedrooms that can be used as children's, guest, or office rooms. The large master bedroom has a walk-in closet and a bay window with many windows (reading room, office, etc.), an en-suite private bathroom with a bathtub, larger shower, toilet + bidet, and 2 wash basins.\n\nOutside, there is a covered terrace with lounge furniture and a large garden. In the carport (with electric roller door), there is space for two small cars or an SUV. In front of the house, up to two additional cars can be parked.\n\n**SURROUNDINGS:**\n\nFriedrichsdorf is directly adjacent to Bad Homburg (3 km) and is thus a sought-after residential area in the Hochtaunus district. \n\nFriedrichsdorf offers a good connection to Bad Homburg and the Rhine-Main metropolis Frankfurt with an S-Bahn connection and a good motorway connection to the A5 (just 1 km away) and A661. \n\nFrankfurt Airport is only 30 km away. The town also offers a wide range of leisure activities. Furthermore, Friedrichsdorf offers excellent infrastructure with its popular primary and secondary schools, which is further strengthened by a large number of shopping opportunities, restaurants, cafés, and various doctors.\n\nA bus stop is just 2 minutes away from the property. Bus line 53 takes about 8 minutes to reach Friedrichsdorf station. From there, the S-Bahn S5 travels through Bad Homburg and Oberursel to Frankfurt.","facilities":{"airConditioning":{"value":"no"},"allergyFriendly":{"value":"yes"},"balconyTerrace":{"value":"private"},"basement":{"value":"private"},"bathroom":{"value":"private"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"yes"},"bedrooms":{"value":"5"},"closet":{"value":"yes"},"couplesAllowed":{"value":"yes"},"desk":{"value":"yes"},"dishwasher":{"value":"yes"},"dryer":{"value":"yes"},"electricityCostIncluded":{"value":"yes"},"flooring":{"value":"wood"},"garden":{"value":"private"},"gasCostIncluded":{"value":"yes"},"heating":{"value":"central"},"internetCostIncluded":{"value":"yes"},"kitchen":{"value":"private"},"kitchenware":{"value":"private"},"livingRoom":{"value":"private"},"parking":{"value":"private"},"pets":{"value":"discussable"},"playMusic":{"value":"yes"},"registrationPossible":{"value":"yes"},"roomFurniture":{"value":"yes"},"smoking":{"value":"outside_only"},"toilet":{"value":"private"},"totalSize":{"value":"300"},"tv":{"value":"yes"},"washingMachine":{"value":"yes"},"waterCostIncluded":{"value":"yes"},"wheelchairAccessible":{"value":"no"},"wifi":{"value":"yes"}},"costs":{"curren