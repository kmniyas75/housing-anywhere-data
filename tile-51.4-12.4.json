4a.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}},{"originalLink":"https://housinganywhere.imgix.net/unit_type/1631406/cd29bfb0-693f-4265-8fea-f56a2f20d2ef.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","categories":null,"sizes":{"1024x768":{"link":"https://housinganywhere.imgix.net/unit_type/1631406/cd29bfb0-693f-4265-8fea-f56a2f20d2ef.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/unit_type/1631406/cd29bfb0-693f-4265-8fea-f56a2f20d2ef.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1631406/cd29bfb0-693f-4265-8fea-f56a2f20d2ef.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1631406/cd29bfb0-693f-4265-8fea-f56a2f20d2ef.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1631406/cd29bfb0-693f-4265-8fea-f56a2f20d2ef.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"DIE WOHNUNG\nWohnen mit Charakter: Diese geschmackvoll eingerichtete 2-Zimmer-Wohnung liegt im charmanten, denkmalgeschützten Ortskern von Leipzig-Seehausen. Als Teil eines liebevoll modernisierten Dreiseitenhof-Ensembles vereint sie herrschaftliches Flair mit modernem Wohnkomfort – in ruhiger, ländlicher Atmosphäre und zugleich stadtnah, mit Einkaufsmöglichkeiten in bequemer Reichweite.\n\nDer großzügige Essbereich lädt zum gemeinsamen Kochen, Genießen und Verweilen ein. Vom Balkon eröffnet sich ein entspannter Blick auf die begrünte Hofanlage.\n\nAUSSTATTUNG & AMBIENTE\nEdles Parkett, behagliche Fußbodenheizung und ein lichtdurchflutetes Tageslichtbad verleihen der Wohnung eine hochwertige, einladende Atmosphäre. Im Bad sorgen eine moderne Designer-Showerpipe, warme Bambuselemente und ausgewählte Fliesen für das besondere Gefühl einer kleinen Auszeit.\n\nKüche und Wohnbereich bilden ein stimmiges Ganzes: Charmante Landhauselemente treffen auf moderne Designmöbel und setzen individuelle Akzente. Die gemütliche Couch lässt sich im Handumdrehen in eine Schlafgelegenheit verwandeln – ideal, wenn sich Besuch ankündigt.\n\nAuch für längere Aufenthalte ist die Wohnung komfortabel ausgestattet: Ein moderner Toplader sowie Bügeleisen und Bügelbrett machen den Alltag angenehm unkompliziert.\n\nDas Schlafzimmer ist ein stilvoller Rückzugsort zum Entspannen. Ein elektrisch verstellbares Boxspringbett, ein durchdachtes Lichtkonzept und ein großer Flatscreen-TV verbinden Komfort mit elegantem Design. Antike Details setzen reizvolle Akzente und runden das besondere Ambiente ab.\n\nLAGE & VERKEHRSANBINDUNG\nDie Wohnung liegt in unmittelbarer Nähe zur Leipziger Messe und ist hervorragend angebunden. Über die A14 mit den Anschlussstellen Leipzig-Messegelände und Leipzig-Mitte sowie über die vierspurig ausgebaute B2 erreichen Sie das Leipziger Stadtzentrum, den Hauptbahnhof und den Flughafen Leipzig/Halle bequem.\n\nEine Bushaltestelle befindet sich nur etwa drei Gehminuten entfernt. Die nächste S-Bahn-Station erreichen Sie in rund 15 Minuten. Für den täglichen Bedarf und ausgedehnte Einkaufstouren liegt der Sachsenpark Leipzig ganz in der Nähe.\n\nAuch bedeutende Arbeitgeber der Region sind schnell erreichbar. Dazu zählen unter anderem Porsche, BMW, Beiersdorf, DHL und das Klinikum St. Georg.\n\nKOSTEN\nDer angegebene Mietpreis gilt für eine Belegung mit bis zu zwei Personen. Für jede weitere Person ab drei Jahren fällt ein monatlicher Aufpreis von 100 EUR an. Kinder bis einschließlich zwei Jahre wohnen kostenfrei.\n\nReinigungspauschale: EUR 120,- einmalig.\n\nKAUTION\nBei einer Mietdauer von bis zu sechs Wochen beträgt die Kaution EUR 950,- . Bei Mietverhältnissen von mehr als sechs Wochen ist eine Kaution in Höhe einer Monatsmiete zu hinterlegen.\n\nNEBENKOSTEN\nAlle Nebenkosten sind im Mietpreis enthalten – einschließlich Strom und Internet. ","facilities":{"airConditioning":{"value":"yes"},"balconyTerrace":{"value":"private"},"basement":{"value":"no"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"no"},"bedrooms":{"value":"1"},"closet":{"value":"yes"},"couplesAllowed":{"value":"yes"},"desk":{"value":"yes"},"dishwasher":{"value":"yes"},"dryer":{"value":"no"},"electricityCostIncluded":{"value":"yes"},"flooring":{"value":"wood"},"garden":{"value":"shared"},"gasCostIncluded":{"value":"yes"},"internetCostIncluded":{"value":"yes"},"kitchen":{"value":"private"},"kitchenware":{"value":"private"},"livingRoom":{"value":"private"},"parking":{"value":"private"},"pets":{"value":"discussable"},"playMusic":{"value":"discussable"},"registrationPossible":{"value":"yes"},"roomFurniture":{"value":"yes"},"smoking":{"value":"outside_only"},"toilet":{"value":"private"},"totalSize":{"value":"60"},"tv":{"value":"yes"},"washingMachine":{"value":"yes"},"waterCostIncluded":{"value":"yes"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":124000,"deposit":95000,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"1240.00","deposit":"950.00","agencyFee":"0.00","estimatedBills":"0.00"},"minimumStayMonths":1,"moveInWindow":0,"currentOccupancy":0,"minAge":0,"maxAge":0,"preferredGender":"","available":[{"to":"9999-12-31","from":"2026-11-10"}],"updated":"2026-11-10T20:01:17Z","__utId__":"ut1631406"}]