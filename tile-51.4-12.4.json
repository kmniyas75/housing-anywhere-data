b.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1631406/5947b8ab-bef6-4fe6-802c-b5961a41770b.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"Diese geschmackvoll eingerichtete Wohnung liegt im denkmalgeschützten Ortskern von Leipzig-Seehausen – inmitten eines liebevoll sanierten Dreiseitenhofs mit herrschaftlichem Flair. Umgeben von Grünflächen und ländlicher Ruhe bietet das stilvolle Domizil zugleich eine hervorragende Anbindung an die Leipziger Innenstadt, die Messe und wichtige Arbeitgeber der Region.\n\nStilvolles Wohnkonzept mit durchdachter Ausstattung\nDas Apartment besticht durch seine hochwertige Ausstattung und ein harmonisches Raumgefühl:\n\nWohn- und Essbereich mit stilvollen Möbeln und Schlafcouch\nModerne Landhausküche\nSchlafzimmer mit elektrisch verstellbarem Boxspringbett und TV\nTageslichtbad mit edlen Fliesen, Bambuselementen und Designer-Showerpipe\nParkettboden, Fußbodenheizung, Balkon mit Blick in die begrünte Hofanlage\nToplader-Waschmaschine, Bügeleisen und Bügelbrett für längere Aufenthalte\n\nDie geschmackvolle Einrichtung und das ruhige Ambiente machen die Wohnung zum idealen Rückzugsort für Geschäftsreisende, Paare, kleine Familien oder Langzeitmieter.\n\n\nLAGE & ANBINDUNG\nNur wenige Minuten entfernt liegen die Leipziger Messe, der Sachsenpark mit umfangreichen Einkaufsmöglichkeiten sowie internationale Unternehmen wie Porsche, BMW, DHL, Beiersdorf oder das Klinikum St. Georg.\n\nA14 (Abfahrt Leipzig-Messegelände / Leipzig-Mitte)\nVierspurige B2 zur Innenstadt und zum Hauptbahnhof\nFlughafen Leipzig/Halle in 10–15 Minuten erreichbar\nBushaltestelle in ca. 3 Gehminuten, S-Bahn in ca. 15 Minuten\n\n\nMIETE\nDer Preis gilt für eine Belegung mit bis zu 2 Personen.\nFür jede weitere Person ab 3 Jahren fallen monatlich 100 € Aufpreis an. Kleinkinder bis 2 Jahre sind kostenfrei.\nBei längeren Anmietungen ist ein Preisnachlass nach Absprache möglich.\n\nKAUTION\nMietdauer bis 6 Wochen: 990 €\nAb 6 Wochen: 1 Monatsmiete\n\nNEBENKOSTEN\nAlle Nebenkosten inkl. Internet und Strom sind im Mietpreis enthalten.\nEine Nachberechnung erfolgt, wenn der Stromverbrauch den Durchschnitt um mehr als 15 % übersteigt.\n\nTourismusabgabe\nDie Abgabe richtet sich nach der aktuellen gesetzlichen Regelung zur Nutzung des Wohnraums und wird individuell behandelt.","facilities":{"airConditioning":{"value":"yes"},"balconyTerrace":{"value":"private"},"basement":{"value":"no"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"no"},"bedrooms":{"value":"1"},"closet":{"value":"yes"},"couplesAllowed":{"value":"yes"},"desk":{"value":"yes"},"dishwasher":{"value":"yes"},"dryer":{"value":"no"},"electricityCostIncluded":{"value":"yes"},"flooring":{"value":"wood"},"garden":{"value":"shared"},"gasCostIncluded":{"value":"yes"},"internetCostIncluded":{"value":"yes"},"kitchen":{"value":"private"},"kitchenware":{"value":"private"},"livingRoom":{"value":"private"},"parking":{"value":"private"},"pets":{"value":"discussable"},"playMusic":{"value":"discussable"},"registrationPossible":{"value":"yes"},"roomFurniture":{"value":"yes"},"smoking":{"value":"outside_only"},"toilet":{"value":"private"},"totalSize":{"value":"60"},"tv":{"value":"yes"},"washingMachine":{"value":"yes"},"waterCostIncluded":{"value":"yes"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":149000,"deposit":90000,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"1490.00","deposit":"900.00","agencyFee":"0.00","estimatedBills":"0.00"},"minimumStayMonths":2,"moveInWindow":0,"currentOccupancy":0,"minAge":0,"maxAge":0,"preferredGender":"","available":[{"to":"9999-12-31","from":"2026-10-01"}],"updated":"2026-08-05T08:48:59Z","__utId__":"ut1631406"}]