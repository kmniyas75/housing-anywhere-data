:800,"height":600}}},{"originalLink":"https://housinganywhere.imgix.net/unit_type/1724724/8b89ef1b-8ffc-4e69-82c2-91ec8e4bdfde.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","categories":["floorplan"],"sizes":{"1024x768":{"link":"https://housinganywhere.imgix.net/unit_type/1724724/8b89ef1b-8ffc-4e69-82c2-91ec8e4bdfde.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/unit_type/1724724/8b89ef1b-8ffc-4e69-82c2-91ec8e4bdfde.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1724724/8b89ef1b-8ffc-4e69-82c2-91ec8e4bdfde.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1724724/8b89ef1b-8ffc-4e69-82c2-91ec8e4bdfde.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1724724/8b89ef1b-8ffc-4e69-82c2-91ec8e4bdfde.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"Diese hochwertig renovierte 3-Zimmer-Wohnung im 1. Obergeschoss bietet auf ca. 73 m2 ein modernes und gemütliches Zuhause. Sie bietet 2 Schlafzimmer, eine Küche, einen praktischen Kellerraum, eine Speisekammer, eine Besenkammer, Garten und sowie eine gemeinschaftliche Waschküche. Zum Grundriss gehört außerdem ein frisches saniertes Badezimmer mit neuer Badewanne. Viel Komfort im Alltag verspricht die hochwertige Ausstattung. Geboten werden Bewohnern mitunter eine Einbauküche sowie ein Parkettboden und viele weitere attraktive Details.\nIm Rahmen der Renovierung wurden unter anderem das Badezimmer, die Bodenbeläge und die Heizkörper erneuert. Die moderne Einbauküche ist bereits vorhanden und bietet zusätzlichen Komfort. Es gibt genug kostenlose Stellplätze oder Parkflächen.\n\nAusstattung:\n- ca. 73 m2 Wohnfläche\n- 3 helle Zimmer\n- großer Balkon\n- moderne Einbauküche\n- neues Badezimmer mit Badewanne\n- Bodenbeläge\n- neue Heizkörper\n- Keller\n- Gartennutzung\n- Speisekammer\n- Diele\n- Besenkammer\n- öffentliche kostenlose Parkmöglichkeiten\n\nUmgeben von weitläufigen Feldern und nur wenige Schritte von dem malerischen Ufer der Lumda entfernt, genießen Sie hier eine traumhaft ruhige und naturnahe Wohnumgebung mit gut ausgebauter Infrastruktur und idealer Anbindung an Gießen.\n\nDie Wohnung befindet sich in ruhiger Lage in Staufenberg-Mainzlar. Einkaufsmöglichkeiten, Kindergarten, Bankfilialen, eine Apotheke, Schule, diverse Arztpraxen und öffentliche Verkehrsmittel sind gut erreichbar.","facilities":{"airConditioning":{"value":"no"},"allergyFriendly":{"value":"no"},"balconyTerrace":{"value":"private"},"basement":{"value":"private"},"bathroom":{"value":"private"},"bed":{"value":"no"},"bedroomFurnished":{"value":"no"},"bedroomLock":{"value":"yes"},"bedrooms":{"value":"3"},"closet":{"value":"no"},"couplesAllowed":{"value":"yes"},"desk":{"value":"no"},"dishwasher":{"value":"yes"},"dryer":{"value":"no"},"electricityCostIncluded":{"value":"no"},"flooring":{"value":"laminate"},"garden":{"value":"private"},"gasCostIncluded":{"value":"yes"},"heating":{"value":"central"},"internetCostIncluded":{"value":"no"},"kitchen":{"value":"private"},"kitchenware":{"value":"no"},"livingRoom":{"value":"private"},"parking":{"value":"shared"},"pets":{"value":"discussable"},"playMusic":{"value":"yes"},"registrationPossible":{"value":"yes"},"roomFurniture":{"value":"no"},"smoking":{"value":"no"},"toilet":{"value":"private"},"totalSize":{"value":"73"},"tv":{"value":"no"},"washingMachine":{"value":"no"},"waterCostIncluded":{"value":"yes"},"wheelchairAccessible":{"value":"no"},"wifi":{"value":"no"}},"costs":{"currency":"EUR","pricing":"monthly","price":115000,"deposit":0,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly",