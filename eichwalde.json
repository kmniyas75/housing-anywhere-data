ix.net/unit_type/1606199/ba358389-fac9-4bd2-b425-5d9d678d885b.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1606199/ba358389-fac9-4bd2-b425-5d9d678d885b.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"Entire apartment\nThis bright duplex apartment with balcony is located on the third floor of a small apartment building. The balcony overlooks the tranquil garden and the surrounding countryside. The balcony is large enough for comfortable garden furniture and a gas barbecue.\n\nThe property is located directly bordering Berlin. The Eichwalde city train station is a 5 minute walk.\n\nThe entire apartment is fully furnished and equipped, so just unpack and make yourself at home.\nBehind the house there is a large garden which can be used by all tenants (barbecue, gardening (voluntary), etc.).\n\nThere are 5 other tenants living in the house and they are all very relaxed.\n\nParking spaces are available behind the house.\nThe apartment has a lockable basement for your own use and a communal room for bicycles.\n\nThe kitchen is custom built and fully equipped, including dishwasher, fridge, crockery, etc.\n\n\n\nAdditional Information\nQuiet location in a neighbourhood with garden city character. Very well kept neighbourhood. The suburban train (S-Bahn) station is a 5 minute walk away. The town centre is also very well kept. All shops and facilities for daily needs are close by.","facilities":{"airConditioning":{"value":"no"},"balconyTerrace":{"value":"private"},"basement":{"value":"no"},"bathroom":{"value":"private"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedrooms":{"value":"2"},"closet":{"value":"yes"},"couplesAllowed":{"value":"yes"},"desk":{"value":"yes"},"dishwasher":{"value":"yes"},"dryer":{"value":"yes"},"electricityCostIncluded":{"value":"yes"},"flooring":{"value":"laminate"},"garde