%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1346080/eb7da67b-6724-418f-aaf0-91e2acc8a225.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1346080/eb7da67b-6724-418f-aaf0-91e2acc8a225.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"Das Objekt besticht durch eine luxuriöse Innenausstattung. Zum 01.07.2023 können Sie das freundlich eingerichtete, moderne, zweistöckige Einfamilienhaus mit einem großen, offenen Wohn- Essbereich und 5 weiteren Zimmern und 2 Bädern mieten.\n\nEG:\nNachdem Sie das Haus im Erdgeschoss betreten, befinden Sie sich im offenen und lichtdurchfluteten Treppenhaus, anschließend gelangen Sie in den offen gestaltete Wohn- Essbereich und die offene Küche in dem neu angebauten Wintergarten mit direkt angrenzendem Esstisch, der offene Kamin und der großzügige Wohnbereich mit bodentiefen Fenstern lädt zum Entspannen ein. Im Erdgeschoss befindet sich außerdem noch einem Gästezimmer (alternativ Arbeitszimmer / Büro) und eine Gäste Bad.\n\nStauraum für Küchenutensilien bietet die bereits vorhandene 1 Jahr junge Einbauküche.\n\nÜber den großzügigen Eingangsbereich und das offene Treppenhaus gelangen Sie in das Obergeschoss. Vier helle Schlafzimmer bieten viel Raum zur persönlichen Entfaltung und individueller Einrichtung.\n\nAuch in dem Keller finden Sie weitere Abstellmöglichkeiten für Ihr Hab und Gut.\n\nDie monatliche Kaltmiete beträgt 2500 Euro.\n\n\nHighlights:\n\nModerne luxuriöse Innenausstattung\n\nLuxuriöse Küche (Leicht, Bora Induktionskochfeld, Miele Einbaugeräte)\n\nAlarmanlage Telenot\n\nSmartHome Steuerung der Heizung, der Lichter im EG und Küche, der Raffstore, der Alarmanlage und des Garagentors\n\nNutzfläche Keller und Garage ca.100 qm\n\nLage:\n\nDas Objekt liegt in Henstedt-Ulzburg. Fußläufig entfernt befinden sich mehrere Buslinien und die Bahnlinien A1, A2 und A3.\n\nIn näherer Umgebung finden Sie Ärzte, Restaurants, Bäckereien, Cafés und ein Einkaufszentrum. Auch Modegeschäfte, Fitnessstudios, Bars, eine Grün- und Parkanlage und eine Buchhandlung sind gut zu Fuß erreichbar. Etwas weiter entfernt gibt es zudem mehrere Kindergärten. Interessante Kultureinrichtungen und ein breit gefächertes Abendgestaltungsangebot erreichen Sie schließlich ebenfalls im größeren Umkreis.\n\nSonstiges:\n\nKomplette energetische Sanierung im Jahre 2021\nKFW 115 Haus\n(Keller, Fassade, neue Fenster/Haustür, Dach alles neu)\n\nBesonders für Familien geeignet\n\nZu Fuß nur 10 min zur AKN Haltestelle Henstedt-Ulzburg\n\nBesonders gute Einkaufsmöglichkeiten, Schulen und Kindergärten in der Nähe","facilities":{"airConditioning":{"value":"no"},"balconyTerrace":{"value":"private"},"basement":{"value":"private"},"bathroom":{"value":"private"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"yes"},"bedrooms":{"value":"4"},"closet":{"value":"yes"},"couplesAllowed":{"value":"yes"},"desk":{"value":"yes"},"dishwasher":{"value":"yes"},"dryer":{"value":"yes"},"electricityCostIncluded":{"value":"yes"},"flooring":{"value":"stone"},"garden":{"value":"private"},"gasCostIncluded":{"value":"yes"},"heating":{"value":"gas"},"internetCostIncluded":{"value":"yes"},"kitchen":{"value":"private"},"kitchenware":{"value":"private"},"livingRoom":{"value":"private"},"parking":{"value":"private"},"pets":{"value":"no"},"playMusic":{"value":"yes"},"registrationPossible":{"value":"yes"},"roomFurniture":{"value":"yes"},"smoking":{"value":"no"},"toilet":{"value":"private"},"totalSize":{"value":"176"},"tv":{"value":"yes"},"washingMachine":{"value":"yes"},"waterCostIncluded":{"value":"yes"},"wheelchairAccessible":{"value":"no"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":350000,"deposit":0,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"3500.00","deposit":"0.00","agencyFee":"0.00","estimatedBills":"0.00"},"minimumStayMonths":6,"moveInWindow":0,"currentOccupancy":0,"minAge":25,"maxAge":0,"preferredGender":"","available":[{"to":"9999-12-31","from":"2026-06-03"}],"updated":"2026-06-03T08:06:45Z","__utId__":"ut1346080"}]