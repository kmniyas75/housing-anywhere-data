516bd39.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1751259/40e5463b-4968-4ba7-a36f-0dcc2516bd39.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1751259/40e5463b-4968-4ba7-a36f-0dcc2516bd39.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"Zwischenmiete für Dezember / Januar\n\nRahmen:\nIn der 3-Zimmerwohnung (81m2) die ich angemietet habe, vermiete ich ein Zimmer unter. Mein WG-Kollege wird im Dezember und Januar in seiner Heimat (Lateinamerika) sein und deshalb hat er es für diese Zeit zur Zwischenmiete freigegeben.\n\nDie WG:\n    - 15m2 Zimmer in 2er WG\n    - Wohnungsgröße: 81m2\n    - 2er WG ( 1 Mann )\n    - Bewohneralter: 30 bis 49 Jahre\n    - Rauchen auf dem Balkon erlaubt\n    - Zweck-WG, Männer-WG\n    - Sprache/n: Deutsch, Englisch\n    - Bier ist eigentlich immer vorhanden. \n    - Hab einen Beamer und auch gerne Gäste :-)\n    - Party? Ja geht gern, aber halt auch nicht zu oft - bin grundsätzlich gern mit dabei, gehöre aber zum arbeitenden Gesellschaftanteil.\n\nDein Zimmer\n    - hat ca. 15 m2 (möbliert, siehe Bilder)\n\nWohnung\n    - Schöne Wohnung (siehe Bilder), 2. Stock mit Westbalkon\n    - gemeinsames geräumiges Wohnzimmer (23 m2) - mit Beamer\n    - gemeinsame schöne neue Küche (11 m2)\n    - gemeinsames Bad (3,6 m2)\n    - gemeinsamer Balkon\n    - Die Wohnung ist in einem 6 Parteien Haus mit netten und unkomplizierten Nachbarn.\n    - Das Haus liegt am Ende einer Sackgasse, was es etwas Ruhiger macht.\n    - Rewe, Aldi, Lidl und dm sind fußläufig erreichbar.\n    - Straßenbahn am Georgi-Marktplatz 600m entfernt\n    - Bahnhof St. Illgen 5 Min. mit dem Fahrrad (1,9km) \n\nKosten: \n    - 480 Kaltmiete\n    - 120 Nebenkosten\n    -   60 Strom, Internet, Müll\n\nWie solltest Du drauf sein?\n    - Etwas gesellig! (kein Problem mit „Gäste haben“ – aber auch nicht zu viel Party)\n    - Nicht jünger als 20 & nicht älter als 45\n    - ordentlich (normal halt! - geteilter Putzdienst)\n    - Ehrlichkeit und respektvoller Umgang sind mir wichtig\n\nWorum es mir bei einer WG geht, sind zwei Dinge:\n1. Gesellschaft und\n2. Miete teilen und dafür eine etwas schönere Wohnung haben.\n\nBesichtigungstermine\nSchreib mich einfach an.\nWenn sich ein paar Interessenten gemeldet haben, suche ich mir ein paar heraus und lade die dann zum persönlichen Kennenlernen (einzeln) für ca. 20 min. ein.\n\n","facilities":{"airConditioning":{"value":"no"},"allergyFriendly":{"value":"no"},"balconyTerrace":{"value":"shared"},"basement":{"value":"no"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"yes"},"bedroomSize":{"value":"15"},"bedrooms":{"value":"1"},"closet":{"value":"yes"},"couplesAllowed":{"value":"no"},"desk":{"value":"yes"},"dishwasher":{"value":"yes"},"dryer":{"value":"no"},"electricityCostIncluded":{"value":"yes"},"flooring":{"value":"laminate"},"garden":{"value":"shared"},"gasCostIncluded":{"value":"yes"},"gender":{"value":"male"},"heating":{"value":"central"},"housematesGender":{"value":"shared_w_boys"},"internetCostIncluded":{"value":"yes"},"kitchen":{"value":"shared"},"kitchenware":{"value":"shared"},"livingRoom":{"value":"shared"},"parking":{"value":"no"},"pets":{"value":"no"},"playMusic":{"value":"yes"},"registrationPossible":{"value":"yes"},"roomFurniture":{"value":"yes"},"smoking":{"value":"outside_only"},"toilet":{"value":"shared"},"totalSize":{"value":"81"},"tv":{"value":"no"},"washingMachine":{"value":"yes"},"waterCostIncluded":{"value":"yes"},"wheelchairAccessible":{"value":"no"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":68000,"deposit":98000,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"680.00","deposit":"980.00","agencyFee":"0.00"