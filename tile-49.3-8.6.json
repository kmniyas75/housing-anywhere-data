2-3a48530e899e.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1754737/2d8762ec-56d3-4613-b072-3a48530e899e.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1754737/2d8762ec-56d3-4613-b072-3a48530e899e.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}},{"originalLink":"https://housinganywhere.imgix.net/unit_type/1754737/aee56a28-4c5d-4126-a8df-c7a8dcbb5f13.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","categories":["livingroom"],"sizes":{"1024x768":{"link":"https://housinganywhere.imgix.net/unit_type/1754737/aee56a28-4c5d-4126-a8df-c7a8dcbb5f13.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/unit_type/1754737/aee56a28-4c5d-4126-a8df-c7a8dcbb5f13.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1754737/aee56a28-4c5d-4126-a8df-c7a8dcbb5f13.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1754737/aee56a28-4c5d-4126-a8df-c7a8dcbb5f13.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1754737/aee56a28-4c5d-4126-a8df-c7a8dcbb5f13.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"Zimmer\n\nDas ca. 15 m2 große, vollmöblierte Zimmer verfügt über zwei Betten und eignet sich damit sowohl für Einzelpersonen als auch für zwei Personen, die gemeinsam unterwegs sind.\n\nNeben deinem Zimmer kannst du folgende Gemeinschaftsräume nutzen:\n\n•  Großzügiges Wohnzimmer (23 m2) mit Beamer – perfekt für Filmabende oder einen entspannten Abend mit Freunden.\n•  Gemeinsame Küche (11 m2), in der du dich selbst versorgen kannst.\n•  Gemeinsames Bad (3,6 m2).\n•  Westbalkon für die Abendsonne und entspannte Stunden\n\nLage\n\nEinkaufsmöglichkeiten sind ganz in der Nähe: REWE, ALDI, Lidl und dm erreichst du bequem zu Fuß.\n\nAuch die Anbindung passt:\nStraßenbahnhaltestelle Georgi-Marktplatz: ca. 600 m\nBahnhof St. Ilgen: ca. 1,9 km bzw. 5 Minuten mit dem Fahrrad\n\nDamit eignet sich die Wohnung sowohl für einen Aufenthalt in Heidelberg als auch als Ausgangspunkt, um die Umgebung zu erkunden.\n\nIch bin unkompliziert, gesellig und habe grundsätzlich nichts gegen nette Gäste. Ein gemeinsamer Abend, mal etwas unternehmen oder zusammen einen Film über den Beamer schauen? Gerne!\n\nAuch eine Party ist gelegentlich völlig okay – nur eben nicht jeden zweiten Abend. Ich gehöre schließlich schon zur arbeitenden Bevölkerung und brauche zwischendurch auch meine Ruhe.\n\nEin Bier ist meistens vorhanden.\n\nEhrlichkeit und respektvoller Umgang ist mir wichtig\n\nWG-Leben\n\nHier erwartet dich kein anonymes Hostelzimmer und keine überfüllte Jugendherberge, sondern eine schöne Wohnung mit Platz zum Wohlfühlen, einem gemeinsamen Wohnzimmer mit Beamer und einem unkomplizierten WG-Leben.","facilities":{"airConditioning":{"value":"no"},"allergyFriendly":{"value":"no"},"balconyTerrace":{"value":"shared"},"basement":{"value":"shared"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"yes"},"bedroomSize":{"value":"15"},"bedrooms":{"value":"1"},"closet":{"value":"yes"},"couplesAllowed":{"value":"yes"},"desk":{"value":"yes"},"dishwasher":{"value":"yes"},"dryer":{"value":"no"},"electricityCostIncluded":{"value":"yes"},"garden":{"value":"shared"},"gasCostIncluded":{"value":"yes"},"heating":{"value":"central"},"housematesGender":{"value":"shared_w_boys"},"internetCostIncluded":{"value":"yes"},"kitchen":{"value":"shared"},"kitchenware":{"value":"private"},"livingRoom":{"value":"shared"},"parking":{"value":"shared"},"pets":{"value":"no"},"playMusic":{"value":"discussable"},"roomFurniture":{"value":"yes"},"smoking":{"value":"no"},"toilet":{"value":"shared"},"totalSize":{"value":"15"},"tv":{"value":"yes"},"washingMachine":{"value":"yes"},"waterCostIncluded":{"value":"yes"},"wheelchairAccessible":{"value":"no"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":70000,"deposit":96000,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"700.00","deposit":"960.00","agencyFee":"0.00","estimatedBills":"0.00"},"minimumStayMonths":1,"moveInWindow":0,"currentOccupancy":0,"minAge":18,"maxAge":49,"preferredGender":"","available":[{"to":"9999-12-31","from":"2026-11-27"}],"updated":"2026-11-27T22:46:19Z","__utId__":"ut1754737"}]