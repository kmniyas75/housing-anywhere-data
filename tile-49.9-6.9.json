f8fdd9204ee.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1472140/84fa3f73-cd08-452a-b981-af8fdd9204ee.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"This luxurious apartment house with upscale, modern equipment located in Wittlich district Neuerburg. Rheinland-Pfalz. It is located in a quiet, friendly, and international neighborhood, including expats from the US. \n \nThe upper floor (approx. 177 m2) offers a luxurious bright living room with a view into the garden, parquet floors (heated), with a functional fireplace, an open-space dining room, a guest room and bathrooms (shower and bathtub). The modern kitchen has all high-end quality appliances needed. \n \nA cantilevered steel staircase with oak wood steps leads you to the attic floor (approx. 70 m2), divided into 3 bedrooms, the master bedroom with its own shower-bath as well as a large living/playing room with office corner.\n \nOn the ground floor of the property, there is a large office with a separate toilet.\nThe house is modern with high-quality lamps and lights installed. \n \nThis house includes a landscaped garden with a generous area for leisure and recreational activities, including a panoramic view of the neighborhood. \nLandscaping is managed by the property owner. The Lawn area is 500 qm.\nThe house includes also one garage (2 cars) and 2 parking spaces in front of the house. \n","facilities":{"airConditioning":{"value":"no"},"allergyFriendly":{"value":"yes"},"balconyTerrace":{"value":"private"},"basement":{"value":"no"},"bathroom":{"value":"private"},"bed":{"value":"no"},"bedroomFurnished":{"value":"no"},"bedroomLock":{"value":"no"},"bedrooms":{"value":"4"},"closet":{"value":"no"},"couplesAllowed":{"value":"yes"},"desk":{"value":"no"},"dishwasher":{"value":"yes"},"dryer":{"value":"no"},"electricityCostIncluded":{"value":"no"},"flooring":{"value":"wood"},"garden":{"value":"shared"},"gasCostIncluded":{"value":"no"},"heating":{"value":"central"},"internetCostIncluded":{"value":"no"},"kitchen":{"value":"private"},"kitchenware":{"value":"no"},"livingRoom":{"value":"private"},"parking":{"value":"private"},"pets":{"value":"yes"},"playMusic":{"value":"yes"},"registrationPossible":{"value":"yes"},"roomFurniture":{"value":"no"},"smoking":{"value":"outside_only"},"tenantStatus":{"value":"working professionals only"},"toilet":{"value":"private"},"totalSize":{"value":"330"},"tv":{"value":"no"},"washingMachine":{"value":"no"},"waterCostIncluded":{"value":"no"},"wheelchairAccessible":{"value":"no"},"wifi":{"value":"no"}},"costs":{"currency":"EUR","pricing":"monthly","price":220000,"deposit":220000,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"2200.00","deposit":"2200.00","agencyFee":"0.00","estimatedBills":"0.00"},"minimumStayMonths":12,"moveInWindow":0,"currentOccupancy":0,"minAge":0,"maxAge":0,"preferredGender":"","available":[{"to":"9999-12-31","from":"2026-06-08"}],"updated":"2026-06-08T14:45:34Z","__utId__":"ut1472140"}]