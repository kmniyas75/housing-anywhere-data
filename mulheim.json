raum\nHelles Zimmer mit großem Fenster\nModernes, freundliches Ambiente\n\nMiete: 400€ monatlich + 100€ (Nebenkosten)All-Inclusive :\n✔ Internet\n✔ Nebenkosten\n✔ Hausflur-Reinigung\n✔ Strom\n\nDie Wohnung eignet sich perfekt für Studierende oder junge Berufstätige, die eine saubere, ruhige und gut organisierte WG suchen. Einkaufsmöglichkeiten sowie der öffentliche Nahverkehr sind schnell erreichbar, die Essener Innenstadt und Hochschulen sind gut angebunden.\n\nLage: Mülheim Styrum 2,5 km zur Uni und zur HS Ruhr-west\nBezugsfrei: nach Absprache\n\nBei Interesse freuen wir uns über eine kurze Vorstellung deiner Person.","facilities":{"allergyFriendly":{"value":"no"},"balconyTerrace":{"value":"shared"},"basement":{"value":"shared"},"bathroom":{"value":"shared_w_both"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"yes"},"bedroomSize":{"value":"15"},"bedrooms":{"value":"1"},"closet":{"value":"yes"},"desk":{"value":"yes"},"dishwasher":{"value":"yes"},"dryer":{"value":"yes"},"electricityCostIncluded":{"value":"yes"},"garden":{"value":"shared"},"gasCostIncluded":{"value":"yes"},"housematesGender":{"value":"shared_w_both"},"internetCostIncluded":{"value":"yes"},"kitchen":{"value":"shared"},"livingRoom":{"value":"no"},"parking":{"value":"shared"},"pets":{"value":"no"},"registrationPossible":{"value":"yes"},"toilet":{"value":"shared"},"totalSize":{"value":"97"},"tv":{"value":"yes"},"washingMachine":{"value":"yes"},"waterCostIncluded":{"value":"yes"},"wheelchairAccessible":{"value":"no"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":50000,"deposit":0,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"500.00","deposit":"0.00","agencyFee":"0.00","estimatedBills":"0.00"},"minimumStayMonths":6,"moveInWindow":0,"currentOccupancy":5,"minAge":0,"maxAge":0,"preferredGender":"","available":[{"to":"9999-12-31","from":"2026-04-09"}],"updated":"2026-04-09T16:45:47Z","__utId__