o=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}},{"originalLink":"https://housinganywhere.imgix.net/unit_type/1627093/4ae64c87-b4f4-47f8-9583-261d0d99af21.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","categories":["livingroom"],"sizes":{"1024x768":{"link":"https://housinganywhere.imgix.net/unit_type/1627093/4ae64c87-b4f4-47f8-9583-261d0d99af21.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/unit_type/1627093/4ae64c87-b4f4-47f8-9583-261d0d99af21.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1627093/4ae64c87-b4f4-47f8-9583-261d0d99af21.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1627093/4ae64c87-b4f4-47f8-9583-261d0d99af21.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1627093/4ae64c87-b4f4-47f8-9583-261d0d99af21.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}},{"originalLink":"https://housinganywhere.imgix.net/unit_type/1627093/a0e33bca-5b1b-4858-9c93-dce8c113ac90.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","categories":["livingroom"],"sizes":{"1024x768":{"link":"https://housinganywhere.imgix.net/unit_type/1627093/a0e33bca-5b1b-4858-9c93-dce8c113ac90.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/unit_type/1627093/a0e33bca-5b1b-4858-9c93-dce8c113ac90.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1627093/a0e33bca-5b1b-4858-9c93-dce8c113ac90.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1627093/a0e33bca-5b1b-4858-9c93-dce8c113ac90.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1627093/a0e33bca-5b1b-4858-9c93-dce8c113ac90.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"Willkommen in unserer gemütlichen Ferienwohnung, die mit viel Liebe zum Detail eingerichtet wurde, um Ihnen einen angenehmen und erholsamen Aufenthalt zu bieten. Die Wohnung verfügt über ein Schlafzimmer, ein Bad, ein Wohnzimmer mit einem komfortablen Schlafsofa (140x200 cm) sowie eine gut ausgestattete Küche, die Ihnen die Freiheit gibt, Ihre eigenen Mahlzeiten zuzubereiten.\n\nWas macht unsere Unterkunft einzigartig? Die Wohnung kombiniert modernen Komfort mit einer warmen, einladenden Atmosphäre, die sofort das Gefühl von Zuhause vermittelt. Das Schlafzimmer ist mit einem bequemen Bett ausgestattet, ideal für eine erholsame Nacht. Im Wohnzimmer haben wir ein Schlafsofa integriert, das auch für zusätzliche Gäste oder Familienmitgliedern einen angenehmen Schlafplatz bietet.\n\nIn der Küche finden Sie alles, was Sie benötigen, um Ihre Lieblingsgerichte zu kochen – von hochwertigen Kochutensilien bis hin zu praktischen Geräten wie einem Kühlschrank, einer Kaffeemaschine und einem Herd.\n\nBesondere Details wie eine stilvolle Einrichtung, warme Farben und durchdachte Dekorationen machen den Aufenthalt noch angenehmer. Zudem bieten wir kostenfreies WLAN und einen Smart-TV, sodass Sie sich nach einem langen Tag entspannen und Unterhaltung genießen können.\n\nWir möchten, dass Sie sich bei uns wie zu Hause fühlen. Deshalb legen wir großen Wert auf Details, die den Aufenthalt noch komfortabler machen – sei es durch frische Handtücher, einen kleinen Willkommensgruß oder Tipps für die Umgebung.\n\nLassen Sie den Alltag hinter sich und genießen Sie Ihre Auszeit in unserer besonderen Ferienwohnung. Wir freuen uns darauf, Sie willkommen zu heißen!","facilities":{"airConditioning":{"value":"no"},"allergyFriendly":{"value":"no"},"balconyTerrace":{"value":"private"},"basement":{"value":"no"},"bathroom":{"value":"private"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"yes"},"bedrooms":{"value":"1"},"closet":{"value":"yes"},"couplesAllowed":{"value":"yes"},"desk":{"value":"no"},"dishwasher":{"value":"yes"},"dryer":{"value":"yes"},"electricityCostIncluded":{"value":"yes"},"flooring":{"value":"stone"},"garden":{"value":"no"},"gasCostIncluded":{"value":"yes"},"heating":{"value":"central"},"internetCostIncluded":{"value":"yes"},"kitchen":{"value":"private"},"kitchenware":{"value":"private"},"livingRoom":{"value":"private"},"parking":{"value":"private"},"pets":{"value":"discussable"},"playMusic":{"value":"no"},"registrationPossible":{"value":"yes"},"roomFurniture":{"value":"yes"},"smoking":{"value":"outside_only"},"toilet":{"value":"private"},"totalSize":{"value":"58"},"tv":{"value":"yes"},"washingMachine":{"value":"yes"},"waterCostIncluded":{"value":"yes"},"wheelchairAccessible":{"value":"no"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":150000,"deposit":0,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"1500.00","deposit":"0.00","agencyFee":"0.00","estimatedBills":"0.00"},"minimumStayMonths":0,"moveInWindow":0,"currentOccupancy":0,"minAge":0,"maxAge":0,"preferredGender":"","available":[{"to":"2026-09-13","from":"2026-09-10"},{"to":"2026-09-27","from":"2026-09-25"},{"to":"2026-10-09","from":"2026-10-08"},{"to":"2026-10-23","from":"2026-10-17"},{"to":"2026-11-24","from":"2026-10-31"},{"to":"2026-12-25","from":"2026-11-27"},{"to":"9999-12-31","from":"2027-01-02"}],"updated":"2026-08-24T21:46:15Z","__utId__":"ut1627093"}]