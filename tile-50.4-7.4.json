5/770f67d4-03b8-48b3-b954-770b4272201f.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","categories":null,"sizes":{"1024x768":{"link":"https://housinganywhere.imgix.net/unit_type/1569045/770f67d4-03b8-48b3-b954-770b4272201f.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/unit_type/1569045/770f67d4-03b8-48b3-b954-770b4272201f.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1569045/770f67d4-03b8-48b3-b954-770b4272201f.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1569045/770f67d4-03b8-48b3-b954-770b4272201f.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1569045/770f67d4-03b8-48b3-b954-770b4272201f.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}},{"originalLink":"https://housinganywhere.imgix.net/unit_type/1569045/a4225854-0e78-4b2b-a150-476677cf57c6.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","categories":null,"sizes":{"1024x768":{"link":"https://housinganywhere.imgix.net/unit_type/1569045/a4225854-0e78-4b2b-a150-476677cf57c6.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/unit_type/1569045/a4225854-0e78-4b2b-a150-476677cf57c6.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1569045/a4225854-0e78-4b2b-a150-476677cf57c6.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1569045/a4225854-0e78-4b2b-a150-476677cf57c6.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1569045/a4225854-0e78-4b2b-a150-476677cf57c6.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"Willkommen in meiner kleinen Oase. Mein geräumiges Apartment mitten in Neuwied bietet dir - mit insgesamt bis zu 6 Gästen - einen angenehmen Aufenthalt.\n\n→ 2 Schlafzimmer (1 mit Queensizebett, das andere mit zwei Einzelbetten, die zu einem Doppelbett werden können)\n→ Küche mit Geschirrspüler, Nespresso uvm.\n→ bequemes Schlafsofa für den 5. und 6. Gast\n→ SmartTV, Netflix\n→ Balkon mit Blick auf die Marktkirche\n→ super zentral\n→ privater Parkplatz\n\nDie Unterkunft\nWusstest du, dass die Farbe grün eine beruhigende, entspannende Wirkung auf die Augen und den Geist hat?\nMeine Wohnung Jungle Eleganza steht ganz im Motto grün, grün, grün und lädt zum Entspannen ein.\n\nStell dir vor, du wachst hier auf. Die Morgensonne kitzelt dich wach, der Blick aus den Schlafzimmern zeigt dir die schöne Marktkirche. Vielleicht ist gerade Markttag und du kannst ein paar leckere Dinge fürs Frühstück kaufen - Marktplatz und Fußgängerzone sind gleich um die Ecke.\nAuf dem gemütlichen Balkon könnt ihr dazu im Sonnenschein einen Kaffee aus unserer Nespresso Maschine genießen. Keine Sorge, auch an die Teetrinker sei gedacht, wir haben verschiedene Teesorten für euch bereitgestellt.\n\nDie Küche ist komplett ausgestattet mit allem, was das Kochherz begehrt. Auch meine Lieblingsgewürze und Öl stehen direkt für euch bereit.\nDer wunderschöne Holz-Esstisch steht imposant in der Mitte des 50qm Zimmers.\n\nDunkle Holztöne, grün und schwarz/anthrazit ziehen sich durch das komplette Wohnkonzept. Und natürlich Pflanzen. Die grüne Samtcouch lädt zum Relaxen ein. Vielleicht deine Lieblings-Netflixserie dazu? Kein Problem mit dem 55 Zoll Smart TV.\n\nNun die Qual der Wahl - welches Zimmer? Zur Wahl stehen das tropical Zimmer mit Queensize Doppelbett und das petrolfarbene Zimmer mit süßer Affenlampe und zwei Einzelbetten, die nach Wahl auch zum Doppelbett zusammengeschoben werden können. Beide Zimmer sind liebevoll dekoriert und mit qualitativen Matratzen, Bettdecken und zahlreichen Kissen ausgestattet. In einem Schlafzimmer befindet sich außerdem ein Arbeitsplatz mit Schreibtisch.\n\nIhr seid mehr als vier Personen? Kein Problem. Das Samtsofa lässt sich mit einem Handgriff in ein 140x200 Schlafsofa umwandeln - super bequem (sagen meine Gäste).\n\nDas Badezimmer ist frisch renoviert und hat eine moderne ebenerdige Dusche und eine schöne Badewanne. Handtücher und Duschgel/Shampoo stelle ich euch selbstverständlich zur Verfügung.\nAlso - was gibt es besseres als ein Schaumbad nach einem langen Tag in der City? Ja, vielleicht ein Gläschen Wein auf meinem gemütlichen Balkon mit Blick auf die Marktkirche, der abends voller Lichterketten wundervoll strahlt.\nEine weitere Gästetoilette steht euch übrigens zusätzlich zur Verfügung.\n\nFalls ihr euer jüngstes Familienmitglied mitbringt, habe ich für euch auch ein Baby Reisebett und einen Babystuhl in der Wohnung. Ich liebe Spiele - und ihr? Unterm TV findet ihr eine Auswahl an Spielen für einen geselligen Abend.\n\nWaschmaschine, Trockner, Bügeleisen und privater Parkplatz stehen zu eurer freien Verfügung.\nFühlt euch einfach wie zuhause in meinem kleinen Jungle.\nZugang für Gäste\nDie gesamte Wohnung inklusive Balkon steht zu eurer Verfügung. Sie befindet sich in der zweiten Etage - natürlich gibt es einen Aufzug.\nWeitere wichtige Hinweise\nMit Buchung stimmt ihr automatisch unseren Hausregeln zu.\n\nIn der Wohnung ist ein Dezibelmesser im Wohnzimmer installiert. Die Dezibelmesser nehmen ausschließlich den Lärmpegel 24h am Tag auf.\n\nVor dem Check-in muss ein Anmeldeformular ausgefüllt werden.\n\nZusätzliche Dienstleistungen:\n- späterer Check-out unterliegt der Verfügbarkeit und kann gegen Aufpreis gebucht werden\n- Reinigung während des Aufenthalts kann ebenfalls gegen Aufpreis gebucht werden","facilities":{"airConditioning":{"value":"no"},"allergyFriendly":{"value":"yes"},"balconyTerrace":{"value":"private"},"basement":{"value":"no"},"bathroom":{"value":"private"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"no"},"bedrooms":{"value":"2"},"closet":{"value":"yes"},"couplesAllowed":{"value":"yes"},"desk":{"value":"yes"},"dishwasher":{"value":"yes"},"dryer":{"value":"yes"},"electricityCostIncluded":{"value":"no"},"flooring":{"value":"wood"},"garden":{"value":"no"},"gasCostIncluded":{"value":"no"},"heating":{"value":"central"},"internetCostIncluded":{"value":"no"},"kitchen":{"value":"private"},"kitchenware":{"value":"private"},"livingRoom":{"value":"private"},"parking":{"value":"private"},"pets":{"value":"no"},"playMusic":{"value":"no"},"registrationPossible":{"value":"no"},"roomFurniture":{"value":"yes"},"smoking":{"value":"no"},"toilet":{"value":"private"},"totalSize":{"value":"100"},"tv":{"value":"yes"},"washingMachine":{"value":"yes"},"waterCostIncluded":{"value":"no"},"wheelchairAccessible":{"value":"yes"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":270000,"deposit":100000,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"2700.00","deposit":"1000.00","agencyFee":"0.00","estimatedBills":"0.00"},"minimumStayMonths":0,"moveInWindow":0,"currentOccupancy":0,"minAge":0,"maxAge":0,"preferredGender":"","available":[{"to":"2026-06-23","from":"2026-06-21"},{"to":"2026-06-26","from":"2026-06-26"},{"to":"2026-07-17","from":"2026-07-04"},{"to":"2026-07-27","from":"2026-07-25"},{"to":"9999-12-31","from":"2026-07-31"}],"updated":"2026-06-19T09:35:22Z","__utId__":"ut1569045"},{"id":"1704976","rank":107,"rating":0,"published":"2026-05-06","kind":1,"kindLabel":"entire place","type":3,"typeLabel":"apartment","rentType":"monthly","title":"Im Wohnpark Nette, Weißenthurm","cancellationPolicy":"strict","