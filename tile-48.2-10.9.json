ith dining area\n✔ High-speed WiFi\n✔ All utilities (heating, electricity, water) – no hidden costs\n✔ Washing machine available\n✔ 2 bathrooms (1 large, 1 small)\nLocation – the highlight:\n✔ Mering St. Afra station: 10–15 min walk\n✔ Munich Hauptbahnhof: 30 min by train (2–3 trains per hour!)\n✔ TH Augsburg: 10 min | Augsburg University: 26 min\n✔ Supermarkets & daily amenities within walking distance\n✔ Mering is a quiet, green town just outside the city – the best of both worlds\nFlatmate situation:\n✔ Students, professionals & internationals very welcome\n✔ Not a party flat – quiet & respectful living expected\nSend me a short intro: your name, occupation/studies, and planned move-in date.","facilities":{"airConditioning":{"value":"no"},"allergyFriendly":{"value":"no"},"balconyTerrace":{"value":"no"},"basement":{"value":"no"},"bathroom":{"value":"shared_w_both"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"yes"},"bedroomSize":{"value":"16"},"bedrooms":{"value":"1"},"closet":{"value":"yes"},"couplesAllowed":{"value":"no"},"desk":{"value":"yes"},"dishwasher":{"value":"yes"},"dryer":{"value":"no"},"electricityCostIncluded":{"value":"yes"},"flooring":{"value":"wood"},"garden":{"value":"no"},"gasCostIncluded":{"value":"yes"},"heating":{"value":"gas"},"housematesGender":{"value":"shared_w_both"},"internetCostIncluded":{"value":"yes"},"kitchen":{"value":"shared"},"kitchenware":{"value":"shared"},"livingRoom":{"value":"no"},"parking":{"value":"no"},"pets":{"value":"no"},"playMusic":{"value":"yes"},"registrationPossible":{"value":"yes"},"roomFurniture":{"value":"no"},"smoking":{"value":"no"},"toilet":{"value":"shared"},"totalSize":{"value":"16"},"tv":{"value":"no"},"washingMachine":{"value":"yes"},"waterCostIncluded":{"value":"yes"},"wheelchairAccessible":{"value":"no"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":57000,"deposit":20000,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR