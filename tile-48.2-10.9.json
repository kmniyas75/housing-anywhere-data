where.imgix.net/unit_type/1708912/7d109884-54f2-4679-91fa-8c857a08d7fc.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1708912/7d109884-54f2-4679-91fa-8c857a08d7fc.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1708912/7d109884-54f2-4679-91fa-8c857a08d7fc.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1708912/7d109884-54f2-4679-91fa-8c857a08d7fc.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"Großes WG-Zimmer für 2 Personen mit Terrassenzugang – nur 30 Minuten nach München per Zug!\nEnglish Version below!\nVerfügbar: 1. Juni bis 30. September | Option auf Verlängerung danach möglich\n\nIhr seid zu zweit und sucht eine gemeinsame Unterkunft im Großraum München? Dieses großzügige 24 m2-Zimmer mit direktem Zugang zur Terrasse und kleinem Garten ist perfekt für Paare, Arbeitskollegen oder zwei Freunde.\nAuch alleine anmietbar (halbes Zimmer)!\n\n24 m2 Zimmer → 390 € p.P. All-Inclusive (780 € gesamt)\n\nWas ist inklusive?\n✔ Großes vollmöbliertes Zimmer für 2 Personen (Betten, Schränke, Schreibtische, Stühle)\n✔ Exklusiver Terrassenzugang mit kleinem Garten – nur dieses Zimmer!\n✔ Große Küche mit Essbereich (gemeinsam genutzt)\n✔ High-Speed-WLAN\n✔ Alle Nebenkosten (Heizung, Strom, Wasser) – keine versteckten Kosten\n✔ Waschmaschine vorhanden\n✔ 2 Bäder (1 großes, 1 kleines)\nLage:\n✔ Bahnhof Mering St. Afra: 10–15 Min. zu Fuß\n✔ München Hbf: 30 Min. per Zug (2–3x pro Stunde!)\n✔ TH Augsburg: 10 Min. | Uni Augsburg: 26 Min.\n✔ Supermärkte & Alltagsgeschäfte fußläufig erreichbar\nFür wen ist dieses Zimmer ideal?\n✔ Paare, die gemeinsam eine unkomplizierte Unterkunft suchen\n✔ Arbeitskollegen, die zusammen im Großraum München tätig sind\n✔ Zwei Freunde, die Kosten teilen möchten\n✔ Internationale Mitbewohner herzlich willkommen\n✔ Keine Party-WG – ruhiges & respektvolles Zusammenleben\nSchreibt uns mit kurzem Steckbrief: Namen, Beruf/Studium, Einzugsdatum.\n\nENGLISH VERSION:\nLarge room for 2 people with private terrace access – just 30 minutes to Munich by train!\nAvailable: 1st June to 30th September | Extension possible thereafter\n\nLooking for a place to share as a couple or with a colleague? This spacious 24 m2 room with direct access to a private terrace and small garden is the perfect base near Munich – whether you're commuting to the city or studying nearby.\nMove in together, no hassle, everything included.\nPossible to rent alone (shared bedroom)!\n\n24 m2 room → €390/person All-Inclusive (€780 total)\n\nWhat's included?\n✔ Large fully furnished room for 2 (beds, wardrobes, desks, chairs)\n✔ Exclusive terrace access with small garden – only this room has it!\n✔ Large shared kitchen with dining area\n✔ High-speed WiFi\n✔ All utilities (heating, electricity, water) – no hidden costs\n✔ Washing machine available\n✔ 2 bathrooms (1 large, 1 small)\nLocation – the highlight:\n✔ Mering St. Afra station: 10–15 min walk\n✔ Munich Hauptbahnhof: 30 min by train (2–3 trains per hour!)\n✔ TH Augsburg: 10 min | Augsburg University: 26 min\n✔ Supermarkets & daily amenities within walking distance\n✔ Mering is a quiet, green town just outside the city – the best of both worlds\nWho is this room ideal for?\n✔ Couples looking for a shared, hassle-free place near Munich\n✔ Colleagues working together in the greater Munich area\n✔ Two friends wanting to split costs\n✔ Internationals & expats very welcome\n✔ Not a party flat – quiet & respectful living expected\nSend us a short intro: your names, occupation/studies, and planned move-in date.","facilities":{"airConditioning":{"value":"no"},"allergyFriendly":{"value":"no"},"balconyTerrace":{"value":"private"},"basement":{"value":"no"},"bathroom":{"value":"shared_w_both"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"yes"},"bedroomSize":{"value":"24"},"bedrooms":{"value":"1"},"closet":{"value":"yes"},"couplesAllowed":{"value":"no"},"desk":{"value":"yes"},"dishwasher":{"value":"yes"},"dryer":{"value":"no"},"electricityCostIncluded":{"value":"yes"},"flooring":{"value":"wood"},"garden":{"value":"private"},"gasCostIncluded":{"value":"yes"},"heating":{"value":"gas"},"housematesGender":{"value":"shared_w_both"},"internetCostIncluded":{"value":"yes"},"kitchen":{"value":"shared"},"kitchenware":{"value":"shared"},"livingRoom":{"value":"no"},"parking":{"value":"no"},"pets":{"value":"no"},"playMusic":{"value":"yes"},"registrationPossible":{"value":"yes"},"roomFurniture":{"value":"no"},"smoking":{"value":"no"},"toilet":{"value":"shared"},"totalSize":{"value":"23"},"tv":{"value":"no"},"washingMachine":{"value":"yes"},"waterCostIncluded":{"value":"yes"},"wheelchairAccessible":{"value":"no"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":39000,"deposit":20000,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"390.00","deposit":"200.00","agencyFee":"0.00","estimatedBills":"0.00"},"minimumStayMonths":4,"moveInWindow":0,"currentOccupancy":3,"minAge":0,"maxAge":0,"preferredGender":"","available":[{"to":"9999-12-31","from":"2026-05-21"}],"updated":"2026-05-21T05:35:26Z","__utId__":"ut1708912"}]