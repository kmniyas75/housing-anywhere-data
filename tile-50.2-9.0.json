w=800","width":800,"height":600}}},{"originalLink":"https://housinganywhere.imgix.net/unit_type/1473661/af70c727-c067-474e-91a5-659678823df1.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","categories":null,"sizes":{"1024x768":{"link":"https://housinganywhere.imgix.net/unit_type/1473661/af70c727-c067-474e-91a5-659678823df1.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/unit_type/1473661/af70c727-c067-474e-91a5-659678823df1.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1473661/af70c727-c067-474e-91a5-659678823df1.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1473661/af70c727-c067-474e-91a5-659678823df1.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1473661/af70c727-c067-474e-91a5-659678823df1.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}},{"originalLink":"https://housinganywhere.imgix.net/unit_type/1473661/45418d61-9077-4bb7-8a1b-54c3d08cc9fd.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","categories":null,"sizes":{"1024x768":{"link":"https://housinganywhere.imgix.net/unit_type/1473661/45418d61-9077-4bb7-8a1b-54c3d08cc9fd.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/unit_type/1473661/45418d61-9077-4bb7-8a1b-54c3d08cc9fd.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1473661/45418d61-9077-4bb7-8a1b-54c3d08cc9fd.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1473661/45418d61-9077-4bb7-8a1b-54c3d08cc9fd.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1473661/45418d61-9077-4bb7-8a1b-54c3d08cc9fd.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"Stylish, spacious house in clean, safe and peaceful environment - Just 25 Minutes from Frankfurt.\n\nTo combine the advantages of living in a metropolis and at the same time enjoying peace and nature is not too easy to achieve. Especially when you live nearby an international airport. Well, this is the quality of life offered by the community of Hammersbach, 25 minutes away from downtown Frankfurt. Fresh air, wide fields and nearby forests are safe from highway or plane noise. Moreover, you reach to any time to Brother Grimm City -  Hanau with its beautiful marketplace and farmers’ market within 10 minutes and the international airport as well as downtown Frankfurt within 25 minutes by car. Alternatively you commute by train from Hanau train station downtown Frankfurt. Services for a comfortable life, i.e. supermarkets, drugstore, 2 kindergartens, schools, playgrounds, pharmacy and doctors are available from 7 am to 9 pm – in 5 minutes distance.\n\nLiving at the hills provides the view which is just marvelous - over the area up to the mountains of the Taunus forests. A small talk or more is appreciated by our neighborhood – all of them kind and nice. The dead end road elevates the quality of living by nearly no traffic. \n\nThe house was constructed  in 2013. It has a sense of Mediterranean design and built to fulfill all the requirements.  There is plenty of light shining brightly through  12 windows besides 2 electric roof windows! The result is an extraordinary low energy consumption, friendly to our resources and for sure to the budget. Enjoy your breakfast and lunch at the sunny terrace in south east direction in front of the house and dinner during astonishing sunsets on the 21 square meter large balcony in south west direction, why not with a glass of wine. In between the mentioned outdoor areas you find the kitchen, living and dining room.  The large chimney sweetens the cold and dark winter season and supports with a max 14 KW output the central heating system. As in all levels the upper one provides flooring heating.  \n\nOne level down you can relax in the “Hamam Style” bathroom equipped with a bio sauna. For working couples all elements for your morning toilet are available two times to prevent a loss of valuable time. The Italian made washboards and bowls, mirrors and the large showering areas allow a swift morning process for the entire family. \n","facilities":{"airConditioning":{"value":"no"},"allergyFriendly":{"value":"yes"},"balconyTerrace":{"value":"private"},"basement":{"value":"private"},"bathroom":{"value":"private"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"yes"},"bedrooms":{"value":"3"},"closet":{"value":"yes"},"couplesAllowed":{"value":"yes"},"desk":{"value":"yes"},"dishwasher":{"value":"yes"},"dryer":{"value":"no"},"electricityCostIncluded":{"value":"no"},"flooring":{"value":"stone"},"garden":{"value":"private"},"gasCostIncluded":{"value":"no"},"heating":{"value":"central"},"internetCostIncluded":{"value":"no"},"kitchen":{"value":"private"},"kitchenware":{"value":"private"},"livingRoom":{"value":"private"},"parking":{"value":"private"},"pets":{"value":"discussable"},"playMusic":{"value":"yes"},"registrationPossible":{"value":"yes"},"roomFurniture":{"value":"yes"},"smoking":{"value":"discussable"},"tenantStatus":{"value":"working professionals only"},"toilet":{"value":"private"},"totalSize":{"value":"200"},"tv":{"value":"yes"},"washingMachine":{"value":"yes"},"waterCostIncluded":{"value":"no"},"wheelchairAccessible":{"value":"yes"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":470000,"deposit":940000,"agencyFee":5000,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"4700.00","deposit":"9400.00","agencyFee":"50.00","estimatedBills":"0.00"},"minimumStayMonths":12,"moveInWindow":0,"currentOccupancy":0,"minAge":25,"maxAge":0,"preferredGender":"","available":[{"to":"9999-12-31","from":"2026-08-25"}],"updated":"2026-08-25T07:45:36Z","__utId__":"ut1473661"}]