ganywhere.imgix.net/room/1789972/fc6e8e97-d52f-46b8-9046-d770d1e23728.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","categories":null,"sizes":{"1024x768":{"link":"https://housinganywhere.imgix.net/room/1789972/fc6e8e97-d52f-46b8-9046-d770d1e23728.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/room/1789972/fc6e8e97-d52f-46b8-9046-d770d1e23728.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/room/1789972/fc6e8e97-d52f-46b8-9046-d770d1e23728.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/room/1789972/fc6e8e97-d52f-46b8-9046-d770d1e23728.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/room/1789972/fc6e8e97-d52f-46b8-9046-d770d1e23728.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}},{"originalLink":"https://housinganywhere.imgix.net/room/1789972/dc11ac9a-6438-4558-a3ea-aa43430f3567.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","categories":null,"sizes":{"1024x768":{"link":"https://housinganywhere.imgix.net/room/1789972/dc11ac9a-6438-4558-a3ea-aa43430f3567.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/room/1789972/dc11ac9a-6438-4558-a3ea-aa43430f3567.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/room/1789972/dc11ac9a-6438-4558-a3ea-aa43430f3567.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/room/1789972/dc11ac9a-6438-4558-a3ea-aa43430f3567.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/room/1789972/dc11ac9a-6438-4558-a3ea-aa43430f3567.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"LIVE FULLY. A Student Residence. Just Better!\n\nWelcome to our student residence in Bremen. With 335 modern, fully furnished single and double studios, spread over three house sections, students from all over the world will find a new home - in one of the most magnificent port cities in Europe! We have the perfect combination between your own living space and a great community:\n\nMeet your roommates at a table football tournament in the Community Lounge or watch a movie in the Movie Lounge. Study together in the study room or have a barbecue outside on the huge green area behind the building. Explore culinary highlights with your fellow roommates in the community kitchen. Everything in a central location in the north of the city, just a few minutes' walk from the campus, with a tram and shops directly opposite.\n\nTake a look at our 3D tour and get a first impression of what your life with us could look like.\n\nSIMPLY PULL IN AND FEEL COMFORTABLE\nOur house manager Frank will take care of your concerns from the moment you move in and, for example, receive your parcels or provide you with free loan equipment (such as vacuum cleaners or irons). A central main entrance, to which you have access via a chip, and video surveillance of all entrances and exits ensure additional security.\n\nComfortable living just a stone's throw from the university\nYour apartment offers you a bright living room with bed including mattress, desk with chair, cloakroom with mirror, light-proof curtains, intercom and generally extra storage space. The pantry kitchen is equipped with two ceramic hobs, a combination microwave, fridge with freezer compartment, a sink and counter. The modern tiled shower room with underfloor heating offers additional storage space in addition to the toilet, washstand with mirror.\n\nAll services and ancillary costs such as heating and hot water as well as internet are included in the rent.\nYou can not only choose the size of your apartment, but also which floor you want to live on. Choose between our single studios between 17-22m2 or move into one of our double studios between 36-39m2 if you need a little more space. There is sure to be just the right apartment for you.\n\n*The photos shown are sample images.\n** Our studios are available in different sizes and prices. Please visit our website for more information.\n\nLOCATION\n•\tDirect route to the University of Bremen (on the opposite side of the street) and to the city centre\n•\tDrug stores and supermarkets, restaurants in the immediate vicinity\n\nYOUR HIGHLIGHTS\n•\tAll-in rent (including electricity, heating and water costs and internet at a monthly flat rate\n•\tCommon rooms: get to know your roommates while cooking in the communal kitchen, chilling out in the community lounge with gaming area or while buffing in the study rooms - including washing and drying rooms.\n•\tBicycle cellar: Park your bike safely in the lockable bicycle cellar.\n•\tUnderground car park: Your car is also kept safe and dry.\n•\tParcel acceptance during opening hours at the reception\n•\tFree rental of household appliances (vacuum cleaner, iron, etc.)\n•\tExclusive partner deals: save outside at selected locations with your Member Card\n•\tRegular events and activities\n•\tA community that gives you the opportunity to make friends out of neighbors\n\nYOUR ALL-IN PRICE\n\nIn our community,  you get a complete living concept and not just an apartment! Your all-in price includes the following services:\nApartment services\n\n•\tApartment\n•\tFurniture\n•\tUtilities (water, electricity)\n•\tInternet\n\nLiving Services\n\n•\tReception/House Management/House Technician\n•\tRental items (vacuum cleaner, iron, games, etc.)\n•\tParcel acceptance\n•\tCommon rooms\n•\tEvents\n\nTip: Benefit from the best offer: The earlier you book and the longer you stay, the better the price offer will be.\n\n- Deposit: ✔3x Cold Rent \n-Admission Fee:  ✔ 99€\n\n **Please note that the rent written on the listing is (hidden) rent. There is a surcharge for quieter apartments facing the courtyard or for apartments on a higher floor level. Deposit may change depending on your chosen rental period or features of your preferred apartment. If you are interested, do let us know and we will send you the offer!\n\nPlease be aware that HousingAnywhere is an online booking platform. Therefore, exchanging contact details and offering viewings is not possible. If you would like to reserve this accommodation, send me a booking request or a message, and please mention your age and occupation. I look forward to meeting you!","facilities":{"airConditioning":{"value":"no"},"allergyFriendly":{"value":"no"},"balconyTerrace":{"value":"no"},"basement":{"value":"no"},"bathroom":{"value":"private"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"yes"},"bedrooms":{"value":"0"},"cleaningCommonRoomsIncluded":{"value":"yes"},"cleaningPrivateRoomIncluded":{"value":"no"},"closet":{"value":"yes"},"couplesAllowed":{"value":"no"},"desk":{"value":"yes"},"dishwasher":{"value":"no"},"dryer":{"value":"yes"},"electricityCostIncluded":{"value":"yes"},"garden":{"value":"shared"},"gasCostIncluded":{"value":"yes"},"heating":{"value":"central"},"internet":{"value":"yes"},"internetCostIncluded":{"value":"yes"},"kitchen":{"value":"private"},"kitchenware":{"value":"no"},"livingRoom":{"value":"private"},"parking":{"value":"no"},"pets":{"value":"no"},"playMusic":{"value":"no"},"registrationPossible":{"value":"yes"},"roomFurniture":{"value":"yes"},"smoking":{"value":"no"},"tenantStatus":{"value":"students only"},"toilet":{"value":"private"},"totalSize":{"value":"17"},"tv":{"value":"no"},"washingMachine":{"value":"yes"},"waterCostIncluded":