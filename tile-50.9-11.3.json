ität. Da ich ein Auslandssemester von Juli 2026 bis Januar 2027 mache wird die Wohnung nur temporär vergeben. Besichtigungen sind vor Ort nach Absprache möglich. Am liebsten wäre mir eine Nutzung für den gesamten Zeitraum. Die Wohnung ist voll möbliert, es gibt Geschirr, Bettwäsche und genug Platz für Kleidung und Anderes.","facilities":{"airConditioning":{"value":"no"},"allergyFriendly":{"value":"no"},"balconyTerrace":{"value":"no"},"basement":{"value":"no"},"bathroom":{"value":"private"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"yes"},"bedrooms":{"value":"1"},"closet":{"value":"yes"},"couplesAllowed":{"value":"yes"},"desk":{"value":"no"},"dishwasher":{"value":"no"},"dryer":{"value":"no"},"electricityCostIncluded":{"value":"yes"},"flooring":{"value":"laminate"},"garden":{"value":"no"},"gasCostIncluded":{"value":"yes"},"gender":{"value":"male"},"heating":{"value":"central"},"internetCostIncluded":{"value":"no"},"kitchen":{"value":"private"},"kitchenware":{"value":"private"},"livingRoom":{"value":"private"},"parking":{"value":"shared"},"pets":{"value":"discussable"},"playMusic":{"value":"discussable"},"registrationPossible":{"value":"no"},"roomFurniture":{"value":"yes"},"smoking":{"value":"no"},"toilet":{"value":"private"},"totalSize":{"value":"30"},"tv":{"value":"no"},"washingMachine":{"value":"yes"},"waterCostIncluded":{"value":"yes"},"wheelchairAccessible":{"value":"no"},"wifi":{"value":"no"}},"costs":{"currency":"EUR","pricing":"monthly","price":50000,"deposit":50000,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"500.00","deposit":"500.00","agencyFee":"0.00","estimatedBills":"0.00"},"minimumStayMonths":3,"moveInWindow":0,"currentOccupancy":0,"minAge":18,"maxAge":0,"preferredGender":"","available":[{"to":"9999-12-31","from":"2026-07-15"}],"updated":"2026-06-19T20:10:42Z","__utId__":"ut1711302"}]