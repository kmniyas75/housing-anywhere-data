=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1679145/385316ab-3050-4195-95a5-0d39ed507adb.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1679145/385316ab-3050-4195-95a5-0d39ed507adb.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1679145/385316ab-3050-4195-95a5-0d39ed507adb.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"\nDiese luxuriös ausgestattete WG mit 3 Zimmern für StudentInnen, 2 Bädern, offener Küche und einem XXL Living Room im Erdgeschoss eines charmanten 2-Familienhauses in ruhiger Lage in Pfungstadt Süd bietet auf ca. 120 m^2 Wohnfläche ein exklusives Wohnerlebnis. Die Wohnung wurde im Jahr 2024/25 umfassend renoviert und saniert.\nDie Wohnung präsentiert sich in einem erstklassigen Zustand. Sie verfügt über ein sehr großzügiges Raumangebot.\nZwei neue luxuriöse Tageslicht-Badezimmer mit Dusche sind vorhanden. Die Vollholzküche mit Speisekammer öffnet sich zum XXL Livingroom mit beheiztem Wintergarten.. Dazu gibt es eine windgeschützte Sonnenterrasse.\nEin Bauantrag für eine weitere überdachte Terrasse von fast 30m^2 ist in Bearbeitung. Eines der Schlafzimmer hat 15m^2 und kostet monatlich 500€ plus 100€ (wieder frei ab 01.09.26) ein weiteres Schlafzimmer misst ca. 12m^2 für monatlich 440€ plus 100€ (wieder frei ab 01.09.28) Um die Qualität der Wohnung auf hohem Niveau zu halten, wird die Wohnung wöchentlich gereinigt. ;)\n\nLage\nPfungstadt bietet eine gute Infrastruktur mit zahlreichen Einkaufsmöglichkeiten für den täglichen Bedarf, Gastronomie sowie ärztlicher Versorgung. Die Bushaltestelle befindet sich in unmittelbarer Nahe, ebenso ist man schnell auf Spazierwegen in die Natur. Ein türkischer Supermarkt, Pizzaservice, Post, Reinigung und ein Bäcker liegen direkt um die Ecke. Sehr viele Supermärkte sind mit dem Auto innerhalb von 5 Minuten zu erreichen.\nAutobahn liegt in beide Richtungen 6 min entfernt, Zug auch.\n\nWG-Leben\nLockere, offene und nette Atmosphäre. Faire Arbeitsaufteilung. Gerne auch mal zusammen chillen, kochen oder what ever. Nach dem Motto better together :)\nKeine Parties, keine Unter-/Weitervermietung, keine Haustiere, ausschliesslich an Nichtraucherlnnen","facilities":{"airConditioning":{"value":"no"},"allergyFriendly":{"value":"no"},"balconyTerrace":{"value":"shared"},"basement":{"value":"no"},"bathroom":{"value":"shared_w_both"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"yes"},"bedroomSize":{"value":"120"},"bedrooms":{"value":"1"},"closet":{"value":"yes"},"couplesAllowed":{"value":"no"},"desk":{"value":"yes"},"dishwasher":{"value":"yes"},"dryer":{"value":"yes"},"electricityCostIncluded":{"value":"yes"},"flooring":{"value":"stone"},"garden":{"value":"no"},"gasCostIncluded":{"value":"yes"},"housematesGender":{"value":"shared_w_both"},"internetCostIncluded":{"value":"yes"},"kitchen":{"value":"shared"},"kitchenware":{"value":"shared"},"livingRoom":{"value":"shared"},"parking":{"value":"shared"},"pets":{"value":"no"},"playMusic":{"value":"yes"},"registrationPossible":{"value":"yes"},"roomFurniture":{"value":"yes"},"smoking":{"value":"no"},"tenantStatus":{"value":"students only"},"toilet":{"value":"shared"},"totalSize":{"value":"120"},"tv":{"value":"no"},"washingMachine":{"value":"yes"},"waterCostIncluded":{"value":"yes"},"wheelchairAccessible":{"value":"no"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":44000,"deposit":150000,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"440.00","deposit":"1500.00","agencyFee":"0.00","estimatedBills":"0.00"},"minimumStayMonths":12,"moveInWindow":0,"currentOccupancy":2,"minAge":18,"maxAge":28,"preferredGen