idth":800,"height":600}}},{"originalLink":"https://housinganywhere.imgix.net/unit_type/1475225/a4c6c43d-35df-49af-b693-d25ea13e4935.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","categories":null,"sizes":{"1024x768":{"link":"https://housinganywhere.imgix.net/unit_type/1475225/a4c6c43d-35df-49af-b693-d25ea13e4935.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/unit_type/1475225/a4c6c43d-35df-49af-b693-d25ea13e4935.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1475225/a4c6c43d-35df-49af-b693-d25ea13e4935.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1475225/a4c6c43d-35df-49af-b693-d25ea13e4935.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1475225/a4c6c43d-35df-49af-b693-d25ea13e4935.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"Willkommen in Ihrem neuen Zuhause!\n\nDiese exquisite 1-Zimmer-Wohnung mit Küche und Bad wurde gerade einer umfassenden Kernsanierung unterzogen und erstrahlt in einem neuen Glanz. Sie liegt zentral in Laubach (Wetterfeld) und befindet sich im erhöhten Erdgeschoss eines charmanten kleinen Hauses.\n\nDas Duschbad und die Küche sind komplett neu, präsentieren sich im zeitgemäßen, edlen Stil und versprechen ein Höchstmaß an Komfort. Die gesamte Wohnung ist mit einem hochwertigen Bodenbelag ausgestattet, der ein elegantes und gemütliches Ambiente schafft.\n\nEin separater Abstellraum im Flur bietet praktischen Stauraum und trägt zur Aufrechterhaltung einer aufgeräumten Wohnatmosphäre bei.\n\nDiese Wohnung ist perfekt für Singles oder Paare konzipiert, die Wert auf gehobene Wohnqualität legen.\n\nDie zentrale Lage in Laubach (Wetterfeld) ermöglicht eine bequeme Anbindung an alle Annehmlichkeiten des täglichen Bedarfs und bietet dennoch eine ruhige und entspannte Wohnlage.\n\nDie Altstadt von Laubach ist circa 5 Minuten mit dem Auto zu erreichen (Entfernung zur Wohnung circa 3km).\nDiverse Einkaufsmöglichkeiten sind in innerhalb von 1 Minuten mit dem Auto zu erreichen: Netto, Tedi,Tankestelle, Pizzeria und eine Burgerbude.\n\nRewe, Lidl, Aldi und weitere Einkaufsmöglichkeiten sind ebenfalls innerhalb 5 Autominuten zu erreichen.","facilities":{"allergyFriendly":{"value":"no"},"balconyTerrace":{"value":"no"},"basement":{"value":"no"},"bathroom":{"value":"private"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"yes"},"bedrooms":{"value":"1"},"closet":{"value":"yes"},"couplesAllowed":{"value":"yes"},"desk":{"value":"yes"},"dishwasher":{"value":"no"},"dryer":{"value":"yes"},"electricityCostIncluded":{"value":"yes"},"flooring":{"value":"laminate"},"garden":{"value":"no"},"gasCostIncluded":{"value":"yes"},"heating":{"value":"gas"},"internetCostIncluded":{"value":"yes"},"kitchen":{"value":"private"},"kitchenware":{"value":"private"},"livingRoom":{"value":"private"},"parking":{"value":"shared"},"pets":{"value":"yes"},"playMusic":{"value":"discussable"},"registrationPossible":{"value":"yes"},"roomFurniture":{"value":"yes"},"smoking":{"value":"outside_only"},"toilet":{"value":"private"},"totalSize":{"value":"40"},"tv":{"value":"yes"},"washingMachine":{"value":"yes"},"waterCostIncluded":{"value":"yes"},"wheelchairAccessible":{"value":"no"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":120000,"deposit":50000,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"1200.00","deposit":"500.00","agencyFee":"0.00","estimatedBills":"0.00"},"minimumStayMonths":1,"moveInWindow":0,"currentOccupancy":0,"minAge":0,"maxAge":0,"preferredGender":"","available":[{