h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1723122/3faf31c4-bd4a-46b5-a4b5-7e51b7ffec10.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1723122/3faf31c4-bd4a-46b5-a4b5-7e51b7ffec10.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"Enjoy a comfortable stay in this spacious ground-floor apartment with a private garden in the peaceful spa town of Bad Füssing. Featuring five bedrooms, a fully equipped kitchen, dedicated workspaces, and modern minimalist furnishings, it’s ideal for families, business travelers, professionals, larger groups, and relocation stays. The Egglfing Egglfinger Hof bus stop is just a 3-minute walk away, providing excellent local connections.\n\nThe space\n\nWelcome to your home away from home. This bright and generously sized apartment has been thoughtfully furnished in a clean, modern style, offering everything needed for both short and extended stays.\n\nThe apartment features:\n\n• Two bedrooms with comfortable double beds\n• Three bedrooms with comfortable single beds\n• Dedicated workspaces for convenient remote work or study\n• Spacious living room with Smart TV and comfortable seating\n• Large fully equipped kitchen with oven, dishwasher, refrigerator, washing machine, and all cooking essentials\n• Modern bathroom\n• Private garden with outdoor space\n• High-speed WiFi throughout\n• Ground-floor access for added convenience\n\nWhether you’re relocating, working remotely, traveling with colleagues, or enjoying time with your family, the apartment provides a quiet and practical environment with plenty of space to work, relax, and feel at home.\n\nGuest access\n\nGuests enjoy exclusive access to the entire apartment, including:\n\n• Five private bedrooms\n• Spacious living room\n• Fully equipped kitchen\n• Bathroom\n• Private garden\n• Washing machine\n• High-speed WiFi\n• Dedicated workspaces\n• Building entrance and shared common areas\n\nThe apartment is entirely yours for the duration of your stay.\n\nOther things to note\n\n• Quiet residential neighborhood in Bad Füssing\n• Perfect for families, professionals, business travelers, company stays, and relocation guests\n• Five bedrooms offering comfortable accommodation for larger groups\n• High-speed WiFi suitable for remote work\n• Dedicated workspaces\n• Private garden exclusively for guests\n• No parties or events\n• Smoking is only permitted outside\n• Please respect quiet hours and neighboring residents\n• Excellent public transport: Egglfing Egglfinger Hof bus stop is only a 3-minute walk away\n• Easy access to local shops, restaurants, spa facilities, and surrounding business locations\n\nPlease note: The photos shown are for reference purposes. The apartment layout remains the same, while furniture, decoration, and styling may vary slightly depending on availability.","facilities":{"airConditioning":{"value":"no"},"bathroom":{"value":"private"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"yes"},"bedrooms":{"value":"5"},"closet":{"value":"yes"},"couplesAllowed":{"value":"yes"},"desk":{"value":"yes"},"dishwasher":{"value":"no"},"dryer":{"value":"no"},"electricityCostIncluded":{"value":"yes"},"flooring":{"value":"laminate"},"garden":{"value":"private"},"gasCostIncluded":{"value":"yes"},"heating":{"value":"gas"},"internetCostIncluded":{"value":"yes"},"kitchen":{"value":"private"},"kitchenware":{"value":"private"},"livingRoom":{"value":"private"},"pets":{"value":"yes"},"playMusic":{"value":"discussable"},"registrationPossible":{"value":"yes"},"roomFurniture":{"value":"yes"},"smoking":{"value":"outside_only"},"toilet":{"value":"private"},"totalSize":{"value":"70"},"tv":{"value":"yes"},"washingMachine":{"value":"yes"},"waterCostIncluded":{"value":"yes"},"wheelchairAccessible":{"value":"yes"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":250000,"deposit":500000,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"2500.00","deposit":"5000.00","agencyFee":"0.00","estimatedBills":"0.00"},"minimumStayMonths":3,"moveInWindow":15,"currentOccupancy":0,"minAge":18,"maxAge":0,"preferredGender":"","available":[{"to":"9999-12-31","from":"2026-10-03"}],"updated":"2026-10-03T00:22:20Z","__utId__":"ut1723122"}]