fit=clip&h=600&w=800","width":800,"height":600}}},{"originalLink":"https://housinganywhere.imgix.net/unit_type/1665248/53b654c8-1454-4086-9933-c2916533fc1b.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","categories":["kitchen"],"sizes":{"1024x768":{"link":"https://housinganywhere.imgix.net/unit_type/1665248/53b654c8-1454-4086-9933-c2916533fc1b.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/unit_type/1665248/53b654c8-1454-4086-9933-c2916533fc1b.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1665248/53b654c8-1454-4086-9933-c2916533fc1b.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1665248/53b654c8-1454-4086-9933-c2916533fc1b.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1665248/53b654c8-1454-4086-9933-c2916533fc1b.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}},{"originalLink":"https://housinganywhere.imgix.net/unit_type/1665248/3e7f235d-5ed0-46a2-99f7-f31a9268cd66.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","categories":null,"sizes":{"1024x768":{"link":"https://housinganywhere.imgix.net/unit_type/1665248/3e7f235d-5ed0-46a2-99f7-f31a9268cd66.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/unit_type/1665248/3e7f235d-5ed0-46a2-99f7-f31a9268cd66.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1665248/3e7f235d-5ed0-46a2-99f7-f31a9268cd66.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1665248/3e7f235d-5ed0-46a2-99f7-f31a9268cd66.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1665248/3e7f235d-5ed0-46a2-99f7-f31a9268cd66.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"Beschreibung\nSie suchen eine charmante, vollständig möblierte Wohnung, die\nsofort bezugsfertig ist? Dann sind Sie hier genau richtig!\nIm ruhigen, grünen Stadtteil Nürtingen-Zizishausen erwartet Sie\neine stilvolle 2,5-Zimmer-Wohnung im modern-barocken Stil, die\nmit viel Herzblut eingerichtet wurde – perfekt für Berufspendler,\nÜbergangsmieter oder Wochenendheimfahrer, die Wert auf\nKomfort, Stil und eine entspannte Wohnatmosphäre legen.\n\nSie suchen ein stilvolles, komplett ausgestattetes Zuhause für die\nnächsten Jahre? Dann freuen wir uns auf Ihre Nachricht!\n\n----------------------------------------------------------------------------------------------\n\nAUSSTATTUNG:\n\nSchlafzimmer\nEin heller, einladender Rückzugsort mit komfortablem Bett, Kleiderschrank, gemütlicher Sitzecke und Regal.\n\nBüro-/Gästezimmer\nHome-Office? Gäste? Beides kein Problem. Mit Schreibtisch, bequemer Schlafsessel, Beistelltisch und flexibelabtrennbarer Wand zum Wohnzimmer.\n\nWohn- und Essbereich\nEin großartiger Ort zum Ankommen: mit gemütlicher Schlafcouch, 65-Zoll-TV und stilvollem Essbereich.\n\nModernes Tageslichtbad\nBegehbare Dusche, stilvolle Armaturen und viel Tageslicht sorgen für einen angenehmen Start in den Tag.\n\nSeparates WC\nPraktisch abgetrennt, geschmackvoll gefliest.\n\nKüche mit Charme\nKompakt und clever geplant: mit Holzdetails, großem Kühlschrank und Frühstückstisch – perfekt für die ersteTasse Kaffee am Morgen.\n\nBalkon\nGeräumig und ruhig – hier können Sie entspannen, abschalten und auftanken.\n\nStellplatz\nPrivater Stellplatz direkt vor dem Haus.\n\nHobbyraum\nVielseitig nutzbar – als Stauraum, Fitnessraum oder kreativer Rückzugsort.\n----------------------------------------------------------------------------------------------\n\nLAGE:\n\nMit über 40.000 Einwohner ist Nürtingen ein bedeutendes\nDienstleistungs-und Wirtschaftszentrum in der Region Stuttgart.\nDie Stadt verbindet den landschaftlichen Reiz des Neckartals mit\nder angrenzenden schwäbischen Alb.\n\nDer Ortsteil Zizishausen hat 3.300 Einwohner und sehr gute\nVerkehrsanbindungen zur 313, B10 und A8.\n\nNürtingen-Zizishausen bietet kulturelle Vielfalt und\nherausragende Bildungsmöglichkeiten von der Ganztagesschule\nbis hin zum Fachhochschuldiplom.\nBürgerengagement und ein ausgeprägtes Vereinsleben sind\nKennzeichen eines intakten Stadtgefüges.\n\nGrundschule, Kindergarteneinrichtungen sind vorhanden.\nWeiterführende Schulen sind bevorzugt in Nürtingen selbst mit dem Fahrrad in ca. 5-10 Min. zu erreichen.\nDie Nahversorgung am Ort ist sehr gut: Supermarkt, Metzger,\nBäcker, Apotheke, Hausarzt und Zahnarzt, alles vorhanden!\nLaufstrecken und Radwege sind unmittelbarer Nähe vorhanden!\n\n--------------------------------------------------------------------------------------\n\nKaltmiete mit Einrichtung und Möbel: 990,- EUR\n\nHobbyraum: 40,- EUR\nStellplatz: 50,- EUR\n\nNebenkosten (Heizung, Wasser): 150,- EUR\n\nMiete in SUMME: 1.230,- EUR","facilities":{"airConditioning":{"value":"no"},"allergyFriendly":{"value":"yes"},"balconyTerrace":{"value":"private"},"basement":{"value":"private"},"bathroom":{"value":"private"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"yes"},"bedrooms":{"value":"1"},"closet":{"value":"yes"},"couplesAllowed":{"value":"yes"},"desk":{"value":"yes"},"dishwasher":{"value":"yes"},"dryer":{"value":"no"},"electricityCostIncluded":{"value":"yes"},"flooring":{"value":"plastic"},"garden":{"value":"shared"},"gasCostIncluded":{"value":"yes"},"heating":{"value":"central"},"internetCostIncluded":{"value":"yes"},"kitchen":{"value":"private"},"kitchenware":{"value":"private"},"livingRoom":{"value":"private"},"parking":{"value":"private"},"pets":{"value":"no"},"playMusic":{"value":"yes"},"roomFurniture":{"value":"yes"},"smoking":{"value":"no"},"toilet":{"value":"private"},"totalSize":{"value":"66"},"tv":{"value":"yes"},"washingMachine":{"value":"no"},"waterCostIncluded":{"value":"yes"},"wheelchairAccessible":{"value":"yes"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":149000,"deposit":180000,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"1490.00","deposit":"1800.00","agencyFee":"0.00","estimatedBills":"0.00"},"minimumStayMonths":0,"moveInWindow":0,"currentOccupancy":0,"minAge":0,"maxAge":0,"preferredGender":"","available":[{"to":"9999-12-31","from":"2026-08-01"}],"updated":"2026-05-13T17:05:04Z","__utId__":"ut1665248"}]