,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1745106/858f5387-9289-458e-98e6-3afcdc46d808.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}},{"originalLink":"https://housinganywhere.imgix.net/unit_type/1745106/18ae1ac8-b47b-4274-bb11-14ffdc422b49.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","categories":null,"sizes":{"1024x768":{"link":"https://housinganywhere.imgix.net/unit_type/1745106/18ae1ac8-b47b-4274-bb11-14ffdc422b49.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/unit_type/1745106/18ae1ac8-b47b-4274-bb11-14ffdc422b49.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1745106/18ae1ac8-b47b-4274-bb11-14ffdc422b49.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1745106/18ae1ac8-b47b-4274-bb11-14ffdc422b49.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1745106/18ae1ac8-b47b-4274-bb11-14ffdc422b49.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}},{"originalLink":"https://housinganywhere.imgix.net/unit_type/1745106/e43bc13e-096f-44d8-865f-e16650b6d0ad.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","categories":null,"sizes":{"1024x768":{"link":"https://housinganywhere.imgix.net/unit_type/1745106/e43bc13e-096f-44d8-865f-e16650b6d0ad.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/unit_type/1745106/e43bc13e-096f-44d8-865f-e16650b6d0ad.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1745106/e43bc13e-096f-44d8-865f-e16650b6d0ad.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1745106/e43bc13e-096f-44d8-865f-e16650b6d0ad.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1745106/e43bc13e-096f-44d8-865f-e16650b6d0ad.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"Hier erwartet Euch ein Aufenthalt voller Ruhe und Natur mitten im Bayerischen Wald! ⛷️ Die Langlaufloipe startet direkt nebenan, der Nationalpark liegt vor der Tür. Nach einem Tag auf den Wanderwegen lasst Ihr den Abend auf dem Balkon ausklingen und genießt die reine Luft des Bayerischen Waldes im staatlich anerkannten Erholungsort Haidmühle.\n\nIdeal für Paare, Gruppen, Remote Worker und Ruhesuchende.\n\n🛜 WLAN 📺 Smart-TV 🍲 Voll ausgestattete Küche 🅿️ Garagenstellplatz 🔑 Self-Check-in\n\nDie Ferienwohnung ist stilvoll eingerichtet und bietet alles, für maximal 6 Gäste, was ihr für einen komfortablen Aufenthalt braucht.  Große Fenster sorgen für viel Tageslicht und einen Blick auf den See. Nach einem Tag am Wandern könnt ihr auf dem Balkon ruhig den Tag ausklingen lassen.\n\n🏠 Ausstattung\n\t•\tStilvoll eingerichtete Zimmer\n\t•\tWLAN inklusive (100 mbit/s)\n\t•\tKüche mit kompletter Ausstattung \n\t•\tEigenes Bad\n\t•\tBalkon mit Sitz- und Essmöglichkeit\n\t•\tKostenloser Parkplatz direkt am Haus\n\nUmgebung\n🛒Supermarkt und Bäcker befinden sich wenige Minuten zu Fuß entfernt in Haidmühle.\n🍴Das Restaurant Strohmaier befindet sich nur wenige Minuten entfernt.\n🥾 Haidmühle bietet Ruhe und Natur mitten im Bayerischen Wald, mit Wanderwegen direkt vor der Tür und einem traditionellen Gasthaus für die Einkehr nach dem Ausflug.\n🚶 Wunderschöne Wanderwege starten direkt vor der Haustür. Der historische Goldene Steig und der Haidel mit seinem Aussichtsturm sind ebenso schnell erreicht wie die Weiten der Hochmoorlandschaft rund um Haidmühle.\n\nAnreise\n🚗 Mit dem Auto: Haidmühle ist über die B12 gut angebunden. Parken ist direkt an der Unterkunft möglich.\n🚆 Mit ÖPNV: Ab Passau Bahnhof gelangt ihr mit dem Auto oder Bus innerhalb einer Stunde zur Unterkunft.\n\nErreichbarkeit\n🚌  Mit dem Bus erreichen Sie bequem Freyung, Waldkirchen und weitere Ziele rund um den Bayrischen Wald.\n\n\n🧖Handtücher und Bettwäsche sind selbstverständlich im Preis inbegriffen.","facilities":{"airConditioning":{"value":"no"},"balconyTerrace":{"value":"private"},"basement":{"value":"no"},"bathroom":{"value":"private"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"no"},"bedrooms":{"value":"2"},"closet":{"value":"yes"},"couplesAllowed":{"value":"yes"},"desk":{"value":"yes"},"dishwasher":{"value":"yes"},"dryer":{"value":"yes"},"electricityCostIncluded":{"value":"yes"},"flooring":{"value":"laminate"},"garden":{"value":"shared"},"gasCostIncluded":{"value":"yes"},"heating":{"value":"central"},"internetCostIncluded":{"value":"yes"},"kitchen":{"value":"private"},"kitchenware":{"value":"private"},"livingRoom":{"value":"private"},"parking":{"value":"private"},"pets":{"value":"no"},"playMusic":{"value":"yes"},"registrationPossible":{"value":"yes"},"roomFurniture":{"value":"yes"},"smoking":{"value":"outside_only"},"toilet":{"value":"private"},"totalSize":{"value":"40"},"tv":{"value":"yes"},"washingMachine":{"value":"yes"},"waterCostIncluded":{"value":"yes"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":70000,"deposit":0,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"700.00","deposit":"0.00","agencyFee":"0.00","estimatedBills":"0.00"},"minimumStayMonths":1,"moveInWindow":0,"currentOccupancy":0,"minAge":0,"maxAge":0,"preferredGender":"","available":[{"to":"9999-12-31","from":"2026-10-07"}],"updated":"2026-10-07T11:35:49Z","__utId__":"ut1745106"}]