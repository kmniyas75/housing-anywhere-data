47/431531c0-3c1c-45fa-a268-4ff7f3ce658d.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1745647/431531c0-3c1c-45fa-a268-4ff7f3ce658d.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}},{"originalLink":"https://housinganywhere.imgix.net/unit_type/1745647/d0676844-0cb0-4762-bf2e-91b9f8ce1e72.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","categories":null,"sizes":{"1024x768":{"link":"https://housinganywhere.imgix.net/unit_type/1745647/d0676844-0cb0-4762-bf2e-91b9f8ce1e72.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/unit_type/1745647/d0676844-0cb0-4762-bf2e-91b9f8ce1e72.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1745647/d0676844-0cb0-4762-bf2e-91b9f8ce1e72.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1745647/d0676844-0cb0-4762-bf2e-91b9f8ce1e72.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1745647/d0676844-0cb0-4762-bf2e-91b9f8ce1e72.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"Wir vermieten unsere vollständig möblierte 2-Zimmer-Wohnung in Göttingen-Weende für den Zeitraum vom 05.12.2026 bis 08.02.2027 zwischen.\n\nDie Wohnung hat ca. 54 m2 und besteht aus zwei großzügigen Zimmern, separater Küche, Badezimmer, kleiner Abstellkammer und Balkon. Sie liegt im 3. Obergeschoss auf einer Anhöhe und ist nach Südwesten ausgerichtet.\n\nEin besonderes Highlight ist die Aussicht: Sowohl vom Balkon als auch aus dem großen Panoramafenster im Wohn- und Arbeitszimmer blickt man über Teile Göttingens und die umliegenden Höhenzüge. Durch die Südwestausrichtung gibt es abends häufig sehr schöne Sonnenuntergänge und später den Blick auf die Lichter der Stadt.\nDie Wohnung wird vollständig möbliert und bezugsfertig übergeben.\n\nDas Wohn- und Arbeitszimmer ist ca. 20 m2 groß und ausgestattet mit:\n- zwei Schreibtischen\n- Sofa\n- 40-Zoll-Fernseher\n- zusätzlichem Gefrierschrank\n- großem Panoramafenster mit Fernblick\n\nDas Schlafzimmer ist ebenfalls ca. 20 m2 groß und verfügt über:\n- großes Doppel-Boxspringbett\n- großen Kleiderschrank\n- 55-Zoll-Fernseher\n- ausreichend Platz zum Wäschetrocknen\n- ruhigen Blick ins Grüne und auf Gärten und Bäume\n\nDie separate Küche wurde vor etwa fünf Jahren neu eingebaut und ist vollständig ausgestattet mit:\n- Geschirrspüler\n- Backofen und 4-Zonen-Kochfeld\n- großem Kühlschrank\n- separatem Gefrierfach/-schrank\n- Geschirr, Besteck und Küchenutensilien\n- fußwarmem Korkboden\n\nVon der Küche gelangt man direkt auf den Balkon. Da dieser an einer Hausecke liegt, hat man sowohl Blick ins Grüne als auch Richtung Stadt und Sonnenuntergang.\n\nDas Badezimmer verfügt über Dusche und Waschtrockner, sodass weder Waschsalon noch Gemeinschaftswaschküche nötig sind.\nZusätzlich gibt es eine kleine Abstellkammer mit vielen Regalböden und entsprechend viel Stauraum für Vorräte, Haushaltsartikel, Putzmittel etc.\n\nDie Wohnung ist sehr ruhig. Nur eine Wand grenzt überhaupt direkt an eine Nachbarwohnung, und die betreffende Nachbarin ist nur selten vor Ort. Von anderen Wohnungen bekommen wir im Alltag praktisch keinen Lärm mit.\n\nAuch die Lage ist sehr angenehm:\n- ca. 5 Minuten zur nächsten Bushaltestelle\n- ca. 5 Minuten mit dem Fahrrad zur HAWK, Fakultät Ressourcenmanagement\n- ca. 5 Minuten mit dem Fahrrad zu Supermarkt und Drogerie\n- ca. 5 Minuten zu Fuß bis ins Grüne bzw. Richtung Wald\n\nDie monatliche Miete beträgt 938 € und beinhaltet bereits Heizung, Warmwasser, Strom und Internet.\n\nDie monatlich angepassten Preise beziehen sich auf die Verfügbarkeit der Wohnung (ab dem 5. bzw. bis zum 8.) und betragen:\nDezember, 27 Tage, 817€\nJanuar, 31 Tage, 938€\nFebruar, 8 Tage, 268€.\n\nDie Mindestmietdauer beträgt 60 Tage bzw. zwei Monate. Die Kaution beträgt eine Monatsmiete bzw. 938€.\n\nNach Absprache und Vertragsunterzeichnung haben wir noch Zeit bis zum 31.10., um auf Wunsch unseren Internetvertrag für den Zeitraum zu kündigen. In diesem Fall reduziert sich die monatliche Miete um 43 € auf 895 €.\n\nWichtig: Die Wohnung liegt im 3. Obergeschoss und das Haus verfügt über keinen Aufzug, sie ist daher leider nicht barrierefrei.\n\nDie Zwischenvermietung ist mit unserer Vermietung abgestimmt.\nWir wünschen uns eine zuverlässige Person oder ein Paar, die bzw. das sorgsam mit Wohnung und Einrichtung umgeht. Bei Interesse schreibt uns gerne ein paar Sätze zu euch und dazu, weshalb ihr für diesen Zeitraum eine Unterkunft in Göttingen sucht.\n\n(Online-) Besichtigung nach Absprache möglich.\nPrivatvermietung.","facilities":{"airConditioning":{"value":"no"},"balconyTerrace":{"value":"private"},"basement":{"value":"no"},"bathroom":{"value":"private"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedrooms":{"value":"1"},"closet":{"value":"yes"},"couplesAllowed":{"value":"yes"},"desk":{"value":"yes"},"dishwasher":{"value":"yes"},"dryer":{"value":"yes"},"electricityCostIncluded":{"value":"yes"},"garden":{"value":"shared"},"gasCostIncluded":{"value":"yes"},"internetCostIncluded":{"value":"yes"},"kitchen":{"value":"private"},"kitchenware":{"value":"private"},"livingRoom":{"value":"private"},"parking":{"value":"shared"},"pets":{"value":"no"},"playMusic":{"value":"yes"},"registrationPossible":{"value":"no"},"roomFurniture":{"value":"yes"},"smoking":{"value":"outside_only"},"toilet":{"value":"private"},"totalSize":{"value":"54"},"tv":{"value":"yes"},"washingMachine":{"value":"yes"},"waterCostIncluded":{"value":"yes"},"wheelchairAccessible":{"value":"no"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":93800,"deposit":93800,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"938.00","deposit":"938.00","agencyFee":"0.00","estimatedBills":"0.00"},"minimumStayMonths":2,"moveInWindow":0,"currentOccupancy":0,"minAge":0,"maxAge":0,"preferredGender":"","available":[{"to":"9999-12-31","from":"2026-10-14"}],"updated":"2026-10-14T12:43:14Z","__utId__":"ut1745647"}]