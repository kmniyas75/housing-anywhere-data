lip&h=240&orient=90&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1706872/df70f620-ebf3-46a3-bdf6-54a189430d83.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&orient=90&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1706872/df70f620-ebf3-46a3-bdf6-54a189430d83.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&orient=90&w=800","width":800,"height":600}}},{"originalLink":"https://housinganywhere.imgix.net/unit_type/1706872/a7b743fe-de3d-46fd-827d-dd2683c85970.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&orient=90&w=2048","categories":null,"sizes":{"1024x768":{"link":"https://housinganywhere.imgix.net/unit_type/1706872/a7b743fe-de3d-46fd-827d-dd2683c85970.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&orient=90&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/unit_type/1706872/a7b743fe-de3d-46fd-827d-dd2683c85970.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&orient=90&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1706872/a7b743fe-de3d-46fd-827d-dd2683c85970.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&orient=90&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1706872/a7b743fe-de3d-46fd-827d-dd2683c85970.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&orient=90&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1706872/a7b743fe-de3d-46fd-827d-dd2683c85970.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&orient=90&w=800","width":800,"height":600}}},{"originalLink":"https://housinganywhere.imgix.net/unit_type/1706872/bae7aa8d-23cf-4aa2-a534-b76376259d61.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&orient=90&w=2048","categories":null,"sizes":{"1024x768":{"link":"https://housinganywhere.imgix.net/unit_type/1706872/bae7aa8d-23cf-4aa2-a534-b76376259d61.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&orient=90&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/unit_type/1706872/bae7aa8d-23cf-4aa2-a534-b76376259d61.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&orient=90&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1706872/bae7aa8d-23cf-4aa2-a534-b76376259d61.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&orient=90&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1706872/bae7aa8d-23cf-4aa2-a534-b76376259d61.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&orient=90&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1706872/bae7aa8d-23cf-4aa2-a534-b76376259d61.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&orient=90&w=800","width":800,"height":600}}}],"videos":null,"description":"WOHNUNG\n\nWir suchen für unsere hochwertige 105,27 qm Wohnung in Herrenberg einen zuverlässigen Zwischenmieter für einen Zeitraum von 18 Monaten. Die Wohnung befindet sich in einem modernen Neubau (Baujahr 2014) und bietet gehobenen Wohnkomfort in ruhiger, aber zentraler Lage. Dank der guten Anbindung, ideal für Pendler.\n\nDie Wohnung wird voll möbliert übergeben („Ready-to-move-in“). Zur Ausstattung gehören u.a.:\n- Hochwertige Einbauküche (Nolte) mit allen Groß-Elektrogeräten\n- Wohnbereich: Sitzmöbel, Esstisch-Gruppe, OLED-TV & Nubert Soundbar für erstklassigen Klang\n- Schlafen/Arbeiten: Betten, großzügige Schränke sowie ein separates Homeoffice-Zimmer (auch alternativ nutzbar)\n(Hinweis: Bücher, Gemälde und Pflanzen werden nicht mitvermietet).\n- auf gleicher Ebene wie die Waschküche\n- Aufzug\n\nAusstattungs-Highlights:\n- Kurze Wege: Die Wohnung befindet sich praktischerweise auf der gleichen Ebene wie die Waschküche\n- Großzügige Wohnküche als Herzstück der Wohnung, mit hochwertiger Ledermöbel\n- Lichtdurchfluteter Wohnbereich (Balkon Nachmittagssonneseite)\n- Fußbodenheizung in allen Räumen für angenehmes Klima\n- Tageslichtbad plus separates Gäste-WC\n- Inklusive Tiefgaragenstellplatz und Fahrradabstellplatz\n- Hervorragende Isolierung und sehr ruhige, angenehme Nachbarschaft\n- Moderner Aufzug\n\nLAGE\n\nHerrenberg Altstadt hat einen der 10 schönsten Provinz-Marktplätze Baden-Württembergs.\n\nDie Stuttgarter Straße bietet die perfekte Kombination aus:\n- städtischer Infrastruktur (5min zu Fuß zur Altstadt)\n- Einkaufsmöglichkeiten (Altstadt, Edeka, Denn ́s, Lidl 300m Luftlinie)\n- Naturwert (Schönbuch Park, Pferderanch in Fußnähe)\n- und Verkehrsanbindung (schneller Zugang zur A81 und S-Bahn Richtung Stuttgart)\n\nDa in einer Seitenstraße gut abgeschirmt vom Verkehr.\n\nSONSTIGES\n\nDas Gebäude wurde erst 2014 fertig gestellt und erfüllt hohe energetische Standards, was geringere Heizkosten bedeutet.\n\nBitte beachten:\n- Kein externer Abstellraum (diesen behalten wir selbst bei)\n- Die Kosten für Strom und Internet sind nicht in der Miete enthalten. Diese Verträge sind vom Zwischenmieter eigenständig anzumelden und abzurechnen\n- private Haftpflichtversicherung (die auch Mietsachschäden abdeckt) wird vorausgesetzt\n- Haustiere sind nicht erlaubt\n- PS5 samt Videothek mit 100 Top-Titeln kann zusätzlich vermietet werden (50€ im Monat)","facilities":{"airConditioning":{"value":"no"},"allergyFriendly":{"value":"yes"},"balconyTerrace":{"value":"private"},"basement":{"value":"no"},"bathroom":{"value":"private"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"yes"},"bedrooms":{"value":"2"},"closet":{"value":"yes"},"couplesAllowed":{"value":"yes"},"desk":{"value":"yes"},"dishwasher":{"value":"yes"},"dryer":{"value":"yes"},"electricityCostIncluded":{"value":"no"},"flooring":{"value":"laminate"},"garden":{"value":"no"},"gasCostIncluded":{"value":"yes"},"heating":{"value":"central"},"internetCostIncluded":{"value":"no"},"kitchen":{"value":"private"},"kitchenware":{"value":"no"},"livingRoom":{"value":"private"},"parking":{"value":"private"},"pets":{"value":"no"},"playMusic":{"value":"discussable"},"registrationPossible":{"value":"yes"},"roomFurniture":{"value":"yes"},"smoking":{"value":"no"},"tenantStatus":{"value":"working professionals only"},"toilet":{"value":"private"},"totalSize":{"value":"105"},"tv":{"value":"no"},"washingMachine":{"value":"yes"},"waterCostIncluded":{"value":"yes"},"wheelchairAccessible":{"value":"yes"},"wifi":{"value":"no"}},"costs":{"currency":"EUR","pricing":"monthly","price":205000,"deposit":330000,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"2050.00","deposit":"3300.00","agencyFee":"0.00","estimatedBills":"0.00"},"minimumStayMonths":12,"moveInWindow":0,"currentOccupancy":0,"minAge":0,"maxAge":0,"preferredGender":"","available":[{"to":"9999-12-31","from":"2026-10-01"}],"updated":"2026-05-13T17:57:04Z","__utId__":"ut1706872"}]