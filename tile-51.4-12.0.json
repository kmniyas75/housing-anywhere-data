20x240":{"link":"https://housinganywhere.imgix.net/unit_type/1658421/9a428399-56ef-4310-b347-07ab4b80a769.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1658421/9a428399-56ef-4310-b347-07ab4b80a769.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1658421/9a428399-56ef-4310-b347-07ab4b80a769.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"Wohnen im grünen Rand von Halle. Die vollständig möblierte Wohnung mit Terrasse liegt ruhig im Hinterhof und erstreckt sich über 2 Etagen. Im EG befinden sich Flur, Gäste WC, Wohnzimmer und Küche (komplett ausgestattet). Vor der Küche befindet sich ein ca. 10qm große Terrasse. Im OG großes Bad mit Wanne und Dusche, Flur Ankleidezimmer und Schlafzimmer. Alle Fenster mit elektr. Rollos. In der Warmmiete von 1400,00 € sind alle NK (Gas, Strom, Wasser, Müll, Gebäudeversicherung, Internet, usw.) enthalten. Eine separate Abrechnung erfolgt nicht. Die Wohnung eignet sich ideal für 1 Person, z. Bsp. als Nebenwohnsitz für Berufspendler. Die NK sind dementsprechend für eine Person kalkuliert. Rauchen ist in der Wohnung nicht erwünscht, auf der Terrasse aber möglich.\n\nAusstattung\n\nFlur: Garderobe, Spiegel, Sitzgelegenheit\nWohnzimmer: Couch, Sessel, Esstisch, Wohnwand, LED Fernseher\nKüche: EBK mit Ceranfeld, Kühlschrank inkl. Gefrierfach, Geschirrspüler, Herd, Kaffeemaschine, Wasserkocher, Toaster (komplett eingerichtet)\nBad: große, ebenerdige Dusche, Wanne\nAnkleide: Schrank, Regal\nSchlafzimmer: Boxspringbett (140x200) Sideboard\n\nLage\n\nDie Wohnung befindet sich mitten im Grünen in Halle Osendorf, ruhig im Hinterhof gelegen.\nBushaltestelle 100 m\nSupermarkt 2 km\nApotheke 2 km\nOsendorfer See 1 km\nElsteraue 1 km\nInnenstadt Halle 15 min / Auto\nA14 10 min / Auto\nA9 10 min / Auto\nA38 15 min / Auto\nB6 3 min / Auto\nFlughafen Leipzig 20 min / Auto\nInnenstadt Leipzig 35 min / Auto\n","facilities":{"airConditioning":{"value":"no"},"allergyFriendly":{"value":"no"},"balconyTerrace":{"value":"private"},"basement":{"value":"no"},"bathroom":{"value":"private"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"yes"},"bedrooms":{"value":"1"},"closet":{"value":"yes"},"couplesAllowed":{"value":"yes"},"desk":{"value":"no"},"dishwasher":{"value":"yes"},"dryer":{"value":"no"},"electricityCostIncluded":{"value":"yes"},"flooring":{"value":"plastic"},"garden":{"value":"shared"},"gasCostIncluded":{"value":"yes"},"heating":{"value":"gas"},"internetCostIncluded":{"value":"yes"},"kitchen":{"value":"private"},"kitchenware":{"value":"private"},"livingRoom":{"value":"private"},"parking":{"value":"private"},"pets":{"value":"discussable"},"playMusic":{"value":"discussable"},"registrationPossible":{"value":"yes"},"roomFurniture":{"value":"yes"},"smoking":{"value":"outside_only"},"toilet":{"value":"private"},"totalSize":{"value":"80"},"tv":{"value":"yes"},"washingMachine":{"value":"yes"},"waterCostIncluded":{"value":"yes"},"wheelchairAccessible":{"value":"no"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":140000,"deposit":140000,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"1400.00","deposit":"1400.00","agencyFee":"0.00","estimatedBills":"0.00"},"minimumStayMonths":1,"moveInWindow":0,"currentOccupancy":0,"minAge":0,"maxAge":0,"preferredGender":"","available":[{"to":"9999-12-31","from":"2026-08-05"}],"updated":"2026-08-05T08:51:33Z","__utId__":"ut1658421"}]