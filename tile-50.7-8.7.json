e.imgix.net/unit_type/1660336/e1cf4f7a-1445-40de-a0a0-e2f0918dce63.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1660336/e1cf4f7a-1445-40de-a0a0-e2f0918dce63.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1660336/e1cf4f7a-1445-40de-a0a0-e2f0918dce63.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}},{"originalLink":"https://housinganywhere.imgix.net/unit_type/1660336/e3f4f7b8-0469-4418-907a-673eb0745a20.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","categories":["bathroom"],"sizes":{"1024x768":{"link":"https://housinganywhere.imgix.net/unit_type/1660336/e3f4f7b8-0469-4418-907a-673eb0745a20.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/unit_type/1660336/e3f4f7b8-0469-4418-907a-673eb0745a20.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1660336/e3f4f7b8-0469-4418-907a-673eb0745a20.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1660336/e3f4f7b8-0469-4418-907a-673eb0745a20.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1660336/e3f4f7b8-0469-4418-907a-673eb0745a20.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}},{"originalLink":"https://housinganywhere.imgix.net/unit_type/1660336/835130eb-de76-423d-a1fb-45ace3d62ef0.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","categories":null,"sizes":{"1024x768":{"link":"https://housinganywhere.imgix.net/unit_type/1660336/835130eb-de76-423d-a1fb-45ace3d62ef0.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/unit_type/1660336/835130eb-de76-423d-a1fb-45ace3d62ef0.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1660336/835130eb-de76-423d-a1fb-45ace3d62ef0.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1660336/835130eb-de76-423d-a1fb-45ace3d62ef0.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1660336/835130eb-de76-423d-a1fb-45ace3d62ef0.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"Gesamte Wohnung\nUnser hochwertig ausgestattetes Wohlfühlapartement mit großem Balkon zur All-Inclusive Miete in der Südstadt Marburgs, bietet Ihnen die perfekte Möglichkeit für Wohnen auf Zeit in ruhiger Lage. Die Wohnungen verfügen über einen  hochwertigen Designboden in Holzoptik im Wohnbereich und Fliesen im Bad. Inklusiv bieten wir Ihnen selbstverständlich auch schnelles WLAN und Fernsehen.\n\nDie vollausgestattete Küche beinhaltet einen geräumigen Kühlschrank, Kochgelegenheit mit Induktionsherd und Multifunktionsbackofen, Toaster, eine Nespresso Kaffeemaschine und Wasserkocher. Geschirr und Besteck sind ebenfalls vorhanden.\n\nDer Wohn- und Schlafbereich ist ausgestattet mit einem Boxspringbett, einer gemütlichen Sitzecke mit Wohnzimmertisch und Smart TV. Von dem Schlafbereich haben sie einen direkten Zugang in ihre große bodengleiche Dusche, sowie zu ihrem WC.\n\nDie Waschmaschine und der Trockner können im Nebenraum genutzt werden. Staubsauger, Bügelbrett und Bügeleisen sind ebenfalls vorhanden.\n\nZusätzliche Informationen\nDie Lage unseres Wohnobjektes bietet Ihnen rundum die Möglichkeit für ihre tagtäglichen Aktivitäten und Bedürfnisse. Nur ca. 200m entfernt befindet sich der nächste große Supermarkt, welcher Ihnen eine große Auswahl an Lebensmitteln und Haushaltsartikeln bietet. Sollten Sie mal keine Lust haben zu Kochen, haben Sie gleich zwei Möglichkeiten die kulinarische Vielfalt der italienischen Küche zu erfahren, denn im gleichen Haus begeistert Sie das Restaurant “Pepe’s” mit seinen sardischen Gerichten und die Vinothek “Vinopolio” mit ihrer Vielfalt an Weinen und täglich wechselnden italienischen Gerichten. Weiterhin sind Sie bestens an den öffentlichen Nahverkehr angebunden. Nur 100m entfernt befindet sich die nächste Bushaltestelle und ca. 6 min zu Fuß befindet sich der nächste Bahnhof durch welche Ihnen eine schnelle und vielfältige Anbindung in alle Stadtteile Marburgs und Umgebung geboten wird.","facilities":{"airConditioning":{"value":"no"},"allergyFriendly":{"value":"yes"},"balconyTerrace":{"value":"private"},"basement":{"value":"no"},"bathroom":{"value":"private"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"yes"},"bedrooms":{"value":"1"},"closet":{"value":"yes"},"couplesAllowed":{"value":"no"},"desk":{"value":"no"},"dishwasher":{"value":"yes"},"dryer":{"value":"yes"},"electricityCostIncluded":{"value":"yes"},"garden":{"value":"no"},"gasCostIncluded":{"value":"yes"},"internetCostIncluded":{"value":"yes"},"kitchen":{"value":"private"},"kitchenware":{"value":"private"},"livingRoom":{"value":"private"},"parking":{"value":"private"},"pets":{"value":"no"},"playMusic":{"value":"discussable"},"registrationPossible":{"value":"no"},"roomFurniture":{"value":"yes"},"smoking":{"value":"no"},"toilet":{"value":"private"},"totalSize":{"value":"35"},"tv":{"value":"yes"},"washingMachine":{"value":"yes"},"waterCostIncluded":{"value":"yes"},"wheelchairAccessible":{"value":"yes"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":125000,"deposit":0,"agencyFee":0,"estimatedBills":0},"cos