93948-2ecc-40db-9826-8108de068c1b.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1362228/04d93948-2ecc-40db-9826-8108de068c1b.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"Ferienwohnung-Stadtmitte-Eigenes Badezimmer-Stadtblick-11\nMaximal 6 Personen.  Aufschlag ab der 5. Person.\n\nTop Lage. Stadtmitte Memmingen, Anfang Fußgängerzone.\nEin romantischer Garten und Hof mit Sitzgelegenheit und Tisch steht allen Gästen zur Verfügung. Das Rauchen ist nur im Garten/Hof erlaubt.\n\n- 2 Schlafzimmer, davon 1 Schlafzimmer mit 4 Einzelbetten und 1 Schlafzimmer mit 2 Einzelbetten. Die Einzelbetten können zu einem Doppelbett   zusammen geführt werden.\n- 1 Babybett\n- 2 Bäder. Davon 1 Bad mit DU/WC. 1 Bad mit Whirlpool-Badewanne\n- 1 Gäste-WC\n- Wohnzimmer mit Ecksofa, TV und Essbereich für bis zu 6 Personen\n- Küche\n- 3 Abstell-Nischen\n- Blick auf die Altstadt und Sehenswürdigkeiten\n\nService:\nEndreinigung im Preis inklusive. \nWiFi steht kostenlos im öffentlichen Bereich beschränk zur Verfügung. \nReinigung/Wechsel Bettwäsche/Handtücher gegen Gebühr/Rückfrage.\nNutzung Waschmaschine/Trockner im Untergeschoß gegen Gebühr/Rückfrage.\nWäscheservice (günstiger KG-Preis) gegen Gebühr. \n\nÜbernachtung ohne Frühstück.","facilities":{"airConditioning":{"value":"no"},"allergyFriendly":{"value":"yes"},"balconyTerrace":{"value":"no"},"basement":{"value":"no"},"bathroom":{"value":"private"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"no"},"bedrooms":{"value":"2"},"closet":{"value":"yes"},"couplesAllowed":{"value":"yes"},"desk":{"value":"yes"},"dishwasher":{"value":"no"},"dryer":{"value":"yes"},"electricityCostIncluded":{"value":"yes"},"flooring":{"value":"stone"},"garden":{"value":"shared"},"gasCostIncluded":{"value":"yes"},"heating":{"value":"central"},"internetCostIncluded":{"value":"yes"},"kitchen":{"value":"private"},"kitchenware":{"value":"private"},"livingRoom":{"value":"private"},"parking":{"value":"shared"},"pets":{"value":"no"},"playMusic":{"value":"no"},"registrationPossible":{"value":"no"},"roomFurniture":{"value":"yes"},"smoking":{"value":"outside_only"},"toilet":{"value":"private"},"totalSize":{"value":"86"},"tv":{"value":"yes"},"washingMachine":{"value":"yes"},"waterCostIncluded":{"value":"yes"},"wheelchairAccessible":{"value":"no"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":450000,"deposit":450000,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"4500.00","deposit":"4500.00","agencyFee":"0.00","estimatedBills":"0.00"},"minimumStayMonths":1,"moveInWindow":0,"currentOccupancy":0,"minAge":0,"maxAge":0,"preferredGender":"","available":[{"to":"9999-12-31","from":"2026-06-08"}],"updated":"2026-06-08T14:41:00Z","__utId__":"ut1362228"}]