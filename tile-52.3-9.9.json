d5b4.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1547067/041bc4e3-e33a-4578-b4a6-0c278276d5b4.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"Cozy Furnished Apartment, Perfect Location for Commuters or Airport Staff, Just 2 Minutes from Lehrte Train Station\n\nThis apartment offers an affordable alternative to Hannover, with trains running every 12 minutes to the main station and a travel time of only 9 minutes. The airport and trade fair grounds are reachable in just 23 minutes by taxi. Free parking is available.\n\nEnjoy the comfort of this apartment featuring underfloor heating and a spacious balcony, ideal for relaxed evenings or your morning coffee. The living room doubles as a bedroom and comes fully equipped with a TV, kitchen, and sofa bed.\n\nWithin close proximity, you'll find a shopping center, Denns Bio Market, EDEKA, and other stores for your daily needs. Lehrte Gymnasium and the town hall are also nearby. This central location offers unbeatable convenience and a warm atmosphere.\n\nThis apartment is perfect for short-term or long-term tenants seeking comfortable and well-located accommodation. Schedule a viewing today and experience all that this apartment has to offer!\n\nKey Details:\nFurnished rental only\nYear built: 1979, renovated 2023\nLayout: 1 living room with kitchen and sofa bed\nBathroom: 1 (with shower, toilet, and sink)\nApartment Type: Mid-level unit (with apartments on all sides)\nFloor: 1st floor, no elevator\nLaundry: Washing machine with built-in dryer\nHeating: Central gas heating\nConnectivity: Cable/Satellite TV, Wi-Fi included\nBalcony: Yes\nEnergy consumption: 110.5 kWh/(m2+a)\nDisclaimer: All details provided without guarantee. We do not take responsibility for the completeness, accuracy, or currentness of this information. Changes and errors are reserved.\n\nGemütliche möblierte Wohnung, perfekte Lage für Berufspendler oder Flughafenpersonal, nur 2 Minuten vom Bahnhof Lehrte entfernt. Die Wohnung bietet eine günstige Alternative zu Hannover, mit Zügen, die alle 12 Minuten zum Hauptbahnhof fahren und nur 9 Minuten Fahrzeit benötigen. Der Flughafen und das Messegelände sind in nur 23 Minuten mit dem Taxi erreichbar. Kostenfreie Parkplätze stehen zur Verfügung.\n\nGenießen Sie den Komfort dieser Wohnung mit Fußbodenheizung und einem geräumigen Balkon, ideal für entspannte Abende oder Ihren Morgenkaffee. Das Wohnzimmer dient auch als Schlafzimmer und ist komplett ausgestattet mit einem Fernseher, einer Küche und einem Schlafsofa.\n\nIn unmittelbarer Nähe finden Sie ein Einkaufszentrum, Denns Bio Markt, EDEKA und weitere Geschäfte für Ihre täglichen Besorgungen. Das Gymnasium Lehrte und das Rathaus sind ebenfalls in der Nähe. Diese zentrale Lage bietet Ihnen einen unschlagbaren Komfort und eine warme Atmosphäre.\n\nDiese Wohnung ist perfekt für kurzfristige oder langfristige Mieter, die nach einer komfortablen und gut gelegenen Unterkunft suchen. Vereinbaren Sie noch heute eine Besichtigung und erleben Sie, was diese Wohnung zu bieten hat!\n\nHard Facts:\n- Diese Wohnung wird nur möbliert vermietet\n- Baujahr 1979\n- 1 Wohnzimmer inkl. Küche und Schlafsofa\n- 1 Badezimmer mit Dusche, Toilette und Waschbecken\n- Etagenwohnung (links und rechts, sowie oberhalb und unterhalb sind Wohnungen)\n- 1. Etage, kein Lift\n- Eine Waschmaschine mit eingebautem Trockner\n- Zentralheizung / Gas \n- Kabel Sat TV Anschluss / WLAN inkl.\n- Balkon \n- Endenergieverbrauch 110,5 kWh/(m2+a) \n\n\nAlle Angaben ohne Gewähr. Wir übernehmen keine Gewähr für die Vollständigkeit, Richtigkeit und Aktualität dieser Angaben.\nÄnderungen und Irrtümer vorbehalten.","facilities":{"airConditioning":{"value":"no"},"allergyFriendly":{"value":"no"},"balconyTerrace":{"value":"private"},"basement":{"value":"no"},"bathroom":{"value":"private"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"yes"},"bedrooms":{"value":"0"},"closet":{"value":"yes"},"couplesAllowed":{"value":"yes"},"desk":{"value":"yes"},"dishwasher":{"value":"no"},"dryer":{"value":"yes"},"electricityCostIncluded":{"value":"yes"},"flooring":{"value":"wood"},"garden":{"value":"no"},"gasCostIncluded":{"value":"yes"},"heating":{"value":"central"},"internetCostIncluded":{"value":"yes"},"kitchen":{"value":"private"},"kitchenware":{"value":"private"},"livingRoom":{"value":"private"},"parking":{"value":"no"},"pets":{"value":"discussable"},"playMusic":{"value":"discussable"},"registrationPossible":{"value":"yes"},"roomFurniture":{"value":"yes"},"smoking":{"value":"outside_only"},"toilet":{"value":"private"},"totalSize":{"value":"32"},"tv":{"value":"yes"},"washingMachine":{"value":"yes"},"waterCostIncluded":{"value":"yes"},"wheelchairAccessible":{"value":"no"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":99000,"deposit":80000,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"990.00","deposit":"800.00","agencyFee":"0.00","estimatedBills":"0.00"},"minimumStayMonths":1,"moveInWindow":0,"currentOccupancy":0,"minAge":0,"maxAge":0,"preferredGender":"","available":[{"to":"9999-12-31","from":"2026-06-11"}],"updated":"2026-06-11T05:20:32Z","__utId__":"ut1547067"}]