248c317cd13c.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}},{"originalLink":"https://housinganywhere.imgix.net/unit_type/1525923/556e5127-1473-4f8c-b7de-90628bab80cc.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","categories":null,"sizes":{"1024x768":{"link":"https://housinganywhere.imgix.net/unit_type/1525923/556e5127-1473-4f8c-b7de-90628bab80cc.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/unit_type/1525923/556e5127-1473-4f8c-b7de-90628bab80cc.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1525923/556e5127-1473-4f8c-b7de-90628bab80cc.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1525923/556e5127-1473-4f8c-b7de-90628bab80cc.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1525923/556e5127-1473-4f8c-b7de-90628bab80cc.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}},{"originalLink":"https://housinganywhere.imgix.net/unit_type/1525923/98500a55-82a2-4bb2-96f9-e8201b7c9822.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","categories":null,"sizes":{"1024x768":{"link":"https://housinganywhere.imgix.net/unit_type/1525923/98500a55-82a2-4bb2-96f9-e8201b7c9822.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/unit_type/1525923/98500a55-82a2-4bb2-96f9-e8201b7c9822.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1525923/98500a55-82a2-4bb2-96f9-e8201b7c9822.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1525923/98500a55-82a2-4bb2-96f9-e8201b7c9822.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1525923/98500a55-82a2-4bb2-96f9-e8201b7c9822.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"Geschmackvolle Wohnung in altem Herrenhaus Nähe Marburg\n\nDas Haus ist Teil des \"Oberhofs\" in der kleinen Landstadt Schweinsberg im Landkreis Marburg.\nVon der geräumigen Wohnung im 2.Stock hat man eine fantastische Panoramaaussicht bis zu den Marburger Lahnbergen. \n\nDie Wohnung ist renoviert und ausgestattet mit schönen Parkett- und Dielenböden. Es gibt zwei Schlafzimmer mit vier Betten, Bad, Wohnzimmer mit Bett, Esszimmer und eine vollausgestattete Küche. Im Erdgeschoss befindet sich als Option ein Saal für kleine Festlichkeiten oder Meetings (14 Sitzplätze).\nBei Bedarf steht ein zusätzliches Zimmer mit Bett und Schreibtisch im 3.Stock kostenlos zur Verfügung.\nVor dem Haus ist eine große Terrasse, im Hof sind genügend Parkplätze und ein Fahrradschuppen.\nIm Ort gibt es einen Biobauer mit Hofverkauf von frischer Milch, Käse und Eiern, in den Nachbarorten sind diverse Bäcker und Lebensmittelgeschäfte vorhanden.\nIm Ort gibt es einen praktischen Arzt, eine Zahnärztin, einen Tierarzt und eine Apotheke. Das Klinikum auf den \"Marburger Lahnbergen\" ist 12 Autominuten entfernt, das Stadtzentrum von Stadtallendorf erreicht man in 10 Minuten.\nFür die \"kleinen Einwohner\" gibt es einen Spielplatz, eine Kindertagesstätte und eine Grundschule, für die \"großen\" einen Sportplatz, eine Grillhütte, einen Reitplatz und eine Pizzeria.\nZusätzliche Informationen\n\nKeine Angst vor einem kalten Winter, das Haus bleibt auch bei Gasmangel oder Blackout warm, wir haben eine Holzheizung und zusätzliche Kaminöfen.\nDie Mieter sind damit einverstanden, dass der\n Haustüreingangsbereich mit einer Videokamera überwacht wird.\n\nProperty details\n\nTasteful apartment in an old manor house near Marburg\n\nThe house is part of the \"Oberhof\" in the small country town of Schweinsberg in the district of Marburg.\nFrom the spacious apartment on the 2nd floor you have a fantastic panoramic view as far as the Marburg Lahn Mountains. \n\nThe apartment is renovated and equipped with beautiful parquet and floorboards. There are two bedrooms with four beds, bathroom, living room with bed, dining room and a fully equipped kitchen. On the first floor there is an optional room for small celebrations or meetings (14 seats).\nIf required, an additional room with bed and desk on the 3rd floor is available free of charge.\nThere is a large terrace in front of the house and plenty of parking spaces and a bicycle shed in the courtyard.\nIn the village there is an organic farmer with farm sales of fresh milk, cheese and eggs, in the neighboring villages there are various bakeries and grocery stores.\nThere is a general practitioner, a dentist, a vet and a pharmacy in the village. The hospital on the \"Marburger Lahnberge\" is 12 minutes away by car, the city center of Stadtallendorf can be reached in 10 minutes.\nFor the \"little ones\" there is a playground, a day care center and an elementary school, for the \"big ones\" a sports field, a barbecue hut, a riding arena and a pizzeria.\n\nAdditional information\n\nDon't worry about a cold winter, the house stays warm even in the event of a gas shortage or blackout, we have wood heating and additional fireplaces.\nThe tenants agree that the entrance to the\n entrance to the house is monitored by a video camera.\n\n","facilities":{"airConditioning":{"value":"no"},"allergyFriendly":{"value":"yes"},"balconyTerrace":{"value":"shared"},"basement":{"value":"no"},"bathroom":{"value":"private"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"no"},"bedrooms":{"value":"2"},"closet":{"value":"yes"},"couplesAllowed":{"value":"yes"},"desk":{"value":"yes"},"dishwasher":{"value":"yes"},"dryer":{"value":"yes"},"electricityCostIncluded":{"value":"yes"},"flooring":{"value":"wood"},"garden":{"value":"shared"},"gasCostIncluded":{"value":"yes"},"heating":{"value":"central"},"internetCostIncluded":{"value":"yes"},"kitchen":{"value":"private"},"kitchenware":{"value":"private"},"livingRoom":{"value":"private"},"parking":{"value":"private"},"pets":{"value":"discussable"},"playMusic":{"value":"no"},"registrationPossible":{"value":"yes"},"roomFurniture":{"value":"yes"},"smoking":{"value":"outside_only"},"toilet":{"value":"private"},"totalSize":{"value":"105"},"tv":{"value":"yes"},"washingMachine":{"value":"yes"},"waterCostIncluded":{"value":"yes"},"wheelchairAccessible":{"value":"no"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":175000,"deposit":175000,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"1750.00","deposit":"1750.00","agencyFee":"0.00","estimatedBills":"0.00"},"minimumStayMonths":1,"moveInWindow":0,"currentOccupancy":0,"minAge":18,"maxAge":0,"preferredGender":"","available":[{"to":"9999-12-31","from":"2026-08-25"}],"updated":"2026-08-25T07:46:58Z","__utId__":"ut1525923"}]