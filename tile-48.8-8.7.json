ganywhere.imgix.net/unit_type/1567364/fdfb84f8-22ed-4ced-858f-dc2c53c737e4.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1567364/fdfb84f8-22ed-4ced-858f-dc2c53c737e4.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1567364/fdfb84f8-22ed-4ced-858f-dc2c53c737e4.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1567364/fdfb84f8-22ed-4ced-858f-dc2c53c737e4.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}},{"originalLink":"https://housinganywhere.imgix.net/unit_type/1567364/69829d17-9d38-4c78-8649-57e7f8454d8f.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","categories":null,"sizes":{"1024x768":{"link":"https://housinganywhere.imgix.net/unit_type/1567364/69829d17-9d38-4c78-8649-57e7f8454d8f.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/unit_type/1567364/69829d17-9d38-4c78-8649-57e7f8454d8f.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1567364/69829d17-9d38-4c78-8649-57e7f8454d8f.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1567364/69829d17-9d38-4c78-8649-57e7f8454d8f.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1567364/69829d17-9d38-4c78-8649-57e7f8454d8f.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"Das Denkmalgeschützte Gebäude wurde im Jahr 1927 erbaut, seitdem regelmäßig renoviert und modernisiert. Die Wohnung befindet sich im 2 Geschoss. Aus jedem der 4 Zimmer haben Sie einen unabhängigen Zugang zur sehr großen Küche, Bad und separatem WC. Die Böden sind teilweise mit hochwertigem Parkett verlegt. Im Flur, Badezimmer und separatem WC wurden Fliesen verbaut. Die abgebildete Einbauküche ist zur gemeinsamen Nutzung. Hier ist auch eine Essecke. Der Raum wird als Gemeinschaftsraum genutzt. Die Küche wurde immer gepflegt und alle Elektrogeräte funktionieren einwandfrei. Ein schöner Wintergarten, möblierte, große Zimmer, sowie die zentrale Lage wird Sie mit Sicherheit überzeugen. Ausstattung Jedes Zimmer ist vollwertig für Schlafen und Arbeiten ausgestattet. In der Einbauküche befindet sich auch ein Geschirrspüler. Es ist eine Waschmaschine und Trockner zur gemeinsamen Nutzung vorhanden. WG-Details Die WG: 13m2 Zimmer in 4er WG Wohnungsgröße: 127m2 4er WG ( 2 Männer ) Rauchen nicht erwünscht gemischte WG Sprache/n: Deutsch Englisch Gesucht wird: Geschlecht egal \nVielen Einkaufsmöglichkeiten, Ärzte, Bäcker, Metzger etc. erreichen Sie in weniger als 15 Gehminuten. Ebenso der Busbahnhof liegt in unmittelbarer Nähe. Eine Bushaltestelle ist direkt vor dem Eingang. Besonders geeignet ist die WG auch für Studenten. Es sind alle Unis zu Fuß oder Fahrrad erreichbar. Hier ein paar davon: Östliche Karl-Friedrich-Str. 24 - 4 min Holzgartenstr. 36 - 7 min Emma-Jäger-Str. 20 - 7 min Eutinger Str. 111 - 10 min Tiefenbronner Str. 65 - 20 min","facilities":{"airConditioning":{"value":"no"},"allergyFriendly":{"value":"yes"},"balconyTerrace":{"value":"shared"},"bathroom":{"value":"shared_w_both"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"yes"},"bedroomSize":{"value":"13"},"bedrooms":{"value":"1"},"closet":{"value":"yes"},"couplesAllowed":{"value":"no"},"desk":{"value":"yes"},"dishwasher":{"value":"yes"},"dryer":{"value":"yes"},"electricityCostIncluded":{"value":"yes"},"gasCostIncluded":{"value":"yes"},"housematesGender":{"value":"shared_w_both"},"internetCostIncluded":{"value":"yes"},"kitchen":{"value":"shared"},"kitchenware":{"value":"shared"},"livingRoom":{"value":"shared"},"pets":{"value":"no"},"registrationPossible":{"value":"yes"},"roomFurniture":{"value":"yes"},"smoking":{"value":"no"},"toilet":{"value":"shared"},"totalSize":{"value":"127"},"tv":{"value":"no"},"washingMachine":{"value":"yes"},"waterCostIncluded":{"value":"yes"},"wheelchairAccessible":{"value":"no"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":80000,"deposit":50000,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"800.00","deposit":"500.00","agencyFee":"0.00","estimatedBills":"0.00"},"minimumStayMonths":0,"moveInWindow":0,"currentOccupancy":4,"minAge":18,"maxAge":0,"preferredGender":"","available":[{"to":"9999-12-31","from":"2026-06-08"}],"updated":"2026-06-08T14:53:51Z","__utId__":"ut1567364"}]