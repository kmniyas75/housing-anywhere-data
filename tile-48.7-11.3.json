.net/unit_type/1713912/2d869b62-c816-4196-a115-41666bc35df2.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}},{"originalLink":"https://housinganywhere.imgix.net/unit_type/1713912/bd4e7c45-2bac-4ea9-a540-22736473b41c.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","categories":null,"sizes":{"1024x768":{"link":"https://housinganywhere.imgix.net/unit_type/1713912/bd4e7c45-2bac-4ea9-a540-22736473b41c.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/unit_type/1713912/bd4e7c45-2bac-4ea9-a540-22736473b41c.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1713912/bd4e7c45-2bac-4ea9-a540-22736473b41c.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1713912/bd4e7c45-2bac-4ea9-a540-22736473b41c.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1713912/bd4e7c45-2bac-4ea9-a540-22736473b41c.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}},{"originalLink":"https://housinganywhere.imgix.net/unit_type/1713912/62906ebd-59d4-41ed-b480-b1f2b68f18d9.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","categories":["bedroom"],"sizes":{"1024x768":{"link":"https://housinganywhere.imgix.net/unit_type/1713912/62906ebd-59d4-41ed-b480-b1f2b68f18d9.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/unit_type/1713912/62906ebd-59d4-41ed-b480-b1f2b68f18d9.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1713912/62906ebd-59d4-41ed-b480-b1f2b68f18d9.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1713912/62906ebd-59d4-41ed-b480-b1f2b68f18d9.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1713912/62906ebd-59d4-41ed-b480-b1f2b68f18d9.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"This 3-bedroom apartment, featuring an east- and south-facing corner balcony, is wonderfully bright thanks to its many windows and two skylights. With ceiling heights of up to 4.20 meters (open sloped ceilings), the atmosphere is very airy and unique. The apartment is fully furnished as shown in the photos and available immediately. \n\nThe kitchen is equipped with a BOSCH fridge-freezer, a ceramic cooktop with an extractor fan, and a dishwasher—all BOSCH brand appliances. The kitchen is fully equipped: pots, dishes, glasses, a kettle, WMF cutlery, etc. The living-dining area is furnished with a new table and four ergonomic chairs. There is also a black leather couch with reclining backrests, a Samsung TV, and a Teufel sound system. \n\nThe bedroom features a spacious closet, a 1.80 x 2.00 m double bed with Emma mattresses, and two nightstands. The home office features natural light from two sides, two cabinets, a height-adjustable desk, and two filing cabinets. \n\nThe bathroom is equipped with a walk-in shower, a bathtub, and colored ambient lighting with a motion sensor. Storage room: This room is equipped with a spacious wooden shelf. Hallway: A high-quality wardrobe, a spacious shoe cabinet, and an illuminated mirror provide great convenience for everyday use. \n\nLaundry room in the basement: private BOSCH washing machine and dryer. All living areas feature tile flooring, while the study and bedrooms are fitted with designer flooring with an apple tree grain pattern. \n\nAll rooms are heated by underfloor heating. The balcony is covered with oiled larch wood. The apartment is located in a four-unit building nestled among single-family and multi-family homes in a quiet residential area in western Ingolstadt. \n\nThe hospital, Haslangpark, the Westpark shopping center, and the Federal Horticultural Show grounds are all within a few minutes’ walk. The Schatzgerstraße or Haslangstraße bus stops are just a two-minute walk away. In addition to Westpark, there is an Edeka supermarket with a bakery on Gerolfinger Straße, just a 5-minute walk away, for grocery shopping. \n\nFor an idyllic run, the Baggersee (running there, a lap around the lake, and back is 10 km) or the open field behind the hospital (approx. 1 km away) are ideal.","facilities":{"airConditioning":{"value":"no"},"allergyFriendly":{"value":"yes"},"balconyTerrace":{"value":"private"},"basement":{"value":"no"},"bathroom":{"value":"private"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"yes"},"bedrooms":{"value":"2"},"closet":{"value":"yes"},"couplesAllowed":{"value":"yes"},"desk":{"value":"yes"},"dishwasher":{"value":"yes"},"dryer":{"value":"yes"},"electricityCostIncluded":{"value":"yes"},"flooring":{"value":"stone"},"garden":{"value":"no"},"gasCostIncluded":{"value":"yes"},"heating":{"value":"central"},"internetCostIncluded":{"value":"yes"},"kitchen":{"value":"private"},"kitchenware":{"value":"private"},"livingRoom":{"value":"private"},"parking":{"value":"private"},"pets":{"value":"no"},"playMusic":{"value":"yes"},"registrationPossible":{"value":"yes"},"roomFurniture":{"value":"yes"},"smoking":{"value":"no"},"toilet":{"value":"private"},"totalSize":{"value":"75"},"tv":{"value":"yes"},"washingMachine":{"value":"yes"},"waterCostIncluded":{"value":"yes"},"wheelchairAccessible":{"value":"no"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":159900,"deposit":175000,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"1599.00","deposit":"1750.00","agencyFee":"0.00","estimatedBills":"0.00"},"minimumStayMonths":2,"moveInWindow":0,"currentOccupancy":0,"minAge":0,"maxAge":0,"preferredGender":"","available":[{"to":"9999-12-31","from":"2026-06-03"}],"updated":"2026-06-03T08:41:00Z","__utId__":"ut1713912"}]