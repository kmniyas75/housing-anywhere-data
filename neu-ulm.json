inalLink":"https://housinganywhere.imgix.net/unit_type/1663041/a21da824-e3b1-45c0-a153-b95429882ea7.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","categories":["bedroom"],"sizes":{"1024x768":{"link":"https://housinganywhere.imgix.net/unit_type/1663041/a21da824-e3b1-45c0-a153-b95429882ea7.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/unit_type/1663041/a21da824-e3b1-45c0-a153-b95429882ea7.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1663041/a21da824-e3b1-45c0-a153-b95429882ea7.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1663041/a21da824-e3b1-45c0-a153-b95429882ea7.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1663041/a21da824-e3b1-45c0-a153-b95429882ea7.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}},{"originalLink":"https://housinganywhere.imgix.net/unit_type/1663041/878b9f1a-10c7-43d2-932e-126a2da3c17d.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","categories":null,"sizes":{"1024x768":{"link":"https://housinganywhere.imgix.net/unit_type/1663041/878b9f1a-10c7-43d2-932e-126a2da3c17d.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/unit_type/1663041/878b9f1a-10c7-43d2-932e-126a2da3c17d.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1663041/878b9f1a-10c7-43d2-932e-126a2da3c17d.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1663041/878b9f1a-10c7-43d2-932e-126a2da3c17d.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1663041/878b9f1a-10c7-43d2-932e-126a2da3c17d.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"Immobilie\n\nDieses familienfreundliche, optimal geschnittene ansprechende möblierte 4-Zi.-Whg. (102m^2) im ersten OG befindet sich in zentralster Lage in NU und verfügt über eine luxuriöse Innenausstattung. Sie ist zum 01.11.2025 verfügbar. Ein Badezimmer und ein separates Gäste-WC zählen neben großzügigem Wohn-Eßbereich zu dem Objekt. Die Immobilie ist barrierefrei und lässt sich bequem über einen Fahrstuhl erreichen. Zur Wohnung gehört auch ein großzügiger Balkon. Durch den zur Wohnung gehörenden optional vermietbaren TG-stellplatz gehört die lange Suche nach einem Parkplatz der Vergangenheit an. Anschließend können Sie Ihre Wocheneinkäufe (Glacis-Galerie 5min. zu Fuß!) bequem in die bereits vorhandene Einbauküche tragen. Es gibt außerdem einen großzügigen gut belüfteten Kellerraum. Glacis-Park, Musikschule und Post sind nur wenige Gehminuten entfernt. \nIdeal für Familien mit und ohne Kinder\n\nAusstattung\nVoll möbliert, Eichenparkett, Bodenheizung, elektr. Jalousien im Wohnbereich, bodentiefe Fenster, Bad mit Fenster, Gäste-WC mit Fenster, Balkon, EBK, Technikraum mit Waschmaschine und Trockner, Kellerraum, TG-Stellplatz mit Fahrstuhl, barrierefrei, voller Hausmeisterservice, Müllservice, TV-Signal, schöner begrünter Innenhof.\nTG Stellplatz in Kaltmiete mit 85 Euro/Monat enthalten.\n\n\nLage\nDie Immobilie befindet sich in zentralster Wohnlage in Neu-Ulm. In direkter Nähe haben Sie Zugang zum öffentlichen Nah- und Fernverkehr durch Bahnhof und ZUP.  Mehrere Buslinien und Bahnlinien sind nur ein paar Gehminuten entfernt. Zu Fuß erreichen Sie verschiedene Restaurants, Ärzte, Cafés, Bäckereien und ein Einkaufszentrum (Glacis-Galerie). Außerdem gibt es mehrere Modegeschäfte, Grün- und Parkanlagen, Bars, Fitnessstudios, Getränkemarkt und Buchhandlungen.\n","facilities":{"airConditioning":{"value":"no"},"allergyFriendly":{"value":"no"},"balconyTerrace":{"value":"private"},"basement":{"value":"private"},"bathroom":{"value":"private"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"yes"},"bedrooms":{"value":"3"},"closet":{"value":"yes"},"couplesAllowed":{"value":"yes"},"desk":{"value":"yes"},"dishwasher":{"value":"yes"},"dryer":{"value":"yes"},"electricityCostIncluded":{"value":"no"},"flooring":{"value":"wood"},"garden":{"value":"no"},"gasCostIncluded":{"value":"no"},"heating":{"value":"central"},"internetCostIncluded":{"value":"no"},"kitchen":{"value":"private"},"kitchenware":{"value":"private"},"livingRoom":{"value":"private"},"parking":{"value":"private"},"pets":{"value":"no"},"playMusic":{"value":"discussable"},"registrationPossible":{"value":"yes"},"roomFurniture":{"value":"yes"},"smoking":{"value":"outside_only"},"toilet":{"value":"private"},"totalSize":{"value":"102"},"tv":{"value":"yes"},"washingMachine":{"value":"yes"},"waterCostIncluded":{"value":"no"},"wheelchairAccessible":{"value":"yes"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":198500,"deposit":450000,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"1985.00","deposit":"4500.00","agencyFee":"0.00","estimatedBills":"0.00"},"minimumStayMonths":0,"moveInWindow":0,"currentOccupancy":0,"minAge":0,"maxAge":0,"preferredGender":"","available":[{"to":"9999-12-31","from":"2026-03-30"}],"updated":"2026-03-30T10:58:23Z","__utId__":"ut1663041"},{"id":"1693461","rank":65,"rating":0,"published":"2026-03-09","kind":1,"kindLabel":"entire place","type":3,"typeLabel":"apartment","rentType":"monthly","title":"Reuttier Straße, Neu-Ulm","cancellationPolicy":"strict","marketType":"rental_company","originalLink":"https://housinganyw