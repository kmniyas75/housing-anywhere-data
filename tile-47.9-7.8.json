_type/1754313/eb45dca9-2165-40c3-9439-ed04285da7fb.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1754313/eb45dca9-2165-40c3-9439-ed04285da7fb.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1754313/eb45dca9-2165-40c3-9439-ed04285da7fb.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1754313/eb45dca9-2165-40c3-9439-ed04285da7fb.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"Diese helle und freundlich geschnittene Wohnung liegt im beliebten Stadtteil Stühlinger, nur wenige Gehminuten vom Hauptbahnhof und der Uniklinik entfernt.\n\nSie bietet viel Licht, zwei schöne Loggien und eine angenehm ruhige Atmosphäre – ideal für alle, die zentral wohnen und dennoch entspannt wohnen möchten.\nDiese helle und modernisierte Wohnung befindet sich in einem gepflegten Mehrfamilienhaus in Freiburg. Dank der zentralen und dennoch ruhigen Lage sowie des Balkons bietet sie eine angenehme Wohnatmosphäre. Der Hauptbahnhof ist in nur wenigen Gehminuten erreichbar, die Freiburger Altstadt ebenfalls. Trotz der hervorragenden Anbindung lässt es sich hier entspannt wohnen.\n\nDie Wohnung eignet sich ideal für eine Einzelperson oder ein Paar. Im Schlafzimmer befindet sich ein komfortables Bett (140 × 200 cm), im Wohnbereich ein gemütliches Sofa zum Entspannen. Hunde oder Katzen sind nach Absprache herzlich willkommen.\n\nWohnungsdetails:\nWohnfläche ca. 34 m2\nObergeschoss mit Aufzug\nRuhiger Balkon\nModerne Einzimmerwohnung mit separater Küche\nHeller Wohn- und Schlafbereich\n\nAusstattung:\nVoll ausgestattete Küche mit Geschirr, Besteck, Gläsern, Töpfen, Pfannen, Kochutensilien, Kaffeemaschine, Mikrowelle, Kühlschrank und Kochfeld\nGemeinschaftswaschraum mit Waschmaschine im Haus\nHighspeed-WLAN\nSmart-TV\nKomfortables Bett (140 × 200 cm)\nNeuwertige Handtücher, Bettwäsche, Bettdecken und Kissen vollständig vorhanden\nAngenehme Beleuchtung und liebevolle Details sorgen für eine wohnliche Atmosphäre\n\nLage:\nCa. 2 Minuten zu Fuß zum Hauptbahnhof\nCa. 5 Minuten zu Fuß in die Freiburger Altstadt\nStraßenbahn sowie Einkaufsmöglichkeiten, Restaurants und Cafés in unmittelbarer Nähe\nÖffentliche Parkmöglichkeiten direkt vor dem Haus\n\nWeitere Informationen:\nAll-Inclusive-Miete inklusive Nebenkosten, Strom und Internet\nRauchen ausschließlich auf dem Balkon\nFahrradraum im Haus vorhanden\n\nKommunikation auf Deutsch, Englisch und Französisch","facilities":{"airConditioning":{"value":"no"},"allergyFriendly":{"value":"yes"},"balconyTerrace":{"value":"private"},"basement":{"value":"private"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"yes"},"bedrooms":{"value":"1"},"closet":{"value":"yes"},"couplesAllowed":{"value":"yes"},"desk":{"value":"yes"},"dishwasher":{"value":"yes"},"dryer":{"value":"no"},"electricityCostIncluded":{"value":"yes"},"flooring":{"value":"laminate"},"garden":{"value":"shared"},"gasCostIncluded":{"value":"yes"},"heating":{"value":"central"},"internetCostIncluded":{"value":"yes"},"kitchen":{"value":"private"},"kitchenware":{"value":"private"},"livingRoom":{"value":"private"},"parking":{"value":"shared"},"pets":{"value":"yes"},"playMusic":{"value":"yes"},"registrationPossible":{"value":"yes"},"roomFurniture":{"value":"yes"},"smoking":{"value":"outside_only"},"toilet":{"value":"private"},"totalSize":{"value":"34"},"tv":{"value":"yes"},"washingMachine":{"value":"yes"},"waterCostIncluded":{"value":"yes"},"wheelchairAccessible":{"value":"no"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":189000,"deposit":200000,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"1890.00","dep