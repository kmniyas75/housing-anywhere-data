&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/room/1761014/0f1321b8-c8b1-47f2-a852-efc34bc891b6.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/room/1761014/0f1321b8-c8b1-47f2-a852-efc34bc891b6.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}},{"originalLink":"https://housinganywhere.imgix.net/room/1761014/79984c30-d56f-4eb0-8a95-c74737dbd382.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","categories":null,"sizes":{"1024x768":{"link":"https://housinganywhere.imgix.net/room/1761014/79984c30-d56f-4eb0-8a95-c74737dbd382.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/room/1761014/79984c30-d56f-4eb0-8a95-c74737dbd382.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/room/1761014/79984c30-d56f-4eb0-8a95-c74737dbd382.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/room/1761014/79984c30-d56f-4eb0-8a95-c74737dbd382.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/room/1761014/79984c30-d56f-4eb0-8a95-c74737dbd382.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"PLEASE NOTE:\nThe listed rental price is the base rent. Additional required costs are listed. the 'all-in' rent is 1050 Euros for single person tenancy.\n\nThe special charm of this around 50 sqm large 2-room apartment is undoubtedly the wonderful location on the outskirts of Düsseldorf in Erkrath-Hochdahl with a view into the greenery of the Bruchhausen nature reserve. If you want to live conveniently but away from the hustle and bustle of the city and are looking for relaxation and tranquility after a busy day, you will feel right at home here.\n\nBy local train (S-Bahn) from Hochdahl station, Düsseldorf's main station can be reached in 10 minutes. \nBy car you have a good transport connection via the freeway junction Hilden to the A3 and A46.\n\nThe apartment has room for 2 persons which should be a couple as there's only one bed-/livingroom. \nThe basic rent listed is for a single person occupancy. I have added the optional costs for 2-person-occupancy as 'other optional costs'.\n\nThe apartment has a spacious, high-quality furnished living-dining area, a separate bedroom and a fully equipped kitchenette. The bathroom has been modernly renovated.\n\nFurthermore, the apartment has a small terrace overlooking a part of the garden.\n\nThe equipment includes:\n- a queen-size bed 140 cm x 200 cm (suitable for 2 persons)\n- a sofa bed\n- a bathroom with shower\n- a fully equipped fitted kitchenette with electric stove, oven, dishwasher, microwave\n- coffee maker, electric kettle\n- access to washing machine and tumble dryer\n- iron/ironing board\n- bed linen and towels\n- Television via DVB-S\n- high speed internet.\n\nMaximum occupancy is 2 adults and a child.\n\nPlease note that all our apartments are non-smoking accommodations. However, if there is smoking in the apartment, extensive cleaning will be required. We ask for your understanding that we will charge the resulting costs of up to 1,000.00 Euros.\n\nPlease be aware that HousingAnywhere is an online booking platform. Therefore exchanging contact details and offering viewings is not possible. If you would like to reserve this accommodation, send me a booking request or a message and please mention your age and occupation. I look forward to meeting you!","facilities":{"airConditioning":{"value":"no"},"allergyFriendly":{"value":"yes"},"balconyTerrace":{"value":"private"},"basement":{"value":"no"},"bathroom":{"value":"private"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"yes"},"bedrooms":{"value":"1"},"closet":{"value":"yes"},"couplesAllowed":{"value":"yes"},"desk":{"value":"yes"},"dishwasher":{"value":"yes"},"dryer":{"value":"yes"},"electricityCostIncluded":{"value":"no"},"flooring":{"value":"wood"},"garden":{"value":"no"},"gasCostIncluded":{"value":"no"},"heating":{"value":"central"},"internet":{"value":"yes"},"internetCostIncluded":{"value":"no"},"kitchen":{"value":"private"},"kitchenware":{"value":"private"},"livingRoom":{"value":"private"},"parking":{"value":"no"},"pets":{"value":"discussable"},"playMusic":{"value":"discussable"},"registrationPossible":{"value":"yes"},"roomFurniture":{"value":"yes"},"smoking":{"value":"no"},"toilet":{"value":"private"},"totalSize":{"value":"50"},"tv":{"value":"yes"},"washingMachine":{"value":"yes"},"waterCostIncluded":{"value":"no"},"wheelchairAccessible":{"value":"no"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":80000,"deposit":150000,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"800.00","deposit":"1500.00","agencyFee":"0.00","estimatedBills":"0.00"},"minimumStayMonths":6,"moveInWindow":0,"currentOccupancy":0,"minAge":25,"maxAge":50,"preferredGender":"","available":[{"to":"9999-12-31","from":"2026-12-01"}],"updated":"2026-05-18T15:55:34Z","__utId__":"ut1114267"}]