nganywhere.imgix.net/unit_type/1449824/b10e38e1-b7ca-4d56-9ba3-24482adee971.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}},{"originalLink":"https://housinganywhere.imgix.net/unit_type/1449824/b4374905-329a-457d-9915-eb26e4367499.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","categories":null,"sizes":{"1024x768":{"link":"https://housinganywhere.imgix.net/unit_type/1449824/b4374905-329a-457d-9915-eb26e4367499.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/unit_type/1449824/b4374905-329a-457d-9915-eb26e4367499.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1449824/b4374905-329a-457d-9915-eb26e4367499.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1449824/b4374905-329a-457d-9915-eb26e4367499.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1449824/b4374905-329a-457d-9915-eb26e4367499.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}},{"originalLink":"https://housinganywhere.imgix.net/unit_type/1449824/cda192fe-5670-4589-8a09-136b41a17ee4.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","categories":null,"sizes":{"1024x768":{"link":"https://housinganywhere.imgix.net/unit_type/1449824/cda192fe-5670-4589-8a09-136b41a17ee4.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/unit_type/1449824/cda192fe-5670-4589-8a09-136b41a17ee4.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1449824/cda192fe-5670-4589-8a09-136b41a17ee4.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1449824/cda192fe-5670-4589-8a09-136b41a17ee4.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1449824/cda192fe-5670-4589-8a09-136b41a17ee4.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"Herzlich willkommen im gemütlichen Tiny House von Ludwigslust – der perfekte Ort, sowohl für Geschäfts- als auch für Urlaubsreisende im idyllischen Vogtland.\n\n→ idyllische Lage mit naturbelassenen See\n→ eigene Terrasse\n→ voll ausgestattete Küche\n→ gemütliches Doppelbett für erholsame Nächte\n\n☆☆☆☆☆ \"Es ist absolut gut zum Entspannen wenn man den Alltag hinter sich lassen will.\n\nUnser Tiny House wurde vor Kurzem renoviert und erstrahlt in neuem Glanz. \n\nEs bietet eine hochwertige Ausstattung sowie eine private Terrasse, auf der Sie Ihren Tag genießen können – sei es bei einem geschäftlichen Anruf oder während Ihres Urlaubs. \n\nEntspannen Sie auf der Terrasse, lauschen Sie den Vögeln und genießen Sie die Natur. Eine Hängematte steht ebenfalls zur Verfügung, um Ihre Freizeit zu verschönern.\n\nWährend Ihres Aufenthalts können Sie das gesamte Gelände erkunden und die natürliche Schönheit der Umgebung genießen. \n\nEin großer Wald mit drei naturbelassenen Seen bietet die Möglichkeit, die Natur zu erkunden, zu angeln oder auch die Pferde auf den Grünflächen zu bewundern.\n\nDas Tiny House verfügt über gemütliche Bett mit hochwertiger Bettwäsche, welche für eine erholsame Nachtruhe sorgt.\n\nGenießen Sie Annehmlichkeiten wie den QLED-TV und ein Essbereich für zwei Personen und ein bequemes Sofa.\n\nDie gut ausgestattete Küche ermöglicht es Ihnen, Ihre Lieblingsspeisen zubereiten können und das Tageslichtbad verfügt über eine Dusche.\n\nWir stellen frische, professionell gereinigte Handtücher sowie Duschgel und Shampoo zur Verfügung.\n\nEgal, ob Sie geschäftlich unterwegs sind oder Ihren wohlverdienten Urlaub genießen, unser Tiny House bietet die Annehmlichkeiten, die Sie für einen angenehmen Aufenthalt benötigen. \n\nBuchen Sie jetzt, um Ihre Reise bei uns zu beginnen und Ihre Träume von einem perfekten Aufenthalt wahr werden zu lassen.","facilities":{"airConditioning":{"value":"no"},"allergyFriendly":{"value":"yes"},"balconyTerrace":{"value":"private"},"basement":{"value":"no"},"bathroom":{"value":"private"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"no"},"bedrooms":{"value":"1"},"closet":{"value":"yes"},"couplesAllowed":{"value":"no"},"desk":{"value":"yes"},"dishwasher":{"value":"no"},"dryer":{"value":"no"},"electricityCostIncluded":{"value":"no"},"flooring":{"value":"laminate"},"garden":{"value":"shared"},"gasCostIncluded":{"value":"yes"},"heating":{"value":"central"},"internetCostIncluded":{"value":"yes"},"kitchen":{"value":"private"},"kitchenware":{"value":"private"},"livingRoom":{"value":"private"},"parking":{"value":"shared"},"pets":{"value":"yes"},"playMusic":{"value":"yes"},"registrationPossible":{"value":"yes"},"roomFurniture":{"value":"yes"},"smoking":{"value":"outside_only"},"toilet":{"value":"private"},"totalSize":{"value":"30"},"tv":{"value":"yes"},"washingMachine":{"value":"no"},"waterCostIncluded":{"value":"yes"},"wheelchairAccessible":{"value":"yes"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":95000,"deposit":0,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"950.00","deposit":"0.00","agencyFee":"0.00","estimatedBills":"0.00"},"minimumStayMonths":1,"moveInWindow":0,"currentOccupancy":0,"minAge":18,"maxAge":0,"preferredGender":"","available":[{"to":"9999-12-31","from":"2027-02-26"}],"updated":"2026-08-06T04:25:07Z","__utId__":"ut1449824"}]