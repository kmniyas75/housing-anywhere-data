7e4548ac79.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1701938/7fe34cca-d7c5-438b-a94f-087e4548ac79.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1701938/7fe34cca-d7c5-438b-a94f-087e4548ac79.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"🏡 Stilvolles, voll ausgestattetes Zuhause auf Zeit, mit Garten, Terrasse & Top-Anbindung\n\nAufgrund eines beruflich bedingten Wohnortwechsels vermieten wir unsere hochwertig ausgestattete, vor wenigen Jahren neu erbaute Doppelhaushälfte befristet für ca. 2 Jahre.\n\nUnser Zuhause ist für uns ein besonderer Ort. Deshalb suchen wir verantwortungsbewusste Mieter:innen, die dieses wertschätzen und sich hier ebenso wohlfühlen.\n\n\n✨ Highlights auf einen Blick\n- Vollständig oder teilweise möbliert (nach Absprache)\n- Moderne, energieeffiziente Bauweise (Solaranlage & Wärmepumpe)\n- Großzügiger Garten mit Terrasse\n- 2 Garage vorhanden\n- Sehr gute Infrastruktur & Verkehrsanbindung\n- S-Bahn in ca. 2 Gehminuten erreichbar\n\nRaumaufteilung\n\nErdgeschoss:\n\nHeller Eingangsbereich\nGäste-WC\nOffener Wohn-, Ess- und Küchenbereich\nAbstellkammer\nDirekter Zugang zur Garage, Terrasse und in den Garten\n\n1. Obergeschoss:\n\nZwei Schlafzimmer\nGroßzügiges Badezimmer mit Badewanne & Dusche\nAnkleidezimmer\n\n2. Obergeschoss:\n\nZwei weitere Zimmer (ideal als Schlaf-, Arbeits- oder Gästezimmer)\nZusätzliches Badezimmer mit Dusche\n\nKeller:\nWaschraum\nTeilweise Abtrennung für private Lagerfläche\n\nAußenbereich\nDer liebevoll angelegte Garten sowie die große Terrasse bieten viel Platz zum Entspannen, Essen im Freien oder für gemeinsame Zeit mit Familie und Freunden.\n\n🛋️ Ausstattung & Besonderheiten\nVollständig ausgestattete Küche\nMöbel (z. B. Betten, Sofa) können übernommen werden\nInternetanschluss vorhanden\nSehr niedrige Energiekosten dank moderner Technik\n\n📍 Lage\nS-Bahn fußläufig in ca. 2 Minuten erreichbar\nEinkaufsmöglichkeiten, Supermärkte und Metzger in unter 5 Minuten\nSchnelle Anbindung an Autobahn und Flughafen\n\n📅 Mietkonditionen\nVerfügbar ab: 01.08.2026 oder 01.09.2026\nMietdauer: ca. 2 Jahre (Verlängerung möglich)\n\n📩 Interesse?\nWenn Sie Interesse haben, freuen wir uns über eine kurze Nachricht mit:\n\nEinem kleinen persönlichen Vorstellungsprofil\nAngabe, wer im Haushalt lebt (z. B. Familien, Paare, Einzelpersonen)\n\nWir werden uns dann zeitnah bei Ihnen melden und weitere Details besprechen.","facilities":{"airConditioning":{"value":"no"},"allergyFriendly":{"value":"no"},"balconyTerrace":{"value":"private"},"basement":{"value":"private"},"bathroom":{"value":"private"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"yes"},"bedrooms":{"value":"4"},"closet":{"value":"yes"},"couplesAllowed":{"value":"yes"},"desk":{"value":"yes"},"dishwasher":{"value":"yes"},"dryer":{"value":"yes"},"electricityCostIncluded":{"value":"yes"},"flooring":{"value":"stone"},"garden":{"value":"private"},"gasCostIncluded":{"value":"yes"},"heating":{"value":"electrical"},"internetCostIncluded":{"value":"yes"},"kitchen":{"value":"private"},"kitchenware":{"value":"private"},"livingRoom":{"value":"private"},"parking":{"value":"private"},"pets":{"value":"discussable"},"playMusic":{"value":"yes"},"registrationPossible":{"value":"yes"},"roomFurniture":{"value":"yes"},"smoking":{"value":"outside_only"},"toilet":{"value":"private"},"totalSize":{"value":"205"},"tv":{"value":"yes"},"washingMachine":{"value":"yes"},"waterCostIncluded":{"value":"yes"},"wheelchairAccessible":{"value":"no"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":320000,"deposit":300000,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"3200.00","deposit":"3000.00","agencyFee":"0.00","estimatedBills":"0.00"},"minimumStayMonths":12,"moveInWindow":0,"currentOccupancy":0,"minAge":0,"maxAge":0,"preferredGender":"","available":[{"to":"9999-12-31","from":"2026-07-17"}],"updated":"2026-07-17T05:03:58Z","__utId__":"ut1701938"}]