87c50ad35.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1701938/1c6377f1-9814-43c8-828f-1d187c50ad35.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1701938/1c6377f1-9814-43c8-828f-1d187c50ad35.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1701938/1c6377f1-9814-43c8-828f-1d187c50ad35.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"🏡 Wohnen auf Zeit in unserem liebevollen Zuhause (1,5–2 Jahre)\n\nSchweren Herzens vermieten wir unser wunderschönes, vor 5 Jahren neu gebautes Zuhause, da wir beruflich für 1–2 Jahre wegziehen werden. Unser Haus ist für uns ein ganz besonderer Ort, an dem wir uns sehr wohlfühlen – und genau dieses Gefühl wünschen wir uns auch für die zukünftigen Bewohner.\n\nWir suchen nette, zuverlässige Menschen, die unser Zuhause in dieser Zeit genauso wertschätzen und sich darin zuhause fühlen.\n\nDas Haus bietet viel Platz, eine moderne Ausstattung und eine großzügige Raumaufteilung:\n\n✨ Erdgeschoss:\n\t•\tFreundlicher Eingangsbereich\n\t•\tGäste-WC\n\t•\tGroßzügiger Wohn-, Ess- und Küchenbereich\n\t•\tAbstellkammer\n\t•\tDirekter Zugang zur Garage, einer großen Terrasse und in den Garten\n\n🌿 Außenbereich:\n\t•\tSchöner Garten\n\t•\tGroße Terrasse – perfekt zum Entspannen, Essen oder Zeit mit Familie & Freunden\n        •       Zwei Garagenstellplätze\n\n✨ 1. Obergeschoss:\n\t•\tZwei Schlafzimmer\n\t•\tSehr großes Badezimmer mit Badewanne & Dusche\n\t•\tAnkleidezimmer\n\n✨ 2. Obergeschoss:\n\t•\tZwei weitere Zimmer\n\t•\tZusätzliches Bad mit Dusche\n\n✨ Keller:\n\t•\tTeilweise von uns genutzt (für Möbel & persönliche Dinge)\n\t•\tWaschraum steht zur Verfügung\n\nDas Haus ist mit moderner Technik ausgestattet (u. a. Photovoltaik und Wärmepumpe) und bietet ein angenehmes Wohnklima.\n\nNach Absprache können einige Möbel im Haus bleiben.\n\n📅 Verfügbar ab: 01.08.2026\n📆 Mietdauer: ca. 1,5 Jahre, eventuell verlängerbar auf bis zu 2 Jahre nach Absprache\n\nUns ist besonders wichtig, dass sich die Mieter in unserem Zuhause wohlfühlen und es mit genauso viel Herz behandeln, wie wir es tun.","facilities":{"airConditioning":{"value":"no"},"allergyFriendly":{"value":"no"},"balconyTerrace":{"value":"private"},"basement":{"value":"private"},"bathroom":{"value":"private"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"yes"},"bedrooms":{"value":"4"},"closet":{"value":"yes"},"couplesAllowed":{"value":"yes"},"desk":{"value":"yes"},"dishwasher":{"value":"yes"},"dryer":{"value":"yes"},"electricityCostIncluded":{"value":"yes"},"flooring":{"value":"stone"},"garden":{"value":"private"},"gasCostIncluded":{"value":"yes"},"heating":{"value":"electrical"},"internetCostIncluded":{"value":"yes"},"kitchen":{"value":"private"},"kitchenware":{"value":"private"},"livingRoom":{"value":"private"},"parking":{"value":"private"},"pets":{"value":"discussable"},"playMusic":{"value":"yes"},"registrationPossible":{"value":"yes"},"roomFurniture":{"value":"yes"},"smoking":{"value":"outside_only"},"toilet":{"value":"private"},"totalSize":{"value":"205"},"tv":{"value":"yes"},"washingMachine":{"value":"yes"},"waterCostIncluded":{"value":"yes"},"wheelchairAccessible":{"value":"no"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":300000,"deposit":300000,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"3000.00","deposit":"3000.00","agencyFee":"0.00","estimatedBills":"0.00"},"minimumStayMonths":12,"moveInWindow":0,"currentOccupancy":0,"minAge":0,"maxAge":0,"preferredGender":"","available":[{"to":"9999-12-31","from":"2026-08-01"}],"updated":"2026-04-24T11:36:05Z","__utId__":"ut1701938"}