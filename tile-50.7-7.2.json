rmat%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1656149/3daf9162-ffcd-4e6a-be64-844d28a73ec4.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1656149/3daf9162-ffcd-4e6a-be64-844d28a73ec4.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"Große moderne 3-Zimmer-Wohnung mit Terrasse und Gartenblick \n\nDie helle und modern eingerichtete Wohnung bietet auf 100 qm viel Platz für Familien, Berufspendler oder Gäste auf Zeit. Sie wurde 2015 kernsaniert und 2025 vollständig möbliert und renoviert – ideal für einen längeren Aufenthalt. Wohnfläche: 100 qm, Souterrain mit Terrasse & Gartennutzung Zimmer: Wohnzimmer mit großer Fensterfront, 2 Schlafzimmer mit blick ins Grüne, moderne Küche mit Essbereich, Tageslichtbad, Flur Schlafmöglichkeiten: 1 Doppelbett, 2 Einzelbetten Ausstattung: WLAN, LED-TV, Waschmaschine, Trockner, Spülmaschine, komplette Küchenausstattung, 2 Parkplätze vor der Tür Besonderheiten: helle Räume, Rollläden, viel Stauraum, Nichtraucher, Haustiere nach Absprache Lage: Königswinter-Thomasberg (ruhige Straße, gute Anbindung) – Supermarkt & Bushaltestelle fußläufig, Autobahn A3 in 5 Min., Bonn in ca. 20 Min., Köln in ca. 40 Min. \n\n👉 Perfekt für Langzeitmieter, die eine komfortable und voll ausgestattete Wohnung mit guter Anbindung suchen.\n\n\n","facilities":{"allergyFriendly":{"value":"yes"},"balconyTerrace":{"value":"private"},"basement":{"value":"no"},"bathroom":{"value":"shared_w_both"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"yes"},"bedrooms":{"value":"2"},"closet":{"value":"yes"},"couplesAllowed":{"value":"yes"},"desk":{"value":"yes"},"dryer":{"value":"yes"},"electricityCostIncluded":{"value":"yes"},"garden":{"value":"shared"},"gasCostIncluded":{"value":"yes"},"heating":{"value":"central"},"internetCostIncluded":{"value":"yes"},"kitchen":{"value":"private"},"kitchenware":{"value":"private"},"livingRoom":{"value":"private"},"parking":{"value":"shared"},"pets":{"value":"discussable"},"playMusic":{"value":"yes"},"registrationPossible":{"value":"yes"},"smoking":{"value":"outside_only"},"tenantStatus":{"value":"working professionals only"},"toilet":{"value":"private"},"totalSize":{"value":"100"},"tv":{"value":"yes"},"washingMachine":{"value":"yes"},"waterCostIncluded":{"value":"yes"},"wheelchairAccessible":{"value":"no"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":300000,"deposit":300000,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"3000.00","deposit":"3000.00","agencyFee":"0.00","estimatedBills":"0.00"},"minimumStayMonths":1,"moveInWindow":0,"currentOccupancy":0,"minAge":25,"maxAge":0,"preferredGender":"","available":[{"to":"9999-12-31","from":"2026-06-03"}],"updated":"2026-06-03T08:31:07Z","__utId__":"ut1656149"}]