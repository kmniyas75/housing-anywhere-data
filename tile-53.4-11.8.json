r Lage in einem historischen Fachwerkhaus in der Altstadt von Parchim. Die Unterkunft eignet sich besonders für Ärzt:innen, medizinisches Fachpersonal sowie Projektmitarbeitende, die für einen befristeten Zeitraum in Parchim tätig sind.\n\nDie Lage ist für berufliche Einsätze sehr praktisch: Das Krankenhaus, der Stadtpark sowie der Wockersee sind fußläufig erreichbar, die Umgebung ist ruhig und dennoch zentral.\n\nDie Wohnung verfügt über ein Wohnzimmer mit kleinem Arbeitsplatz, eine separate Küche sowie ein Schlafzimmer zum Innenhof, wodurch auch bei geöffnetem Fenster eine ruhige Schlafumgebung gegeben ist.\n\nEin Innenhof kann mitgenutzt werden, z. B. zum Abstellen von Fahrrädern oder im Sommer zum Grillen.\n\nEin Self Check-in über Schlüsselbox ermöglicht eine flexible und unabhängige Anreise.\n\nBettwäsche und Handtücher sind vorhanden, eine regelmäßige Reinigung inklusive Wäschewechsel erfolgt in festem Intervall.\n\nSupermärkte sind in wenigen Minuten mit dem Auto oder in ca. 15 Minuten zu Fuß erreichbar.\n\nKostenlose Parkmöglichkeiten befinden sich an der Straße.","facilities":{"airConditioning":{"value":"no"},"allergyFriendly":{"value":"no"},"balconyTerrace":{"value":"private"},"basement":{"value":"no"},"bathroom":{"value":"private"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"yes"},"bedrooms":{"value":"1"},"closet":{"value":"yes"},"couplesAllowed":{"value":"yes"},"desk":{"value":"yes"},"dishwasher":{"value":"no"},"dryer":{"value":"no"},"electricityCostIncluded":{"value":"yes"},"flooring":{"value":"laminate"},"garden":{"value":"no"},"gasCostIncluded":{"value":"yes"},"heating":{"value":"gas"},"internetCostIncluded":{"value":"yes"},"kitchen":{"value":"private"},"kitchenware":{"value":"private"},"livingRoom":{"value":"private"},"parking":{"value":"shared"},"pets":{"value":"no"},"playMusic":{"value":"yes"},"registrationPossible":{"value":"yes"},"roomFurniture":{"value":"yes"},"smoking":{"value":"outside_only"},"toilet":{"value":"private"},"totalSize":{"value":"50"},"tv":{"value":"yes"},"washingMachine":{"value":"yes"},"waterCostIncluded":{"value":"yes"},"wheelchairAccessible":{"value":"no"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":135000,"deposit":0,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"1350.00","deposit":"0.00","agencyFee":"0.00","estimatedBills":"0.00"},"minimumStayMonths":0,"moveInWindow":0,"currentOccupancy":0,"minAge":0,"maxAge":0,"preferredGender":"","available":[{"to":"9999-12-31","from":"2026-05-29"}],"updated":"2026-05-29T05:32:01Z","__utId__":"ut1680916"}]