37aab1a-2534-44ac-a931-f453883e2fdb.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/unit_type/1454314/637aab1a-2534-44ac-a931-f453883e2fdb.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1454314/637aab1a-2534-44ac-a931-f453883e2fdb.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1454314/637aab1a-2534-44ac-a931-f453883e2fdb.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1454314/637aab1a-2534-44ac-a931-f453883e2fdb.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}},{"originalLink":"https://housinganywhere.imgix.net/unit_type/1454314/b3ab65d2-a339-4c2e-a715-f707c73fb1c1.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","categories":["floorplan"],"sizes":{"1024x768":{"link":"https://housinganywhere.imgix.net/unit_type/1454314/b3ab65d2-a339-4c2e-a715-f707c73fb1c1.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/unit_type/1454314/b3ab65d2-a339-4c2e-a715-f707c73fb1c1.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1454314/b3ab65d2-a339-4c2e-a715-f707c73fb1c1.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1454314/b3ab65d2-a339-4c2e-a715-f707c73fb1c1.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1454314/b3ab65d2-a339-4c2e-a715-f707c73fb1c1.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"English/German:\nBright, quiet 1-room apartment in the east of Munich (Haar), with S-Bahn connection, at rush hour every 10 minutes to the city in 20 minutes. The apartment is modern and attractively furnished, fully equipped, has vinyl flooring in wood look (suitable for allergy sufferers), is located on the 4th and last floor with elevator and has a balcony with a wonderful view!\n\nPack your bags, move in, arrive!\n\nThe living/bedroom is visually separated by a room divider, bathroom with tub and toilet, \nsmall balcony with seating, west orientation / evening sun.\n\nRental exclusively for a limited period of time to 1 person, min. 4 - 6 months, with option of extension.\n\n- Kitchen as good as new with stove/oven, fridge/freezer, microwave, toaster, kettle, coffee machine etc.\n- Crockery and cooking utensils fully provided\n- Blinds + curtains for blackout on the window front\n- Smart cable TV, flat screen TV, Wi-Fi \n- Washing machine in the communal laundry room in the house\n-Wardrobe, bed 140x200 cm\n- Living/dining area with armchair, cupboards, room divider, dining table etc.\n- Apartment is suitable for 1 person\n- Smoking only on the balcony, no pets\n- Vacuum cleaner, ironing board, iron, bed linen, towels provided\n- Basic equipment cleaning products available\n\nThere are always plenty of parking spaces on the street in front of the house.\nAll shops for daily needs, doctors and restaurants are within walking distance. \n\n\nHelles, ruhiges 1-Zimmer-Appartement im Osten von München (Haar), mit S-Bahn-Anbindung, zur Rush-Hour im 10-Minuten Takt in die City in 20 Minuten. Das Apartment ist modern und ansprechend möbliert, voll ausgestattet, verfügt über Vinylboden in Holzoptik (Allergikergeeignet), liegt im 4. und letztes Obergeschoss mit Aufzug und hat einen Balkon mit herrlichem Ausblick!\n\nKoffer packen, einziehen, ankommen!\n\nDas Wohn/Schlafzimmer ist durch einen Raumteiler optisch getrennt, Badezimmer mit Wanne und WC, \nkleiner Balkon mit Sitzgelegenheit, Westausrichtung / Abendsonne.\n\nVermietung ausschließlich befristet an 1 Person, min. 4 - 6 Monate, mit Option auf Verlängerung.\n\n- Neuwertige Küche mit Herd/Backofen, Kühl/Gefrierkombination, Mikrowelle, Toaster, Wasserkocher, Kaffeemaschine etc.\n- Geschirr und Kochutensilien komplett vorhanden\n- Jalousien + Vorhänge zur Verdunkelung an der Fensterfront\n- Kabelfernsehen, Flat TV, W-lan \n- Waschmaschine im Gemeinschaftswaschkeller im Haus\n- Kleiderschrank, Bett  140x200 cm\n- Wohn-/Essbereich mit Sessel, Schränken, Raumteiler, Esstisch etc.\n- Apartment ist für 1 Person geeignet\n- Rauchen nur auf dem Balkon, keine Haustiere\n- Staubsauger, Bügelbrett, Bügeleisen, Bettwäsche, Handtücher vorhanden\n- Grundausstattung Putzmittel vorhanden\n\nParkplätze sind auf der Straße vor dem Haus immer ausreichend vorhanden.\nAlle Geschäfte des täglichen Bedarfs, Ärzte und Restaurants befinden sich fußläufig in der näheren Umgebung. \n\n\n","facilities":{"airConditioning":{"value":"no"},"allergyFriendly":{"value":"no"},"balconyTerrace":{"value":"private"},"basement":{"value":"no"},"bathroom":{"value":"private"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"no"},"bedrooms":{"value":"0"},"closet":{"value":"yes"},"couplesAllowed":{"value":"no"},"desk":{"value":"yes"},"dishwasher":{"value":"no"},"dryer":{"value":"yes"},"electricityCostIncluded":{"value":"yes"},"flooring":{"value":"laminate"},"garden":{"value":"no"},"gasCostIncluded":{"value":"yes"},"heating":{"value":"central"},"internetCostIncluded":{"value":"yes"},"kitchen":{"value":"private"},"kitchenware":{"value":"private"},"livingRoom":{"value":"private"},"parking":{"value":"shared"},"pets":{"value":"no"},"playMusic":{"value":"no"},"registrationPossible":{"value":"yes"},"roomFurniture":{"value":"yes"},"smoking":{"value":"outside_only"},"tenantStatus":{"value":"working professionals only"},"toilet":{"value":"private"},"totalSize":{"value":"32"},"tv":{"value":"yes"},"washingMachine":{"value":"yes"},"waterCostIncluded":{"value":"yes"},"wheelchairAccessible":{"value":"no"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":99000,"deposit":198000,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"990.00","deposit":"1980.00","agencyFee":"0.00","estimatedBills":"0.00"},"minimumStayMonths":6,"moveInWindow":0,"currentOccupancy":0,"minAge":0,"maxAge":0,"preferredGender":"","available":[{"to":"9999-12-31","from":"2027-01-01"}],"updated":"2026-03-30T10:42:22Z","__utId__":"ut1454314"}]