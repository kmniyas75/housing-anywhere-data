:"https://housinganywhere.imgix.net/unit_type/1585175/5c639aa6-bbe1-46cb-aed7-9987e317941e.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1585175/5c639aa6-bbe1-46cb-aed7-9987e317941e.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1585175/5c639aa6-bbe1-46cb-aed7-9987e317941e.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1585175/5c639aa6-bbe1-46cb-aed7-9987e317941e.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"Ich bin beruflich auf Reisen und würde gerne für drei Monate mein gemütliches Reihenhaus in Buchholz an nette Menschen (maximal 3 Personen) untervermieten.\n\nZeitraum\nMitte Februar bis Ende Mai (Mindestmietdauer 2 Monate, idealerweise 3 Monate)\n\nLage\n- Buchholz in der Nordheide\n- gut angebunden an A1 und A7 (Parken an der Straße kostenlos möglich)\n- mit der Bahn 25min zum Hamburger Hauptbahnhof\n- Das Haus ist 1km vom Buchholzer Bahnhof entfernt, fußläufig in 15min oder mit dem Rad in 5min zu erreichen. \n\nHaus\n- Reihenhaus, 90m2\n- 1 Schlafzimmer mit Doppelbett (1,60mx2m)\n- 1 Gäste- oder Kinderzimmer mit Bett (1,20mx2m)\n- 1 Wohnzimmer\n- offene Küche\n- Arbeitszimmer\n- Badezimmer mit Vollbad und 1 Gäste-WC\n- großer Balkon\n- Terrasse mit Garten\n\nDie Umgebung\nBuchholz hat ca. 40.000 Einwohner und liegt direkt am Naturschutzgebiet Lüneburger Heide. Wer gerne wandert, Fahrrad fährt oder reitet hat hier super Freizeitmöglichkeiten. Es gibt eine direkte Zuganbindung sowohl nach Hamburg als auch nach Bremen. \nEinkaufsmöglichkeiten (Edeka, Aldi, Lidl, Budni) sind fußläufig zu erreichen. ","facilities":{"airConditioning":{"value":"no"},"balconyTerrace":{"value":"private"},"basement":{"value":"no"},"bathroom":{"value":"shared_w_both"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"yes"},"bedrooms":{"value":"2"},"closet":{"value":"yes"},"couplesAllowed":{"value":"yes"},"desk":{"value":"yes"},"dishwasher":{"value":"yes"},"dryer":{"value":"no"},"electricityCostIncluded":{"value":"yes"},"flooring":{"value":"wood"},"garden":{"value":"private"},"gasCostIncluded":{"value":"yes"},"heating":{"value":"gas"},"internetCostIncluded":{"value":"yes"},"kitchen":{"value":"private"},"kitchenware":{"value":"private"},"livingRoom":{"value":"private"},"parking":{"value":"shared"},"pets":{"value":"discussable"},"playMusic":{"value":"discussable"},"roomFurniture":{"value":"yes"},"smoking":{"value":"outside_only"},"toilet":{"value":"private"},"totalSize":{"value":"90"},"tv":{"value":"yes"},"washingMachine":{"value":"yes"},"waterCostIncluded":{"value":"yes"},"wheelchairAccessible":{"value":"no"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":125000,"deposit":100000,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"1250.00","deposit":"1000.00","agencyFee":"0.00","estimatedBills":"0.00"},"minimumStayMonths":1,"moveInWindow":0,"currentOccupancy":0,"minAge":0,"maxAge":0,"preferredGender":"","available":[{"to":"9999-12-31","from":"2026-11-01"}],"updated":"2026-08-05T08:45:30Z","__utId__":"ut1585175"}]