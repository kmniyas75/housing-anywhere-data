compress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}},{"originalLink":"https://housinganywhere.imgix.net/unit_type/1744565/190649a9-54bd-4712-9c49-e38a49e86304.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","categories":["bedroom"],"sizes":{"1024x768":{"link":"https://housinganywhere.imgix.net/unit_type/1744565/190649a9-54bd-4712-9c49-e38a49e86304.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/unit_type/1744565/190649a9-54bd-4712-9c49-e38a49e86304.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1744565/190649a9-54bd-4712-9c49-e38a49e86304.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1744565/190649a9-54bd-4712-9c49-e38a49e86304.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1744565/190649a9-54bd-4712-9c49-e38a49e86304.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"Apartment facts: \n\nThe 3-room apartment is centrally yet quietly located on Bornaische Str. in Connewitz. It is available for immediate move-in.\n\nThe furnished apartment features three well-laid-out rooms, each measuring approximately 8 to 11.9 sqm. Thanks to the floor plan and the three similarly sized rooms, the apartment is suitable for a flatshare (shared apartment). Additionally, there is a bright kitchen complete with a fitted kitchen, including a dishwasher, stove/oven, and a fridge-freezer.\n\nEach of the three rooms is equipped with a bed, a wardrobe, and a desk. \n\nThe courtyard can be used by tenants and offers bicycle storage. Free street parking is available in the immediate neighborhood.\n\n\nLocation: \nThe apartment is centrally located in the popular Leipzig district of Connewitz.\nConnewitzer Kreuz is about a 3-minute walk away. Several bus and tram lines run from there (including lines 9, 10, 11, and 89).\nHTWK is within walking distance, as is the lively Karl-Liebknecht-Straße (\"Karli\" pub mile) featuring numerous bars, restaurants, cafes, etc.\n\nEverything for your daily needs is quickly accessible (a Netto supermarket is directly opposite, REWE is 5 minutes away). In the immediate vicinity, you will also find medical centers, several parks and green spaces, gyms, clothing stores, and bookstores. The Wildpark wildlife park and Lake Cospuden offer great nearby recreational spots that are easily reached by bike. \n\n* **HTWK:** 5 min walk away\n* **Connewitzer Kreuz:** 3 min walk away (public transport, REWE, bakery, Sparkasse bank, daily fruit & vegetable market)\n* **Pharmacy, medical center, bakery, late-night convenience store (\"Späti\"):** 1 min walk away\n* **City center (Wilhelm-Leuschner-Platz) / Main Station (Hauptbahnhof):** 10 and 15 min by tram, respectively\n* **Close to Wildpark, great access to Lake Cospuden**\n\nHere is the English translation of the additional text, polished specifically for rental listings:\n\nContract formality: \nThe available room is ideal for international students and working professionals looking for a temporary home in Leipzig. A rental agreement will be signed for the duration of your stay, allowing for official city registration (*Anmeldung*) with the City of Leipzig. For this purpose, proof of the reason for your stay is required (e.g., employment contract, employer confirmation, or certificate of enrollment).","facilities":{"airConditioning":{"value":"no"},"balconyTerrace":{"value":"no"},"basement":{"value":"no"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"yes"},"bedroomSize":{"value":"10"},"bedrooms":{"value":"1"},"closet":{"value":"yes"},"desk":{"value":"yes"},"dishwasher":{"value":"yes"},"dryer":{"value":"no"},"electricityCostIncluded":{"value":"yes"},"flooring":{"value":"laminate"},"garden":{"value":"shared"},"gasCostIncluded":{"value":"yes"},"heating":{"value":"central"},"housematesGender":{"value":"shared_w_both"},"internetCostIncluded":{"value":"yes"},"kitchen":{"value":"shared"},"kitchenware":{"value":"shared"},"livingRoom":{"value":"no"},"pets":{"value":"no"},"playMusic":{"value":"discussable"},"registrationPossible":{"value":"yes"},"roomFurniture":{"value":"no"},"smoking":{"value":"no"},"toilet":{"value":"shared"},"totalSize":{"value":"59"},"tv":{"value":"no"},"washingMachine":{"value":"no"},"waterCostIncluded":{"value":"yes"},"wheelchairAccessible":{"value":"yes"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":110000,"deposit":110000,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"1100.00","deposit":"1100.00","agencyFee":"0.00","estimatedBills":"0.00"},"minimumStayMonths":1,"moveInWindow":0,"currentOccupancy":2,"minAge":0,"maxAge":0,"preferredGender":"","available":[{"to":"9999-12-31","from":"2026-10-07"}],"updated":"2026-10-07T05:24:27Z","__utId__":"ut1744565"}]