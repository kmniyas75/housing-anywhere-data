=srgb&fit=clip&h=600&w=800","width":800,"height":600}}},{"originalLink":"https://housinganywhere.imgix.net/unit_type/1670014/ca58f336-9a51-472b-8430-bef89e8ce175.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","categories":null,"sizes":{"1024x768":{"link":"https://housinganywhere.imgix.net/unit_type/1670014/ca58f336-9a51-472b-8430-bef89e8ce175.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/unit_type/1670014/ca58f336-9a51-472b-8430-bef89e8ce175.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1670014/ca58f336-9a51-472b-8430-bef89e8ce175.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1670014/ca58f336-9a51-472b-8430-bef89e8ce175.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1670014/ca58f336-9a51-472b-8430-bef89e8ce175.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}},{"originalLink":"https://housinganywhere.imgix.net/unit_type/1670014/02bdb937-d4f6-4b35-8503-bbd8a05f4f0a.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","categories":null,"sizes":{"1024x768":{"link":"https://housinganywhere.imgix.net/unit_type/1670014/02bdb937-d4f6-4b35-8503-bbd8a05f4f0a.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/unit_type/1670014/02bdb937-d4f6-4b35-8503-bbd8a05f4f0a.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1670014/02bdb937-d4f6-4b35-8503-bbd8a05f4f0a.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1670014/02bdb937-d4f6-4b35-8503-bbd8a05f4f0a.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1670014/02bdb937-d4f6-4b35-8503-bbd8a05f4f0a.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"Komplett eingerichtete Erdgeschosswohnung mit Terrasse in guter ruhiger Lage in Herten. \n \nIdeal für 1-2 Personen, die in der Gegend arbeiten oder einen schönen Rückzugsort suchen.\n\nSehr gute Anbindung an ÖPVN (Bus/ Zug), A43 und A2 sind in 10 Autominuten erreichbar. Ein Supermarkt, eine Schwimmbad mit Saunalandschaft  und der Schlosspark sind 5 Gehminuten entfernt. Das Stadtzentrum mit Einkaufsmöglichkeiten ebenfalls fußläufig erreichbar.\n\nParkmöglichkeiten sind auf öffentlichem Parkraum direkt vor dem Haus ausreichend vorhanden, oder gegen Aufpreis im Carport.\n\nDer Eigentümer wohnt im Haus und ist kurzfristig ansprechbar. \n\nDie Terrasse mit Gartenblick ist zur alleinigen Benutzung für den Mieter, wird aber als Durchgang mitbenutzt. \n\nRauchen ist nur draußen gestattet, in der Wohnung gilt Rauchverbot.\n\nHaustiere nach Absprache, im Haus lebt eine Katze, die auch die Terrasse mitbenutzt. Für Menschen die keine Katzen mögen, ist der Ort also nicht zu empfehlen.\n\nDie Küche ist komplett ausgestattet mit Ofen und Mikrowelle, großer Side-by-Side Kühl-/ Gefrierkombi, Geschirrspüler, Induktionskochfeld, Dunstabzug, sowie komplettem Besteck und Geschirr. Außerdem werden Toaster, Mixer, Wasserkocher, und Sodastreamer zur Verfügung gestellt.\n\nWohnzimmer mit Kaminofen.\n\nIm Schlafzimmer gibt es ein Bett (1,40 x 200m), sowie ein Schlafsofa im Wohnzimmer.\nGroßer Schreibtisch (ca 3 m) mit LAN-Anschluss im Schlafzimmer.\n\nW-LAN ist in allen Bereichen vorhanden, Bettwäsche und Handtücher können auf Wunsch zur Verfügung gestellt werden.\n\nKleines Bad mit Dusche und gesichertem Fenster.\nFotos vom Schlafzimmer folgen.\n\nEine Waschmaschine und einen Trockner gibt es im Keller zur Gemeinschaftsverwendung. Hier finden sie auf Wunsch auch Wäscheständer, Bügelbrett/ Bügeleisen / Staubsauger / Putzzeug etc.\n\nKeine lauten Geräusche oder störendes Verhalten nach 22 Uhr. Zusätzliche Serviceleistungen sind auf Anfrage möglich.\n\nVerlängerung der Mietdauer ist nach Absprache möglich","facilities":{"airConditioning":{"value":"no"},"allergyFriendly":{"value":"no"},"balconyTerrace":{"value":"shared"},"basement":{"value":"shared"},"bathroom":{"value":"private"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"yes"},"bedrooms":{"value":"1"},"closet":{"value":"yes"},"couplesAllowed":{"value":"yes"},"desk":{"value":"yes"},"dishwasher":{"value":"yes"},"dryer":{"value":"yes"},"electricityCostIncluded":{"value":"yes"},"flooring":{"value":"wood"},"garden":{"value":"shared"},"gasCostIncluded":{"value":"yes"},"heating":{"value":"central"},"internetCostIncluded":{"value":"yes"},"kitchen":{"value":"private"},"kitchenware":{"value":"private"},"livingRoom":{"value":"private"},"parking":{"value":"shared"},"pets":{"value":"discussable"},"playMusic":{"value":"discussable"},"registrationPossible":{"value":"yes"},"roomFurniture":{"value":"yes"},"smoking":{"value":"outside_only"},"tenantStatus":{"value":"working professionals only"},"toilet":{"value":"private"},"totalSize":{"value":"63"},"tv":{"value":"yes"},"washingMachine":{"value":"yes"},"waterCostIncluded":{"value":"yes"},"wheelchairAccessible":{"value":"no"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":130000,"deposit":180000,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"1300.00","deposit":"1800.00","agencyFee":"0.00","estimatedBills":"0.00"},"minimumStayMonths":0,"moveInWindow":0,"currentOccupancy":0,"minAge":30,"maxAge":50,"preferredGender":"","available":[{"to":"2026-07-21","from":"2026-03-30"},{"to":"9999-12-31","from":"2026-08-23"}],"updated":"2026-03-30T10:59:03Z","__utId__":"ut1670014"}]