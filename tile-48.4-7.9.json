},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"yes"},"bedrooms":{"value":"3"},"closet":{"value":"yes"},"couplesAllowed":{"value":"yes"},"desk":{"value":"yes"},"dishwasher":{"value":"yes"},"dryer":{"value":"no"},"electricityCostIncluded":{"value":"yes"},"flooring":{"value":"wood"},"garden":{"value":"no"},"gasCostIncluded":{"value":"yes"},"heating":{"value":"central"},"internetCostIncluded":{"value":"yes"},"kitchen":{"value":"private"},"kitchenware":{"value":"private"},"livingRoom":{"value":"private"},"parking":{"value":"private"},"pets":{"value":"no"},"playMusic":{"value":"yes"},"registrationPossible":{"value":"yes"},"roomFurniture":{"value":"yes"},"smoking":{"value":"outside_only"},"toilet":{"value":"private"},"totalSize":{"value":"80"},"tv":{"value":"yes"},"washingMachine":{"value":"yes"},"waterCostIncluded":{"value":"yes"},"wheelchairAccessible":{"value":"no"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":280000,"deposit":50000,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"2800.00","deposit":"500.00","agencyFee":"0.00","estimatedBills":"0.00"},"minimumStayMonths":0,"moveInWindow":0,"currentOccupancy":0,"minAge":0,"maxAge":0,"preferredGender":"","available":[{"to":"9999-12-31","from":"2026-09-14"}],"updated":"2026-09-14T11:53:17Z","__utId__":"ut1740086"}]