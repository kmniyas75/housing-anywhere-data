a67d-d31ea4fbc5e3.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","categories":null,"sizes":{"1024x768":{"link":"https://housinganywhere.imgix.net/unit_type/1698997/dceff71c-f3be-4e4c-a67d-d31ea4fbc5e3.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/unit_type/1698997/dceff71c-f3be-4e4c-a67d-d31ea4fbc5e3.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1698997/dceff71c-f3be-4e4c-a67d-d31ea4fbc5e3.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1698997/dceff71c-f3be-4e4c-a67d-d31ea4fbc5e3.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1698997/dceff71c-f3be-4e4c-a67d-d31ea4fbc5e3.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}},{"originalLink":"https://housinganywhere.imgix.net/unit_type/1698997/6837cba3-df62-42e3-9572-410771c37415.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","categories":null,"sizes":{"1024x768":{"link":"https://housinganywhere.imgix.net/unit_type/1698997/6837cba3-df62-42e3-9572-410771c37415.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/unit_type/1698997/6837cba3-df62-42e3-9572-410771c37415.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1698997/6837cba3-df62-42e3-9572-410771c37415.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1698997/6837cba3-df62-42e3-9572-410771c37415.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1698997/6837cba3-df62-42e3-9572-410771c37415.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"The Room\nThe available room is part of my 120 m2 penthouse on the 2nd floor. Over the last two years, the apartment has been  renovated (new electrics, floors, and walls). The building itself dates back to the 70s.\n\nThe room comes fully furnished and is very cozy: it includes a comfortable bed with a mattress, a wardrobe, curtains, a desk with a chair, a large rug, and some plants to make you feel right at home. I’ll also be mounting a TV on the wall (it’s currently still sitting on the bed). The apartment has two real highlights: a smaller southeast-facing balcony and a 20 m2  terrace facing southwest. Both offer a direct, unobstructed view of the greenery (Everstenholz).\n\nWe will share the new kitchen, the bathroom with a tub (there’s also a separate guest toilet), the hallway, and the heart of the home: a 40 m2 living and dining area with panoramic windows and a fireplace, which we can enjoy during the winter. On the practical side, there’s a washer-dryer in the apartment, a huge 40 m2 private cellar space, and a shared bike cellar. Once a week, a cleaner comes by to take care of the basic cleaning of the common areas, including your room if you want.\n\nLocation\nWe are located on Wichelnstraße in the beautiful Dobbenviertel, right on the border of the Eversten district. The location is perfect if you love nature but still want to be close to the city center. Everstenholz is right on our doorstep, and at the end of the street—within sight—the Dobbenwiesen begin. It’s ideal for jogging, walking, or just getting some fresh air. You can usually find parking right on the street in front of the house. The city center is not far away and can be reached in just a few minutes by foot, bike, or bus.\n\nFlatshare Life (WG-Leben)\nA little about me: I’m 33 years old (turning 34 in two weeks) and work as a doctor in the outpatient medical sector four days a week. I lead a fairly structured daily life. In my free time, I enjoy going to the gym, doing Zumba, or playing padel tennis, which I’ve recently discovered. I used to practice yoga regularly and would love to get back into it. I’d describe myself as more of an introvert and I really value my peace and quiet at home.\n\nI’m looking for someone who also leads a structured life—whether you’re a student or a professional doesn't matter to me.  I’d love for us to have a chat over a glass of wine or tea, sit on the terrace together, or just catch up on our day. A warm, open atmosphere where we respect each other’s space but also enjoy sharing some time is important to me. International housemates are just as welcome as locals!\n\nAdditional Info\nThe rental is initially planned for the medium term (fixed term), but I’m very open to a long-term arrangement if we get along well.\n\nIf this sounds like a good fit for you, please send me a message and tell me a bit about yourself: Who are you, what does your daily routine look like, and what’s important to you in a flatshare?\n\nI look forward to meeting you!\n\nGreetings Tara","facilities":{"airConditioning":{"value":"no"},"allergyFriendly":{"value":"yes"},"balconyTerrace":{"value":"shared"},"basement":{"value":"shared"},"bathroom":{"value":"shared_w_both"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"yes"},"bedroomSize":{"value":"15"},"bedrooms":{"value":"1"},"closet":{"value":"yes"},"couplesAllowed":{"value":"no"},"desk":{"value":"yes"},"dishwasher":{"value":"yes"},"dryer":{"value":"yes"},"electricityCostIncluded":{"value":"yes"},"flooring":{"value":"laminate"},"garden":{"value":"shared"},"gasCostIncluded":{"value":"yes"},"heating":{"value":"gas"},"housematesGender":{"value":"shared_w_girls"},"internetCostIncluded":{"value":"yes"},"kitchen":{"value":"shared"},"kitchenware":{"value":"shared"},"livingRoom":{"value":"shared"},"parking":{"value":"no"},"pets":{"value":"discussable"},"playMusic":{"value":"discussable"},"registrationPossible":{"value":"yes"},"roomFurniture":{"value":"yes"},"smoking":{"value":"no"},"toilet":{"value":"shared"},"totalSize":{"value":"120"},"tv":{"value":"yes"},"washingMachine":{"value":"yes"},"waterCostIncluded":{"value":"yes"},"wheelchairAccessible":{"value":"no"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":89000,"deposit":89000,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"890.00","deposit":"890.00","agencyFee":"0.00","estimatedBills":"0.00"},"minimumStayMonths":0,"moveInWindow":0,"currentOccupancy":1,"minAge":24,"maxAge":45,"preferredGender":"","available":[{"to":"9999-12-31","from":"2026-04-06"}],"updated":"2026-04-06T07:45:46Z","__utId__":"ut1698997"}]