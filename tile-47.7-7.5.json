d8.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1749482/d5bfa5cc-73a7-422d-a72c-79811d7be3d8.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"Premium 2-Room Attic Apartment next to Golf Resort – Incl. Parking & 2 Balconies\n\nDescription\n\nElegant Living at the \"Drei Thermen\" Golf Resort – Perfect for Expats & Professionals\nWelcome to your high-end retreat in Bad Bellingen-Hertingen. Located right next to the prestigious golf course and surrounded by beautiful nature, this modern 54 m2 penthouse apartment offers the perfect balance between a peaceful countryside lifestyle and close proximity to the Basel metropolitan area.\nThe Space:\n* Fully Equipped & Furnished: Move in with just your suitcase. The apartment is beautifully furnished with high-quality pieces, a fully equipped kitchen (including all appliances, dishes, and coffee machine), and fast Wi-Fi.\n* Two Private Balconies: Enjoy your morning coffee or scenic evening views on two separate balconies, offering sun throughout the day.\n* Top Floor Privacy: Located in the attic (Dachgeschoss), providing maximum privacy, bright rooms, and a cozy yet modern atmosphere.\nLocation & Commute:\n* Perfect for Car Commuters: The apartment includes a dedicated parking space right at the building.\n* Pharma Hub Access: Drive to the Swiss border or the major pharmaceutical hubs in Basel (Roche, Novartis) in about 25–30 minutes.\n* Relaxation: The famous thermal baths of Bad Bellingen and premium golf facilities are right at your doorstep.\nRental Terms:\n* All-Inclusive Price: Heating, electricity, water, high-speed internet, and the private parking space are completely included in the monthly rent.\n* Target Group: Ideal for single professionals, consultants, or couples looking for a premium, quiet home after a busy work day in Basel.","facilities":{"airConditioning":{"value":"no"},"balconyTerrace":{"value":"private"},"basement":{"value":"private"},"bathroom":{"value":"private"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"yes"},"bedrooms":{"value":"1"},"closet":{"value":"yes"},"couplesAllowed":{"value":"yes"},"desk":{"value":"yes"},"dishwasher":{"value":"no"},"dryer":{"value":"no"},"electricityCostIncluded":{"value":"yes"},"flooring":{"value":"stone"},"garden":{"value":"no"},"gasCostIncluded":{"value":"yes"},"heating":{"value":"central"},"internetCostIncluded":{"value":"yes"},"kitchen":{"value":"private"},"livingRoom":{"value":"private"},"parking":{"value":"private"},"pets":{"value":"discussable"},"playMusic":{"value":"no"},"registrationPossible":{"value":"no"},"roomFurniture":{"value":"yes"},"smoking":{"value":"outside_only"},"toilet":{"value":"private"},"totalSize":{"value":"54"},"tv":{"value":"yes"},"washingMachine":{"value":"no"},"waterCostIncluded":{"value":"yes"},"wheelchairAccessible":{"value":"no"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":135000,"deposit":0,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"1350.00","deposit":"0.00","agencyFee":"0.00","estimatedBills":"0.00"},"minimumStayMonths":1,"moveInWindow":0,"currentOccupancy":0,"minAge":0,"maxAge":0,"preferredGender":"","available":[{"to":"9999-12-31","from":"2026-11-10"}],"updated":"2026-10-30T11:58:06Z","__utId__":"ut1749482"}]