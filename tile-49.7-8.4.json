housinganywhere.imgix.net/unit_type/1615434/dba1e400-b87a-4341-a16e-97d2cae8e559.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1615434/dba1e400-b87a-4341-a16e-97d2cae8e559.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1615434/dba1e400-b87a-4341-a16e-97d2cae8e559.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1615434/dba1e400-b87a-4341-a16e-97d2cae8e559.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"Die 5-Zimmerwohnung befindet sich in einer ruhigen Wohngegend von Biebesheim am Rhein. Die Gemeinde liegt am südlichen Rand des Rhein-Main-Gebiets im Hessischen Ried und bietet eine ideale Kombination aus ländlicher Ruhe und guter Anbindung an die umliegenden Ballungszentren.\n\nBeschreibung: Diese kompakte und voll ausgestattete Wohnung eignet sich ideal für Wohnen auf Zeit. Sie verfügt über ein Schlafzimmer, ein Wohnzimmer mit Arbeitsplatz (höhenverstellbarer Schreibtisch), eine Küche mit allen Annehmlichkeiten und ein Badezimmer. Kostenfreies WLAN ist vorhanden. Ein Waschtrockner befindet sich im Keller für die Nutzung der Gäste.\n\nAusstattung:\n\n- Handtücher und Bettwäsche\n- TV mit Kabelfernsehen, Satellitenempfang und Streamingmöglichkeiten\n- Heizung für angenehme Temperaturen\n- Internet (WLAN und LAN)\n- Föhn, Bügeleisen und Kleiderbügel für den täglichen Gebrauch\n- Voll ausgestattete Küche mit Kochutensilien, Kaffeemaschine, Wasserkocher, Mikrowelle und Gefrierschrank\n- Esstisch für gemütliche Mahlzeiten\n- Nichtraucherunterkunft\n- Smart TV für Unterhaltung\n\nService:\n- Selbständiger Check-In für flexible Anreisen\n- Gastgeber sprechen Englisch und Deutsch für eine reibungslose Kommunikation\n- Wohnsitzanmeldung ist möglich\n\nPreis: Der Preis ist inklusive Umsatzsteuer, da es sich um einen gewerblichen Gastgeber handelt.\n\nDiese Wohnung bietet alle Annehmlichkeiten für einen angenehmen Aufenthalt und ist perfekt für Personen, die eine temporäre Unterkunft suchen.","facilities":{"airConditioning":{"value":"no"},"allergyFriendly":{"value":"no"},"balconyTerrace":{"value":"private"},"basement":{"value":"no"},"bathroom":{"value":"private"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"yes"},"bedrooms":{"value":"4"},"closet":{"value":"yes"},"couplesAllowed":{"value":"yes"},"desk":{"value":"yes"},"dishwasher":{"value":"yes"},"dryer":{"value":"yes"},"electricityCostIncluded":{"value":"yes"},"flooring":{"value":"laminate"},"garden":{"value":"no"},"gasCostIncluded":{"value":"yes"},"heating":{"value":"central"},"internetCostIncluded":{"value":"yes"},"kitchen":{"value":"private"},"kitchenware":{"value":"private"},"livingRoom":{"value":"private"},"parking":{"value":"no"},"pets":{"value":"no"},"playMusic":{"value":"discussable"},"registrationPossible":{"value":"yes"},"roomFurniture":{"value":"yes"},"smoking":{"value":"outside_only"},"toilet":{"value":"private"},"totalSize":{"value":"130"},"tv":{"value":"yes"},"washingMachine":{"value":"yes"},"waterCostIncluded":{"value":"yes"},"wheelchairAccessible":{"value":"no"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":320000,"deposit":0,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"3200.00","deposit":"0.00","agencyFee":"0.00","estimatedBills":"0.00"},"minimumStayMonths":1,"moveInWindow":0,"currentOccupancy":0,"minAge":18,"maxAge":0,"preferredGender":"","available":[{"to":"9999-12-31","from":"2027-12-31"}],"updated":"2026-06-12T09:51:54Z","__utId__":"ut1615434"}]