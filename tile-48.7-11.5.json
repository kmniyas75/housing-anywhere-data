320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1611949/da12bcb3-bf96-4847-8588-8df90d2b6ec4.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1611949/da12bcb3-bf96-4847-8588-8df90d2b6ec4.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"☆ WILLKOMMEN IM AUSZEIT-DOMIZIL „RUHEPO(O)L“ ☆\nGemütliche und komplett eingerichtete Wohnung in Großmehring. Perfekt für 4 Personen. Abhängig von den Außentemperaturen (ca. Mitte Apr. bis Mitte Okt.) lädt der beheizte, private Swimmingpool zum Entspannen ein. Aber auch ein Wellnessraum inkl. Sauna steht Ihnen in der Wohnung zur Verfügung. Sie befinden sich optimal zur AUDI und der Hochschule IN direkt am Donauradwanderweg im Einzugsgebiet von Ingolstadt. Genießen Sie die helle und moderne Wohnung, die sich in ruhiger und direkt angebundener Lage zur historischen Altstadt von Ingolstadt befindet. Durch den unmittelbaren Autobahnanschluss (A9 ca. 5 km), aber auch durch ihre Lage am Donauradwanderweg ist sie die ideale Unterkunft für Menschen, die entspannende Tage am Pool oder in der Sauna verbringen wollen. Die Nähe zum „Ingolstadt Village“, zum Altmühltal, dem Donaudurchbruch, aber auch zum Flughafen München, qualifiziert diese Wohnung als passende Basis für Ausflüge und Unternehmungen. Auch wenn Sie geschäftlich von dort aus arbeiten wollen, können Sie dank WLAN und Arbeitsplatz alle Aufgaben reibungslos erledigen.\n \nDie Wohnung befindet sich im Erdgeschoß eines Zweiparteien-Wohnhauses und besteht aus folgenden Räumen/Bereichen:\n- Eingangsbereich mit Schiebetürenschrank\n- Wohn- / Essbereich mit integriertem Arbeitsplatz\n- offene Küche mit Kochinsel und Tresen\n- Wellnessraum mit Sauna und Whirlpool\n- Schlafzimmer mit einem Doppelbett und Kleiderschrank\n- Schlafraum mit 2 Etagenbetten und genügend Stauraum für Ihre Kleidung\n- Badezimmer mit Dusche und WC\n- separates WC\n- große Terrasse mit genügend Sitzmöglichkeiten zum Speisen im Freien\n- Beheizbarer Pool mit Gegenstromanlage","facilities":{"airConditioning":{"value":"no"},"allergyFriendly":{"value":"yes"},"balconyTerrace":{"value":"private"},"basement":{"value":"no"},"bathroom":{"value":"private"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"no"},"bedrooms":{"value":"2"},"closet":{"value":"yes"},"couplesAllowed":{"value":"yes"},"desk":{"value":"yes"},"dishwasher":{"value":"yes"},"dryer":{"value":"yes"},"electricityCostIncluded":{"value":"yes"},"flooring":{"value":"laminate"},"garden":{"value":"no"},"gasCostIncluded":{"value":"yes"},"heating":{"value":"central"},"internetCostIncluded":{"value":"yes"},"kitchen":{"value":"private"},"kitchenware":{"value":"private"},"livingRoom":{"value":"private"},"parking":{"value":"private"},"pets":{"value":"no"},"playMusic":{"value":"discussable"},"registrationPossible":{"value":"yes"},"roomFurniture":{"value":"yes"},"smoking":{"value":"outside_only"},"toilet":{"value":"private"},"totalSize":{"value":"120"},"tv":{"value":"yes"},"washingMachine":{"value":"yes"},"waterCostIncluded":{"value":"yes"},"wheelchairAccessible":{"value":"no"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":259900,"deposit":300000,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"2599.00","deposit":"3000.00","agencyFee":"0.00","estimatedBills":"0.00"},"minimumStayMonths":1,"moveInWindow":0,"currentOccupancy":0,"minAge":0,"maxAge":0,"preferredGender":"","available":[{"to":"9999-12-31","from":"2026-05-13"}],"updated":"2026-05-13T16:26:06Z","__utId__":"ut1611949"}]