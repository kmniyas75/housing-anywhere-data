s://housinganywhere.imgix.net/unit_type/1724544/cbb7aa21-c188-40ba-9ba7-66025c6fdeb9.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1724544/cbb7aa21-c188-40ba-9ba7-66025c6fdeb9.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1724544/cbb7aa21-c188-40ba-9ba7-66025c6fdeb9.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"The high-quality furnished two-room apartment is located on the second floor of a modern new-build apartment building in Lübeck-St. Jürgen. It offers approximately 55.6 m2 of living space and is easily accessible by lift. Its south-facing orientation makes the apartment pleasantly bright.\n\nThe open-plan living and dining area provides direct access to the balcony. The modern fitted kitchen with cooking island is equipped with a built-in refrigerator, oven, induction hob with integrated downdraft extractor, microwave, dishwasher, coffee machine and Thermomix TM7. Crockery, glasses, cutlery, pots and other kitchen utensils are also provided.\n\nThe separate bedroom is furnished with a box-spring bed, wardrobe and television. The bathroom includes a shower, heated mirror, washing machine and tumble dryer.\n\nFurther features include underfloor heating, triple-glazed windows, electric shutters, fibre-optic internet and an additional television in the living area.\n\nThe apartment also includes a designated parking space and two reserved bicycle spaces in the underground bicycle parking facility. A private storage room is also available for use.\n\nThe apartment is situated in the St. Jürgen district. UKSH University Hospital, the University of Lübeck and Lübeck University of Applied Sciences can all be reached quickly. Lübeck city centre and everyday amenities are also well connected.\n\nThe apartment is rented fully furnished, preferably for periods of at least three months. It is particularly suitable for professionals, UKSH employees, researchers, doctoral candidates or anyone looking for a furnished apartment in Lübeck for a temporary professional or private stay.\n\nThe apartment is located in a quiet residential building. Smoking, pets and parties are not permitted. Considerate behaviour towards the other residents is expected.","facilities":{"airConditioning":{"value":"no"},"balconyTerrace":{"value":"private"},"basement":{"value":"shared"},"bathroom":{"value":"private"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"yes"},"bedrooms":{"value":"1"},"closet":{"value":"yes"},"couplesAllowed":{"value":"yes"},"desk":{"value":"no"},"dishwasher":{"value":"yes"},"dryer":{"value":"yes"},"electricityCostIncluded":{"value":"no"},"flooring":{"value":"stone"},"garden":{"value":"no"},"gasCostIncluded":{"value":"yes"},"heating":{"value":"central"},"internetCostIncluded":{"value":"no"},"kitchen":{"value":"private"},"kitchenware":{"value":"private"},"livingRoom":{"value":"private"},"parking":{"value":"private"},"pets":{"value":"no"},"playMusic":{"value":"discussable"},"registrationPossible":{"value":"yes"},"roomFurniture":{"value":"yes"},"smoking":{"value":"no"},"toilet":{"value":"private"},"totalSize":{"value":"56"},"tv":{"value":"yes"},"washingMachine":{"value":"yes"},"waterCostIncluded":{"value":"yes"},"wheelchairAccessible":{"value":"no"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":143200,"deposit":266400,"agencyFee":0,"estimatedBills":20800},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"1432.00","deposit":"2664.00","agencyFee":"0.00","estimatedBills":"208.00"},"minimumStayMonths":3,"moveInWindow":0,"currentOccupancy":0,"minAge":18,"maxAge":0,"preferredGender":"","available":[{"to":"9999-12-31","from":"2026-07-13"}],"updated":"2026-07-13T12:44:15Z","__utId__":"ut1724544"}]