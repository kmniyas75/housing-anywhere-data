10-4d25-83fd-258e00ecd60a.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1605244/9ad2ec77-4010-4d25-83fd-258e00ecd60a.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}},{"originalLink":"https://housinganywhere.imgix.net/unit_type/1605244/1e703f8b-d6b9-4b7c-9df5-402fe5ed7caf.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","categories":null,"sizes":{"1024x768":{"link":"https://housinganywhere.imgix.net/unit_type/1605244/1e703f8b-d6b9-4b7c-9df5-402fe5ed7caf.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/unit_type/1605244/1e703f8b-d6b9-4b7c-9df5-402fe5ed7caf.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1605244/1e703f8b-d6b9-4b7c-9df5-402fe5ed7caf.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1605244/1e703f8b-d6b9-4b7c-9df5-402fe5ed7caf.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1605244/1e703f8b-d6b9-4b7c-9df5-402fe5ed7caf.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}},{"originalLink":"https://housinganywhere.imgix.net/unit_type/1605244/7bab6c36-57a0-47ac-9eaa-5817df1d7237.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","categories":["bathroom"],"sizes":{"1024x768":{"link":"https://housinganywhere.imgix.net/unit_type/1605244/7bab6c36-57a0-47ac-9eaa-5817df1d7237.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/unit_type/1605244/7bab6c36-57a0-47ac-9eaa-5817df1d7237.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1605244/7bab6c36-57a0-47ac-9eaa-5817df1d7237.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1605244/7bab6c36-57a0-47ac-9eaa-5817df1d7237.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1605244/7bab6c36-57a0-47ac-9eaa-5817df1d7237.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"82 m2, 3 Zimmer · Parkplatz & Balkon · 10 Minuten nach Tübingen\n\nMöbliert, komplett ausgestattet, alles inklusive: 82 m2 auf einer Ebene, drei Zimmer, Balkon und ein eigener Parkplatz direkt am Haus. Bezugsfertig ab dem ersten Tag – Bettwäsche, Handtücher, Küchenausstattung, Waschmaschine und Trockner sind da.\n\nIn der Monatsmiete enthalten sind Strom, Heizung, Wasser, Internet und der Rundfunkbeitrag. Es kommt keine Nebenkostenabrechnung nach. Einmalig fällt die Endreinigung an.\n\nAnmeldung ist möglich. Sie erhalten eine Wohnungsgeberbestätigung, Briefkasten und Klingel werden auf Ihren Namen beschriftet.\n\nZum Arbeiten eingerichtet: fester Arbeitsplatz und Starlink-Internet mit 100 Mbit/s – auf dem Land keine Selbstverständlichkeit. Ruhige Lage ohne Durchgangsverkehr.\n\nAngenehm im Sommer: Das Haus hat keine Split-Klimaanlage, sondern eine Wärmepumpe, die über die Fußbodenheizung kühlt. Kaltes Wasser im Estrich – lautlos, kein Luftzug, keine trockene Luft. An allen Fenstern gibt es Beschattung.\n\nWege: Tübingen 10 Minuten, Reutlingen 15, Stuttgart 25–30, Flughafen und Messe Stuttgart 20 – mit dem Auto über die B27. Der Bahnhof Kirchentellinsfurt ist 6 Minuten zu Fuß entfernt (RE10 Mannheim–Tübingen, RB63 Herrenberg–Bad Urach).\n\nZwei Dinge vorab, damit es keine Überraschung gibt: Die Zufahrt zum Haus ist steil und schmal, links begrenzt von einer Steinmauer. Und wir vermieten maximal fünf Monate am Stück – wer eine dauerhafte Wohnung sucht, ist bei uns falsch.\n\nRauchen und Haustiere sind im ganzen Objekt nicht erlaubt (Rücksicht auf Allergiker).\n\n——— English ———\n\nFurnished, fully equipped, all-inclusive: 82 m2 on one level, three rooms, a balcony and your own parking space right at the house. Ready to move into from day one – bed linen, towels, kitchen equipment, washing machine and dryer are all there.\n\nThe monthly rent includes electricity, heating, water, internet and the German broadcasting fee. There is no utility bill afterwards. A one-off final cleaning fee applies.\n\nYou can register at this address (Anmeldung). You will receive a Wohnungsgeberbestätigung, and the mailbox and doorbell will carry your name.\n\nSet up for work: a proper desk and Starlink internet at 100 Mbit/s – not a given in the countryside. Quiet location, no through traffic.\n\nComfortable in summer: no split air conditioning, but a heat pump that cools through the underfloor heating – silent, no draught, no dry air. All windows have blinds.\n\nGetting around: Tübingen 10 minutes, Reutlingen 15, Stuttgart 25–30, Stuttgart airport and trade fair 20 – by car via the B27. Kirchentellinsfurt station is a 6-minute walk away (RE10 Mannheim–Tübingen, RB63 Herrenberg–Bad Urach).\n\nTwo things up front: the driveway up to the house is steep and narrow, bounded on the left by a stone wall. And we rent for a maximum of five months at a time – if you are looking for a permanent home, we are the wrong address.\n\nSmoking and pets are not allowed anywhere on the property.","facilities":{"airConditioning":{"value":"yes"},"allergyFriendly":{"value":"no"},"balconyTerrace":{"value":"private"},"basement":{"value":"no"},"bathroom":{"value":"private"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"yes"},"bedrooms":{"value":"2"},"closet":{"value":"yes"},"couplesAllowed":{"valu