rfügbar, werden wir weitere Bilder ergänzen.\n\nDie Wohnung verfügt über eine Küchenzeile, ein großes Wohn- und Schlafzimmer sowie einen weiteren kleinen Raum, der ebenfalls mit genutzt werden kann. Ein Duschbad mit Tageslicht ist ebenfalls vorhanden. \nDie Wohnung ist voll möbliert und kann direkt bezogen werden.\n\nDen Strom für die Wohnung erzeugen wir größtenteils durch unsere PV-Anlage selbst. \nDie Internetverbindung stellen wir über einen Glasfaseranschluss zur Verfügung.\nFalls es Fragen zu dieser Wohnung gibt, melden Sie sich gerne bei uns.","facilities":{"airConditioning":{"value":"no"},"balconyTerrace":{"value":"no"},"basement":{"value":"no"},"bathroom":{"value":"private"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"yes"},"bedrooms":{"value":"1"},"closet":{"value":"yes"},"couplesAllowed":{"value":"yes"},"desk":{"value":"yes"},"dishwasher":{"value":"yes"},"dryer":{"value":"no"},"electricityCostIncluded":{"value":"yes"},"flooring":{"value":"stone"},"garden":{"value":"no"},"gasCostIncluded":{"value":"yes"},"heating":{"value":"central"},"internetCostIncluded":{"value":"yes"},"kitchen":{"value":"private"},"kitchenware":{"value":"private"},"livingRoom":{"value":"private"},"parking":{"value":"shared"},"pets":{"value":"discussable"},"playMusic":{"value":"discussable"},"registrationPossible":{"value":"yes"},"roomFurniture":{"value":"yes"},"smoking":{"value":"outside_only"},"toilet":{"value":"private"},"totalSize":{"value":"57"},"tv":{"value":"yes"},"washingMachine":{"value":"yes"},"waterCostIncluded":{"value":"yes"},"wheelchairAccessible":{"value":"no"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":136000,"deposit":200000,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"1360.00","deposit":"2000.00","agencyFee":"0.00","estimatedBills":"0.00"},"minimumStayMonths":1,"moveInWindow":0,"currentOccupancy":0,"minAge":0,"maxAge":0,"preferredGender":"","avai