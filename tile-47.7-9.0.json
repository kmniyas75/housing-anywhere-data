1714031/60787103-d853-4c61-ac8e-e5dbd5c43e74.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1714031/60787103-d853-4c61-ac8e-e5dbd5c43e74.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1714031/60787103-d853-4c61-ac8e-e5dbd5c43e74.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"Fully Furnished Maisonette Apartment with Lake View in Allensbach\n\nThis exceptional maisonette apartment offers approximately 145 m2 of living space spread over two levels and combines modern architecture, high-quality furnishings and beautiful views towards Lake Constance.\n\nThe apartment is located on the 2nd and top floor of a modern residential building with elevator access and is ideal for professionals, researchers, university staff, medical professionals or families relocating to the Lake Constance region.\n\nThe lower level features a spacious dining area with a premium fitted kitchen including a cooking island, two additional rooms, a guest bathroom, a separate guest WC and a balcony.\n\nThe upper level forms the heart of the apartment with a large open living area, exposed wooden beams, high ceilings and direct access to a spacious south-facing loggia with lake view. The upper floor also includes the master bedroom, the main bathroom and an additional balcony.\n\nProperty Highlights\n\n1 Master Bedroom\n1 Guest Room (can be furnished with a sofa bed)\n1 Fully Equipped Home Office\n2 Bathrooms\n1 Guest WC\n3 Balconies / Loggia\n\nRent: €3,700 per month\nUtilities: Included\n\nThe apartment is offered fully furnished and includes:\n\nPremium fitted kitchen with cooking island\nDining table and chairs\nLiving room with sofa, TV and sideboard\nFully equipped home office\nBed and built-in wardrobe\nBathroom furniture and mirrors\nOutdoor furniture for balcony and loggia\nPrivate carport parking space\n\nAdditional features:\n\nSmart home system (lighting, blinds and heating control)\nAir conditioning\nElevator\nThree outdoor areas (two balconies and one loggia)\nPrivate cellar storage rooms\nSouth-facing outdoor spaces\nBeautiful views towards Lake Constance\n\nAllensbach is one of the most desirable residential locations on Lake Constance and offers excellent connections to Konstanz, Radolfzell, Switzerland and the University of Konstanz. Shops, restaurants, the train station and the lakeside promenade are all within easy reach.\n\nMove in and feel at home immediately.","facilities":{"airConditioning":{"value":"yes"},"allergyFriendly":{"value":"yes"},"balconyTerrace":{"value":"private"},"basement":{"value":"private"},"bathroom":{"value":"private"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"yes"},"bedrooms":{"value":"2"},"closet":{"value":"yes"},"couplesAllowed":{"value":"yes"},"desk":{"value":"yes"},"dishwasher":{"value":"yes"},"dryer":{"value":"yes"},"electricityCostIncluded":{"value":"yes"},"flooring":{"value":"wood"},"garden":{"value":"no"},"gasCostIncluded":{"value":"yes"},"heating":{"value":"central"},"internetCostIncluded":{"value":"yes"},"kitchen":{"value":"private"},"kitchenware":{"value":"private"},"livingRoom":{"value":"private"},"parking":{"value":"private"},"pets":{"value":"no"},"playMusic":{"value":"discussable"},"registrationPossible":{"value":"yes"},"roomFurniture":{"value":"yes"},"smoking":{"value":"outside_only"},"toilet":{"value":"private"},"totalSize":{"value":"145"},"tv":{"value":"yes"},"washingMachine":{"value":"yes"},"waterCostIncluded":{"value":"yes"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":370000,"deposit":1000000,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"3700.00","deposit":"10000.00","agencyFee":"0.00","estimatedBills":"0.00"},"minimumStayMonths":6,"moveInWindow":0,"currentOccupancy":0,"minAge":25,"maxAge":0,"preferredGender":"","available":[{"to":"9999-12-31","from":"2026-06-08"}],"updated":"2026-06-08T15:12:29Z","__utId__":"ut1714031"}]