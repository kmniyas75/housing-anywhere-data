712a29d06e5d.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1662148/2b328966-975a-4e8e-b79c-712a29d06e5d.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"Herzlich Willkommen in meinem stilvoll eingerichteten und frisch sanierten Studio. Das Studio liegt in einer ruhigen Seitenstraße in der Andreasvorstadt. Die Altstadt, der Domplatz und die Uni sind zu Fuß in 5 Min. zu erreichen. Die Wohnung ist mit allem ausgestattet, was ihr für einen angenehmen Aufenthalt benötigt. Ich freue mich euch begrüßen zu dürfen und solltet ihr Fragen haben, stehe ich euch gerne zur Verfügung und kann euch Tipps und Anregungen für Restaurantbesuche oder Ausflüge geben. Das Studio ist liebevoll neu eingerichtet und saniert. Die Küche ist voll ausgestattet, ihr habt einen SmartTV mit Netflix, ein Bad mit Badewanne, Couch und ein Doppelbett, sowie einen Balkon mit Sitzgelegenheiten.\n\nDie Nachbarschaft ist ruhig und sehr entspannt. Dennoch seid ihr innerhalb von 2 Minuten an der Uni oder am Helios Klinikum und in 5 Minuten im Nordpark oder in der Altstadt und am Dom. Parkplätze stehen in der Straße zur Verfügung und in etwa 500m Entfernung befindet sich ein großer, kostenloser Parkplatz. Die Straßenbahn ist nur 200m entfernt.","facilities":{"airConditioning":{"value":"no"},"allergyFriendly":{"value":"yes"},"balconyTerrace":{"value":"private"},"basement":{"value":"no"},"bathroom":{"value":"private"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"yes"},"bedrooms":{"value":"0"},"closet":{"value":"yes"},"couplesAllowed":{"value":"yes"},"desk":{"value":"yes"},"dishwasher":{"value":"yes"},"electricityCostIncluded":{"value":"yes"},"flooring":{"value":"laminate"},"garden":{"value":"no"},"gasCostIncluded":{"value":"yes"},"heating":{"value":"central"},"internetCostIncluded":{"value":"yes"},"kitchen":{"value":"private"},"kitchenware":{"value":"private"},"livingRoom":{"value":"private"},"parking":{"value":"shared"},"pets":{"value":"no"},"playMusic":{"value":"no"},"registrationPossible":{"value":"yes"},"roomFurniture":{"value":"yes"},"smoking":{"value":"no"},"toilet":{"value":"private"},"totalSize":{"value":"35"},"tv":{"value":"yes"},"washingMachine":{"value":"no"},"waterCostIncluded":{"value":"yes"},"wheelchairAccessible":{"value":"no"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":139000,"deposit":100000,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"1390.00","deposit":"1000.00","agencyFee":"0.00","estimatedBills":"0.00"},"minimumStayMonths":2,"moveInWindow":0,"currentOccupancy":0,"minAge":18,"maxAge":0,"preferredGender":"","available":[{"to":"9999-12-31","from":"2029-01-01"}],"updated":"2026-03-30T10:58:19Z","__utId__":"ut1662148"}]