/housinganywhere.imgix.net/unit_type/1713134/07c775d4-fe10-4b4b-a8ec-e9c903d2bc43.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","categories":["bathroom"],"sizes":{"1024x768":{"link":"https://housinganywhere.imgix.net/unit_type/1713134/07c775d4-fe10-4b4b-a8ec-e9c903d2bc43.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/unit_type/1713134/07c775d4-fe10-4b4b-a8ec-e9c903d2bc43.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1713134/07c775d4-fe10-4b4b-a8ec-e9c903d2bc43.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1713134/07c775d4-fe10-4b4b-a8ec-e9c903d2bc43.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1713134/07c775d4-fe10-4b4b-a8ec-e9c903d2bc43.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"Vom 15.6.26 bis 15.12.2026 biete ich meine schöne Wohnung in Lörrach, in einer Hausgemeinschaft, möbliert und zeitlich befristet zur Untermiete an.\n\nRäume:\n1x Wohnküche mit direktem Gartenzugang, Herd, Backofen und Kühlschrank, Holzofen mit integriertem Backofen.\n1x Wohnzimmer: mit großer (elektr. Beamerleinwand, Mit blickdichtem Schiebevorhang als Raumteiler für Abstellraum\n1x Schlafzimmer\n1x Bad: mit WC und Badewann\n\nDie Wohnung teilt sich einen gemeinsamen Flur, mit der Wohnung im OG, die dauerhaft vermietet ist.\nZwischen beiden Wohnungen gibt es keine abschliessbare Tür.\n\nPerfekt z.B. für alle, die im Dreiländereck z.B. in Basel arbeiten.\n\nAllgemeines:\nBeste Villenlage Lörrach, 6 Min. zu Fuss zum Bahnhof, 2024 umfangreich renoviert, Holzfußböden, Gas Zentralheizung, zus. Holzofen zum Heizen, Garten, DSL Internet.\n\nIn der Warmmiete  von 982 € sind Abschlagszahlungen für Stromversorgung, Gas, Internet und die üblichen Nebenkosten enthalten.\n--------------\n\nWeitere Details gerne nach einem Ertstkontakt per Email, wenn beiderseitiges Interesse besteht.\nViele Grüße\nJörg","facilities":{"airConditioning":{"value":"no"},"balconyTerrace":{"value":"private"},"basement":{"value":"no"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"yes"},"bedrooms":{"value":"1"},"closet":{"value":"no"},"desk":{"value":"no"},"dishwasher":{"value":"no"},"dryer":{"value":"no"},"electricityCostIncluded":{"value":"yes"},"garden":{"value":"shared"},"gasCostIncluded":{"value":"yes"},"heating":{"value":"gas"},"internetCostIncluded":{"value":"yes"},"kitchen":{"value":"private"},"kitchenware":{"value":"private"},"livingRoom":{"value":"private"},"pets":{"value":"no"},"registrationPossible":{"value":"yes"},"roomFurniture":{"value":"yes"},"smoking":{"value":"no"},"toilet":{"value":"private"},"totalSize":{"value":"73"},"tv":{"value":"no"},"washingMachine":{"value":"yes"},"waterCostIncluded":{"value":"yes"},"wheelchairAccessible":{"value":"no"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":98200,"deposit":156000,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"982.00","deposit":"1560.00","agencyFee":"0.00","estimatedBills":"0.00"},"minimumStayMonths":6,"moveInWindow":0,"currentOccupancy":0,"minAge":0,"maxAge":0,"preferredGender":"","available":[{"to":"2026-12-30","from":"2026-06-15"},{"to":"9999-12-31","from":"2027-06-01"}],"updated":"2026-06-03T08:40:50Z","__utId__":"ut1713134"}]