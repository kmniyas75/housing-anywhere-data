gix.net/unit_type/1478998/a780ac3f-2f93-4201-9e1e-4a858724facd.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1478998/a780ac3f-2f93-4201-9e1e-4a858724facd.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"Make yourself comfortable on 96m2!\n\nThe living room with smart TV and a couch equipped with a mattress (140x185cm) offers you a sleeping possibility for another 2 persons. From here you have access to the 20m2 balcony, where you can enjoy the afternoon sun & a wonderful sunset.\nThe dining table, which offers space for 6 people, invites you to enjoy a cozy dinner.\n\nKitchen:\nThe kitchen is fully equipped with stove, oven, dishwasher, microwave, fridge-freezer with ice function, toaster, kettle, juicer, juicer & smoothie maker. \n\nAnd for coffee lovers out there.... a Jura coffee machine incl. fresh beans for the best coffee enjoyment is at your disposal. \n\nBedroom:\nThe bedroom is equipped with a box spring bed (180x200cm) with a back-friendly comfortable 7-zone barrel pocket spring core mattress and offers enough space for your clothes. It is in a quiet location. Like the living room and fitness room, the bedroom is also equipped with electric shutters - want to sleep in? No problem.\nA Hauck baby travel cot (120x60cm) is available for the little ones). \n\nFitness:\nSports enthusiasts can work out in the fitness room with treadmill, dumbbells, balance board, fitness & yoga mat & resistance bands. There is also a punching bag in the bedroom. \n\nIf required, a comfortable folding bed for a 5th person can be set up here.\n\nThe apartment is located in Bergheim Zieverich, just a 2-minute walk from the beautiful Erft river.\n\nBy train, which is within walking distance, you can reach Cologne city center within 35 minutes (approx. 25 km).\nDirect highway connection to the A61/A4. \n\nShopping facilities such as ALDI, LIDL, Netto & Trinkgut are within walking distance.\n\nThe center of Bergheim can be reached in approx. 10 - 15 minutes on foot. \nHere you will find restaurants, Kaufland, DM, post office and many other stores.","facilities":{"airConditioning":{"value":"no"},"allergyFriendly":{"value":"yes"},"balconyTerrace":{"value":"private"},"basement":{"value":"no"},"bathroom":{"value":"private"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"yes"},"bedrooms":{"value":"2"},"closet":{"value":"yes"},"desk":{"value":"yes"},"dishwasher":{"value":"yes"},"dryer":{"value":"yes"},"electricityCostIncluded":{"value":"no"},"flooring":{"value":"other"},"garden":{"value":"no"},"gasCostIncluded":{"value":"no"},"heating":{"value":"central"},"internetCostIncluded":{"value":"no"},"kitchen":{"value":"private"},"kitchenware":{"value":"private"},"livingRoom":{"value":"private"},"parking":{"value":"private"},"roomFurniture":{"value":"yes"},"toilet":{"value":"private"},"totalSize":{"value":"96"},"tv":{"value":"yes"},"washingMachine":{"value":"yes"},"waterCostIncluded":{"value":"no"},"wheelchairAccessible":{"value":"no"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":360000,"deposit":0,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"3600.00","deposit":"0.00","agencyFee":"0.00","estimatedBills":"0.00"},"minimumStayMonths":0,"moveInWindow":0,"currentOccupancy":0,"minAge":0,"maxAge":0,"preferredGender":"","available":[{"to":"2026-05-12","from":"2026-05-10"},{"to":"2026-05-18","from":"2026-05-18"},{"to":"2026-05-20","from":"2026-05-20"},{"to":"2026-05-26","from":"2026-05-25"},{"to":"2026-07-09","from":"2026-05-30"},{"to":"2026-08-05","from":"2026-07-15"},{"to":"2026-08-12","from":"2026-08-09"},{"to":"2026-08-18","from":"2026-08-16"},{"to":"9999-12-31","from":"2026-08-22"}],"updated":"2026-05-07T01:57:44Z","__utId__":"ut1478998"}]