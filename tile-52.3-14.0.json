.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1727173/b5127f94-8912-4450-b5a1-db9fd903b703.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1727173/b5127f94-8912-4450-b5a1-db9fd903b703.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"Bright furnished family house with private garden in a quiet residential area of Fürstenwalde/Spree, conveniently located for professionals working in the Berlin–Brandenburg region and near the Tesla Gigafactory.\n\nThe terraced house offers approximately 99 m2 of living space across two floors, plus around 10 m2 of usable attic storage. It is suitable for families, couples, professionals, relocations and temporary stays.\n\nThe ground floor features a spacious open-plan living and dining area with direct access to the private garden and terrace, a fully equipped kitchen, an entrance hall with storage and a guest WC.\n\nUpstairs, there is a main bedroom, two additional rooms that can be used as children’s bedrooms or home offices, a family bathroom with bathtub and shower, and an additional storage room.\n\nThe kitchen includes an oven, stove, refrigerator, freezer, dishwasher, microwave, air fryer, coffee machine, kettle and other essential equipment. A washing machine is also available.\n\nFast 500 Mbps fibre-optic internet and a Huawei Wi-Fi 6 mesh system provide reliable coverage throughout the house. A private parking space is included.\n\nThe monthly rent includes furniture, operating costs, heating, electricity, water, internet and parking. The broadcasting fee is not included.\n\nThe house is offered furnished. A semi-furnished arrangement with fewer items of furniture may be negotiated before move-in.\n\nPets may be accepted with prior approval; large dogs are not permitted. Smoking is not allowed inside the house. Parties and events are not allowed, and quiet hours must be respected.","facilities":{"airConditioning":{"value":"no"},"allergyFriendly":{"value":"yes"},"balconyTerrace":{"value":"no"},"basement":{"value":"private"},"bathroom":{"value":"private"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"no"},"bedrooms":{"value":"2"},"closet":{"value":"yes"},"couplesAllowed":{"value":"yes"},"desk":{"value":"yes"},"dishwasher":{"value":"yes"},"dryer":{"value":"no"},"electricityCostIncluded":{"value":"yes"},"flooring":{"value":"other"},"garden":{"value":"private"},"gasCostIncluded":{"value":"no"},"heating":{"value":"central"},"internetCostIncluded":{"value":"yes"},"kitchen":{"value":"private"},"kitchenware":{"value":"private"},"livingRoom":{"value":"private"},"parking":{"value":"private"},"pets":{"value":"discussable"},"playMusic":{"value":"yes"},"registrationPossible":{"value":"yes"},"roomFurniture":{"value":"yes"},"smoking":{"value":"outside_only"},"tenantStatus":{"value":"working professionals only"},"toilet":{"value":"private"},"totalSize":{"value":"99"},"tv":{"value":"yes"},"washingMachine":{"value":"yes"},"waterCostIncluded":{"value":"yes"},"wheelchairAccessible":{"value":"no"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":220000,"deposit":280000,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"2200.00","deposit":"2800.00","agencyFee":"0.00","estimatedBills":"0.00"},"minimumStayMonths":1,"moveInWindow":0,"currentOccupancy":0,"minAge":0,"maxAge":0,"preferredGender":"","available":[{"to":"9999-12-31","from":"2026-10-05"}],"updated":"2026-10-05T16:30:46Z","__utId__":"ut1727173"},{"id":"1744836","rank":90,"rating":0,"published":"2026-10-08","kind":1,"kindLabel":"entire place","type":3,"typeLabel":"apartment","rentType":"monthly","title":"Altstädter Ring, Fürstenwalde","cancellationPolicy":"30d-movein-flexible","market