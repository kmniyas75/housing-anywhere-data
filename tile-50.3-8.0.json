x.net/room/1873298/e8b15961-cd2b-4a65-8f4c-fdb247df2592.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/room/1873298/e8b15961-cd2b-4a65-8f4c-fdb247df2592.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"Wohnung\nBitte kontaktieren Sie mich mit einer Nachricht zu Ihrer Person (Name,Alter,Beruf, etc.)\n\nSchöne 2-Zimmer Wohnung mit Balkon und Großer Küche\n\nDie Wohnung ist voll möbliert. Sie müssen nur Ihre persönlichen Sachen mitbringen. Auch die Küche ist voll ausgestattet.\n\nWenn Sie die Küche mitzählen sind es eigentlich 3 Zimmer + großer Balkon\n\nZu vermieten ab 1.6.26  aufgrund von beruflicher Abwesenheit\n\nSchöne ruhige Lage im Innenhof\nSie werden sich wohlfühlen\n\nEs ist im Zentrum trotzdem ist es sehr ruhig\n\n10 Min zu Fuß ins Zentrum (Neumarkt)\n5 Min zum Bahnhof.\n\nEs gibt auch eine Bushaltestelle direktin der Nähe\nLage\nSehr nah ans Zentrum\n\nSie laufen 5 Min zum Bahnhof\nDurch die Unterführung laufen Sie 2 Min und sind im Herzen von Limburg am Neumarkt etc wo Sie viele Geschäfte finden können, Eiscafes, Restaurants, usw.\n\nDie Wohnung ist in sehr ruhiger Lage gelegen im Innnenhof\nSie werden sich bestimmt wohl fühlen\nSehr schön auf dem Balkon den Sonnenuntergang genießen\nParkplätze sind leicht und kostenlos findbar in der Gartenstraße\nSie können auch einen Tief-Garagen-Platz gegen Gebühr mieten\nDie Wohnung liegt im 1.Stock\n\nSonstiges\nWenn Sie Fragen haben bitte melden Sie sich","facilities":{"airConditioning":{"value":"no"},"allergyFriendly":{"value":"yes"},"balconyTerrace":{"value":"private"},"basement":{"value":"private"},"bathroom":{"value":"private"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"no"},"bedrooms":{"value":"1"},"closet":{"value":"yes"},"couplesAllowed":{"value":"yes"},"desk":{"value":"yes"},"dishwasher":{"value":"yes"},"dryer":{"value":"no"},"electricityCostIncluded":{"value":"yes"},"flooring":{"value":"plastic"},"garden":{"value":"shared"},"gasCostIncluded":{"value":"yes"},"heating":{"value":"central"},"internetCostIncluded":{"value":"no"},"kitchen":{"value":"private"},"kitchenware":{"value":"private"},"livingRoom":{"value":"private"},"parking":{"value":"private"},"pets":{"value":"no"},"playMusic":{"value":"no"},"registrationPossible":{"value":"yes"},"roomFurniture":{"value":"yes"},"smoking":{"value":"outside_only"},"toilet":{"value":"private"},"totalSize":{"value":"50"},"tv":{"value":"yes"},"washingMachine":{"value":"no"},"waterCostIncluded":{"value":"yes"},"wheelchairAccessible":{"value":"no"},"wifi":{"value":"no"}},"costs":{"currency":"EUR","pricing":"monthly","price":93000,"deposit":200000,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"930.00","deposit":"2000.00","agencyFee":"0.00","estimatedBills":"0.00"},"minimumStayMonths":3,"moveInWindow":0,"currentOccupancy":0,"minAge":0,"maxAge":0,"preferredGender":"","available":[{"to":"9999-12-31","from":"2026-06-12"}],"updated":"2026-06-12T11:09:02Z","__utId__":"ut1226540"}]