}},{"originalLink":"https://housinganywhere.imgix.net/unit_type/1508501/d1d635f0-c8d6-4e82-bda4-b31ad739db34.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","categories":null,"sizes":{"1024x768":{"link":"https://housinganywhere.imgix.net/unit_type/1508501/d1d635f0-c8d6-4e82-bda4-b31ad739db34.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/unit_type/1508501/d1d635f0-c8d6-4e82-bda4-b31ad739db34.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1508501/d1d635f0-c8d6-4e82-bda4-b31ad739db34.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1508501/d1d635f0-c8d6-4e82-bda4-b31ad739db34.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1508501/d1d635f0-c8d6-4e82-bda4-b31ad739db34.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}},{"originalLink":"https://housinganywhere.imgix.net/unit_type/1508501/a0f2927d-bd8a-480b-a337-7164d8b12db0.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","categories":null,"sizes":{"1024x768":{"link":"https://housinganywhere.imgix.net/unit_type/1508501/a0f2927d-bd8a-480b-a337-7164d8b12db0.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/unit_type/1508501/a0f2927d-bd8a-480b-a337-7164d8b12db0.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1508501/a0f2927d-bd8a-480b-a337-7164d8b12db0.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1508501/a0f2927d-bd8a-480b-a337-7164d8b12db0.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1508501/a0f2927d-bd8a-480b-a337-7164d8b12db0.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"Historisches Fachwerkhaus mitten in Butzbach - zentrale Anbindung nach FFM. Das ca. 300 Jahre alte Fachwerkhaus wurde im Jahr 1997 zu diesem schönen Anwesen ausgebaut. Er wurde sorgsam darauf geachtet, dass möglichst viele original Details erhalten bleiben. Dies ist im gesamten Haus erlebbar und bietet einen angenehmen Wohnkomfort.\nBereits von der Straße aus ist zu spüren, dass in dem Haus etwas Besonderes entdeckt werden kann. Gekonnt verbindet sich neue und alte Substanz, offene Bereiche und kleinere Räume des alten Fachwerkhauses miteinander.\nDas Erdgeschoss bietet einen großzügigen Eingangsbereich mit Zugang in den angegliederten Innenhof. Über die Treppe erreichen Sie das 1. Obergeschoss, das ganz dem Wohnen und Essen gewidmet ist. Durch freigelegtes Fachwerk ist der offene Küchenbereich räumlich gefasst. Typisch für die damalige Zeit ist die Etagentoilette auf dem Flur. Im 2. Obergeschoss befinden sich zwei Zimmer und ein Bad mit Dusche, freistehender Wanne, Waschtisch und WC.\nButzbach mit seinen 13 Stadtteilen liegt am Rande des Naturparks Hochtaunus, nördlich von Frankfurt am Main und hat einen direkten Anschluss an die AS Frankfurt-Kassel. Mit der Bahn ist der Hauptbahnhof Frankfurt am Main in 35 Minuten erreichbar.\nDie „Perle der Wetterau\" liegt inmitten einer reizvollen Landschaft und besticht durch einen romantischen Stadtkern mit zahlreichen Fachwerkhäusern, winkeligen Gässchen und malerischen Plätze.\nModeme Neubaugebiete fügen sich in das gewachsene Stadtbild ein und zeugen von einer Kinder – und familienfreundlichen Stadt. Hierfür spricht auch die große Anzahl von Schulen und Kindergärten, Hortmöglichkeiten und vielen verschiedenen Freizeitvereinen.\nUmweltfreundliche Industrieansiedlungen zeugen von dem Wachstum und der Wirtschaftskraft einer modernen Stadt, die dennoch nicht auf ihr historisch geprägtes Stadtbild verzichtet hat. Butzbach bietet für jeden Geschmack eine Fülle von Sehenswürdigkeiten.\nWir sind aus familiären Gründen aus Butzbach weggezogen und möchten dieses Haus gern erhalten, so wie es ist. Das Haus hat sehr viel Charme und liegt zentral in Butzbach. Der Bahnhof ist fußläufig zu erreichen. Im 2. OG gibt es 2 Schlafzimmer mit 2 Doppelbetten – hier können wir auch gern noch auf individuelle Bedürfnisse eingehen.\nWer auf der Suche nach eine ganz besonderen Unterkunft für eine bestimmte Zeit ist, ist hier richtig. Nähere Fragen beantworten wir gern.","facilities":{"airConditioning":{"value":"no"},"allergyFriendly":{"value":"no"},"balconyTerrace":{"value":"private"},"basement":{"value":"no"},"bathroom":{"value":"private"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"no"},"bedrooms":{"value":"2"},"closet":{"value":"yes"},"couplesAllowed":{"value":"yes"},"desk":{"value":"yes"},"dishwasher":{"value":"yes"},"dryer":{"value":"yes"},"electricityCostIncluded":{"value":"yes"},"flooring":{"value":"other"},"garden":{"value":"no"},"gasCostIncluded":{"value":"yes"},"heating":{"value":"central"},"internetCostIncluded":{"value":"yes"},"kitchen":{"value":"private"},"kitchenware":{"value":"private"},"livingRoom":{"value":"private"},"parking":{"value":"private"},"pets":{"value":"discussable"},"playMusic":{"value":"yes"},"registrationPossible":{"value":"yes"},"roomFurniture":{"value":"yes"},"smoking":{"value":"no"},"toilet":{"value":"private"},"totalSize":{"value":"86"},"tv":{"value":"yes"},"washingMachine":{"value":"yes"},"waterCostIncluded":{"value":"yes"},"wheelchairAccessible":{"value":"no"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":179800,"deposit":200000,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"1798.00","deposit":"2000.00","agencyFee":"0.00","estimatedBills":"0.00"},"minimumStayMonths":1,"moveInWindow":0,"currentOccupancy":0,"minAge":0,"maxAge":0,"preferredGender":"","available":[{"to":"9999-12-31","from":"2026-07-13"}],"updated":"2026-07-13T11:26:10Z","__utId__":"ut1508501"}]