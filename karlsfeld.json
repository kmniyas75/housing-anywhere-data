link":"https://housinganywhere.imgix.net/room/1291491/f55a9192-959c-11e7-a07c-42010af00008.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/room/1291491/f55a9192-959c-11e7-a07c-42010af00008.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/room/1291491/f55a9192-959c-11e7-a07c-42010af00008.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}},{"originalLink":"https://housinganywhere.imgix.net/unit_type/635938/19863d0c-0400-4b00-b529-015559f3c083.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","categories":null,"sizes":{"1024x768":{"link":"https://housinganywhere.imgix.net/unit_type/635938/19863d0c-0400-4b00-b529-015559f3c083.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/unit_type/635938/19863d0c-0400-4b00-b529-015559f3c083.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/635938/19863d0c-0400-4b00-b529-015559f3c083.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/635938/19863d0c-0400-4b00-b529-015559f3c083.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/635938/19863d0c-0400-4b00-b529-015559f3c083.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}},{"originalLink":"https://housinganywhere.imgix.net/room/1291491/07ecf974-959d-11e7-9df2-42010af00004.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","categories":null,"sizes":{"1024x768":{"link":"https://housinganywhere.imgix.net/room/1291491/07ecf974-959d-11e7-9df2-42010af00004.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/room/1291491/07ecf974-959d-11e7-9df2-42010af00004.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/room/1291491/07ecf974-959d-11e7-9df2-42010af00004.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/room/1291491/07ecf974-959d-11e7-9df2-42010af00004.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/room/1291491/07ecf974-959d-11e7-9df2-42010af00004.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"Zimmer in ruhiger 3er-WG zu vermieten!\n\nVon dem S-Bahnhof Karlsfeld sind es nur 20 min bis München Hauptbahnhof. \n\nWir suchen eine/n neue/n Mitbewohner/in für unsere gemütliche 3-Personen-WG. Du suchst nach einer ruhigen Umgebung, in der du dich zurückziehen und entspannen kannst? Dann bist du bei uns genau richtig!\n\nDas erwartet dich:\n\nDein Zimmer ist möbliert und mit einem Schreibtisch ausgestattet – ideal zum Arbeiten oder Lernen.\n\nSchnelles WLAN und eine gemütliche Gemeinschaftsküche mit Essbereich, perfekt für entspannte Mahlzeiten.\n\nBadezimmer mit Dusche, Badewanne und einer Waschmaschine.\n\nEin gemeinsamer Garten, den du mit uns genießen kannst – ob zum Entspannen oder zum Grillen.\n\nZusätzlich gibt es einen Trockenraum im Keller.\n\nDie Wohnung befindet sich im obersten Geschoss, wodurch absolute Ruhe garantiert ist – ideal für alle, die eine ruhige Wohnatmosphäre schätzen.\n\nBesonders attraktiv für Sportliebhaber: Auf Wunsch bieten wir vergünstigte CrossFit-Gym-Mitgliedschaften an.\n\n\nLage:\n\nDirekt an einer Bushaltestelle gelegen, super Anbindung!\n\nNur 5 Minuten zu Fuß zum wunderschönen Karlsfelder See, einem 24 Hektar großen Naturparadies – perfekt zum Schwimmen, Spazieren oder einfach die Natur genießen.\n\nIn der Nähe des neuen Zentrums von Karlsfeld und dennoch in ruhiger Lage.\n\nKarlsfeld liegt am nordwestlichen Stadtrand von München und bietet eine großartige Kombination aus Ruhe und Nähe zur Großstadt.\n\nWG-Leben: Bei uns geht es ruhig und entspannt zu. Unsere WG ist perfekt für alle, die nach einem Rückzugsort suchen. Wer Action braucht, findet diese in unserer CrossFit-Box nur 5 km entfernt. Von gemeinsamen Sportausflügen, BBQs, Sauna-Abenden bis hin zu Ausflügen in München und Umgebung – bei uns ist immer etwas los, wenn man möchte. Alles ist optional, und deiner Kreativität sind keine Grenzen gesetzt!\n\nENGLISH:\n\nRoom available in a quiet 3-person shared flat!\n\nFrom Sban Karlsfeld it's only 20 mins to Munich central station. \n\nWe’re looking for a new tenant for our cozy 3-person shared flat. Are you someone who values peace and quiet in your living space? Then you’ve found the right place!\n\nWhat we offer:\n\nA fully furnished room with a desk – perfect for studying or working.\n\nHigh-speed internet and a comfortable shared kitchen with a dining area for relaxed meals.\n\nA bathroom with both a shower and a bathtub, plus a washing machine.\n\nA shared garden where you can unwind, relax, or enjoy a BBQ with friends.\n\nA drying room in (hidden)ment for your laundry.\n\nLocated on the top floor of the house, ensuring a peaceful and quiet atmosphere – ideal for those who seek tranquility.\n\nSpecial perk: Reduced CrossFit gym membership available upon request for fitness enthusiasts.\n\n\nLocation:\n\nConveniently located right next to a bus stop.\n\nFrom Sban Karlsfeld it's only 20 mins to the central station. \n\nOnly a 5-minute walk to the beautiful Karlsfelder Lake, a 24-hectare natural lake – perfect for swimming, walking, or enjoying the outdoors.\n\nClose to the new center in Karlsfeld, yet in a very quiet location.\n\nKarlsfeld is a community on the northwestern outskirts of Munich, offering a perfect balance between peaceful living and proximity to the city.\n\n\nFlatshare Lifestyle: Our home is a quiet, relaxed place. If you're looking for peace and quiet, this is the ideal environment. For those who want action, the CrossFit gym is only 5 km away. There, you can enjoy events, group sports activities, BBQs, sauna sessions, swimming, running, cycling, and more. We often explore Munich and the surrounding areas together, but everything is optional – the sky’s the limit for your creativity! \n\n","facilities":{"airConditioning":{"value":"no"},"allergyFriendly":{"value":"yes"},"balconyTerrace":{"value":"no"},"basement":{"value":"no"},"bathroom":{"value":"shared_w_both"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"yes"},"bedroomSize":{"value":"10"},"bedrooms":{"value":"1"},"cleaningCommonRoomsIncluded":{"value":"no"},"cleaningPrivateRoomIncluded":{"value":"no"},"closet":{"value":"yes"},"couplesAllowed":{"value":"no"},"desk":{"value":"yes"},"dishwasher":{"value":"yes"},"dryer":{"value":"no"},"electricityCostIncluded":{"value":"yes"},"flooring":{"value":"wood"},"garden":{"value":"shared"},"gasCostIncluded":{"value":"yes"},"heating":{"value":"central"},"housematesGender":{"value":"shared_w_both"},"internet":{"value":"yes"},"internetCostIncluded":{"value":"no"},"kitchen":{"value":"shared"},"kitchenware":{"value":"shared"},"livingRoom":{"value":"shared"},"parking":{"value":"no"},"pets":{"value":"no"},"playMusic":{"value":"no"},"registrationPossible":{"value":"yes"},"roomFurniture":{"value":"yes"},"smoking":{"value":"no"},"toilet":{"value":"shared"},"totalSize":{"value":"50"},"tv":{"value":"no"},"washingMachine":{"value":"yes"},"waterCostIncluded":{"value":"yes"},"wheelchairAccessible":{"value":"no"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":75000,"deposit":150000,"agencyFee":0,"estimatedBills":2000},"costsFormatted":{"currency