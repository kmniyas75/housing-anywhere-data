8669/546158ae-4989-47e1-8507-7c94f3b6169c.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/unit_type/1668669/546158ae-4989-47e1-8507-7c94f3b6169c.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1668669/546158ae-4989-47e1-8507-7c94f3b6169c.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1668669/546158ae-4989-47e1-8507-7c94f3b6169c.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1668669/546158ae-4989-47e1-8507-7c94f3b6169c.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"🌟 Furnished Friends Room for Two with Balcony – Kursdorfer Weg 4, Leipzig-Schönau\n\nAre you looking for an affordable furnished room in a green and well-connected area of Leipzig? \n\nThis offer is for one bed space in a move-in-ready Friends Room for Two in a furnished three-bedroom shared apartment.\n\nThe room is designed for two people who would like to live together, such as friends, couples or siblings. Solo applicants who are comfortable sharing with another resident are also welcome.\nThe balcony belongs exclusively to the room and is shared only by its two residents.\n\n📜 Contract and Rental Details\n•\tMinimum rental period: 3 months\n•\tNotice period after the minimum rental period: 1 month\n•\tAvailability: Please select your preferred move-in date when submitting your booking request.\n•\tEach tenant receives an individual rental agreement for the rented bed space.\n•\tResidential registration (Anmeldung) is possible.\n•\tElectricity, heating, water and internet are included under the fair-use policy.\n•\tOne-time processing fee: €130.00\n•\tThe processing fee is waived for returning tenants.\n•\tThe German broadcasting fee (Rundfunkbeitrag) must be paid separately by the tenants.\n•\tNo age or gender restrictions\n\n🛏️ The Friends Room for Two\nThe bright shared room is fully furnished and ready to move into. You will share the room and its balcony with one roommate.\nEach resident is provided with:\n•\tBed with mattress\n•\tWardrobe or storage furniture\n•\tDesk or table with chair\n•\tPillow, duvet or blanket, sheets and covers\n•\tAccess to the room’s balcony\n\n🏠 The Apartment\nThe furnished apartment consists of three bedrooms and accommodates a maximum of four residents.\nYou will share the kitchen, bathroom/WC, hallway and other common areas with your roommate and two additional housemates.\n\n🍳 Shared Areas and Facilities\n•\tFully equipped fitted kitchen\n•\tShared bathroom/WC\n•\tShared hallway and common areas\n•\tRefrigerator\n•\tOven\n•\tWashing machine\n•\tVacuum cleaner\n•\tWi-Fi router\n•\tDining area\n•\tTables, chairs and storage furniture\n•\tPlates, bowls and cutlery\n•\tPots, pans and cooking utensils\n\n🏢 Property Details\n•\tAddress: Kursdorfer Weg 4, 04205 Leipzig\n•\tDistrict: Schönau\n•\tCity area: West Leipzig\n•\tNumber of bedrooms: 3\n•\tMaximum occupancy: 4 residents\n•\tRoom type: Friends Room for Two\n•\tRoom occupancy: 2 residents\n•\tBalcony: exclusive to the room and shared by its two residents\n\n📍 Location and Surroundings\nThe apartment is located in Leipzig-Schönau, a green and residential neighbourhood in the western part of the city. The area offers convenient public transport connections as well as shops and everyday amenities.\nNearby tram, train and bus connections provide access to central Leipzig, Leipzig Central Station, universities, workplaces and shopping areas.\nWithin easy reach, you will find:\n•\tSchönauer Park\n•\tKulkwitzer See and recreational areas\n•\tPublic transport connections\n•\tSupermarkets and shopping facilities\n•\tPharmacies and everyday services\n•\tBakeries, cafés and restaurants\n•\tGyms and leisure facilities\n•\tParks, walking paths and green spaces\nThe accommodation is suitable for students, interns, trainees, newcomers to Leipzig and working professionals.\n\n📩 Interested?\nSubmit your booking request directly through HousingAnywhere. Please include a short introduction about yourself, your current occupation, your preferred move-in date and your planned rental period.\n\nIf you have any questions, please feel free to contact us through HousingAnywhere.\n\n","facilities":{"airConditioning":{"value":"no"},"allergyFriendly":{"value":"no"},"balconyTerrace":{"value":"no"},"basement":{"value":"no"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"no"},"bedroomSize":{"value":"28"},"bedrooms":{"value":"1"},"closet":{"value":"yes"},"couplesAllowed":{"value":"yes"},"desk":{"value":"yes"},"dishwasher":{"value":"no"},"dryer":{"value":"no"},"electricityCostIncluded":{"value":"yes"},"flooring":{"value":"other"},"garden":{"value":"no"},"gasCostIncluded":{"value":"yes"},"heating":{"value":"central"},"housematesGender":{"value":"shared_w_both"},"internetCostIncluded":{"value":"yes"},"kitchen":{"value":"shared"},"kitchenware":{"value":"shared"},"livingRoom":{"value":"no"},"parking":{"value":"no"},"pets":{"value":"no"},"playMusic":{"value":"discussable"},"registrationPossible":{"value":"yes"},"roomFurniture":{"value":"no"},"smoking":{"value":"no"},"toilet":{"value":"shared"},"totalSize":{"value":"91"},"tv":{"value":"no"},"washingMachine":{"value":"yes"},"waterCostIncluded":{"value":"yes"},"wheelchairAccessible":{"value":"no"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":34900,"deposit":25000,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"349.00","deposit":"250.00","agencyFee":"0.00","estimatedBills":"0.00"},"minimumStayMonths":6,"moveInWindow":20,"currentOccupancy":3,"minAge":0,"maxAge":0,"