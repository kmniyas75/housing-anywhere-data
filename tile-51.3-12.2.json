x.net/unit_type/1740696/20e3dadf-57af-4ece-a877-85079c876c26.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1740696/20e3dadf-57af-4ece-a877-85079c876c26.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}},{"originalLink":"https://housinganywhere.imgix.net/unit_type/1740696/5916b8b7-3c91-4331-8996-4e16d8bea246.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","categories":null,"sizes":{"1024x768":{"link":"https://housinganywhere.imgix.net/unit_type/1740696/5916b8b7-3c91-4331-8996-4e16d8bea246.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/unit_type/1740696/5916b8b7-3c91-4331-8996-4e16d8bea246.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1740696/5916b8b7-3c91-4331-8996-4e16d8bea246.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1740696/5916b8b7-3c91-4331-8996-4e16d8bea246.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1740696/5916b8b7-3c91-4331-8996-4e16d8bea246.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}},{"originalLink":"https://housinganywhere.imgix.net/unit_type/1740696/08bd08c8-1a3c-41a1-b071-1984bfa3e3ce.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","categories":null,"sizes":{"1024x768":{"link":"https://housinganywhere.imgix.net/unit_type/1740696/08bd08c8-1a3c-41a1-b071-1984bfa3e3ce.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/unit_type/1740696/08bd08c8-1a3c-41a1-b071-1984bfa3e3ce.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1740696/08bd08c8-1a3c-41a1-b071-1984bfa3e3ce.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1740696/08bd08c8-1a3c-41a1-b071-1984bfa3e3ce.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1740696/08bd08c8-1a3c-41a1-b071-1984bfa3e3ce.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"A small room, a big home - and perhaps some interesting people you would otherwise never have met.\n\nWe are offering a furnished private room in our comfortable 4-room apartment in Leipzig-Schönau.\nI am a theatre director and artist, and I live here with my teenage daughter. We are looking for an open-minded, friendly and independent person who enjoys living in a home that is a little different from a typical shared flat.\n\nAvailable initially for 6 - 12 months, with the possibility of extending if it works well for everyone.\n\n## Your room\n\nThe room is approximately 11 m2. It is small, but well equipped and designed to be comfortable both for living and studying/working.\n\nIt includes:\n\n* 90 × 200 cm bed, extendable for occasional guests\n* height-adjustable desk\n* office chair\n* two drawer units\n* chest of drawers and clothes rail\n* wall mirror\n* bookshelves\n* private TV, with the option to participate in the Netflix subscription\n* private attached clothes dryer\n* large window\n* plants\n* lockable room\n* Wi-Fi\n\nA **private printer** can also be provided on request.\n\nYou have access to the entire apartment, including:\n\n* living room\n* fully equipped kitchen\n* bathroom\n* balcony\n* cellar\n* bicycle storage\n\n## About us\n\nMy daughter enjoys reading, theatre, guitar, crafts, films and board games. **She is also learning Spanish and would be happy to have more opportunities to hear and speak the language.**\n\nI am increasingly working with storytelling, AI, VR and immersive media.\n\nWe are curious, culturally interested people who enjoy good conversations and meeting people from different backgrounds.\n\nAt the same time, privacy is important to us. Everyone should have their own space and their own life.\n\nWe are not looking for a classic Zweck-WG where everyone simply shares the rent and disappears behind their bedroom door.\n\nIf you feel like cooking together, watching a film, playing a board game, having a coffee or talking about an interesting project - great.\nIf you have had a long day and simply want to close your door and have time for yourself - equally great.\n\nWe would like our home to feel warm and welcoming, but without obligations or pressure.\n\n## Who might enjoy living here?\n\nWe are particularly interested in meeting people from creative and technology-related fields, for example:\n\n* AI / AI creation\n* VR / XR\n* Unreal Engine / Unity\n* motion design\n* sound design\n* storytelling / screenwriting\n* games\n* film / animation\n* marketing / community\n* cultural and innovation projects\n\nYou absolutely do not have to work in one of these fields.\nFor us, personality is much more important: openness, respect, curiosity and a willingness to communicate.\n\n**International and English-speaking tenants are very welcome.**\nWe also speak German, English, Slovak, Czech and Polish. My daughter learns Spanish too.\n\n## An important part of our home\n\nA friendly and respectful relationship with my daughter is very important to us. We are looking for someone who genuinely enjoys talking to and interacting with a teenager - not someone who merely tolerates the fact that a child lives here.\n\nThere is no expectation that you become part of our family or take on any responsibility for her. We simply want someone who is naturally comfortable around young people.\n\n## The location\n\nThe apartment is in **Leipzig-Schönau**, a quiet and green residential area with good everyday infrastructure.\n\n* Lidl and Norma are nearby\n* Kaufland is about 10 minutes on foot\n* Allee-Center is about 12 minutes on foot\n* Kulkwitzer See is about 10 minutes by bicycle\n* tram stop about 9 minutes from the apartment\n* trams run approximately every 10 minutes\n* Leipzig city centre is easily accessible by public transport\n* by bicycle, the city centre takes approximately 20 - 30 minutes\n\nThe bicycle route into central Leipzig is particularly nice, with a large part of the way running through green areas and along the **Karl-Heine-Kanal**.\n\nThere is also **free parking directly in front of the building**.\n\n## Rent\n\n**420€ rent + 75 € monthly flat-rate additional costs**\n\nThe additional costs include:\n* internet\n* electricity\n* water\n* broadcasting fee\n* furniture\n\nNot included are: \n* towels/bedding (can be rent upon request) \n* cosmetic & hygiene products (shampoo, shower gel, washing powder...)\n* overnight guests\n\n**Total: 495 € per month**\n\n**Deposit: 500 €**\n\nInitial rental period: ** 3-12 months**, with the possibility of extending by mutual agreement.\n\n## House rules\n\nWe are a **non-smoking household**.\n\nNo:\n* parties in the apartment\n* excessive alcohol consumption\n* pets\n\nIf you think this could be a good fit for you, please tell us a little about yourself:\n\n**What are you doing in Leipzig? Why are you coming to the city? What are you looking for in a home and in a shared living situation?**\n\nWe are looking forward to getting to know you.\n","facilities":{"airConditioning":{"value":"no"},"allergyFriendly":{"value":"yes"},"balconyTerrace":{"value":"shared"},"basement":{"value":"shared"},"bathroom":{"value":"shared_w_both"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"yes"},"bedroomSize":{"value":"11"},"bedrooms":{"value":"1"},"closet":{"value":"yes"},"couplesAllowed":{"value":"no"},"desk":{"value":"yes"},"dishwasher":{"value":"yes"},"dryer":{"value":"no"},"electricityCostIncluded":{"value":"no"},"flooring":{"value":"plastic"},"garden":{"value":"no"},"gasCostIncluded":{"value":"yes"},"gender":{"value":"female"},"heating":{"value":"central"},"housematesGender":{"value":"shared_w_girls"},"internetCostIncluded":{"value":"no"},"kitchen":{"value":"shared"},"kitchenware":{"value":"shared"},"livingRoom":{"value":"shared"},"parking":{"value":"shared"},"pets":{"value":"discussable"},"playMusic":{"value":"discussable"},"registrationPossible":{"value":"yes"},"roomFurniture":{"value":"yes"},"smoking":{"value":"no"},"toilet":{"value":"shared"},"totalSize":{"value":"11"},"tv":{"value":"yes"},"washingMachine":{"value":"yes"},"waterCostIncluded":{"value":"no"},"wheelchairAccessible":{"value":"no"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":49500,"deposit":50000,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"495.00","deposit":"500.00","agencyFee":"0.00","estimatedBills":"0.00"},"minimumStayMonths":3,"moveInWindow":0,"currentOccupancy":0,"minAge":18,"maxAge":0,"preferredGender":"","available":[{"to":"9999-12-31","from":"2026-11-21"}],"updated":"2026-11-21T21:41:10Z","__utId__":"ut1740696"}]