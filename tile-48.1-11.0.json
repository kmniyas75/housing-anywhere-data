nk":"https://housinganywhere.imgix.net/unit_type/1738697/22091191-a91b-48bd-8907-febbabbb0db6.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}},{"originalLink":"https://housinganywhere.imgix.net/unit_type/1738697/639da7a9-f704-42b1-8496-e9186d89aab8.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","categories":null,"sizes":{"1024x768":{"link":"https://housinganywhere.imgix.net/unit_type/1738697/639da7a9-f704-42b1-8496-e9186d89aab8.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/unit_type/1738697/639da7a9-f704-42b1-8496-e9186d89aab8.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1738697/639da7a9-f704-42b1-8496-e9186d89aab8.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1738697/639da7a9-f704-42b1-8496-e9186d89aab8.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1738697/639da7a9-f704-42b1-8496-e9186d89aab8.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}},{"originalLink":"https://housinganywhere.imgix.net/unit_type/1738697/8e41ecb7-79e0-4937-8e6a-94c131d3dbc5.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","categories":null,"sizes":{"1024x768":{"link":"https://housinganywhere.imgix.net/unit_type/1738697/8e41ecb7-79e0-4937-8e6a-94c131d3dbc5.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/unit_type/1738697/8e41ecb7-79e0-4937-8e6a-94c131d3dbc5.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1738697/8e41ecb7-79e0-4937-8e6a-94c131d3dbc5.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1738697/8e41ecb7-79e0-4937-8e6a-94c131d3dbc5.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1738697/8e41ecb7-79e0-4937-8e6a-94c131d3dbc5.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"Discovery Channel: Haus des Jahres - Design-Bauernhaus nahe München\n\nDas exklusive Anwesen wurde auf Discovery Channel vorgestellt und erhielt die volle Punktzahl in der Kategorie „Schönstes Haus Deutschlands”.\n\nNahe München und den schönsten Seen der Region -ein Ort, an dem das Nervensystem wieder zur Ruhe kommt. Trotzdem strategisch sehr günstig gelegen. Für Personen, die eine Kombination aus Stadt und Erholung suchen.\n\nHistorisches Anwesen von 1840: Sehr repräsentativ, hochwertig möbliert, zur Alleinnutzung.  \n\n🏡 Perfekt für eine Familie mit 3-4 Kindern und Aupair\n🌳 Großer privater Garten mit Blick auf`s Feld\n🌸 Idyllische Süd-Terrasse\n🔥 Kamin im Wohn-Essbereich\n🛀 10 Zimmer, 3 Bäder\n\nLage & Umgebung:\n🚣 Ammersee und weitere Seen in der Umgebung: Hiking, Biking, Sailing\n🥐 Bäcker, Gartencafé & Hofläden fussläufig\n🚍 Bus zur S-Bahn nach München direkt ab Haustüre.\n\n📍 16 Min. zum Ammersee\n📍 20 Min. Landsberg\n📍 38 Min. München Hbf\n📍 35 Min. Augsburg\n\nHochwertige Ausstattung:\n4 Schlafzimmer, 3 Bäder, Wohnzimmer, Leseraum, Esszimmer, Yogaraum mit 7 m Deckenhöhe, voll ausgestattetes Büro für Homeoffice, Kamin in der Küche. Großer Garten mit alten Obstbäumen, unverbauter Blick aufs Feld, idyllische Veranda, kleiner Seerosenteich.\n\nEinrichtung:\nJedes Möbelstück erzählt eine Geschichte – von Reisen, Antiquitätenmärkten, gemischt mit exklusiven Designklassikern. Das Haus ist voll ausgestattet, inklusive Geschirr, Bettwäsche und Handtücher.\n\nBaubiologisch und elektrosmogarm eingerichtet – für viele ein unerwartetes Highlight.\n\nEin echter Kraftplatz: Kleine Kinder wollen hier oft umgehend einziehen, sie scheinen intuitiv zu spüren, dass es sich um einen guten Ort handelt.\n\nMietpreis zzgl. Heizung nach Verbrauch (500.- € veranschlagt)\nKaution 2 MM\n\nGesucht werden Mieter, die einen sorgsamen, respektvollen Umgang mit hochwertigen Materialien gewohnt sind.\n\nFür alle, die vorübergehend ein echtes Zuhause statt eines Hotelzimmers suchen – beruflich oder privat.","facilities":{"airConditioning":{"value":"no"},"balconyTerrace":{"value":"private"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"yes"},"bedrooms":{"value":"4"},"closet":{"value":"yes"},"desk":{"value":"yes"},"dishwasher":{"value":"yes"},"dryer":{"value":"no"},"electricityCostIncluded":{"value":"yes"},"garden":{"value":"private"},"gasCostIncluded":{"value":"yes"},"internetCostIncluded":{"value":"yes"},"kitchen":{"value":"private"},"kitchenware":{"value":"private"},"livingRoom":{"value":"private"},"parking":{"value":"private"},"playMusic":{"value":"yes"},"registrationPossible":{"value":"yes"},"roomFurniture":{"value":"yes"},"smoking":{"value":"no"},"toilet":{"value":"private"},"totalSize":{"value":"380"},"tv":{"value":"no"},"washingMachine":{"value":"yes"},"waterCostIncluded":{"value":"yes"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":495000,"deposit":990000,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"4950.00","deposit":"9900.00","agencyFee":"0.00","estimatedBills":"0.00"},"minimumStayMonths":0,"moveInWindow":0,"currentOccupancy":0,"minAge":0,"maxAge":0,"preferredGender":"","available":[{"to":"9999-12-31","from":"2026-09-08"}],"updated":"2026-09-08T08:26:31Z","__utId__":"ut1738697"}]